<% const homeIsAdmin = String(userrole || '').toUpperCase() === 'ADMIN'; %>
<% const homeSubjects = Array.isArray(subjects) ? [...new Map(subjects.filter(item => item && item.subject).map(item => [String(item.subject).trim(), item])).values()] : []; %>
<% const homeSchoolName = String(schoolName || 'School').trim(); %>
<% const homeSchoolShortName = homeSchoolName.split(/\s+/).filter(Boolean).map(word => word[0]).join('').toUpperCase(); %>
<aside class="desktop-home-sidebar" id="desktopHomeSidebar" aria-label="Main navigation">
	<div class="home-sidebar-brand">
		<a href="/" aria-label="<%= homeSchoolName %> home"><span class="home-brand-mark"><img src="/image.png" alt="<%= homeSchoolName %> logo" onerror="this.hidden=true; this.nextElementSibling.hidden=false"><span class="home-brand-monogram" hidden><%= homeSchoolShortName %></span></span><span class="home-brand-copy"><strong><%= homeSchoolShortName %></strong><small><%= homeSchoolName %></small></span></a>
		<button class="home-sidebar-toggle" type="button" aria-label="Collapse sidebar" title="Collapse sidebar"><i class="fa-solid fa-angles-left" aria-hidden="true"></i></button>
	</div>
	<div class="home-sidebar-user"><span class="home-user-avatar"><%= String(teacherName || 'U').trim().split(/\s+/).slice(0, 2).map(part => part[0] || '').join('').toUpperCase() %></span><span class="home-user-copy"><strong><%= teacherName || 'Staff member' %></strong><small><%= homeIsAdmin ? 'Administrator' : 'Teacher' %></small></span></div>
