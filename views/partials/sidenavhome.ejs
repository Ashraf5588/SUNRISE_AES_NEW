			</div>
		</details>
		<% if (homeIsAdmin) { %>
		<details class="home-nav-group">
			<summary><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i><span>Basic Setup</span></summary>
			<div class="home-nav-submenu">
				<a href="/admin/class"><i class="fa-solid fa-school" aria-hidden="true"></i>Class setup</a>
				<a href="/admin/terminal"><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i>Terminal setup</a>
				<a href="/admin/marksheetsetup"><i class="fa-solid fa-file-circle-check" aria-hidden="true"></i>Marksheet setup</a>
				<a href="/admin/new/subject"><i class="fa-solid fa-book-medical" aria-hidden="true"></i>Add subject</a>
				<a href="/user"><i class="fa-solid fa-user-gear" aria-hidden="true"></i>User management</a>
				<a href="/branchsetup"><i class="fa-solid fa-building" aria-hidden="true"></i>Branch setup</a>
				<a href="/departmentsetup"><i class="fa-solid fa-sitemap" aria-hidden="true"></i>Department setup</a>
				<a href="/sectionsetup"><i class="fa-solid fa-layer-group" aria-hidden="true"></i>Section setup</a>
				<a href="/designationsetup"><i class="fa-solid fa-id-card" aria-hidden="true"></i>Designation setup</a>
				<a href="/shiftsetup"><i class="fa-solid fa-clock" aria-hidden="true"></i>Shift setup</a>
			</div>
		</details>
		<% } %>
		<a class="home-nav-link" href="/staffcontacts"><i class="fa-solid fa-address-book" aria-hidden="true"></i><span>Staff Contact List</span></a>
		<% if (homeIsAdmin) { %>
		<a class="home-nav-link" href="/inventory"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i><span>Inventory Dashboard</span></a>
		<a class="home-nav-link" href="/healthrecord"><i class="fa-solid fa-kit-medical" aria-hidden="true"></i><span>Health Management Dashboard</span></a>
		<a class="home-nav-link" href="/library/dashboard"><i class="fa-solid fa-book-open" aria-hidden="true"></i><span>Library Management Dashboard</span></a>
		<a class="home-nav-link" href="/employeemanagementdashboard"><i class="fa-solid fa-users" aria-hidden="true"></i><span>Employee Management Dashboard</span></a>
		<% } %>
		<a class="home-nav-link" href="/employeeprofile"><i class="fa-solid fa-id-card" aria-hidden="true"></i><span>My profile (KYC)</span></a>
		<% if (homeIsAdmin) { %>
		<details class="home-nav-group">
			<summary><i class="fa-solid fa-ellipsis" aria-hidden="true"></i><span>More</span></summary>
			<div class="home-nav-submenu">
				<a href="/principaldashboard"><i class="fa-solid fa-gauge" aria-hidden="true"></i>Principal dashboard</a>
			</div>
		</details>
		<% } %>
	</nav>
	<a class="home-sidebar-logout" href="/admin/login"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><span>Sign out</span></a>
</aside>
<script>
	(() => {
		const toggle = document.querySelector('.home-sidebar-toggle');
		toggle?.addEventListener('click', () => {
			const collapsed = document.body.classList.toggle('home-sidebar-collapsed');
			toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
			toggle.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
		});
	})();
</script>
