			<summary><i class="fa-solid fa-bullhorn" aria-hidden="true"></i><span>Notice & Event</span></summary>
			<div class="home-nav-submenu">
				<% if (homeIsAdmin) { %><a href="/notice/add"><i class="fa-solid fa-plus" aria-hidden="true"></i>Add notice</a><% } %>
				<a href="/notice"><i class="fa-solid fa-bell" aria-hidden="true"></i>Notice list</a>
				<a href="/createevent"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i>Event management</a>
			</div>
		</details>
		<details class="home-nav-group">
			<summary><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i><span>Exam Management</span></summary>
			<div class="home-nav-submenu">
				<% if (homeIsAdmin) { %><a href="/exammanagement"><i class="fa-solid fa-gauge" aria-hidden="true"></i>Exam management dashboard</a><a href="/locker"><i class="fa-solid fa-lock" aria-hidden="true"></i>Entry form locker</a><a href="/admin/marksheetsetup"><i class="fa-solid fa-file-circle-check" aria-hidden="true"></i>Marksheet setup</a><% } %>
				<a href="/examform"><i class="fa-solid fa-file-signature" aria-hidden="true"></i>Exam marks entry</a>
				<% if (homeIsAdmin) { %><a href="/theoryentrycounter"><i class="fa-solid fa-arrow-down-1-9" aria-hidden="true"></i>Exam marks entry counter</a><a href="/ledger"><i class="fa-solid fa-book-open" aria-hidden="true"></i>Generate ledger</a><a href="/formatchoose"><i class="fa-solid fa-file-lines" aria-hidden="true"></i>Generate marksheet</a><% } %>
			</div>
		</details>
