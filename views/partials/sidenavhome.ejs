				<a href="/admin/subject"><i class="fa-solid fa-list-check" aria-hidden="true"></i>Question format</a>
				<% homeSubjects.forEach(subject => { const encodedSubject = encodeURIComponent(String(subject.subject).trim()); %>
				<div class="home-nav-nested"><strong><%= subject.subject %></strong><a href="/forms/<%= encodedSubject %>">Enter analysis data</a><a href="/teacher/<%= encodedSubject %>/findData">View analysis report</a></div>
				<% }) %>
				<% if (homeIsAdmin) { %><a href="/reportprint"><i class="fa-solid fa-print" aria-hidden="true"></i>Print analysis report</a><a href="/admin/comparisionprint"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>Print comparison analysis</a><a href="/deleteanalysis"><i class="fa-solid fa-trash" aria-hidden="true"></i>Delete analysis report</a><a href="/analysisentrycounter"><i class="fa-solid fa-chart-column" aria-hidden="true"></i>Analysis entry counter</a><% } %>
			</div>
		</details>
		<details class="home-nav-group">
			<summary><i class="fa-solid fa-book" aria-hidden="true"></i><span>Academics</span></summary>
			<div class="home-nav-submenu">
