			<summary><i class="fa-solid fa-calendar-check" aria-hidden="true"></i><span>Attendance</span></summary>
			<div class="home-nav-submenu">
				<% if (homeIsAdmin) { %><a href="/absent-record"><i class="fa-solid fa-user-xmark" aria-hidden="true"></i>Daily absent record</a><a href="/employeeattendance"><i class="fa-solid fa-user-clock" aria-hidden="true"></i>Employee attendance</a><% } %>
				<a href="/onlineattendance"><i class="fa-solid fa-users" aria-hidden="true"></i>Student attendance</a>
				<a href="/attendance-summary"><i class="fa-solid fa-chart-column" aria-hidden="true"></i>Student attendance summary</a>
				<a href="/myattendance"><i class="fa-solid fa-user-check" aria-hidden="true"></i>My attendance</a>
				<% if (homeIsAdmin) { %><a href="/employeeattendancesetup"><i class="fa-solid fa-sliders" aria-hidden="true"></i>Employee time setup</a><a href="/addweekend"><i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i>Employee weekends</a><% } %>
			</div>
		</details>
		<details class="home-nav-group">
			<summary><i class="fa-solid fa-inbox" aria-hidden="true"></i><span>Requests</span></summary>
			<div class="home-nav-submenu">
				<a href="/leave"><i class="fa-solid fa-plane-departure" aria-hidden="true"></i>Leave request</a>
				<a href="/manualpunch"><i class="fa-solid fa-fingerprint" aria-hidden="true"></i>Manual punch request</a>
				<a href="/inventory/productrequests"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>Product request</a>
			</div>
		</details>
		<% if (homeIsAdmin) { %><a class="home-nav-link" href="/teacher-record"><i class="fa-solid fa-user-tie" aria-hidden="true"></i><span>Teacher Activity Record</span></a><% } %>
		<% if (homeIsAdmin) { %>
		<details class="home-nav-group">
			<summary><i class="fa-solid fa-users-gear" aria-hidden="true"></i><span>Student Management</span></summary>
			<div class="home-nav-submenu">
				<a href="/studentportfolio"><i class="fa-solid fa-address-card" aria-hidden="true"></i>Portfolio</a>
				<a href="/printportfolio"><i class="fa-solid fa-print" aria-hidden="true"></i>Print portfolio</a>
				<a href="/admin/portfolio/eventscholarship"><i class="fa-solid fa-award" aria-hidden="true"></i>Print participation</a>
				<a href="/studentrecord"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>Add or manage students</a>
				<a href="/student-transfer"><i class="fa-solid fa-right-left" aria-hidden="true"></i>Student update</a>
			</div>
		</details>
		<details class="home-nav-group">
			<summary><i class="fa-solid fa-chart-line" aria-hidden="true"></i><span>Monitoring</span></summary>
			<div class="home-nav-submenu">
				<a href="/dailydashboard"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i>Day dashboard</a>
				<a href="/cascounter"><i class="fa-solid fa-list-ol" aria-hidden="true"></i>1-5 CAS entry counter</a>
				<a href="/projectcounter"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i>Project entry counter</a>
				<a href="/projectlist"><i class="fa-solid fa-list-check" aria-hidden="true"></i>Project work list</a>
				<a href="/analysisentrycounter"><i class="fa-solid fa-chart-column" aria-hidden="true"></i>Answer Analysis entry counter</a>
			</div>
		</details>
		<% } %>
