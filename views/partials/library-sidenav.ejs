 <script src="https://cdn.lordicon.com/lordicon.js"></script>
    <script src="https://kit.fontawesome.com/368eb67b69.js" crossorigin="anonymous"></script>
<button class="library-nav-toggle" type="button" aria-label="Collapse navigation" aria-controls="librarySidebar" aria-expanded="true">
  <span></span><span></span><span></span>
</button>
<button class="library-nav-overlay" type="button" aria-label="Close navigation"></button>
<aside class="sidebar" id="librarySidebar">
  <div class="brand">
    <span class="brand-mark">L</span>
    <span class="library-nav-text">Library</span>
  </div>
  <div class="nav-group">
    <div class="nav-label">Overview</div>
    <% const libraryNavItems = [
      { id: 'dashboard', label: 'Dashboard', href: '/library/dashboard', icon: '<i class="fa-solid fa-house" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'books', label: 'Add New Books', href: '/library/books', icon: '<i class="fa-solid fa-plus" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'categories', label: 'Categories', href: '/library/categories', icon: '<i class="fa-solid fa-tags" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'members', label: 'Members', href: '/library/members', icon: '<i class="fa-solid fa-users" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'issues', label: 'Book Issue/Return', href: '/library/issues', icon: '<i class="fa-solid fa-hand-holding-dollar" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'lost-books', label: 'Lost Books', href: '/library/lost-books', icon: '<i class="fa-solid fa-question-circle" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'analytics', label: 'Analytics', href: '/library/analytics', icon: '<i class="fa-solid fa-chart-line" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'inventory', label: 'Book Inventory', href: '/library/inventory', icon: '<i class="fa-solid fa-warehouse" style="color: rgb(255, 255, 255);"></i>' },
      { id: 'shelf-assignment', label: 'Assign Shelves', href: '/library/shelf-assignment', icon: '<i class="fa-solid fa-bars-progress" style="color: rgb(255, 255, 255);"></i>' }
    ]; %>
    <% libraryNavItems.forEach((item) => { %>
      <a class="nav-item<%= activePage === item.id ? ' active' : '' %>" href="<%= item.href %>" title="<%= item.label %>" <%= activePage === item.id ? 'aria-current="page"' : '' %>>
        <span class="library-nav-icon" aria-hidden="true"><%- item.icon %></span>
        <span class="library-nav-text"><%= item.label %></span>
      </a>
    <% }); %>
  </div>
</aside>