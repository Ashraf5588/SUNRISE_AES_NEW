<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f6f8f7">
  <title>Parent Portal Sign In</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { color-scheme: light; --ink:#182a2a; --muted:#667977; --green:#157765; --coral:#e97758; --line:#dce7e4; }
    * { box-sizing:border-box; }
    body { min-height:100vh; margin:0; display:grid; place-items:center; padding:22px; background:radial-gradient(circle at 12% 10%,#d9eee8 0,transparent 34%),radial-gradient(circle at 90% 90%,#ffe4d5 0,transparent 32%),#f6f8f7; color:var(--ink); font-family:'DM Sans',sans-serif; }
    .login { width:min(100%,410px); padding:30px; background:rgba(255,255,255,.94); border:1px solid var(--line); border-radius:8px; box-shadow:0 20px 65px rgba(24,42,42,.09); }
    .brand { display:flex; align-items:center; gap:12px; margin-bottom:30px; }
    .brand-mark { width:44px; aspect-ratio:1; display:grid; place-items:center; border-radius:50%; background:#dcefe9; color:var(--green); font-size:18px; font-weight:700; }
    .brand-title { font-size:14px; font-weight:700; letter-spacing:.04em; }
    .brand-subtitle { margin-top:2px; color:var(--muted); font-size:12px; }
    h1 { margin:0 0 8px; font-size:27px; line-height:1.2; }
    .intro { margin:0 0 25px; color:var(--muted); font-size:14px; }
    label { display:block; margin:15px 0 7px; font-size:13px; font-weight:600; }
    input { width:100%; min-height:48px; padding:12px 13px; border:1px solid #bdcfca; border-radius:5px; background:#fff; color:var(--ink); font:inherit; }
    input:focus { outline:3px solid #cce9e1; border-color:var(--green); }
    button { width:100%; min-height:48px; margin-top:22px; border:0; border-radius:5px; background:var(--green); color:white; font:700 14px 'DM Sans',sans-serif; cursor:pointer; }
    button:hover { background:#105e50; }
    .error { margin:0 0 14px; padding:11px 12px; border-left:3px solid var(--coral); background:#fff1eb; color:#7c382b; font-size:13px; }
    @media(max-width:480px) { body { padding:14px; } .login { padding:24px 20px; } }
  </style>
</head>
<body>
  <main class="login">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">S</div>
      <div><div class="brand-title">SUNRISE AES</div><div class="brand-subtitle">Parent Portal</div></div>
    </div>
    <h1>Welcome back</h1>
    <p class="intro">Sign in to view your student's school updates.</p>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="POST" action="/parents/login" autocomplete="on">
      <label for="username">Username</label>
      <input id="username" name="username" autocomplete="username" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit">Sign in</button>
    </form>
  </main>
</body>
</html>
