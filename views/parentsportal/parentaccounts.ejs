<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Parent Portal Accounts</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --ink:#182a2a; --muted:#647874; --green:#157765; --line:#dce7e4; --paper:#fff; }
    * { box-sizing:border-box; }
    body { margin:0; padding:24px 16px; background:#f3f7f5; color:var(--ink); font-family:'DM Sans',sans-serif; }
    main { max-width:1160px; margin:auto; }
    header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:18px; }
    h1 { margin:0; font-size:25px; }
    a { color:var(--green); font-size:13px; font-weight:700; text-decoration:none; }
    .intro { margin:6px 0 20px; color:var(--muted); font-size:14px; }
    .search { width:100%; max-width:360px; min-height:42px; margin-bottom:14px; padding:10px 12px; border:1px solid #bfcec9; border-radius:5px; font:inherit; }
    .table-wrap { overflow:auto; border:1px solid var(--line); border-radius:7px; background:var(--paper); }
    table { width:100%; min-width:960px; border-collapse:collapse; }
    th,td { padding:11px 12px; border-bottom:1px solid #e7eeec; text-align:left; vertical-align:middle; }
    th { background:#eaf2ef; color:#48605a; font-size:11px; text-transform:uppercase; }
    td { font-size:13px; }
    tbody tr:last-child td { border-bottom:0; }
    .student { font-weight:700; }
    .subline { display:block; margin-top:3px; color:var(--muted); font-size:11px; }
    input[type=text],input[type=password] { width:100%; min-width:130px; min-height:38px; padding:8px; border:1px solid #c7d4d0; border-radius:4px; font:inherit; }
    .active-cell { text-align:center; }
    .active-cell input { width:17px; height:17px; accent-color:var(--green); }
    button { border:0; border-radius:4px; padding:9px 13px; background:var(--green); color:#fff; font:700 12px 'DM Sans',sans-serif; cursor:pointer; white-space:nowrap; }
    .empty { padding:32px; text-align:center; color:var(--muted); }
    @media(max-width:640px) { body { padding:18px 12px; } header { align-items:flex-start; flex-direction:column; } h1 { font-size:22px; } }
  </style>
</head>
<body>
  <main>
    <header><h1>Parent Management</h1><a href="/">Back to dashboard</a></header>
    <p class="intro">Create a student-role login linked to the student's registration. That username and password also work on the main login page. Leave password blank to keep an existing shared login.</p>
    <% if (saved) { %><p role="status">Student account saved. The student can sign in from the main login page.</p><% } %>
    <% if (error) { %><p role="alert"><%= error %></p><% } %>
    <input class="search" id="studentSearch" type="search" placeholder="Filter by student, class, or registration" aria-label="Filter students">
    <div class="table-wrap">
      <% if (rows.length) { %>
        <% rows.forEach((row, index) => { const formId = `student-account-${index}`; %><form id="<%= formId %>" method="POST" action="/parents/admin/accounts/create"><input type="hidden" name="studentReg" value="<%= row.reg %>"></form><% }) %>
        <table>
          <thead><tr><th>Student</th><th>Username</th><th>Parent display name</th><th>Password</th><th>Active</th><th></th></tr></thead>
          <tbody id="accountRows">
            <% rows.forEach((row, index) => { const formId = `student-account-${index}`; %>
              <tr data-search="<%= `${row.name} ${row.reg} ${row.studentClass} ${row.section}`.toLowerCase() %>">
                <td><span class="student"><%= row.name %></span><span class="subline"><%= row.studentClass %> · <%= row.section %> · <%= row.reg %></span></td>
                <td><input form="<%= formId %>" type="text" name="username" value="<%= row.parentAccount?.username || '' %>" autocomplete="off" required minlength="3" aria-label="Student username for <%= row.name %>"></td>
                <td><input form="<%= formId %>" type="text" name="displayName" value="<%= row.parentAccount?.displayName || row.fatherName || row.motherName || '' %>" aria-label="Parent display name for <%= row.name %>"></td>
                <td><input form="<%= formId %>" type="password" name="password" autocomplete="new-password" placeholder="<%= row.isSharedAccount ? 'Keep current' : '8+ characters' %>" <%= row.isSharedAccount ? '' : 'required minlength="8"' %> aria-label="Student password for <%= row.name %>"></td>
                <td class="active-cell"><input form="<%= formId %>" type="checkbox" name="active" <%= row.parentAccount ? row.parentAccount.active !== false ? 'checked' : '' : 'checked' %> aria-label="Enable student login for <%= row.name %>"></td>
                <td><button form="<%= formId %>" type="submit"><%= row.isSharedAccount ? 'Save' : 'Create' %></button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %><div class="empty">No student records found.</div><% } %>
    </div>
  </main>
  <script>
    document.getElementById('studentSearch').addEventListener('input', (event) => {
      const query = event.target.value.trim().toLowerCase();
      document.querySelectorAll('#accountRows tr').forEach((row) => {
        row.hidden = query && !row.dataset.search.includes(query);
      });
    });
  </script>
</body>
</html>
