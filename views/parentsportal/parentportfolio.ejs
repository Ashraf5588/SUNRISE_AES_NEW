<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
	<meta name="theme-color" content="#f4f7f6">
	<title>Student portfolio | <%= student.name %></title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
	<style>
		:root { color-scheme:light; --ink:#19324d; --muted:#667b92; --blue:#235d9d; --blue-dark:#174577; --blue-soft:#eaf2fb; --line:#d8e3ef; --paper:#fff; --canvas:#f1f5fa; font-family:'DM Sans',sans-serif; color:var(--ink); background:var(--canvas); }
		* { box-sizing:border-box; }
		body { margin:0; min-height:100vh; padding-bottom:calc(92px + env(safe-area-inset-bottom)); background:linear-gradient(145deg,#edf3fa,#f7f9fc); }
		.page { width:min(100%,820px); min-height:100vh; margin:0 auto; padding:20px 20px 110px; background:var(--paper); }
		.topbar { display:flex; align-items:center; justify-content:space-between; gap:14px; padding-bottom:18px; border-bottom:1px solid var(--line); }
		.profile { display:flex; align-items:center; gap:12px; min-width:0; }
		.avatar { display:grid; width:48px; height:48px; flex:0 0 48px; place-items:center; border:2px solid #d6e5f5; border-radius:50%; background:var(--blue-soft); color:var(--blue-dark); font:800 14px 'Manrope',sans-serif; }
		.profile-copy { min-width:0; }
		.profile-copy h1 { overflow:hidden; margin:0; font:800 17px/1.25 'Manrope',sans-serif; text-overflow:ellipsis; white-space:nowrap; }
		.profile-copy p { margin:4px 0 0; color:var(--muted); font-size:11px; }
		.back-link { display:inline-flex; min-height:38px; align-items:center; padding:0 12px; border:1px solid var(--line); border-radius:5px; background:#fff; color:var(--blue); font-size:12px; font-weight:700; text-decoration:none; white-space:nowrap; }
		.back-link:hover { border-color:#b6cde6; background:#f7faff; }
		.intro { margin:20px 0 5px; color:var(--blue); font-size:11px; font-weight:800; text-transform:uppercase; }
		.page-title { margin:0 0 17px; font:800 23px/1.25 'Manrope',sans-serif; }
		.summary-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:18px; }
		.summary-card { display:grid; min-height:76px; align-content:center; gap:4px; padding:11px 13px; border:1px solid var(--line); border-left:3px solid var(--blue); border-radius:6px; background:#f7faff; color:var(--ink); text-decoration:none; }
		.summary-card:hover { background:var(--blue-soft); }
		.summary-label { color:var(--muted); font-size:11px; font-weight:700; }
		.summary-value { color:var(--blue-dark); font:800 21px 'Manrope',sans-serif; }
		.portfolio-section { margin-top:13px; padding:16px; border:1px solid var(--line); border-radius:7px; background:var(--paper); }
		.section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:10px; }
		.section-heading h2 { margin:0; font:800 16px 'Manrope',sans-serif; }
		.section-count { color:var(--blue); font-size:11px; font-weight:800; }
		.entry { padding:12px 0; border-bottom:1px solid #edf1ef; }
		.entry:last-child { border-bottom:0; }
		.entry-title { font-size:13px; font-weight:700; }
		.entry-meta { margin-top:4px; color:var(--muted); font-size:11px; }
		.entry-detail { margin-top:6px; color:#465a55; font-size:12px; line-height:1.5; }
		.month-counts { display:flex; flex-wrap:wrap; gap:7px; margin:0 0 8px; }
		.month-count { padding:6px 9px; border:1px solid #d8e6f5; border-radius:5px; background:#f2f7fd; color:var(--blue-dark); font-size:11px; }
		.empty-state { padding:12px 0 5px; color:var(--muted); font-size:12px; }
		.mobile-bottom-nav { position:fixed; z-index:20; right:0; bottom:0; left:0; display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); align-items:end; width:min(100%,820px); margin:0 auto; padding:8px 10px calc(8px + env(safe-area-inset-bottom)); border-top:1px solid #d8e2ef; background:rgba(255,255,255,.97); box-shadow:0 -7px 20px rgba(24,53,86,.08); backdrop-filter:blur(12px); }
		.parent-bottom-link { min-width:0; min-height:48px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; border-radius:9px; color:#74849a; font-size:9px; font-weight:700; text-decoration:none; }
		.parent-bottom-link.active { background:#e9f1fb; color:var(--blue-dark); }
		.parent-bottom-link.home-link { width:58px; height:58px; justify-self:center; transform:translateY(-10px); border:3px solid #fff; border-radius:19px; background:#183d6b; color:#fff; box-shadow:0 7px 17px rgba(18,49,85,.3); }
		.parent-bottom-link svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
		@media(max-width:520px) { .page { padding:16px 13px 110px; } .topbar { align-items:flex-start; } .profile { gap:9px; } .avatar { width:42px; height:42px; flex-basis:42px; } .profile-copy h1 { font-size:14px; } .profile-copy p { max-width:180px; line-height:1.4; } .back-link { min-height:34px; padding:0 9px; font-size:11px; } .summary-grid { gap:6px; } .summary-card { min-height:70px; padding:9px 7px; } .summary-label { font-size:10px; line-height:1.25; } .summary-value { font-size:19px; } .portfolio-section { padding:13px 12px; } .section-heading h2 { font-size:15px; } }
	</style>
</head>
<body>
	<main class="page">
		<header class="topbar">
			<div class="profile">
				<div class="avatar" aria-hidden="true"><%= studentInitials %></div>
				<div class="profile-copy">
					<h1><%= student.name %></h1>
					<p>Reg <%= student.reg %> · Class <%= student.studentClass %> · Section <%= student.section %></p>
				</div>
			</div>
			<a class="back-link" href="/parents">Back to home</a>
		</header>
		<p class="intro">Student portfolio</p>
		<h2 class="page-title">Activities and records</h2>
		<nav class="summary-grid" aria-label="Portfolio record counts">
			<a class="summary-card" href="#complaints"><span class="summary-label">Complaints</span><strong class="summary-value"><%= complaints.length %></strong></a>
			<a class="summary-card" href="#parent-responses"><span class="summary-label">Parent responses</span><strong class="summary-value"><%= parentMeetings.length %></strong></a>
			<a class="summary-card" href="#absences"><span class="summary-label">Absent days</span><strong class="summary-value"><%= absentSummary.totalAbsent %></strong></a>
		</nav>

		<section class="portfolio-section" id="complaints" aria-labelledby="complaints-title">
			<div class="section-heading"><h2 id="complaints-title">Complaints</h2><span class="section-count"><%= complaints.length %> records</span></div>
			<% if (complaints.length) { complaints.forEach(item => { %>
				<article class="entry"><div class="entry-title"><%= item.reason || 'Complaint' %></div><div class="entry-meta"><%= item.nepaliDate || (item.date ? new Date(item.date).toLocaleDateString() : '') %><%= item.by ? ` · By ${item.by}` : '' %></div></article>
			<% }) } else { %><div class="empty-state">No complaints recorded yet.</div><% } %>
		</section>

		<section class="portfolio-section" id="parent-responses" aria-labelledby="parent-responses-title">
			<div class="section-heading"><h2 id="parent-responses-title">Parent Response Record</h2><span class="section-count"><%= parentMeetings.length %> records</span></div>
			<% if (parentMeetings.length) { parentMeetings.forEach(item => { %>
				<article class="entry"><div class="entry-title"><%= item.visitingReason || item.parentComplaint || 'Parent response' %></div><div class="entry-meta"><%= item.nepaliDate || (item.createdAt ? new Date(item.createdAt).toLocaleDateString() : '') %><%= item.by ? ` · By ${item.by}` : '' %></div><% if (item.parentComplaint) { %><div class="entry-detail"><strong>Parent view:</strong> <%= item.parentComplaint %></div><% } %><% if (item.schoolResponse) { %><div class="entry-detail"><strong>School response:</strong> <%= item.schoolResponse %></div><% } %></article>
			<% }) } else { %><div class="empty-state">No parent response records yet.</div><% } %>
		</section>

		<section class="portfolio-section" id="absences" aria-labelledby="absences-title">
			<div class="section-heading"><h2 id="absences-title">Absent Details</h2><span class="section-count"><%= absentSummary.totalAbsent %> total</span></div>
			<% const absenceMonths = Object.entries(absentSummary.monthCounts || {}); %>
			<% if (absenceMonths.length) { %><div class="month-counts"><% absenceMonths.forEach(([month, count]) => { %><span class="month-count"><%= month %> <strong><%= count %></strong></span><% }) %></div><% } %>
			<% if (absentSummary.reasons.length) { absentSummary.reasons.forEach(item => { %><article class="entry"><div class="entry-meta"><%= item.date %></div><div class="entry-detail"><%= item.reason %></div></article><% }) } else if (!absentSummary.totalAbsent) { %><div class="empty-state">No absence records yet.</div><% } else { %><div class="empty-state">No absence reasons have been recorded.</div><% } %>
		</section>

		<section class="portfolio-section" aria-labelledby="health-title">
			<div class="section-heading"><h2 id="health-title">Health Visits</h2><span class="section-count"><%= healthVisits.length %> visits</span></div>
			<% if (healthVisits.length) { healthVisits.forEach(item => { %><article class="entry"><div class="entry-title"><%= item.diagnosis || 'Health visit' %></div><div class="entry-meta"><%= item.nepaliDate || (item.createdAt ? new Date(item.createdAt).toLocaleDateString() : '') %></div><div class="entry-detail"><strong>Treatment:</strong> <%= item.treatment || '-' %><% if (item.remarks) { %><br><strong>Remarks:</strong> <%= item.remarks %><% } %></div></article><% }) } else { %><div class="empty-state">No health visits recorded yet.</div><% } %>
		</section>

		<section class="portfolio-section" aria-labelledby="call-logs-title">
			<div class="section-heading"><h2 id="call-logs-title">Parent Call Logs</h2><span class="section-count"><%= callLogs.length %> calls</span></div>
			<% if (callLogs.length) { callLogs.forEach(item => { %><article class="entry"><div class="entry-title"><%= item.callReason || 'Parent call' %></div><div class="entry-meta"><%= item.callLoggedAt ? new Date(item.callLoggedAt).toLocaleString() : [item.academicYear, item.month, item.day].filter(Boolean).join(' ') %><%= item.callBy ? ` · By ${item.callBy}` : '' %></div><% if (item.parentResponse) { %><div class="entry-detail"><strong>Parent response:</strong> <%= item.parentResponse %></div><% } %></article><% }) } else { %><div class="empty-state">No parent call logs recorded yet.</div><% } %>
		</section>

		<section class="portfolio-section" aria-labelledby="participations-title">
			<div class="section-heading"><h2 id="participations-title">Participations</h2><span class="section-count"><%= participations.length %></span></div>
			<% if (participations.length) { participations.forEach(item => { %>
				<article class="entry"><div class="entry-title"><%= item.event || 'Activity' %></div><div class="entry-meta"><%= item.nepaliDate || (item.date ? new Date(item.date).toLocaleDateString() : '') %></div><div class="entry-detail"><%= item.position || 'Participation' %></div></article>
			<% }) } else { %><div class="empty-state">No participation records yet.</div><% } %>
		</section>

		<section class="portfolio-section" aria-labelledby="awards-title">
			<div class="section-heading"><h2 id="awards-title">Awards</h2><span class="section-count"><%= awards.length %></span></div>
			<% if (awards.length) { awards.forEach(item => { %>
				<article class="entry"><div class="entry-title"><%= item.event || 'Award' %></div><div class="entry-meta"><%= item.nepaliDate || (item.date ? new Date(item.date).toLocaleDateString() : '') %></div><% if (item.position) { %><div class="entry-detail"><%= item.position %></div><% } %></article>
			<% }) } else { %><div class="empty-state">No award records yet.</div><% } %>
		</section>

		<section class="portfolio-section" aria-labelledby="scholarships-title">
			<div class="section-heading"><h2 id="scholarships-title">Scholarships</h2><span class="section-count"><%= scholarships.length %></span></div>
			<% if (scholarships.length) { scholarships.forEach(item => { %>
				<article class="entry"><div class="entry-title"><%= item.reason || 'Scholarship' %></div><div class="entry-meta"><%= item.year || item.nepaliDate || (item.date ? new Date(item.date).toLocaleDateString() : '') %></div><% if (item.amount) { %><div class="entry-detail">Amount: <%= item.amount %></div><% } %></article>
			<% }) } else { %><div class="empty-state">No scholarship records yet.</div><% } %>
		</section>
	</main>
	<nav class="mobile-bottom-nav" aria-label="Parent navigation">
		<a class="parent-bottom-link" href="/parents?tab=notices"><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9m-8 13h4"/></svg>Notice</a>
		<a class="parent-bottom-link" href="/parents?tab=homework"><svg viewBox="0 0 24 24"><path d="M5 3h14v18H5zM8 7h8M8 11h8M8 15h5"/></svg>Homework</a>
		<a class="parent-bottom-link home-link" href="/parents"><svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg>Home</a>
		<a class="parent-bottom-link" href="/parents?tab=attendance"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4m8-4v4M3 9h18m-13 5 2 2 4-4"/></svg>Attendance</a>
		<a class="parent-bottom-link active" href="/parents/portfolio" aria-current="page"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5zM4 6h13M8 10h8M8 14h6"/></svg>Portfolio</a>
	</nav>
</body>
</html>