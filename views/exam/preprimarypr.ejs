<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<meta charset="UTF-8">
<title>Grade Sheet</title>

 <style>
    /* Clean, professional marksheet styling for A4 printing */
    :root {
      --accent: #1f6fb3;
      --muted: #666;
      --border: #222;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      background: #f3f4f6;
      font-family: 'Inter', 'Segoe UI', Roboto, Arial, sans-serif;
      color: #111;
    }

    .no-print {
      padding: 18px;
      text-align: left;
    }

    .control-panel {
      max-width: 1100px;
      margin: 12px auto;
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .control-panel button {
      padding: 8px 14px;
      border-radius: 6px;
      border: 0;
      background: var(--accent);
      color: #fff;
      cursor: pointer;
      font-size: 14px;
    }

    .control-panel button.secondary {
      background: #6c757d;
    }

    .control-panel .hint {
      color: var(--muted);
      font-size: 13px;
      margin-left: 8px;
    }

    .column-toggle-group {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-right: 8px;
    }

    .column-toggle-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
      color: #222;
      background: #f8f9fa;
      border: 1px solid #d6d8db;
      padding: 6px 10px;
      border-radius: 999px;
    }

    .column-toggle-item input {
      accent-color: #1f6fb3;
    }

    .hidden-column {
      display: none !important;
    }

    .sheets-container {
      max-width: 210mm;
      margin: 0 auto;
      padding: 0 10px;
    }

    .sheet {
      width: 100%;
      max-width: 210mm;
      min-height: 297mm;
      margin: 18mm auto;
      background: #fff;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      padding: 10mm;
      position: relative;
      box-sizing: border-box;
      page-break-after: always;
      page-break-inside: avoid;
    }

    .border-frame {
      border: 5px double #000;
      height: 100%;
      padding: 15px;
      box-sizing: border-box;
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 0;
      opacity: 0.06;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .watermark img {
      max-width: 400px;
      max-height: 400px;
      opacity: 0.08;
      filter: grayscale(100%);
    }

    .content {
      position: relative;
      z-index: 1;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .header {
      display: flex;
      gap: 15px;
      align-items: center;
      border-bottom: 2px solid #000;
      padding-bottom: 15px;
      margin-bottom: 15px;
    }

    .logo {
      width: 80px;
      height: 80px;
      flex: 0 0 80px;
      border-radius: 0;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo img {
      max-width: 100%;
      max-height: 100%;
      display: block;
    }

    .head-text {
      flex: 1;
      text-align: center;
    }

    .school-name {
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 0.5px;
      font-family: 'Times New Roman', Times, serif;
      text-transform: uppercase;
      color: #000;
      margin-bottom: 5px;
      white-space: nowrap;
    }

    .school-meta {
      font-size: 13px;
      color: #000000;
      font-weight: 500;
    }

    .report-title {
      text-align: center;
      font-weight: 800;
      color: #000;
      margin-top: 10px;
      text-transform: uppercase;
      font-size: 16px;
      border: 1px solid #000;
      display: inline-block;
      padding: 5px 15px;
      border-radius: 20px;
    }

    .student-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-top: 10px;
      gap: 8px;
      font-size: 14px;
      border: 1px solid #000;
      padding: 10px;
    }

    .info-label {
      font-weight: 700;
      color: #000;
      min-width: 120px;
    }

    .info-value {
      font-weight: 600;
      color: #000;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
      font-size: 12px;
      border: 2px solid #000;
    }

    table th, table td {
      border: 2px solid #000;
      padding: 6px 7px;
      text-align: center;
      word-wrap: break-word;
      font-size: 14px;
    }

    table th {
      background: #f0f0f0;
      color: #000;
      font-weight: 800;
      font-size: 14px;
      text-transform: uppercase;
    }

    tr:nth-child(even) td {
      background: #fff;
    }

    .subject {
      text-align: left;
      padding-left: 10px;
      font-weight: 600;
    }

    .summary {
      display: flex ;
      justify-content: space-between;
      margin-top: 12px;
      font-weight: 700;
      border: 2px solid #000;
      padding: 10px;
      font-size: 13px;
    }

    .remark-box {
      margin-top: 10px;
      padding: 10px;
      border: 1px solid #000;
      background: #fff;
      min-height: 40px;
      flex: 1;
      
    }

    .notes-row {
      display: flex;
      gap: 10px;
      margin-top: 8px;
      align-items: stretch;
    }

    .notes-row .remark-box {
      margin-top: 0;
      flex: 1;
    }

    .issued-box {
      flex: 0 0 180px;
      border: 1px solid #000;
      border-radius: 4px;
      background: #fff;
      padding: 10px;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .sign-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 30px;
      padding: 0 10px;
      gap: 16px;
    }

    .sign {
      width: 33.333%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      min-height: 100px;
      gap: 8px;
      text-align: center;
    }

    .sign .sign-img,
    .sign .sign-placeholder {
      display: block;
      max-width: 90px;
      max-height: 48px;
      width: auto;
      height: auto;
      object-fit: contain;
      margin: 0 auto;
    }

    .sign .sign-placeholder {
      width: 90px;
      height: 48px;
      border: 1px dashed #cbd5e1;
      background: #f8fafc;
    }

    .sign .line {
      margin-top: 0;
      border-top: 1px solid #000;
      padding-top: 6px;
      font-weight: 700;
      font-size: 13px;
      width: 100%;
    }

    hr {
      margin: 15px 0 10px 0;
      border: 1px solid #ddd;
    }

    .grading-scale {
      margin-top: 10px;
      font-size: 10px;
      width: 100%;
    }

    .grading-scale table {
      border: 1px solid #000;
      margin-top: 0;
    }

    .grading-scale td {
      padding: 3px 8px;
      border: 1px solid #000;
      text-align: left;
      font-size: 10px;
    }
.summary-box {
      display: flex;
      justify-content: space-between;
      margin-top: 12px;
      font-weight: 700;
     
      padding: 10px;
      font-size: 15px;
    }
    /* Form Selector Styles */
    .form-selector-panel {
      background: linear-gradient(135deg, #ff9d41 0%, #e7b170 100%);
      padding: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .form-selector-container {
      max-width: 1100px;
      margin: 0 auto;
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .form-selector-title {
      text-align: center;
      font-size: 20px;
      font-weight: 700;
      color: #333;
      margin-bottom: 20px;
    }

    .form-selector-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
      margin-bottom: 20px;
    }

    .form-selector-panel select {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 14px;
      color: #333;
      background-color: #fff;
      transition: all 0.3s ease;
      cursor: pointer;
      appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 12px center;
      background-size: 18px;
      padding-right: 40px;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-selector-panel select:hover {
      border-color: #667eea;
      box-shadow: 0 2px 8px rgba(102, 126, 234, 0.15);
    }

    .form-selector-panel select:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .form-selector-panel button {
      display: block;
      width: 100%;
      max-width: 300px;
      margin: 0 auto;
      padding: 14px 32px;
      background: linear-gradient(135deg, #250789 0%, #1e096f 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-selector-panel button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    }

    .form-selector-panel button:active {
      transform: translateY(0);
    }

    /* Print Styles */
    @media print {
      body, html {
        background: #fff;
        margin: 0;
        padding: 0;
      }

      .no-print {
        display: none !important;
      }

      .sheets-container {
        max-width: 100%;
        padding: 0;
        margin: 0;
      }

      .sheet {
        box-shadow: none;
        margin: 0;
        padding: 8mm;
        width: 210mm;
        height: 297mm;
        page-break-after: always;
        page-break-inside: avoid;
        max-width: 210mm;
      }

      .border-frame {
        height: calc(100% - 2mm);
        border: 3px double #000;
        padding: 12px;
      }

      .sheet:last-child {
        page-break-after: auto;
      }

      .sheet .watermark {
        opacity: 0.06;
      }

      .school-name {
        font-size: 24px;
      }

      table {
        font-size: 14px;
      }

      table th, table td {
        padding: 4px 5px;
      }

      .student-info {
        font-size: 13px;
        padding: 8px;
      }

      .summary {
        font-size: 11px;
        padding: 8px;
      }

      .sign .line {
        font-size: 11px;
      }

      .form-selector-panel {
        display: none !important;
      }
    }

    @page {
      size: A4;
      margin: 0;
    }

    /* Responsive */
    @media screen and (max-width: 768px) {
      .sheet {
        margin: 10px auto;
        padding: 8px;
        min-height: auto;
      }

      .border-frame {
        padding: 10px;
      }

      .header {
        flex-wrap: wrap;
        justify-content: center;
      }

      .school-name {
        font-size: 18px;
        white-space: normal;
      }

      .student-info {
        grid-template-columns: 1fr;
      }

      table {
        font-size: 10px;
      }

      table th, table td {
        padding: 3px 4px;
      }

      .notes-row {
        flex-direction: column;
      }

      .issued-box {
        flex: 1;
      }

      .sign-row {
        flex-wrap: wrap;
        gap: 10px;
      }

      .sign {
        min-width: 100px;
      }
    }
  </style>
</head>
<body>

  <div class="form-selector-panel no-print">
    <div class="form-selector-container">
      <div class="form-selector-title">Choose Class, Section and Terminal for Marksheet</div>
      <div class="form-selector-grid">
        <%
          const classSortOrder = {
            nursery: 1, lkg: 2, ukg: 3, one: 4, two: 5, three: 6,
            four: 7, five: 8, six: 9, seven: 10, eight: 11, nine: 12, ten: 13
          };
          const numericClassMap = { '1': 'one', '2': 'two', '3': 'three', '4': 'four', '5': 'five', '6': 'six', '7': 'seven', '8': 'eight', '9': 'nine', '10': 'ten' };
          const getClassSortRank = (value) => {
            const normalized = String(value || '').trim().toLowerCase().replace(/^class\s+/, '').replace(/\s+section$/, '');
            const key = numericClassMap[normalized] || normalized;
            return classSortOrder[key] || 999;
          };
          const sortedClassSectionData = [...(studentClassdata || [])].sort((a, b) => {
            const classRankA = getClassSortRank(a && a.studentClass);
            const classRankB = getClassSortRank(b && b.studentClass);
            if (classRankA !== classRankB) return classRankA - classRankB;
            return String(a && a.section || '').localeCompare(String(b && b.section || ''), undefined, { numeric: true, sensitivity: 'base' });
          });
        %>
        <select name="classSection" id="classSection">
          <option value="" selected disabled>Choose Class & Section</option>
          <% sortedClassSectionData.forEach((data)=>{%>
            <option value="<%=data.studentClass%>-<%=data.section%>"><%=data.studentClass%>-<%=data.section%></option>
          <%})%>
        </select>
        <select name="terminals" id="terminal">
          <option value="" selected disabled>Choose Terminal</option>
          <% marksheetSetups[0].terminals.forEach((terminal)=>{%>
            <option value="<%=terminal.name%>"><%=terminal.name%></option>
          <% }) %>
        </select>

        <select name="academicYear" id="academicYear">
          <option value="" selected disabled>Choose Academic Year</option>
          <% currentYear = Number(marksheetSetups[0].academicYear) %>;
            <% for (let i = 0; i < 5; i++) { %>
              <option value="<%= currentYear - i %>"><%= currentYear - i %></option>
            <% } %>
        </select>
      </div>
      <button onclick="loadform()">Load Marksheet</button>
    </div>
  </div>

  <script>
    function loadform()
    {
       
        const classSection = document.getElementById('classSection').value
        const studentClass = classSection.split("-")[0];
        const section = classSection.split("-")[1];
        const academicYear = document.getElementById('academicYear').value;
        const terminal = document.getElementById('terminal').value

        window.location.href=(`/generatemarksheet?studentClass=${studentClass}&section=${section}&format=${"practicalonly"}&terminal=${terminal}&academicYear=${academicYear}`)
      
    }
  </script>

  <%
    // ========== BACKEND LOGIC ==========
    // Subjects that should NOT have worksheets
    const NO_WORKSHEET_SUBJECTS = ['ORAL', 'HYGIENE', 'ECA','HYGINE'];
    if (studentClass && studentClass.toUpperCase() === 'LKG') {
      NO_WORKSHEET_SUBJECTS.push('THEME');
    }

    // ========== SUBJECT DISPLAY ORDER AND NAME MAPPING ==========
    // Define the display order - change numbers to reorder subjects
    const subjectOrder = {
        'NEPALI': 2,
        'ENGLISH': 1,
        'MATHEMATICS': 3,
        'THEME': 4,
        'HYGIENE': 5,
        'ORAL': 6
    };
    
    // Subject name mapping - what to display
    const subjectDisplayNames = {
        // Add any subject name mappings here if needed
        // Example: 'SCIENCE': 'SCIENCE & TECHNOLOGY'
    };
    
    // Function to get display name
    function getDisplaySubjectName(subjectName) {
        const upperName = subjectName.toUpperCase().trim();
        return subjectDisplayNames[upperName] || subjectName;
    }
    
    // Function to get sort order
    function getSubjectOrder(subjectName) {
        const upperName = subjectName.toUpperCase().trim();
        return subjectOrder[upperName] || 999; // Unknown subjects go to the end
    }

    // Function to check if a value is Ab (sentinel 0.000001)
    function isAb(value) {
      if (value === null || value === undefined) {
        return false;
      }
      
      const strValue = String(value).trim();
      
      // Check for exact match
      if (strValue === '0.000001') {
        return true;
      }
      
      // Check for number comparison (handle floating point precision)
      if (typeof value === 'number') {
        const epsilon = 0.0000001;
        if (Math.abs(value - 0.000001) < epsilon) {
          return true;
        }
      }
      
      // Check if it's a string representation
      if (typeof value === 'string') {
        const cleanValue = value.trim().toLowerCase();
        if (cleanValue === '0.000001' || cleanValue === 'ab' || cleanValue === 'absent') {
          return true;
        }
      }
      
      return false;
    }

    // Function to get numeric value for calculations
    function getNumericValue(value) {
      if (isAb(value)) {
        return 0;
      }
      if (value === null || value === undefined) {
        return 0;
      }
      const num = Number(value);
      return isNaN(num) ? 0 : num;
    }

    // Function to get display value
    function getDisplayValue(value) {
      if (isAb(value)) {
        return 'Ab';
      }
      if (value === null || value === undefined) {
        return '-';
      }
      return value;
    }

    // Function to get grade from GP
    function getGrade(gp) {
      if (gp === 4.0) return "A+";
      if (gp >= 3.6) return "A";
      if (gp >= 3.2) return "B+";
      if (gp >= 2.8) return "B";
      if (gp >= 2.4) return "C+";
      if (gp >= 2.0) return "C";
      if (gp >= 1.6) return "D";
      return "NG";
    }

    // Function to get worksheet GP
    function getWorksheetGP(grade) {
      if (!grade) return 0;
      if (isAb(grade)) return 0;
      const gradeMap = {
        'A+': 4.0,
        'A': 3.6,
        'B+': 3.2,
        'B': 2.8,
        'C+': 2.4,
        'C': 2.0,
        'D': 1.6,
        'NG': 0.0
      };
      return gradeMap[grade] || 0;
    }
  %>

  <div class="no-print control-panel">
    <div class="column-toggle-group">
      <label class="column-toggle-item"><input type="checkbox" data-column-toggle="theorymarks"> Hide Th GP</label>
      <label class="column-toggle-item"><input type="checkbox" data-column-toggle="prgp"> Hide W.S GP</label>
      <label class="column-toggle-item"><input type="checkbox" data-column-toggle="finalgp"> Hide Avg GP</label>
      <label class="column-toggle-item"><input type="checkbox" data-column-toggle="finalgrade"> Hide Final Grade</label>
      <label class="column-toggle-item"><input type="checkbox" data-column-toggle="obtainedgp"> Hide Obtained GP</label>
      <label class="column-toggle-item"><input type="checkbox" data-column-toggle="highestmarks"> Hide Highest Marks</label>
      <label class="column-toggle-item"><input type="checkbox" data-column-toggle="remarks"> Hide Remarks</label>
    </div>
    <button onclick="window.print()">Print All</button>
    <button onclick="downloadPdf()">Download PDF</button>
    <button onclick="exportToWord()" class="secondary">Download Word</button>
  </div>

  <input type="hidden" id="pageClass" value="<%= studentClass %>">
  <input type="hidden" id="pageSection" value="<%= section %>">
  <input type="hidden" id="pageYear" value="<%= academicYear %>">
  <input type="hidden" id="pageTerminal" value="<%= terminal %>">

  <div class="sheets-container">

  
 <% const sortedStudentData = [...studentWisedata].sort((a, b) => {
    return Number(a.roll) - Number(b.roll);
  });
  sortedStudentData.forEach((data) => { 
    
    
    // Sort subjects by the defined order
    const sortedSubjects = [...data.subjects].sort((a, b) => {
        return getSubjectOrder(a.subject) - getSubjectOrder(b.subject);
    });
  %>

  <div class="sheet">
      <div class="watermark"><img src="/image.png" alt="Watermark"></div>
      <div class="border-frame">
      <!-- HEADER -->
      <div class="header">
          <div class="logo"><img src="/image.png" onerror="this.style.display='none'"></div>
          <div class="head-text">
              <div class="school-name">United English Boarding School</div>
              <div class="school-meta">Manahari-8, Simpani &nbsp; | &nbsp; Phone: +057-414040</div>
              <div class="report-title">
                  <div>ACADEMIC PROGRESS REPORT</div>
                  <div style="font-size:14px; margin-top:5px; font-weight:600"><%= terminal %> Terminal - <%= academicYear %></div>
              </div>
          </div>
          <div class="logo" style="border:none; visibility:hidden"></div>
      </div>

  <!-- Student Info -->
  <div class="student-info">
      <div><span class="info-label">Student Name:</span> <span class="info-value"><%= data.name %></span></div>
      <div><span class="info-label">Roll No:</span> <span class="info-value"><%= data.roll %></span></div>
      <div><span class="info-label">Class:</span> <span class="info-value"><%= studentClass %></span></div>
      <div><span class="info-label">Section:</span> <span class="info-value"><%= section %></span></div>
      <div><span class="info-label">Academic Year:</span> <span class="info-value"><%= academicYear || 'N/A' %></span></div>
  </div>

  <!-- SUBJECT TABLE -->
  <table>
      <thead>
          <tr>
              <th>S.N</th>
              <th>Subject</th>
              <th>Credit Hour</th>
              
              <th class="col-finalgp">Avg GP</th>
              <th class="col-finalgrade">Grade</th>
              <th class="col-obtainedgp">Grade Point</th>
              <th class="col-highestmarks">Highest Marks</th>
              <th class="col-remarks">Remarks</th>
          </tr>
      </thead>

      <tbody>

      <% 
      let totalCredit = 0;
      let m;
      let totalGradePoints = 0;
      %>

      <% sortedSubjects.forEach((sub, index) => { 
        // Get display name for subject
        const displaySubjectName = getDisplaySubjectName(sub.subject);
      %>

      <% 
        // ========== FIXED BACKEND CALCULATIONS ==========
        const isNoWorksheet = NO_WORKSHEET_SUBJECTS.includes(sub.subject.toUpperCase());
        
        // Get theory marks - handle Ab
        let theoryMarksValue = getNumericValue(sub.theorymarks);
        let theoryMarksDisplay = getDisplayValue(sub.theorymarks);
        
        // Process worksheet grades
        let worksheetMarks = [];
        if (!isNoWorksheet && sub.worksheetGrades && Array.isArray(sub.worksheetGrades)) {
          sub.worksheetGrades.forEach((worksheetgrade) => {
            let grade = String(worksheetgrade).trim();
            // Check for Ab in worksheet grades
            if (grade === '0.000001' || grade === 'Ab' || grade === 'ab') {
              worksheetMarks.push(0);
            } else if (grade == "A+") {
              worksheetMarks.push(4);
            } else if (grade == "A") {
              worksheetMarks.push(3.6);
            } else if (grade == "B+") {
              worksheetMarks.push(3.2);
            } else if (grade == "B") {
              worksheetMarks.push(2.8);
            } else if (grade == "C+") {
              worksheetMarks.push(2.4);
            } else if (grade == "C") {
              worksheetMarks.push(2.0);
            } else if (grade == "D") {
              worksheetMarks.push(1.6);
            } else {
              worksheetMarks.push(0); // NG or empty
            }
          });
        }
        
        // Calculate practical marks (only for subjects with worksheets)
        let practicalmarks = 0;
        if (!isNoWorksheet && worksheetMarks.length > 0) {
          practicalmarks = worksheetMarks.reduce((acc, i) => acc + i, 0);
        }
        
        // Calculate final GP
        let finalGP = 0;
        if (isNoWorksheet) {
          // For ORAL, HYGIENE, THEME - final GP = theory marks
          finalGP = theoryMarksValue;
        } else if (worksheetMarks.length > 0) {
          // Regular subjects with worksheets
          finalGP = ((theoryMarksValue + practicalmarks)) / ((worksheetMarks.length + 1)) || 0;
        } else {
          // No worksheets available
          finalGP = theoryMarksValue;
        }
        
        // If the student is Ab, finalGP should be 0
        if (isAb(sub.theorymarks)) {
          finalGP = 0;
        }
        
        // GP display for practical column
        let prGPDisplay = '-';
        if (!isNoWorksheet && worksheetMarks.length > 0) {
          prGPDisplay = (practicalmarks / worksheetMarks.length).toFixed(2);
        } else if (isNoWorksheet) {
          prGPDisplay = '-';
        } else {
          prGPDisplay = '0.00';
        }
        
        // Get credit hours
        let creditHour = 0;
        const chData = creditHourData.filter(ch => ch.newsubject === sub.subject)[0];
        if (chData) {
          creditHour = (chData.theoryCreditHour || 0) + (chData.practicalCreditHour || 0);
        }
        m = creditHour || 'N/A';
        
        // Calculate total grade points
        let practicalCreditHour = chData ? (chData.practicalCreditHour || 0) : 0;
        totalGradePoints += (finalGP * practicalCreditHour);
        totalCredit += creditHour;
      %>

      <tr>
        <td><%= index + 1 %></td>
        <td><%= displaySubjectName %></td>
        <td><%= m %></td>
     
        
        
        <td class="col-finalgp"><%= finalGP.toFixed(2) %></td>
        <td class="col-finalgrade"><%= getGrade(finalGP) %></td>
        <td class="col-obtainedgp">
          <% 
            const grade = getGrade(finalGP);
            let obtainedGP = 0;
            if (grade === 'A+') obtainedGP = 4.0;
            else if (grade === 'A') obtainedGP = 3.6;
            else if (grade === 'B+') obtainedGP = 3.2;
            else if (grade === 'B') obtainedGP = 2.8;
            else if (grade === 'C+') obtainedGP = 2.4;
            else if (grade === 'C') obtainedGP = 2.0;
            else if (grade === 'D') obtainedGP = 1.6;
            else obtainedGP = 'NG';
          %>
          <%= obtainedGP %>
        </td>
        <td class="col-highestmarks"><%= sub.highestmarks || '-' %></td>
        <td class="col-remarks"><% function getRemarks(finalgrade) {
            if (finalgrade === "NG") return "Needs Improvement";
            else if(finalgrade === "D") return "Satisfactory";
            else if(finalgrade === "C" || finalgrade === "C+") return "Good";
            else if(finalgrade === "B" || finalgrade === "B+") return "Very Good";
            else return "Excellent";
          } %><%= getRemarks(getGrade(finalGP)) %></td>
      </tr>
      <% }) %>

      </tbody>
  </table>

      <!-- SUMMARY -->
      <div class="summary">
          <div>Total Credit Hours: <%= totalCredit %></div>
          <div>
      
          <!-- taking attendance from nepali subject -->
        
 <%
  const nepaliSubject = data.subjects.find(sub => sub.subject === 'NEPALI');
  const studentAttendance = nepaliSubject ? nepaliSubject.attendance : 0;
%>
            <span class="info-label">Attendance:</span> <span class="info-value"><%= studentAttendance  %></span></div>
          <div>GPA: <%= totalCredit > 0 ? (totalGradePoints / totalCredit).toFixed(2) : '0.00' %></div>
      </div>

  <!-- REMARKS -->
  <div class="remark-box">
      <b>Remarks:</b><br>
      <% let gpa = totalCredit > 0 ? (totalGradePoints / totalCredit) : 0; %>
      <% if (gpa >= 3.6) { %> Excellent Performance
      <% } else if (gpa >= 3.2) { %> Very Good
      <% } else if (gpa >= 2.4) { %> Good
      <% } else if (gpa >= 2.0) { %> Satisfactory
      <% } else { %> Needs Improvement <% } %>
  </div>
<!-- nepali date should be here -->
  <p><b>Issued Date:</b> 2083-4-31</p>

  <!-- SIGNATURES -->
  <div class="sign-row">
          <div class="sign">
            <div class="sign-placeholder"></div>
            <div class="line">Class Teacher</div>
          </div>
          <div class="sign">
            <img class="sign-img" src="/examcoordinator.webp" alt="Exam Coordinator Signature" onerror="this.style.display='none'">
            <div class="line">Exam Coordinator</div>
          </div>
          <div class="sign">
            <img class="sign-img" src="/principalsign.webp" alt="Principal Signature" onerror="this.style.display='none'">
            <div class="line">Principal</div>
          </div>
        </div>

        <hr>
      

      <!-- GRADING SCALE -->
      <div class="grading-scale">
          <table>
              <tr>
                  <td>90% and above : A+</td>
                  <td>80% and above : A</td>
                  <td>70% and above : B+</td>
                  <td>60% and above : B</td>
              </tr>
              <tr>
                  <td>50% and above: C+</td>
                  <td>40% and above: C</td>
                  <td>35% and above: D</td>
                  <td>Below 35% : NG</td>
              </tr>
          </table>
      </div>
  </div>
</div>

<% }) %>

</div>

<!-- Include html2pdf from CDN for client-side PDF export and small helpers -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
<script>
    function applyColumnVisibility() {
        document.querySelectorAll('[data-column-toggle]').forEach(function(checkbox) {
            const key = checkbox.dataset.columnToggle;
            const shouldHide = checkbox.checked;
            document.querySelectorAll('.col-' + key).forEach(function(cell) {
                cell.classList.toggle('hidden-column', shouldHide);
                cell.style.display = shouldHide ? 'none' : '';
            });
        });
    }

    document.querySelectorAll('[data-column-toggle]').forEach(function(checkbox) {
        checkbox.addEventListener('change', applyColumnVisibility);
    });

    applyColumnVisibility();

    // Download all marksheets as a single PDF
    function downloadPdf(){
        const studentClass = document.getElementById('pageClass').value;
        const section = document.getElementById('pageSection').value;
        const year = document.getElementById('pageYear').value;
        const terminal = document.getElementById('pageTerminal').value;
        const filename = `${studentClass}-${section}-${year}-${terminal}-marksheet.pdf`;
        
        const element = document.querySelector('.sheets-container');
        const opt = {
            margin:       [8, 8, 8, 8],
            filename:     filename,
            image:        { type: 'jpeg', quality: 0.95 },
            html2canvas:  { scale: 2, useCORS: true, letterRendering: true, logging: false },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
            pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
        };
        // hide controls while creating pdf
        const controls = document.querySelectorAll('.no-print');
        controls.forEach(c=>c.style.display='none');
        html2pdf().set(opt).from(element).save().then(()=>{
            controls.forEach(c=>c.style.display='flex');
        }).catch((err)=>{
            console.error('PDF Error:', err);
            controls.forEach(c=>c.style.display='flex');
        });
    }

    // Export visible content to a Word (.doc) file
    function exportToWord(){
        const studentClass = document.getElementById('pageClass').value;
        const section = document.getElementById('pageSection').value;
        const year = document.getElementById('pageYear').value;
        const terminal = document.getElementById('pageTerminal').value;
        const filename = `${studentClass}-${section}-${year}-${terminal}-marksheet.doc`;
        
        const header = "<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>";
        const footer = "</html>";
        let content = '';
        document.querySelectorAll('.sheet').forEach(function(s){
            // clone node to avoid modifying original
            const clone = s.cloneNode(true);
            // remove watermark images for word export if desired
            clone.querySelectorAll('.watermark').forEach(w=>w.parentNode.removeChild(w));
            content += clone.innerHTML + '<div style="page-break-after:always"></div>';
        });
        const blob = new Blob([header + content + footer], { type: 'application/msword' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        setTimeout(function(){
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
        },0);
    }
</script>

</body>
</html>