    <div>
      <label for="comparisonClass">Class</label>
      <select id="comparisonClass">
        <option value="">All Classes</option>
        <% [...new Map((comparisonData || []).map(item => [item.classKey, item.className])).entries()].forEach(([classKey, className]) => { %>
          <option value="<%= classKey %>" <%= String(selectedClass || 'all').toLowerCase() === String(classKey).toLowerCase() ? 'selected' : '' %>><%= className %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="comparisonSectionMode">Sections</label>
      <select id="comparisonSectionMode">
        <option value="all" <%= sectionMode === 'all' ? 'selected' : '' %>>Without Section (Combined)</option>
        <option value="with-section" <%= sectionMode === 'with-section' ? 'selected' : '' %>>With Sections</option>
      </select>
    </div>
    <div>
      <label for="comparisonSection">Section</label>
      <select id="comparisonSection">
        <option value="">All Sections</option>
        <% (comparisonSections || []).forEach(sectionName => { %>
          <option value="<%= sectionName %>" <%= sectionMode === 'with-section' && selectedSection === sectionName ? 'selected' : '' %>><%= sectionName %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="comparisonSubject">Subject</label>
      <select id="comparisonSubject">
        <option value="">All Subjects</option>
        <% [...new Set((comparisonData || []).flatMap(item => item.subjects || []))].sort().forEach(subjectName => { %>
          <option value="<%= subjectName %>" <%= selectedSubject === subjectName ? 'selected' : '' %>><%= subjectName %></option>
        <% }) %>
      </select>
    </div>
    <button type="button" onclick="applyComparisonFilters()">Generate</button>
    <button type="button" style="background-color: #259374;color: white;" class="sidebar-btn sidebar-btn--excel no-print" onclick="exportAnalyticsToExcel()">Export to Excel</button>
  </div>

  <div class="page">
    <div class="report-header">
      <div>
        <h1 class="report-title">Class Comparison</h1>
        <p class="report-subtitle">Subjects grouped in one table per class and section</p>
      </div>
    </div>
    <% (comparisonData || []).forEach(group => { %>
      <div class="section-header">Class <%= group.className %> | <%= group.section %> | Academic Year: <%= group.academicYear %></div>
      <div class="table-container">
        <table class="comparison-table">
          <thead>
            <tr>
              <th rowspan="2">Subject</th>
              <% comparisonTerminals.forEach(terminalName => { %><th class="terminal-heading" colspan="6"><%= terminalName %></th><% }) %>
            </tr>
            <tr>
              <% comparisonTerminals.forEach(() => { %><th>Total</th><th>Pass</th><th>Pass%</th><th>Fail</th><th>Fail%</th><th>Avg</th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% group.subjects.filter(subjectName => !selectedSubject || selectedSubject === 'all' || selectedSubject === subjectName).forEach(subjectName => { %>
              <tr>
                <td class="subject-cell"><%= subjectName %></td>
                <% comparisonTerminals.forEach(terminalName => { const row = group.terminals[terminalName]?.[subjectName]; %>
                  <% if (row) { %><td><%= row.totalStudents %></td><td><%= row.pass %></td><td><%= fixed2(row.passPercent) %>%</td><td><%= row.fail %></td><td><%= fixed2(row.failPercent) %>%</td><td><%= fixed2(row.avg) %></td>
                  <% } else { %><td colspan="6">-</td><% } %>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>
  </div>

  <div class="page legacy-comparison">
    <div class="report-header">
      <div>
          <h1 class="report-title">Academic Progress Report</h1>
          <p class="report-subtitle">Comprehensive Performance Analysis</p>
      </div>
      <div class="report-meta">Generated on: <%= new Date().toLocaleDateString() %></div>
    </div>
    
    <div class="section-header">Class Wise Analysis Per Subject</div>
    
<% const groupedByterminal = groupBy(classSubjectAnalysis, item => item._id.terminal); %>


