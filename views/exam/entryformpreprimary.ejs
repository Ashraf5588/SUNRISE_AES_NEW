  <script>
    const studentSaveTimers = new Map();
    const saveStatus = document.getElementById('saveStatus');

    function buildStudentSaveData(reg) {
      const form = document.getElementById('entryForm');
      const urlParams = new URLSearchParams(window.location.search);
      const studentField = (field) => form.querySelector(`[name="${field}[${reg}]"]`);

      return {
        reg,
        studentClass: urlParams.get('studentClass'),
        section: urlParams.get('section'),
        terminal: urlParams.get('terminal'),
        academicYear: urlParams.get('academicYear'),
        subject: form.querySelector('[name="subject"]').value,
        worksheet: form.querySelector('[name="worksheet"]').value || urlParams.get('worksheet') || 1,
        totalWorksheet: form.querySelector('[name="totalWorksheet"]').value || 1,
        worksheetGrades: studentField('worksheetGrades')?.value || '',
        theorymarks: studentField('theorymarks')?.value || 0,
        attendance: studentField('attendance')?.value || 0,
        status: studentField('status')?.checked ? 'ABSENT' : 'PRESENT',
        roll: studentField('roll')?.value || '',
        gender: studentField('gender')?.value || '',
        name: studentField('name')?.value || ''
      };
    }

    async function saveStudentData(reg) {
      const studentData = buildStudentSaveData(reg);
      const response = await fetch(`/entryformpreprimary?studentClass=${encodeURIComponent(studentData.studentClass)}&section=${encodeURIComponent(studentData.section)}&terminal=${encodeURIComponent(studentData.terminal)}&academicYear=${encodeURIComponent(studentData.academicYear)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(studentData)
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message || 'Save failed');
    }

    function autoSaveStudent(input) {
      const reg = input?.dataset.reg;
      if (!reg) return;

      clearTimeout(studentSaveTimers.get(reg));
      studentSaveTimers.set(reg, setTimeout(async () => {
        saveStatus.textContent = 'Saving changes…';
        saveStatus.className = 'save-status';
        try {
          await saveStudentData(reg);
          saveStatus.textContent = 'All changes saved';
          saveStatus.className = 'save-status success';
        } catch (error) {
          console.error('Auto-save error:', error);
          saveStatus.textContent = 'Could not save changes. Please try again.';
          saveStatus.className = 'save-status error';
        } finally {
          studentSaveTimers.delete(reg);
        }
      }, 250));
    }

    document.querySelectorAll('.worksheetGrade, .theoryGrade, input[name^="status["]').forEach((input) => {
      input.addEventListener('change', () => autoSaveStudent(input));
    });

    document.getElementById('saveMarks').addEventListener('click', async (event) => {
      const saveButton = event.currentTarget;
      const registrations = [...new Set(
        [...document.querySelectorAll('#entrytable [data-reg]')]
          .map(input => String(input.dataset.reg || '').trim())
          .filter(Boolean)
      )];
      if (!registrations.length) return;

      registrations.forEach(reg => {
        clearTimeout(studentSaveTimers.get(reg));
        studentSaveTimers.delete(reg);
      });
      saveButton.disabled = true;
      saveButton.textContent = 'Saving…';
      saveStatus.textContent = 'Saving student marks…';
      saveStatus.className = 'save-status';
      try {
        for (const reg of registrations) await saveStudentData(reg);
        saveStatus.textContent = 'All student marks saved';
        saveStatus.className = 'save-status success';
      } catch (error) {
        console.error('Save marks error:', error);
        saveStatus.textContent = `Unable to save all marks: ${error.message}`;
        saveStatus.className = 'save-status error';
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = 'Save marks';
      }
    });
  </script>

  <% if (isAdminUser) { %>
  <script>
    const saveWorksheetCountButton = document.getElementById('saveWorksheetCount');
    saveWorksheetCountButton.addEventListener('click', async () => {
      const countInput = document.getElementById('totalWorksheet');
      const count = Number(countInput.value);
      if (!Number.isInteger(count) || count < 1 || count > 100) {
        countInput.setCustomValidity('Enter a whole number from 1 to 100.');
        countInput.reportValidity();
        return;
      }
      countInput.setCustomValidity('');

      const params = new URLSearchParams(window.location.search);
      const details = ['studentClass', 'section', 'subject', 'terminal', 'academicYear'];
      if (details.some((key) => !params.get(key))) {
        saveStatus.textContent = 'Select a subject, class, terminal and academic year first.';
        saveStatus.className = 'save-status error';
        return;
      }

      const url = `/entryform/setTotalWorksheet?${params.toString()}`;
      saveWorksheetCountButton.disabled = true;
      saveWorksheetCountButton.textContent = 'Saving…';
      saveStatus.textContent = 'Saving worksheet count…';
      saveStatus.className = 'save-status';
      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ totalWorksheet: count })
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'Unable to save worksheet count');

        const worksheetSelect = document.querySelector('select[name="worksheet"]');
        const selectedWorksheet = Number(worksheetSelect.value) || 1;
        worksheetSelect.replaceChildren(new Option('Select worksheet', '', true, false));
        worksheetSelect.options[0].disabled = true;
        for (let i = 1; i <= count; i++) {
          worksheetSelect.add(new Option(`Worksheet ${i}`, String(i), false, i === Math.min(selectedWorksheet, count)));
        }
        if (selectedWorksheet > count) {
          worksheetSelect.value = '1';
          const updatedParams = new URLSearchParams(window.location.search);
          updatedParams.set('worksheet', '1');
          window.history.replaceState(null, '', `${window.location.pathname}?${updatedParams.toString()}`);
          document.getElementById('worksheetheader').textContent = 'Worksheet 1';
        }
        saveStatus.textContent = 'Worksheet count saved';
        saveStatus.className = 'save-status success';
      } catch (error) {
        console.error('Worksheet count save error:', error);
        saveStatus.textContent = error.message;
        saveStatus.className = 'save-status error';
      } finally {
        saveWorksheetCountButton.disabled = false;
        saveWorksheetCountButton.textContent = 'Save count';
      }
    });
  </script>
  <% } %>

   <script>
  // Hide table only when no worksheet is selected
  const worksheetSelect = document.querySelector('select[name="worksheet"]');
  const entryTable = document.getElementById('entrytable');

  function updateTableVisibility() {
    if (!entryTable) return;
    if (worksheetSelect.value) {
      entryTable.style.display = 'table';
    } else {
      entryTable.style.display = 'none';
    }
  }

  // Run immediately after page loads
  updateTableVisibility();

  // Run whenever worksheet changes
  worksheetSelect.addEventListener('change', function () {
    updateTableVisibility();
  });
</script>
<script>
  // Load saved theory marks and display them as grades
  document.querySelectorAll('.theoryGrade').forEach(select => {

    const reg = select.dataset.reg;

    const studentData = existingData.find(
      item => String(item.reg) === String(reg)
    );

    if (
      studentData &&
      studentData.theorymarks !== null &&
      studentData.theorymarks !== undefined
    ) {
      const savedTheoryMark = Number(studentData.theorymarks).toFixed(1);
      if ([...select.options].some(option => option.value === savedTheoryMark)) {
        select.value = savedTheoryMark;
      }
    }

  });
  
document.querySelectorAll('input[type="number"]').forEach(input => {
