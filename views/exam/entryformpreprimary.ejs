<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pre primary Entry Form</title>
</head>
<body>
  <form action="/entryformpreprimary?studentClass=<%= studentClass %>&section=<%= section %>&terminal=<%= terminal %>&academicYear=<%= academicYear %>" method="POST" id="entryForm" >  
  <select name="subject" id="subjectSelect" class="formloader">
    <option selected disabled>Select Subject</option>
    <%
    const preprimarysubjects = subjects.filter(sub=> sub.forClass.toLowerCase() === "nursery" || sub.forClass.toLowerCase() === "playgroup" || sub.forClass.toLowerCase() === "lkg" || sub.forClass.toLowerCase() === "ukg");
    const uniqueSubjects = new Set(preprimarysubjects.map(sub => sub.newsubject));
    uniqueSubjects.forEach(subject => { %>
      <option value="<%= subject %>"><%= subject %></option>
    <% }) %>
  </select>

      <select name="classSection" class="formloader">
        <option selected disabled>Select Class Section</option>
        <% const classOrder = {
          "Nursery": 1,
          "LKG": 2,
          "UKG": 3,
          "One": 4,
          "Two": 5,
          "Three": 6,
          "Four": 7,
          "Five": 8,
          "Six": 9,
          "Seven": 10,
          "Eight": 11,
          "Nine": 12,
          "Ten": 13,
        }; %>
        <% studentClassdata.sort((a, b) => classOrder[a.studentClass] - classOrder[b.studentClass]).forEach(classItem => { %>
          <option value="<%= classItem.studentClass %>-<%= classItem.section %>"><%= classItem.studentClass %>-<%= classItem.section %></option>
        <% }) %>
      </select>
  <!-- hidden field for class & section -->
   <input type="hidden" name="studentClass" value="<%= studentClass %>">
   <input type="hidden" name="section" value="<%= section %>">
<select name="terminal" class="formloader">
  <option selected disabled>Select Terminal</option>
  <% terminals.forEach(terminal => { %>
    <option value="<%= terminal.terminal %>"><%= terminal.terminal%></option>
  <% }) %>

</select>
<select name="academicYear" class="formloader">
  <option selected disabled>Select Academic Year</option>
<% marksheetSetups.forEach(setup => { %>
  <% for (i=0;i<5;i++){ %>
    <option value="<%= setup.academicYear - i %>" ><%= setup.academicYear - i %></option>
  <% } %>

<% }) %>
</select>

<br>
<%= subject %> | <%=studentClass%>-<%section%> | <%=terminal%> Terminal | <%=academicYear%>

 
  Total Worksheet: <input type="number" name="totalWorksheet" value="<%= existingData[0]?.totalWorksheet || 1 %>" readonly>
  <select name="worksheet">
    <option selected disabled>Select Worksheet</option>
    <% for (let i = 1; i <= (existingData[0]?.totalWorksheet || 1); i++) { %>
      <option value="<%= i %>" <%= existingData[0]?.worksheet === i ? 'selected' : '' %>>Worksheet <%= i %></option>
    <% } %>
  </select>
<table cellspacing="0" border="1"> 
  <tr>
   
  <Th>Name</Th>
  <th>Th</th>
  <th id="worksheetheader"></th>
  <th>Attendance</th>
</tr>
<% const sortedStudent = studentData.sort((a,b)=>Number(a.roll) - Number(b.roll)); %>
<% sortedStudent.forEach(student => { %>
  <tr>
     <input type="hidden" name="roll[<%= student.reg %>]" value="<%= student.roll %>">
      <input type="hidden" name="gender[<%= student.reg %>]" value="<%= student.gender %>">

    <td style="color: <%= student.reg == '' || student.reg == null || student.reg == undefined || student.reg == 'N/A'|| !student.reg ? 'red' : 'black' %>">
      <input type="hidden" name="reg[<%= student.reg %>]" value="<%= student.reg %>">
      <input type="hidden" name="name[<%= student.reg %>]" value="<%= student.name %>">
      
      <%=student.roll%>. <%= student.name %></td>
    <td><input type="text" name="theorymarks[<%= student.reg %>]" value="<%= existingData[0]?.theorymarks || 0 %>" /></td>
    <td><select  class="worksheetGrade" id="worksheetgrade_<%= student._id %>" name="worksheetGrades[<%= student.reg %>]" data-reg = <%=student.reg%>  >
      <option selected disabled>Select Grade</option>
      <option value="A+" >A+</option>
      
      <option value="A" >A</option>
      <option value="B+" >B+</option>
      <option value="B" >B</option>
      <option value="C+" >C+</option>
      <option value="C" >C</option>
      <option value="D" >D</option>
      <option value="NG" >NG</option>
      <option value="Ab">Absent</option>
    </select></td>
    <td><input type="number" name="attendance[<%= student.reg %>]"></td>
  </tr>
<% }) %>
</table>


</form>

<!-- script to auto load  -->
 <script>
  const subjectSelect = document.getElementById('subjectSelect');
  const studentClassSection = document.querySelector('select[name="classSection"]').value;
  const separated = studentClassSection.split('-');
  const studentClass = separated[0];
  const section = separated[1];
  const terminal = document.querySelector('select[name="terminal"]').value;
  const academicYear = document.querySelector('select[name="academicYear"]').value;

  // if all values are selected, redirect to the entry form
  if (subjectSelect.value && studentClass && section && terminal && academicYear) {
    const url = `/entryform?subject=${encodeURIComponent(subjectSelect.value)}&studentClass=${encodeURIComponent(studentClass)}&section=${encodeURIComponent(section)}&terminal=${encodeURIComponent(terminal)}&academicYear=${encodeURIComponent(academicYear)}`;
    window.location.href = url;
  }
  else
  {
    // highlight the missing fields
    if (!subjectSelect.value) {
      subjectSelect.style.border = '2px solid red';
    }
    if (!studentClass) {
      document.querySelector('select[name="classSection"]').style.border = '2px solid red';
    }
 
    if (!terminal) {
      document.querySelector('select[name="terminal"]').style.border = '2px solid red';
    }
    if (!academicYear) {
      document.querySelector('select[name="academicYear"]').style.border = '2px solid red';
    }


    // make selected value from query on page load
    const urlParams = new URLSearchParams(window.location.search);
    const subjectParam = urlParams.get('subject');
    const studentClassParam = urlParams.get('studentClass');
    const sectionParam = urlParams.get('section');
    const terminalParam = urlParams.get('terminal');
    // terminal param value become empty fix
    if (terminalParam === '') {
      document.querySelector('select[name="terminal"]').value = '';
    }

    const academicYearParam = urlParams.get('academicYear');

    if (subjectParam) {
      subjectSelect.value = subjectParam;
    }
    if (studentClassParam) {
      document.querySelector('select[name="classSection"]').value = `${studentClassParam}-${sectionParam}`;
    }
    if (terminalParam) {
      document.querySelector('select[name="terminal"]').value = terminalParam;
    }
    if (academicYearParam) {
      document.querySelector('select[name="academicYear"]').value = academicYearParam;
    }

    document.querySelectorAll('.formloader').forEach(select => {
      select.addEventListener('change', () => {
        const selectedSubject = subjectSelect.value;
        const selectedClassSection = document.querySelector('select[name="classSection"]').value;
        const selectedTerminal = document.querySelector('select[name="terminal"]').value;
        const selectedAcademicYear = document.querySelector('select[name="academicYear"]').value;

        if (selectedSubject && selectedClassSection && selectedTerminal && selectedAcademicYear) {
          const [selectedClass, selectedSection] = selectedClassSection.split('-');
          const url = `/entryform?subject=${encodeURIComponent(selectedSubject)}&studentClass=${encodeURIComponent(selectedClass)}&section=${encodeURIComponent(selectedSection)}&terminal=${encodeURIComponent(selectedTerminal)}&academicYear=${encodeURIComponent(selectedAcademicYear)}`;
          window.location.href = url;
        }
      });
    });

  }

 </script>

 <!-- making as per worksheet select value shown in table  -->
  <script>
    const currentWorksheetSelect = document.querySelector('select[name="worksheet"]').value;
    document.querySelector('select[name="worksheet"]').addEventListener('change', (event) => {
      const selectedWorksheet = event.target.value;
      const urlParams = new URLSearchParams(window.location.search);
      urlParams.set('worksheet', selectedWorksheet);
      window.location.search = urlParams.toString();
    });

    window.addEventListener('load', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const worksheetParam = urlParams.get('worksheet');
      if (worksheetParam) {
        document.querySelector('select[name="worksheet"]').value = worksheetParam;
        document.getElementById('worksheetheader').textContent = `W${worksheetParam}`;
      } else {
        document.querySelector('select[name="worksheet"]').value = currentWorksheetSelect;

      }
    });
   
  </script>

   <input type="hidden" id = "exisingData" value = "<%= JSON.stringify(existingData) %>">
  <script>
       const existingData = document.getElementById('exisingData').value ? JSON.parse(document.getElementById('exisingData').value) : [];
        const urlParams = new URLSearchParams(window.location.search);
        const currentWorksheet = urlParams.get('worksheet') ? parseInt(urlParams.get('worksheet')) : 1; // Default to 1 if not present
    document.querySelectorAll('.worksheetGrade').forEach(select => {  
   const reg = select.dataset.reg;

   const existingGrade = existingData.find(item => item.reg === reg)?.worksheetGrades[currentWorksheet-1];
 
   if (existingGrade) {
     select.value = existingGrade;
   }
  



    });
  </script>

  <!-- script for autosave -->
   <script>
    async function autoSave() {
      const form = document.getElementById('entryForm');
     const reg = this.dataset.reg; // Get the reg value from the data attribute
      const urlParams = new URLSearchParams(window.location.search);
      const studentClass = urlParams.get('studentClass');
      const section = urlParams.get('section');
      const terminal = urlParams.get('terminal');
      const academicYear = urlParams.get('academicYear');
 const studentInputs = form.querySelectorAll(
        `[name$="[${reg}]"]`
    );

        const studentData = {
        reg: reg,
        studentClass: studentClass,
        section: section,
        terminal: terminal,
        academicYear: academicYear,
        subject: form.querySelector('[name="subject"]').value,
        worksheet: form.querySelector('[name="worksheet"]').value,
        totalWorksheet: form.querySelector('[name="totalWorksheet"]').value,
        worksheetGrades: form.querySelector(`[name="worksheetGrades[${reg}]"]`).value,
        theorymarks: form.querySelector(`[name="theorymarks[${reg}]"]`)?.value || 0, // Default to 0 if empty
        attendance: form.querySelector(`[name="attendance[${reg}]"]`).value

    };
    console.log("Student data to be saved:", studentData);
    studentInputs.forEach(input => {

        const match = input.name.match(/^([^\[]+)\[([^\]]+)\]$/);

        if (!match) return;

        const field = match[1];

        // Remove [REG] from field name
        studentData[field] = input.value;
    });

    console.log("Saving ONLY student:", studentData);

    try {

        const response = await fetch(
            `/entryformpreprimary?studentClass=${encodeURIComponent(studentClass)}&section=${encodeURIComponent(section)}&terminal=${encodeURIComponent(terminal)}&academicYear=${encodeURIComponent(academicYear)}`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(studentData)
            }
        );

        const data = await response.json();

        console.log("Student auto-saved:", data);

    } catch (error) {

        console.error("Auto-save error:", error);

    }
}
      
   </script>

   <!-- script to trigger auto-save -->
    <script>
      document.querySelector('input[name="totalWorksheet"]').addEventListener('change', autoSave);
      document.querySelectorAll('.worksheetGrade').forEach(select => {
        select.addEventListener('change', autoSave);
      });
      document.querySelectorAll('input[name^="theorymarks"]').forEach(input => {
        input.addEventListener('input', autoSave);
      });
      document.querySelectorAll('input[name^="attendance"]').forEach(input => {
        input.addEventListener('input', autoSave);
      });
      document.querySelector('select[name="worksheet"]').addEventListener('change', autoSave);
      

    </script>
</body>
</html>