<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pre primary Entry Form</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #172b4d;
      --muted: #66758b;
      --line: #e2e8f0;
      --surface: #ffffff;
      --canvas: #f4f7fb;
      --accent: #2457c5;
      --accent-dark: #1946a3;
      --success: #16804a;
      --danger: #c43d48;
      font-family: Inter, "Segoe UI", Arial, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--canvas); color: var(--ink); }
    .page { width: 100%; max-width: 1500px; margin: 0 auto; padding: 24px 20px 48px; }
    .page-heading { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 22px; }
    .page-heading-copy { min-width: 0; }
    .eyebrow { margin: 0 0 6px; color: var(--accent); font-size: 12px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
    h1 { margin: 0; font-size: clamp(24px, 3vw, 32px); letter-spacing: -.03em; }
    .subtitle { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
    .page-action { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 9px 16px; border-radius: 8px; background: var(--accent); color: #fff; font-size: 13px; font-weight: 700; text-decoration: none; }
    .page-action:hover { background: var(--accent-dark); }
    .card { margin-bottom: 18px; padding: 22px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); box-shadow: 0 4px 18px rgba(23, 43, 77, .045); }
    .filter-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 15px; }
    .worksheet-filter { grid-template-columns: minmax(180px, 260px); margin-bottom: 16px; }
    .field { display: flex; min-width: 0; flex-direction: column; gap: 7px; }
    .field label, .field-label { color: #35445c; font-size: 12px; font-weight: 700; }
    select, input[type="number"] {
      width: 100%; min-height: 42px; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px;
      background: #fff; color: var(--ink); font: inherit; font-size: 14px;
    }
    select:focus, input[type="number"]:focus { outline: 3px solid rgba(36, 87, 197, .14); border-color: var(--accent); }
    input[readonly] { background: #f6f8fb; color: #59677d; }
    .detail-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
    .context { color: var(--muted); font-size: 13px; line-height: 1.6; }
    .context strong { color: var(--ink); }
    .worksheet-tools { display: flex; align-items: end; gap: 10px; }
    .worksheet-tools .field { width: 155px; }
    button { min-height: 42px; padding: 9px 16px; border: 0; border-radius: 8px; background: var(--accent); color: #fff; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; transition: background .15s ease, transform .15s ease; }
    button:hover { background: var(--accent-dark); }
    button:active { transform: translateY(1px); }
    button:disabled { opacity: .65; cursor: wait; }
    .entry-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .entry-heading h2 { margin: 0; font-size: 18px; }
    .entry-heading p { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
    .save-status { min-height: 18px; color: var(--muted); font-size: 12px; text-align: right; }
    .save-status.success { color: var(--success); }
    .save-status.error { color: var(--danger); }
    .table-wrap { overflow-x: auto; border: 1px solid #b8c7dc; border-radius: 10px; }
    #entrytable { width: 100%; min-width: 560px; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
    #entrytable th:nth-child(1), #entrytable td:nth-child(1) { width: 34%; }
    #entrytable th:nth-child(2), #entrytable td:nth-child(2) { width: 20%; }
    #entrytable th:nth-child(3), #entrytable td:nth-child(3) { width: 30%; }
    #entrytable th:nth-child(4), #entrytable td:nth-child(4) { width: 16%; }
    #entrytable th { position: sticky; top: 58px; z-index: 2; padding: 12px 10px; border: 1px solid #24477f; background: #24477f; color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .04em; text-align: left; text-transform: uppercase; }
    #entrytable th:first-child { border-top-left-radius: 8px; }
    #entrytable th:last-child { border-top-right-radius: 8px; }
    #entrytable th:not(:first-child), #entrytable td:not(:first-child) { text-align: center; }
    #entrytable td { padding: 9px 10px; border-right: 1px solid #d9e2ef; border-bottom: 1px solid #d9e2ef; background: #fff; vertical-align: middle; overflow-wrap: anywhere; }
    #entrytable td:first-child { border-left: 1px solid #d9e2ef; }
    #entrytable tbody tr:nth-child(even) td { background: #f5f8fc; }
    #entrytable tbody tr:hover td { background: #eaf1fb; }
    #entrytable td select, #entrytable td input[type="number"] { display: block; width: 100%; max-width: 100%; min-width: 0; min-height: 38px; padding: 6px 8px; }
    .student-name { font-weight: 600; }
    .invalid-registration { color: var(--danger); }
    .valid-registration { color: var(--ink); }
    .absent-control { display: inline-flex; align-items: center; gap: 6px; margin-left: 10px; color: var(--muted); font-size: 12px; white-space: nowrap; }
    input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--accent); vertical-align: middle; }
    .empty-state { padding: 32px 16px; color: var(--muted); text-align: center; }
    @media (max-width: 800px) {
      .page { padding: 18px 12px 36px; }
      .filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .detail-bar { align-items: stretch; flex-direction: column; }
      .worksheet-tools { justify-content: space-between; }
      .worksheet-tools .field { width: min(50%, 200px); }
      #entrytable th { top: 68px; }
    }
    @media (max-width: 480px) {
      .filter-grid { grid-template-columns: 1fr; }
      .page-heading { align-items: flex-start; flex-direction: column; }
      .page-action { padding: 8px 10px; font-size: 11px; white-space: nowrap; }
      .card { padding: 10px; }
      .entry-heading { align-items: flex-start; flex-direction: column; }
      .save-status { text-align: left; }
      #entrytable { min-width: 0; }
      #entrytable th:nth-child(1), #entrytable td:nth-child(1) { width: 32%; }
      #entrytable th:nth-child(2), #entrytable td:nth-child(2) { width: 20%; }
      #entrytable th:nth-child(3), #entrytable td:nth-child(3) { width: 32%; }
      #entrytable th:nth-child(4), #entrytable td:nth-child(4) { width: 16%; }
      #entrytable th { top: 0; padding: 8px 3px; font-size: 9px; letter-spacing: 0; text-align: center; }
      #entrytable td { padding: 6px 3px; font-size: 11px; }
      #entrytable td select, #entrytable td input[type="number"] { min-height: 34px; padding: 4px 2px; font-size: 11px; }
      .absent-control { display: flex; width: fit-content; margin: 5px 0 0; font-size: 10px; }
    }
  </style>
</head>
<body>
  <% const isAdminUser = String(typeof userRole === 'undefined' ? '' : userRole || '').toUpperCase() === 'ADMIN'; %>
  <% const preprimaryExistingData = typeof existingData === 'undefined' || !Array.isArray(existingData) ? [] : existingData; %>
  <% const worksheetCount = Math.max(1, Number(typeof configuredWorksheetCount === 'undefined' ? 0 : configuredWorksheetCount) || Number(preprimaryExistingData[0]?.totalWorksheet) || 1); %>
  <main class="page">
  <header class="page-heading">
    <div class="page-heading-copy">
      <p class="eyebrow">Assessment entry</p>
      <h1>Pre-primary worksheet grades</h1>
      <p class="subtitle">Choose the class, subject and assessment period, then enter student grades.</p>
    </div>
    <a class="page-action" id="addTotalAttendance" href="/total-attendanceentry">Add total attendance</a>
  </header>
  <form action="/entryformpreprimary?studentClass=<%= studentClass %>&section=<%= section %>&terminal=<%= terminal %>&academicYear=<%= academicYear %>" method="POST" id="entryForm">
  <section class="card" aria-label="Assessment selection">
  <div class="filter-grid">
  <div class="field">
    <label for="subjectSelect">Subject</label>
    <select name="subject" id="subjectSelect" class="formloader">
      <option value="" selected disabled>Select subject</option>
      <%
      const preprimarysubjects = subjects.filter(sub=> sub.forClass.toLowerCase() === "nursery" || sub.forClass.toLowerCase() === "playgroup" || sub.forClass.toLowerCase() === "lkg" || sub.forClass.toLowerCase() === "ukg");
      const uniqueSubjects = new Set(preprimarysubjects.map(sub => sub.newsubject));
      uniqueSubjects.forEach(subject => { %>
        <option value="<%= subject %>"><%= subject %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="classSection">Class and section</label>
    <select name="classSection" id="classSection" class="formloader">
      <option value="" selected disabled>Select class and section</option>
      <% const classOrder = {
        "Nursery": 1, "LKG": 2, "UKG": 3, "One": 4, "Two": 5, "Three": 6,
        "Four": 7, "Five": 8, "Six": 9, "Seven": 10, "Eight": 11, "Nine": 12, "Ten": 13
      }; %>
      <% studentClassdata.sort((a, b) => classOrder[a.studentClass] - classOrder[b.studentClass]).forEach(classItem => { %>
        <option value="<%= classItem.studentClass %>-<%= classItem.section %>"><%= classItem.studentClass %> - <%= classItem.section %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="terminalSelect">Terminal</label>
    <select name="terminal" id="terminalSelect" class="formloader">
      <option value="" selected disabled>Select terminal</option>
      <% terminals.forEach(terminal => { %><option value="<%= terminal.terminal %>"><%= terminal.terminal %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="academicYearSelect">Academic year</label>
    <select name="academicYear" id="academicYearSelect" class="formloader">
      <option value="" selected disabled>Select academic year</option>
      <% marksheetSetups.forEach(setup => { %>
        <% for (let i = 0; i < 5; i++) { %><option value="<%= setup.academicYear - i %>"><%= setup.academicYear - i %></option><% } %>
      <% }) %>
    </select>
  </div>
  </div>
  <input type="hidden" name="studentClass" value="<%= studentClass %>">
  <input type="hidden" name="section" value="<%= section %>">
  <div class="detail-bar">
    <div class="context">
      <strong><%= subject || 'Select a subject' %></strong>
      <span aria-hidden="true"> · </span><%= studentClass %> - <%= section %>
      <span aria-hidden="true"> · </span><%= terminal %> Terminal
      <span aria-hidden="true"> · </span>Academic year <%= academicYear %>
    </div>
    <div class="worksheet-tools">
      <div class="field">
        <label for="totalWorksheet">Total worksheets <%= isAdminUser ? '(admin)' : '' %></label>
        <input type="number" id="totalWorksheet" name="totalWorksheet" value="<%= worksheetCount %>" min="1" max="100" step="1" <%= isAdminUser ? '' : 'readonly aria-readonly="true"' %> required>
      </div>
      <% if (isAdminUser) { %>
        <button type="button" id="saveWorksheetCount">Save count</button>
      <% } %>
    </div>
  </div>
  </section>

  <section class="card" aria-label="Student worksheet grades">
    <div class="entry-heading">
      <div>
        <h2>Student entries</h2>
        <p>Select a worksheet and enter grades. Changes save automatically, or use Save marks.</p>
      </div>
      <div class="worksheet-tools">
        <div class="save-status" id="saveStatus" role="status" aria-live="polite">Ready</div>
        <button type="button" id="saveMarks">Save marks</button>
      </div>
    </div>
    <div class="filter-grid worksheet-filter">
      <div class="field">
        <label for="worksheetSelect">Worksheet</label>
        <select name="worksheet" id="worksheetSelect">
          <option value="" disabled>Select worksheet</option>
          <% for (let i = 1; i <= worksheetCount; i++) { %>
            <option value="<%= i %>" <%= Number(worksheet || 1) === i ? 'selected' : '' %>>Worksheet <%= i %></option>
          <% } %>
        </select>
      </div>
    </div>
    <div class="table-wrap">
    <% const sortedStudent = studentData.sort((a,b)=>Number(a.roll) - Number(b.roll)); %>
    <% if (sortedStudent.length) { %>
    <table id="entrytable">
      <thead><tr><th>Name</th><th>Th</th><th id="worksheetheader">W<%= worksheet || 1 %></th><th>Att.</th></tr></thead>
      <tbody>
      <% sortedStudent.forEach(student => { %>
        <tr>
          <input type="hidden" name="roll[<%= student.reg %>]" value="<%= student.roll %>">
          <input type="hidden" name="gender[<%= student.reg %>]" value="<%= student.gender %>">
          <td class="<%= student.reg == '' || student.reg == null || student.reg == undefined || student.reg == 'N/A' || !student.reg ? 'invalid-registration' : 'valid-registration' %>">
            <input type="hidden" name="reg[<%= student.reg %>]" value="<%= student.reg %>">
            <input type="hidden" name="name[<%= student.reg %>]" value="<%= student.name %>">
            <span class="student-name"><%= student.roll %>. <%= student.name %></span>
            <label class="absent-control">Absent <input type="checkbox" name="status[<%= student.reg %>]" value="ABSENT" data-reg="<%= student.reg %>" <%= ['ABSENT', '1'].includes(String(preprimaryExistingData.find(item => String(item.reg) === String(student.reg))?.status || '').toUpperCase()) ? 'checked' : '' %>></label>
          </td>
          <td>
            <select class="theoryGrade" name="theorymarks[<%= student.reg %>]" data-reg="<%= student.reg %>" aria-label="Theory grade for <%= student.name %>">
              <option value="">Grade</option>
              <option value="4.0">A+</option><option value="3.6">A</option><option value="3.2">B+</option>
              <option value="2.8">B</option><option value="2.4">C+</option><option value="2.0">C</option>
              <option value="1.6">D</option><option value="0.0">NG</option>
            </select>
          </td>
          <td><select class="worksheetGrade" id="worksheetgrade_<%= student._id %>" name="worksheetGrades[<%= student.reg %>]" data-reg="<%= student.reg %>" aria-label="Worksheet grade for <%= student.name %>">
            <option value="">Grade</option><option value="A+">A+</option><option value="A">A</option>
            <option value="B+">B+</option><option value="B">B</option><option value="C+">C+</option>
            <option value="C">C</option><option value="D">D</option><option value="NG">NG</option><option value="Ab">Absent</option>
          </select></td>
          <td>          <input type="number" name="attendance[<%= student.reg %>]" min="0" value="<%= (typeof totalAttendanceByReg === 'undefined' ? {} : totalAttendanceByReg)[String(student.reg)] ?? preprimaryExistingData.find(item => String(item.reg) === String(student.reg))?.attendance ?? '' %>" data-reg="<%= student.reg %>" aria-label="Attendance for <%= student.name %>" readonly aria-readonly="true"></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <% } else { %>
      <div class="empty-state">No students are available for this class and section.</div>
    <% } %>
    </div>
  </section>
  </form>
  </main>

<!-- script to auto load  -->
 <script>
  const subjectSelect = document.getElementById('subjectSelect');
  const totalAttendanceParams = new URLSearchParams(window.location.search);
  document.getElementById('addTotalAttendance').href =
    `/total-attendanceentry?${totalAttendanceParams.toString()}`;
  const studentClassSection = document.querySelector('select[name="classSection"]').value;
  const separated = studentClassSection.split('-');
  const studentClass = separated[0];
  const section = separated[1];
  const terminal = document.querySelector('select[name="terminal"]').value;
  const academicYear = document.querySelector('select[name="academicYear"]').value;

  // if all values are selected, redirect to the entry form
  if (subjectSelect.value && studentClass && section && terminal && academicYear) {
    const url = `/entryform?subject=${encodeURIComponent(subjectSelect.value)}&studentClass=${encodeURIComponent(studentClass)}&section=${encodeURIComponent(section)}&terminal=${encodeURIComponent(terminal)}&academicYear=${encodeURIComponent(academicYear)}`;
    window.location.href = url;
  }
  else
  {
    // highlight the missing fields
    if (!subjectSelect.value) {
      subjectSelect.style.border = '2px solid red';
    }
    if (!studentClass) {
      document.querySelector('select[name="classSection"]').style.border = '2px solid red';
    }
 
    if (!terminal) {
      document.querySelector('select[name="terminal"]').style.border = '2px solid red';
    }
    if (!academicYear) {
      document.querySelector('select[name="academicYear"]').style.border = '2px solid red';
    }


    // make selected value from query on page load
    const urlParams = new URLSearchParams(window.location.search);
    const subjectParam = urlParams.get('subject');
    const studentClassParam = urlParams.get('studentClass');
    const sectionParam = urlParams.get('section');
    const terminalParam = urlParams.get('terminal');
    // terminal param value become empty fix
    if (terminalParam === '') {
      document.querySelector('select[name="terminal"]').value = '';
    }

    const academicYearParam = urlParams.get('academicYear');

    if (subjectParam) {
      subjectSelect.value = subjectParam;
    }
    if (studentClassParam) {
      document.querySelector('select[name="classSection"]').value = `${studentClassParam}-${sectionParam}`;
    }
    if (terminalParam) {
      document.querySelector('select[name="terminal"]').value = terminalParam;
    }
    if (academicYearParam) {
      document.querySelector('select[name="academicYear"]').value = academicYearParam;
    }

    document.querySelectorAll('.formloader').forEach(select => {
      select.addEventListener('change', () => {
        const selectedSubject = subjectSelect.value;
        const selectedClassSection = document.querySelector('select[name="classSection"]').value;
        const selectedTerminal = document.querySelector('select[name="terminal"]').value;
        const selectedAcademicYear = document.querySelector('select[name="academicYear"]').value;

        if (selectedSubject && selectedClassSection && selectedTerminal && selectedAcademicYear) {
          const [selectedClass, selectedSection] = selectedClassSection.split('-');
          const url = `/entryform?subject=${encodeURIComponent(selectedSubject)}&studentClass=${encodeURIComponent(selectedClass)}&section=${encodeURIComponent(selectedSection)}&terminal=${encodeURIComponent(selectedTerminal)}&academicYear=${encodeURIComponent(selectedAcademicYear)}&worksheet=1`;
          window.location.href = url;
        }
      });
    });

  }

 </script>

 <!-- making as per worksheet select value shown in table  -->
  <script>
    const currentWorksheetSelect = document.querySelector('select[name="worksheet"]').value;
    document.querySelector('select[name="worksheet"]').addEventListener('change', (event) => {
      const selectedWorksheet = event.target.value;
      const urlParams = new URLSearchParams(window.location.search);
      urlParams.set('worksheet', selectedWorksheet);
      window.location.search = urlParams.toString();
    });

    window.addEventListener('load', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const worksheetParam = urlParams.get('worksheet');
      if (worksheetParam) {
        document.querySelector('select[name="worksheet"]').value = worksheetParam;
        document.getElementById('worksheetheader').textContent = `Worksheet ${worksheetParam}`;
      } else {
        document.querySelector('select[name="worksheet"]').value = currentWorksheetSelect;

      }
    });
   
  </script>

   <input type="hidden" id = "exisingData" value = "<%= JSON.stringify(preprimaryExistingData) %>">
