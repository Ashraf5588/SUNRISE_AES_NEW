              <td colspan="<%= colCount %>" class="subject-column subject-<%= index %>" data-subject="<%= sub %>"><%= d && d.femaleavg !== undefined ? d.femaleavg.toFixed(2) : '-' %></td>
            <% }) %>
            <td colspan="4"></td>
          </tr>

          <tr>
            <th colspan="2" style="text-align:right; font-weight:bold;">Pass Count:</th>
            <% uniqueSubjects.forEach((sub, index) => { 
              const info = subjectInfo[sub];
              const wsCount = info.isNoWorksheet ? 0 : (info.worksheetCount || 0);
              const colCount = wsCount + 2;
            %>
              <td colspan="<%= colCount %>" class="subject-column subject-<%= index %>" data-subject="<%= sub %>"><%= ledgerAnalysisLookup && ledgerAnalysisLookup[sub] ? ledgerAnalysisLookup[sub].passCount : '-' %></td>
            <% }) %>
            <td colspan="4"></td>
          </tr>

          <tr>
            <th colspan="2" style="text-align:right; font-weight:bold;">Fail Count:</th>
            <% uniqueSubjects.forEach((sub, index) => { 
              const info = subjectInfo[sub];
              const wsCount = info.isNoWorksheet ? 0 : (info.worksheetCount || 0);
              const colCount = wsCount + 2;
            %>
              <td colspan="<%= colCount %>" class="subject-column subject-<%= index %>" data-subject="<%= sub %>"><%= ledgerAnalysisLookup && ledgerAnalysisLookup[sub] ? ledgerAnalysisLookup[sub].failCount : '-' %></td>
