            <th colspan="2" style="text-align:right; font-weight:bold;">Fail %:</th>
            <% uniqueSubjects.forEach((sub, index) => {
              const d = ledgerAnalysisLookup && ledgerAnalysisLookup[sub];
              const pct = d && d.totalStudents > 0
                ? ((d.failCount / d.totalStudents) * 100).toFixed(2)
                : '-';
              const info = subjectInfo[sub];
              const wsCount = info.isNoWorksheet ? 0 : (info.worksheetCount || 0);
              const colCount = wsCount + 2;
            %>
              <td colspan="<%= colCount %>" class="subject-column subject-<%= index %>" data-subject="<%= sub %>"><%= pct %>%</td>
            <% }) %>
            <td colspan="4"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <script>
    // Subjects that should NOT have worksheets (same as backend)
    const NO_WORKSHEET_SUBJECTS = ['ORAL', 'HYGIENE'];

    // Function to check if a value is Ab (sentinel 0.000001)
    function isAb(value) {
      // Check if value is null or undefined
      if (value === null || value === undefined) {
        return false;
      }
      
      // Convert to string for comparison
      const strValue = String(value).trim();
      
      // Check for exact match
      if (strValue === '0.000001') {
        return true;
      }
      
      // Check for number comparison (handle floating point precision)
      if (typeof value === 'number') {
        // Use a small epsilon for floating point comparison
        const epsilon = 0.0000001;
        if (Math.abs(value - 0.000001) < epsilon) {
          return true;
        }
      }
      
      // Check if it's a string representation
      if (typeof value === 'string') {
        const cleanValue = value.trim().toLowerCase();
        if (cleanValue === '0.000001' || cleanValue === 'ab' || cleanValue === 'absent') {
          return true;
        }
      }
      
      return false;
    }

    // Function to get numeric value for calculations
    function getNumericValue(value) {
      if (isAb(value)) {
        return 0;
      }
      if (value === null || value === undefined) {
        return 0;
      }
      const num = Number(value);
      return isNaN(num) ? 0 : num;
    }

    // Function to get worksheet GP
    function getWorksheetGP(grade) {
      if (!grade) return 0;
      if (isAb(grade)) return 0;
      const gradeMap = {
        'A+': 4.0,
        'A': 3.6,
        'B+': 3.2,
        'B': 2.8,
        'C+': 2.4,
        'C': 2.0,
        'D': 1.6,
        'NG': 0.0
      };
      return gradeMap[grade] || 0;
    }

    document.addEventListener('DOMContentLoaded', function() {
      // Function to update subject group header colspan
      function updateSubjectGroupHeaderColspan() {
        const subjectHeaders = document.querySelectorAll('.subject-header');
        subjectHeaders.forEach(header => {
          const index = header.dataset.subjectIndex;
          const visibleSubheaders = document.querySelectorAll(`.subject-subheader.subject-${index}:not(.hidden-column)`);
          const visibleCount = visibleSubheaders.length;
          
          if (visibleCount === 0) {
            header.classList.add('hidden-column');
          } else {
            header.classList.remove('hidden-column');
            header.colSpan = visibleCount;
          }
        });
      }

      // Subject toggle handler
      document.querySelectorAll('.subject-toggle').forEach(toggle => {
        toggle.addEventListener('change', function() {
          const index = this.dataset.subjectIndex;
          const isVisible = this.checked;
          
          // Toggle all columns with this subject
          document.querySelectorAll(`.subject-${index}`).forEach(el => {
            if (!isVisible) {
              el.classList.add('hidden-column');
            } else {
              el.classList.remove('hidden-column');
            }
          });
          
          updateSubjectGroupHeaderColspan();
        });
      });

      // Column type toggle handler
      document.querySelectorAll('.column-toggle').forEach(toggle => {
        toggle.addEventListener('change', function() {
          const colType = this.dataset.coltype;
          const isVisible = this.checked;
          
          // Toggle all columns with this type
          document.querySelectorAll(`.${colType}`).forEach(el => {
            if (!isVisible) {
              el.classList.add('hidden-column');
            } else {
              el.classList.remove('hidden-column');
            }
          });
          
          updateSubjectGroupHeaderColspan();
        });
      });

      // Initialize visibility on page load
      function initializeVisibility() {
        // Subject toggles
        document.querySelectorAll('.subject-toggle').forEach(toggle => {
          const index = toggle.dataset.subjectIndex;
          const isVisible = toggle.checked;
          document.querySelectorAll(`.subject-${index}`).forEach(el => {
            if (!isVisible) {
              el.classList.add('hidden-column');
            } else {
              el.classList.remove('hidden-column');
            }
          });
        });

        // Column type toggles
        document.querySelectorAll('.column-toggle').forEach(toggle => {
          const colType = toggle.dataset.coltype;
          const isVisible = toggle.checked;
          document.querySelectorAll(`.${colType}`).forEach(el => {
            if (!isVisible) {
              el.classList.add('hidden-column');
            } else {
              el.classList.remove('hidden-column');
            }
          });
        });

        updateSubjectGroupHeaderColspan();
      }

      // Initialize after a small delay to ensure DOM is ready
      setTimeout(() => {
        initializeVisibility();
    
      }, 100);
    });

    
      

 

       

      
         
         
        
     

    function loadform() {
      const classSection = document.getElementById('classSection').value;
      if(!classSection) { alert("Please select Class & Section"); return; }
      const studentClass = classSection.split("-")[0];
      const section = classSection.split("-")[1];
      const academicYear = document.getElementById('academicYear').value;
      const terminal = document.getElementById('terminal').value;

      window.location.href = `/ledger?studentClass=${studentClass}&section=${section}&terminal=${terminal}&academicYear=${academicYear}`;
    }
    
    // Set initial values for selectors
    try {
      const currentClass = "<%= typeof studentClass !== 'undefined' ? studentClass : '' %>";
      const currentSection = "<%= typeof section !== 'undefined' ? section : '' %>";
      const currentTerminal = "<%= typeof terminal !== 'undefined' ? terminal : '' %>";
      const currentYear = "<%= typeof academicYear !== 'undefined' ? academicYear : '' %>";

      if(currentClass && currentSection) {
        const val = currentClass + '-' + currentSection;
        const select = document.getElementById('classSection');
        if(select) {
          const options = select.options;
          for(let i = 0; i < options.length; i++) {
            if(options[i].value === val) {
              select.selectedIndex = i;
              break;
            }
          }
        }
      }
      
      if(currentTerminal) {
        const termSelect = document.getElementById('terminal');
        if(termSelect) {
          const options = termSelect.options;
          for(let i = 0; i < options.length; i++) {
            if(options[i].value === currentTerminal) {
              termSelect.selectedIndex = i;
              break;
            }
          }
        }
      }
      
      if(currentYear) {
        const yearSelect = document.getElementById('academicYear');
        if(yearSelect) {
          const options = yearSelect.options;
          for(let i = 0; i < options.length; i++) {
            if(options[i].value === currentYear) {
              yearSelect.selectedIndex = i;
              break;
            }
          }
        }
      }
    } catch(e) {
      console.error("Error setting initial values:", e);
    }

    function shareToWhatsapp() {
      const url = window.location.href;
      const message = "📘 Result Published\nClass: <%= studentClass %>-<%= section %>\nTerminal: <%= terminal %>\nYear: <%= academicYear %>\n\n👉 View Result:\n" + url;

      const whatsappUrl = "https://wa.me/?text=" + encodeURIComponent(message);
      window.open(whatsappUrl, "_blank");
    }

    function exportToCSV() {
      const table = document.getElementById('ledgerTable');
      let csv = [];
      
      // Get headers
      const headers = [];
      const headerRows = table.querySelectorAll('thead tr');
      headerRows.forEach(row => {
        const rowData = [];
        row.querySelectorAll('th').forEach(th => {
          if (!th.classList.contains('hidden-column')) {
            rowData.push('"' + th.textContent.trim() + '"');
          }
        });
        if (rowData.length > 0) {
          headers.push(rowData.join(','));
        }
      });
      csv.push(headers.join('\n'));

      // Get body data
      const rows = table.querySelectorAll('tbody tr');
      rows.forEach(row => {
        const rowData = [];
        row.querySelectorAll('td').forEach(td => {
          if (!td.classList.contains('hidden-column')) {
            rowData.push('"' + td.textContent.trim() + '"');
          }
        });
        if (rowData.length > 0) {
          csv.push(rowData.join(','));
        }
      });

      // Download CSV
      const csvContent = csv.join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      link.setAttribute('href', url);
      link.setAttribute('download', 'ledger_<%= studentClass %>_<%= section %>_<%= terminal %>.csv');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function exportToExcel() {
      const table = document.getElementById('ledgerTable');
      
      // Get visible subject data
      const subjectHeaders = document.querySelectorAll('.subject-header:not(.hidden-column)');
      const subjectGroups = [];
      subjectHeaders.forEach(header => {
        const index = header.dataset.subjectIndex;
        const subheaders = document.querySelectorAll(`.subject-subheader.subject-${index}:not(.hidden-column)`);
        subjectGroups.push({
          name: header.textContent.trim(),
          count: subheaders.length,
          index: index,
          subheaders: subheaders
        });
      });

      // Get visible remaining columns (only once)
      const remainingCols = [];
      const remainingHeaders = ['gpa', 'rank', 'att', 'status'];
      remainingHeaders.forEach(type => {
        const col = document.querySelector(`.col-${type}`);
        if (col && !col.classList.contains('hidden-column')) {
          const header = document.querySelector(`th[data-coltype="${type}"]`);
          if (header) {
            remainingCols.push({
              name: header.textContent.trim(),
              type: type
            });
          }
        }
      });

      // Build HTML table for Excel
      let html = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" 
              xmlns:x="urn:schemas-microsoft-com:office:excel" 
              xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="UTF-8">
          <!--[if gte mso 9]>
          <xml>
            <x:ExcelWorkbook>
              <x:ExcelWorksheets>
                <x:ExcelWorksheet>
                  <x:Name>Ledger</x:Name>
                  <x:WorksheetOptions>
                    <x:DisplayGridlines/>
                  </x:WorksheetOptions>
                </x:ExcelWorksheet>
              </x:ExcelWorksheets>
            </x:ExcelWorkbook>
          </xml>
          <![endif]-->
          <style>
            th {
              background-color: #153b71;
              color: #ffffff;
              font-weight: bold;
              border: 1px solid #1d3d69;
              padding: 8px;
              text-align: center;
              vertical-align: middle;
            }
            td {
              border: 1px solid #e2e8f0;
              padding: 6px;
              text-align: center;
              vertical-align: middle;
            }
            .pass {
              background-color: #dcfce7;
            }
            .fail {
              background-color: #fee2e2;
            }
            .ab {
              background-color: #fef3c7;
              color: #92400e;
              font-weight: bold;
            }
            .footer-bg {
              background-color: #f1f5f9;
              font-weight: bold;
            }
            table {
              border-collapse: collapse;
              font-family: Inter, Arial, sans-serif;
              font-size: 11px;
            }
          </style>
        </head>
        <body>
          <table>
      `;

      const totalCols = 2 + subjectGroups.reduce((sum, group) => sum + group.count, 0) + remainingCols.length;
      html += `<tr><th colspan="${totalCols}" style="text-align:left; font-weight:700; font-size:12px; padding:8px 10px;">`;
      html += `Class/Section: ${escapeHtml('<%= studentClass %> - <%= section %>')} | Terminal: ${escapeHtml('<%= terminal %>')} | Academic Year: ${escapeHtml('<%= academicYear %>')}`;
      html += `</th></tr>`;

      // FIRST HEADER ROW: Roll, Name, Subject names (merged), remaining headers
      html += `<tr>`;
      html += `<th rowspan="2">Roll</th>`;
      html += `<th rowspan="2">Name</th>`;
      
      subjectGroups.forEach(group => {
        html += `<th colspan="${group.count}">${escapeHtml(group.name)}</th>`;
      });
      
      remainingCols.forEach(col => {
        html += `<th rowspan="2">${escapeHtml(col.name)}</th>`;
      });
      
      html += `</tr>`;

      // SECOND HEADER ROW: Sub-headers (TH, W1, W2, etc.)
      html += `<tr>`;
      subjectGroups.forEach(group => {
        group.subheaders.forEach(subheader => {
          html += `<th>${escapeHtml(subheader.textContent.trim())}</th>`;
        });
      });
      html += `</tr>`;

      // DATA ROWS
      const rows = table.querySelectorAll('tbody tr');
      rows.forEach(row => {
        html += `<tr>`;
        
        // Roll and Name
        const roll = row.querySelector('.fixed-column-roll');
        const name = row.querySelector('.fixed-column-name');
        html += `<td>${escapeHtml(roll ? roll.textContent.trim() : '')}</td>`;
        html += `<td>${escapeHtml(name ? name.textContent.trim() : '')}</td>`;
        
        // Subject data - get all subject columns in order
        subjectGroups.forEach(group => {
          const cells = row.querySelectorAll(`.subject-${group.index}:not(.hidden-column)`);
          cells.forEach(cell => {
            const text = cell.textContent.trim();
            let cls = '';
            if (text === 'Pass') cls = 'pass';
            else if (text === 'NG' || text === 'Fail') cls = 'fail';
            else if (text === 'Ab') cls = 'ab';
            html += `<td class="${cls}">${escapeHtml(text)}</td>`;
          });
        });
        
        // Remaining columns data (only once)
        remainingCols.forEach(col => {
          const cell = row.querySelector(`.col-${col.type}:not(.hidden-column)`);
          const text = cell ? cell.textContent.trim() : '';
          let cls = '';
          if (col.type === 'status') {
            if (text === 'Pass') cls = 'pass';
            else if (text === 'NG' || text === 'Fail') cls = 'fail';
          }
          html += `<td class="${cls}">${escapeHtml(text)}</td>`;
        });
        
        html += `</tr>`;
      });

      // FOOTER ROWS
      const tfootRows = table.querySelectorAll('tfoot tr');
      tfootRows.forEach(row => {
        html += `<tr>`;
        const cells = row.querySelectorAll('th, td');
        cells.forEach(cell => {
          if (!cell.classList.contains('hidden-column')) {
            const text = cell.textContent.trim();
            const colspan = cell.getAttribute('colspan') || 1;
            const tag = cell.tagName === 'TH' ? 'th' : 'td';
            html += `<${tag} colspan="${colspan}" class="footer-bg">${escapeHtml(text)}</${tag}>`;
          }
        });
        html += `</tr>`;
      });

      html += `
          </table>
        </body>
        </html>
      `;

      // Download as .xls
      const blob = new Blob([html], { 
        type: 'application/vnd.ms-excel;charset=utf-8' 
      });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      link.setAttribute('href', url);
      link.setAttribute('download', `ledger_<%= studentClass %>_<%= section %>_<%= terminal %>.xls`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;');
    }
  </script>
