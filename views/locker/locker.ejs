<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Exam Locker</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }

    .terminal {
      margin-bottom: 50px;
    }

    .terminal-title {
      text-align: center;
      margin-bottom: 30px;
    }

    .group-box {
      margin-bottom: 35px;
    }

    .group-title {
      text-align: center;
      margin-bottom: 10px;
      background: #f2f2f2;
      padding: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      text-align: center;
    }

    th {
      background-color: #ddd;
    }

    hr {
      margin: 40px 0;
    }
  </style>
</head>


<body>

  <h1>Exam Locker</h1>


  <%
    /* ==========================================
       TERMINAL ORDER
    ========================================== */

    const terminalOrder = {
      FIRST: 1,
      SECOND: 2,
      MID: 3,
      THIRD: 4,
      FINAL: 5
    };


    /* Sort terminals */
    terminalList.sort((a, b) => {

      const orderA = terminalOrder[a.terminal] || 999;
      const orderB = terminalOrder[b.terminal] || 999;

      return orderA - orderB;

    });


    /* ==========================================
       CLASS GROUPS
    ========================================== */

    const Group1 = [
      'Nursery',
      'LKG',
      'UKG'
    ];

    const Group2 = [
      'One',
      'Two',
      'Three',
      '1',
      '2',
      '3'
    ];

    const Group3 = [
      'Four',
      'Five',
      '4',
      '5'
    ];

    const Group4 = [
      'Six',
      'Seven',
      '6',
      '7'
    ];

    const Group5 = [
      'Eight',
      'Nine',
      'Ten',
      '8',
      '9',
      '10'
    ];


    const classGroups = [
      {
        name: 'Nursery - UKG',
        classes: Group1
      },
      {
        name: 'Grade 1 - 3',
        classes: Group2
      },
      {
        name: 'Grade 4 - 5',
        classes: Group3
      },
      {
        name: 'Grade 6 - 7',
        classes: Group4
      },
      {
        name: 'Grade 8 - 10',
        classes: Group5
      }
    ];

  %>


  <!-- ==========================================
       TERMINAL LOOP
  =========================================== -->

  <% terminalList.forEach(function(terminal) { %>


    <div class="terminal">

      <h2 class="terminal-title">
        Terminal: <%= terminal.terminal %>
      </h2>


      <h2>
        Lock Subjects
      </h2>


      <!-- ==========================================
           GROUP LOOP
      =========================================== -->

      <% classGroups.forEach(function(group) { %>


        <%
          /*
           * Get subjects for ALL classes
           * inside this group.
           *
           * Remove duplicate subject names.
           */

          const groupSubjects = [
            ...new Map(

              subjectList

                .filter(subject =>
                  group.classes.includes(subject.forClass)
                )

                .map(subject => [
                  subject.newsubject,
                  subject
                ])

            ).values()
          ];
        %>


        <!--
          If this group has NO subjects,
          don't display anything.
        -->

        <% if (groupSubjects.length > 0) { %>


          <div class="group-box">


            <h3 class="group-title">
              <%= group.name %>
            </h3>


            <table>

              <thead>

                <tr>

                  <th>Class</th>

                  <th>Subject</th>

                  <th>Open Date</th>

                </tr>

              </thead>


              <tbody>


                <% groupSubjects.forEach(function(subject) { %>


                  <tr>

                    <td>
                      <%= subject.forClass %>
                    </td>

                    <td>
                      <%= subject.newsubject %>
                    </td>

                    <td>
                      2083-8-01 to 2083-8-31
                    </td>

                  </tr>


                <% }); %>


              </tbody>

            </table>


          </div>


        <% } %>


      <% }); %>


    </div>


    <hr>


  <% }); %>


  <!-- ==========================================
       PROJECT WORK LOCKER
  =========================================== -->

  <div>

    <h2>
      Project Work Locker
    </h2>

  </div>


</body>

</html>