<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Class <%= studentClass %>-<%= section %> Analysis Report of</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet">
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- DataTables CSS -->
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css" href="/datatable-buttons.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.bootstrap5.min.css">

  <style>
    .print-all-btn {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      padding: 10px 20px;
      background: #4CAF50;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    .print-all-btn:hover {
      background: #45a049;
    }

    .subject-section {
      margin-bottom: 30px;
      page-break-after: always;
    }

    .subject-section:last-child {
      page-break-after: avoid;
    }

    .subject-header {
      background: #f8f9fa;
      padding: 15px;
      margin-bottom: 20px;
      border-radius: 5px;
      border-left: 5px solid #4CAF50;
    }

    .print-sort-controls {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      margin: 0 0 14px;
    }

    .print-sort-controls select {
      padding: 6px 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #fff;
    }

    .subject-print-page {
      page-break-after: always;
      break-after: page;
      min-height: 245mm;
    }

    .subject-blank-page {
      page-break-after: always;
      break-after: page;
      min-height: 245mm;
    }

    .print-context {
      text-align: center;
      font-size: 16px;
      font-weight: 600;
      margin: 12px 0 18px;
    }

    .print-page-header {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 10px;
    }
table thead
{
 background-color: #70d2ff;
}
    @media print {
      .print-all-btn {
        display: none;
      }

      .print-sort-controls {
        display: none;
      }

      .subject-section {
        page-break-after: auto;
        break-after: auto;
        margin: 0;
      }

      .subject-print-page,
      .subject-blank-page {
        page-break-after: always;
        break-after: page;
        min-height: 245mm;
      }

      .subject-print-page:last-child {
        page-break-after: always;
      }

      .buttons-html5,
      .buttons-print {
        display: none !important;
      }
      table { table-layout: auto !important; width: 100% !important; }
      th, td { font-size: 12px !important; padding: 6px !important; }
    }
  </style>

  <!-- jQuery and DataTables JS -->
  <script type="text/javascript" language="javascript" src="https://code.jquery.com/jquery-3.7.0.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/responsive/2.4.1/js/responsive.bootstrap5.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
  <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>

  <script>
    // Define custom sorting for question numbers
    $.fn.dataTable.ext.type.detect.unshift(function (data) {
      if (typeof data === 'string' && data.match(/^q?\d+[a-z]?$/i)) {
        return 'question-num';
      }
      return null;
    });

    $.fn.dataTable.ext.type.order['question-num-pre'] = function (data) {
      if (!data || data === '') return 0;
      
      var match = data.match(/^q?(\d+)([a-z]?)$/i);
      if (!match) return 0;
      
      var questionNum = parseInt(match[1]);
      var subQuestion = match[2] ? match[2].toLowerCase() : 'a';
      
      var subQuestionNum = subQuestion.charCodeAt(0) - 97;
      return questionNum * 100 + subQuestionNum;
    };

    // store DataTable APIs for each subject table
    window._dtTables = [];

    const PRINT_ROWS_PER_PAGE = 22;

    function applyPrintSort() {
      const value = document.getElementById('printSort')?.value || 'question-asc';
      const order = value.endsWith('-desc') ? 'desc' : 'asc';
      const column = value.startsWith('average') ? 11 : value.startsWith('wrong') ? 3 : 0;
      window._dtTables.forEach(function(dt) {
        dt.order([[column, order]]).draw();
      });
    }

    function buildSubjectPrintPages() {
      document.querySelectorAll('.subject-section').forEach(function(section) {
        if (section.dataset.printPrepared === 'true') return;
        const table = section.querySelector('table');
        const tbody = table && table.querySelector('tbody');
        const header = table && table.querySelector('thead');
        if (!table || !tbody || !header) return;

        const rows = Array.from(tbody.querySelectorAll('tr'));
        if (!rows.length) return;

        const pageHost = document.createElement('div');
        pageHost.className = 'subject-print-pages';
        const subjectTitle = section.querySelector('.subject-header h3')?.textContent.trim() || '';
        const printContext = 'Class <%= studentClass %> - <%= section %> | <%= terminal %> Terminal';

        for (let start = 0; start < rows.length; start += PRINT_ROWS_PER_PAGE) {
          const page = document.createElement('div');
          page.className = 'subject-print-page';
          const pageTitle = document.createElement('div');
          pageTitle.className = 'print-page-header';
          pageTitle.textContent = `${printContext} | ${subjectTitle}`;
          page.appendChild(pageTitle);
          const pageTable = table.cloneNode(false);
          const pageHead = header.cloneNode(true);
          const pageBody = document.createElement('tbody');
          rows.slice(start, start + PRINT_ROWS_PER_PAGE).forEach(row => pageBody.appendChild(row.cloneNode(true)));
          pageTable.appendChild(pageHead);
          pageTable.appendChild(pageBody);
          page.appendChild(pageTable);
          pageHost.appendChild(page);
        }

        const pageCount = Math.ceil(rows.length / PRINT_ROWS_PER_PAGE);
        const chapterBlocks = Array.from(section.querySelectorAll('.chapter-analysis-block'));
        if (chapterBlocks.length) {
          const finalPage = pageHost.querySelector('.subject-print-page:last-of-type');
          chapterBlocks.forEach(block => {
            finalPage?.appendChild(block.cloneNode(true));
            block.remove();
          });
        }
        if (pageCount % 2 === 1) {
          const blank = document.createElement('div');
          blank.className = 'subject-blank-page';
          pageHost.appendChild(blank);
        }

        const tableCard = table.closest('.card');
        if (tableCard) {
          tableCard.replaceWith(pageHost);
        } else {
          table.replaceWith(pageHost);
        }
        section.dataset.printPrepared = 'true';
      });
    }

    function printAllReports() {
      try {
        // Expand all DataTables to show all rows before print
        const restore = [];
        window._dtTables.forEach(function(dt) {
          try {
            const api = dt; // already DataTable API instance
            restore.push({ api: api, len: api.page.len(), page: api.page() });
            api.page.len(-1).draw();
          } catch (e) { console.warn('dt expand failed', e); }
        });

        applyPrintSort();
        buildSubjectPrintPages();

        // ensure layout adjusts
        document.body.style.webkitPrintColorAdjust = 'exact';

        // after print restore pagination
        function restoreAfterPrint() {
          setTimeout(function() {
            restore.forEach(function(r) {
              try { r.api.page.len(r.len).draw(false); r.api.page(r.page).draw(false);} catch(e){}
            });
            window.removeEventListener('afterprint', restoreAfterPrint);
          }, 500);
        }

        window.addEventListener('afterprint', restoreAfterPrint);
        window.print();
      } catch (err) {
        console.error(err);
        window.print();
      }
    }

    function printSingleSubject(subjectIndex) {
      applyPrintSort();
      buildSubjectPrintPages();
      const content = document.getElementById(`subject-${subjectIndex}`);
      const originalDisplay = [];
      const sections = document.querySelectorAll('.subject-section');
      
      sections.forEach((section, idx) => {
        if (idx !== subjectIndex) {
          originalDisplay[idx] = section.style.display;
          section.style.display = 'none';
        }
      });

      window.print();

      sections.forEach((section, idx) => {
        if (idx !== subjectIndex) {
          section.style.display = originalDisplay[idx];
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.subject-section').forEach((section, index) => {
        const printBtn = document.createElement('button');
        printBtn.className = 'btn btn-success mt-3 mb-4';
        printBtn.innerHTML = '<i class="fas fa-print"></i> Print This Subject Report';
        printBtn.onclick = () => printSingleSubject(index);
        section.insertBefore(printBtn, section.querySelector('.card'));
      });
    });
  </script>
</head>
<body>
  <button onclick="printAllReports()" class="print-all-btn">
    <i class="fas fa-print"></i> Print All Reports
  </button>

  <div class="container-fluid mt-4">
    <div class="print-context">
      Class <%= studentClass %> - <%= section %> | <%= terminal %> Terminal | Analysis Report
    </div>
    <div class="print-sort-controls">
      <label for="printSort">Sort:</label>
      <select id="printSort" onchange="applyPrintSort()">
        <option value="question-asc">Question order</option>
        <option value="average-asc">Average: Low to High</option>
        <option value="average-desc">Average: High to Low</option>
        <option value="wrong-desc">Wrong: High to Low</option>
        <option value="wrong-asc">Wrong: Low to High</option>
      </select>
    </div>

    <% reportofClass.forEach(function(subjectReport, subjectIndex) { %>
    <div class="subject-section" id="subject-<%= subjectIndex %>">
      <div class="subject-header">
          <h3 class="mb-0"><%= subjectReport.subject %> Analysis</h3>
          <div style="font-size:13px;color:#444;margin-top:6px;">Class: <%= studentClass %> - <%= section %> &nbsp; | &nbsp; Terminal: <%= terminal %></div>
      </div>

      <div class="row mb-4">
        <div class="col-12">
          <div class="card">
            <div class="card-header py-3" style="background-color: #0ea5e9; color: white;">
              <h5 class="mb-0"><i class="fas fa-table me-2"></i> Question Analysis - <%= subjectReport.subject %> <center>Total Student : <%= subjectReport.totalStudents%></center></h5>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table id="example<%= subjectIndex %>" class="table table-striped table-hover" style="width:100%">
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if (subjectReport.chapterAnalysis && subjectReport.chapterAnalysis.length) { %>
      <div class="row mb-4">
        <div class="col-12">
          <div class="card">
            <div class="card-header py-2" style="background-color:#f1f5f9;">
              <h6 class="mb-0">Chapter-wise Weakness - <%= subjectReport.subject %></h6>
            </div>
            <div class="card-body">
              <% subjectReport.chapterAnalysis.forEach(function(ch){ %>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                  <div style="width:220px;font-size:13px;color:#111;"><%= ch.chapterName || ch.name || 'Chapter' %></div>
                  <div style="flex:1;background:#e6eef6;border-radius:8px;height:16px;overflow:hidden;">
                    <div style="height:100%;width:<%= Math.min(100, Math.round((ch.errorRate||ch.error||0)*100)) %>%;background:linear-gradient(90deg,#ff7a7a,#ff4949);"></div>
                  </div>
                  <div style="width:48px;text-align:right;font-size:12px;color:#222;"><%= Math.min(100, Math.round((ch.errorRate||ch.error||0)*100)) %>%</div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <script>
        document.addEventListener("DOMContentLoaded", function () {
          var persons = <%- JSON.stringify(subjectReport.results || []) %>;
          console.log('Subject:', '<%= subjectReport.subject %>', 'Data:', persons);

          if (Array.isArray(persons) && persons.length > 0) {
            persons.sort(function(a, b) {
              var aVal = $.fn.dataTable.ext.type.order['question-num-pre'](a.questionNo);
              var bVal = $.fn.dataTable.ext.type.order['question-num-pre'](b.questionNo);
              return aVal - bVal;
            });

            var classInfo = "<%= terminal %> Terminal Examination\n" +
                          "Class: <%= studentClass %> (<%= section %>)\n" +
                          "Subject: <%= subjectReport.subject %>\n" +
                          "Total Student: <%= subjectReport.totalStudents %>";

            var dtInstance = $("#example<%= subjectIndex %>").DataTable({
              data: persons,
              responsive: true,
              columns: [
                { data: "questionNo", title: "Question No", type: "question-num" },
                { data: "chapterName", title: "Chapter" },
                { data: "correct", title: "Correct" },
                { data: "wrong", title: "Wrong" },
                { data: null, title: "Current", defaultContent: "" },
                { data: "fifty", title: "50% Correct" },
                { data: null, title: "Current", defaultContent: "" },
                { data: "correctabove50", title: "Above 50%" },
                { data: null, title: "Current", defaultContent: "" },
                { data: "correctbelow50", title: "Below 50%" },
                { data: null, title: "Current", defaultContent: "" },
                { 
                    data: "averagePercentage", 
                    title: "Average %",
                    render: function (data, type, row) {
                        return data + "%";
                    }
                },
                { 
                    data: null, 
                    title: "Wrong Percentage", 
                    render: function (data, type, row) {
                        var totalStudents = <%= subjectReport.totalStudents %>;
                        return (row.wrong / totalStudents * 100).toFixed(2) + "%";
                    }
                },
                { data: "totalMarks", title: "Total Obtained" },
                { data: "fullMarks", title: "Full Marks" }
              ],
              dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                   "<'row'<'col-sm-12'tr>>" +
                   "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>" +
                   "<'row'<'col-sm-12'B>>",
              order: [[0, 'asc']],
              lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
              pageLength: 25,
              buttons: [
                {
                  extend: "copy",
                  className: "btn btn-outline-primary",
                  messageTop: classInfo,
                  exportOptions: { columns: ':visible', modifier: { page: 'all' } }
                },
                {
                  extend: "csv",
                  className: "btn btn-outline-primary",
                  messageTop: classInfo,
                  exportOptions: { columns: ':visible', modifier: { page: 'all' } }
                },
                {
                  extend: "excel",
                  className: "btn btn-outline-primary",
                  messageTop: classInfo,
                  exportOptions: { columns: ':visible', modifier: { page: 'all' } }
                },
                {
                  extend: "pdf",
                  className: "btn btn-outline-primary",
                  messageTop: classInfo,
                  exportOptions: { columns: ':visible', modifier: { page: 'all' } }
                },
                {
                  extend: "print",
                  className: "btn btn-outline-primary",
                  messageTop: classInfo,
                  exportOptions: { columns: ':visible', modifier: { page: 'all' } }
                }
              ]
            });
            // store API for printAll control
            try { window._dtTables = window._dtTables || []; window._dtTables.push(dtInstance); } catch(e){}
            // If server didn't provide chapterAnalysis, compute it client-side and render
            try {
              const subjectContainer = document.getElementById('subject-<%= subjectIndex %>');
              if (subjectContainer && !subjectContainer.querySelector('.chapter-analysis-block')) {
                // compute chapter stats from `persons`
                const totalStudent = <%= subjectReport.totalStudents %> || 0;
                const chapterMap = {};
                persons.forEach(function(r){
                  const ch = (r.chapterName || 'Uncategorized') + '';
                  if (!chapterMap[ch]) chapterMap[ch] = { chapterName: ch, questionCount: 0, totalWrong: 0 };
                  chapterMap[ch].questionCount += 1;
                  chapterMap[ch].totalWrong += (Number(r.wrong) || 0);
                });

                const chapterArr = Object.keys(chapterMap).map(function(k){
                  const s = chapterMap[k];
                  const maxPossibleWrong = s.questionCount * totalStudent;
                  const errorRate = maxPossibleWrong > 0 ? (s.totalWrong / maxPossibleWrong) : 0;
                  return { chapterName: s.chapterName, errorRate: errorRate };
                }).sort(function(a,b){ return b.errorRate - a.errorRate; });

                if (chapterArr.length) {
                  const card = document.createElement('div');
                  card.className = 'row mb-4 chapter-analysis-block';
                  card.innerHTML = "\n                    <div class=\"col-12\">\n                      <div class=\"card\">\n                        <div class=\"card-header py-2\" style=\"background-color:#f1f5f9;\">\n                          <h6 class=\"mb-0\">Chapter-wise Weakness - <%= subjectReport.subject %></h6>\n                        </div>\n                        <div class=\"card-body\">\n                        </div>\n                      </div>\n                    </div>";
                  const body = card.querySelector('.card-body');
                  chapterArr.forEach(function(ch){
                    const pct = Math.min(100, Math.round(ch.errorRate * 100));
                    const row = document.createElement('div');
                    row.style.display = 'flex'; row.style.alignItems = 'center'; row.style.gap = '10px'; row.style.marginBottom = '8px';
                    row.innerHTML = `<div style="width:220px;font-size:13px;color:#111;">${ch.chapterName}</div>`;
                    const barWrap = document.createElement('div');
                    barWrap.style.flex = '1'; barWrap.style.background = '#e6eef6'; barWrap.style.borderRadius = '8px'; barWrap.style.height = '16px'; barWrap.style.overflow = 'hidden';
                    const bar = document.createElement('div'); bar.style.height = '100%'; bar.style.width = pct + '%'; bar.style.background = 'linear-gradient(90deg,#ff7a7a,#ff4949)'; bar.style.borderRadius = '8px';
                    barWrap.appendChild(bar);
                    const percent = document.createElement('div'); percent.style.width = '48px'; percent.style.textAlign = 'right'; percent.style.fontSize = '12px'; percent.style.color = '#222'; percent.textContent = pct + '%';
                    row.appendChild(barWrap); row.appendChild(percent);
                    body.appendChild(row);
                  });
                  // insert after the card element that contains the table
                  const tableCard = subjectContainer.querySelector('.card');
                  if (tableCard && tableCard.parentNode) tableCard.parentNode.parentNode.parentNode.insertBefore(card, tableCard.parentNode.parentNode.nextSibling);
                }
              }
            } catch(e) { console.warn('chapter analysis render failed', e); }
          } else {
            console.warn('No data available for subject:', '<%= subjectReport.subject %>');
            $("#example<%= subjectIndex %>").parent().prepend(
              '<div class="alert alert-warning" role="alert">' +
              'No data available for this subject.' +
              '</div>'
            );
          }
        });
      </script>
    </div>
    <% }) %>
  </div>
</body>
</html>
