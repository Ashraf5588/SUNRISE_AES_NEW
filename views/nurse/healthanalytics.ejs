<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Health Management - Analytics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/health-record.css">
</head>
<body class="hm-body">
  <button class="hm-menu-toggle" type="button" aria-controls="hmSidebar" aria-expanded="false">Menu</button>
  <div class="hm-backdrop" id="hmBackdrop" hidden></div>
  <div class="hm-shell">
    <aside class="hm-sidenav" id="hmSidebar" aria-label="Nurse tools navigation">
      <div class="hm-sidenav-header">
        <div>
          <p class="hm-sidenav-kicker">Nurse Tools</p>
          <h2>Health Module</h2>
        </div>
        <button class="hm-sidenav-close" type="button" aria-label="Close menu">×</button>
      </div>
      <nav class="hm-sidenav-nav">
        <a href="/healthrecord" class="hm-nav-link">Dashboard</a>
        <a href="/healthrecord/bmi" class="hm-nav-link">Add height, weight and MUAQ</a>
        <a href="/healthrecord/bp/add" class="hm-nav-link">Add blood pressure</a>
        <a href="/healthrecord/medicine" class="hm-nav-link">Add medicine name</a>
        <a href="/healthrecord/medicine/distributed" class="hm-nav-link">Add medicine distributed record</a>
        <a href="/healthrecord/padrecord" class="hm-nav-link">Add pad record</a>
        <a href="/healthrecord/analytics" class="hm-nav-link">Generate analytics</a>
      </nav>
    </aside>

    <div class="hm-main-wrap">
      <div class="hm-bg"></div>
      <div class="hm-page hm-analytics-page">
        <section class="hm-bmi-toolbar">
          <div>
            <p class="hm-kicker">School Health</p>
            <h1>Student BMI Report</h1>
            <p class="hm-muted"><%= totalWithBmi %> students with BMI records</p>
          </div>
          <div class="hm-analytics-actions">
            <button type="button" style="background-color:green !important;color:white;" class="hm-button hm-button-secondary" id="exportBmiExcelBtn">Export BMI to Excel</button>
            <button type="button" class="hm-button hm-button-secondary" id="printBmiReportBtn">Print BMI Report</button>
            <button type="button" class="hm-button hm-button-secondary" id="printDiagnosisSummaryBtn">Print Summary</button>
          </div>
        </section>

        <section class="hm-card hm-summary-card" id="diagnosisSummaryPanel" hidden>
          <div class="hm-summary-header">
            <div>
              <p class="hm-kicker">Clinic Summary</p>
              <h2>Monthly Diagnosis Summary</h2>
              <p class="hm-muted">Printable report of diagnosis cases grouped by Nepali month.</p>
            </div>
            <button type="button" class="hm-button hm-button-secondary" onclick="window.print()">Print</button>
          </div>

          <% if (diagnosisSummary && diagnosisSummary.length) { %>
            <div class="hm-summary-grid">
              <% diagnosisSummary.forEach(function(monthSummary) { %>
                <article class="hm-summary-month-card">
                  <div class="hm-summary-month-head">
                    <h3><%= monthSummary.monthLabel %><% if (monthSummary.year) { %> <%= monthSummary.year %><% } %></h3>
                    <span class="hm-summary-total">Total cases: <%= monthSummary.totalCases %></span>
                  </div>
                  <table class="hm-summary-table">
                    <thead>
                      <tr>
                        <th>Diagnosis</th>
                        <th>Cases</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% monthSummary.diagnoses.forEach(function(entry) { %>
                        <tr>
                          <td><%= entry.name %></td>
                          <td><%= entry.count %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </article>
              <% }); %>
            </div>
          <% } else { %>
            <div class="hm-empty">No diagnosis records found yet.</div>
          <% } %>
        </section>

        <header class="hm-bmi-print-heading">
          <h1>Student BMI Report</h1>
          <p><%= totalWithBmi %> students with BMI records</p>
        </header>

        <section class="hm-bmi-grouping-panel" id="bmiGroupingPanel" aria-label="Students grouped by BMI category">
          <% bmiGroups.forEach(function(group, index) { %>
            <article class="hm-card hm-bmi-group-card hm-bmi-<%= group.color %>">
              <div class="hm-card-header hm-bmi-group-header">
                <div>
                  <p class="hm-bmi-group-kicker">BMI Type</p>
                  <h2><%= group.label %></h2>
                </div>
                <span class="hm-bmi-count"><%= group.count %></span>
              </div>

              <div class="hm-bmi-class-groups">
                <% if (group.classGroups.length) { %>
                  <% group.classGroups.forEach(function(classGroup) { %>
                    <section class="hm-bmi-class-group" data-class="<%= classGroup.studentClass %>" data-section="<%= classGroup.section %>">
                      <div class="hm-bmi-class-heading">
                        <h3>Class <%= classGroup.studentClass %> | Section <%= classGroup.section %></h3>
                        <span><%= classGroup.students.length %> students</span>
                      </div>
                      <div class="hm-bmi-table-wrap">
                        <table class="hm-bmi-table">
                          <thead>
                            <tr>
                              <th scope="col">Roll</th>
                              <th scope="col">Student</th>
                              <th scope="col">Contact</th>
                              <th scope="col">BMI</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% classGroup.students.forEach(function(student) { %>
                              <tr>
                                <td><%= student.roll %></td>
                                <td><%= student.name %></td>
                                <td><%= student.contactNumber || 'Not available' %></td>
                                <td><%= student.bmi %></td>
                              </tr>
                            <% }); %>
                          </tbody>
                        </table>
                      </div>
                    </section>
                  <% }); %>
                <% } else { %>
                  <div class="hm-empty hm-bmi-empty">No students in this group.</div>
                <% } %>
              </div>
            </article>
          <% }); %>
        </section>
      </div>
    </div>
  </div>

  <script src="/nurse-healthanalytics.js"></script>
</body>
</html>