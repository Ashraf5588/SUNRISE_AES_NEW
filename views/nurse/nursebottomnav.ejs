		<span>My attendance</span>
	</a>
	<a class="nurse-home-link" href="/healthrecord" data-nurse-nav="/healthrecord">
		<span class="nurse-home-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"></path><path d="M12 10v5M9.5 12.5h5"></path></svg></span>
		<span>Home</span>
	</a>
	<a href="/manualpunch" data-nurse-nav="/manualpunch">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a7 7 0 0 0-7 7v2M12 6a4 4 0 0 0-4 4v3M12 9a1 1 0 0 0-1 1v5a4 4 0 0 0 8 0v-4a7 7 0 0 0-7-8"></path><path d="M8 17a4 4 0 0 0 8 0"></path></svg>
		<span>Manual punch</span>
	</a>
	<a href="/employeeprofile" data-nurse-nav="/employeeprofile">
		<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
		<span>My profile</span>
	</a>
