<style>
	.nurse-bottom-nav { display:none; }
	@media(max-width:768px) {
		body { padding-bottom:calc(82px + env(safe-area-inset-bottom)); }
		.nurse-bottom-nav {
			position:fixed;
			z-index:20;
			right:0;
			bottom:0;
			left:0;
			display:grid;
			grid-template-columns:repeat(5,minmax(0,1fr));
			align-items:end;
			width:min(100%,680px);
			min-height:68px;
			margin:0 auto;
			padding:7px 8px calc(7px + env(safe-area-inset-bottom));
			border-top:1px solid rgba(148,163,184,.28);
			background:rgba(255,255,255,.97);
			box-shadow:0 -8px 26px rgba(15,23,42,.12);
			backdrop-filter:blur(14px);
		}
		.nurse-bottom-nav a {
			display:flex;
			min-width:0;
			min-height:48px;
			flex-direction:column;
			align-items:center;
			justify-content:center;
			gap:4px;
			border-radius:9px;
			color:#71808a;
			font:700 9px/1.1 "Space Grotesk",sans-serif;
			text-align:center;
			text-decoration:none;
			-webkit-tap-highlight-color:transparent;
		}
		.nurse-bottom-nav svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.8; }
		.nurse-bottom-nav a.is-active { color:#087d70; background:#eaf8f5; }
		.nurse-bottom-nav a:focus-visible { outline:2px solid #087d70; outline-offset:2px; }
		.nurse-bottom-nav a:active { color:#075c53; }
		.nurse-bottom-nav a.nurse-home-link { position:relative; gap:2px; color:#087d70; }
		.nurse-bottom-nav .nurse-home-icon {
			display:grid;
			width:54px;
			height:54px;
			margin-top:-29px;
			place-items:center;
			border:4px solid #fff;
			border-radius:50%;
			color:#fff;
			background:linear-gradient(145deg,#11a892,#075c53);
			box-shadow:0 6px 0 rgba(7,92,83,.18),0 12px 20px rgba(8,125,112,.25);
		}
		.nurse-bottom-nav .nurse-home-icon svg { width:23px; height:23px; fill:currentColor; stroke:none; }
		@media(prefers-reduced-motion:no-preference) {
			.nurse-bottom-nav .nurse-home-icon { transition:transform .16s ease,box-shadow .16s ease; }
			.nurse-bottom-nav .nurse-home-link:active .nurse-home-icon { transform:translateY(2px); box-shadow:0 3px 9px rgba(8,125,112,.22); }
		}
	}
	@media print { .nurse-bottom-nav { display:none !important; } }
</style>
<nav class="nurse-bottom-nav" aria-label="Nurse navigation">
