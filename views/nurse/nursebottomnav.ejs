<script>
	(() => {
		const currentPath = window.location.pathname;
		document.querySelectorAll('[data-nurse-nav]').forEach(link => {
			if (link.dataset.nurseNav === currentPath) {
				link.classList.add('is-active');
				link.setAttribute('aria-current', 'page');
			}
		});
	})();
</script>
