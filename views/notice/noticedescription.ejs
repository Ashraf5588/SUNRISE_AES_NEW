<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<% if (notice && isPublicShare) { %>
		<title><%= notice.title %> | United English Boarding School</title>
		<meta name="description" content="<%= notice.description || `Notice published on ${notice.noticeDate}` %>">
		<link rel="canonical" href="<%= shareUrl %>">
		<meta property="og:type" content="article">
		<meta property="og:title" content="<%= notice.title %>">
		<meta property="og:description" content="<%= notice.description || `Notice published on ${notice.noticeDate}` %>">
		<meta property="og:url" content="<%= shareUrl %>">
		<meta property="og:image" content="<%= ogImageUrl %>">
		<meta property="og:site_name" content="United English Boarding School">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="<%= notice.title %>">
		<meta name="twitter:description" content="<%= notice.description || `Notice published on ${notice.noticeDate}` %>">
		<meta name="twitter:image" content="<%= ogImageUrl %>">
	<% } else { %>
		<title><%= notice ? notice.title : 'Notices' %> | eAnalyst</title>
	<% } %>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<style>
		:root { --ink:#172638; --muted:#687b8f; --line:#dce5ee; --blue:#1954a6; --paper:#f3f7fb; --white:#fff; }
		* { box-sizing:border-box; }
		body { margin:0; padding:24px; color:var(--ink); background:linear-gradient(145deg,#edf4fa,#f8fafc 55%,#eef5f5); font-family:'Lexend',sans-serif; }
		a { color:inherit; text-decoration:none; }
		.page { width:min(100%,900px); margin:0 auto; }
		.page-header { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:18px; }
		.eyebrow { margin:0 0 5px; color:var(--blue); font-size:10px; font-weight:800; text-transform:uppercase; }
		h1 { margin:0; font-size:24px; font-weight:800; overflow-wrap:anywhere; }
		.subtitle { margin:6px 0 0; color:var(--muted); font-size:12px; }
		.actions { display:flex; flex-wrap:wrap; gap:8px; }
		.button { display:inline-flex; min-height:38px; align-items:center; justify-content:center; gap:7px; padding:0 12px; border:1px solid #d7e2ee; border-radius:6px; color:#314b67; background:#fff; font-size:11px; font-weight:700; }
		.button.primary { border-color:var(--blue); color:#fff; background:var(--blue); }
		.button.small { min-height:31px; padding:0 8px; font-size:9px; }
		.button.facebook { border-color:#d3e1f2; color:#245c99; background:#f4f8fe; }
		.button.danger { border-color:#efd4d4; color:#9d3030; background:#fff8f8; }
		.action-form { display:inline-flex; margin:0; }
		.action-form button { font-family:inherit; cursor:pointer; }
		.panel { padding:18px; border:1px solid var(--line); border-radius:8px; background:var(--white); box-shadow:0 8px 22px rgba(24,48,72,.045); }
		.message { margin-bottom:14px; padding:10px 12px; border:1px solid #c7e3d3; border-radius:6px; color:#17613e; background:#f0faf4; font-size:12px; }
		.notice-list { display:grid; gap:10px; }
		.notice-card { display:grid; grid-template-columns:70px minmax(0,1fr); align-items:center; gap:13px; padding:12px; border:1px solid #e1e9f1; border-radius:6px; background:#fbfdff; }
		.notice-date { display:grid; min-height:56px; align-content:center; justify-items:center; border-radius:5px; color:#28578e; background:#eaf3ff; font-size:10px; font-weight:800; text-align:center; }
		.notice-copy { min-width:0; }
		.notice-copy h2 { margin:0; color:#1d3f69; font-size:14px; font-weight:800; overflow-wrap:anywhere; }
		.notice-meta { margin:5px 0 0; color:var(--muted); font-size:10px; }
		.notice-excerpt { margin:7px 0 0; color:#465b70; font-size:11px; line-height:1.5; overflow-wrap:anywhere; }
		.notice-actions { grid-column:1/-1; display:flex; flex-wrap:wrap; gap:6px; padding-top:3px; }
		.image-count { display:inline-flex; align-items:center; gap:5px; margin-top:7px; color:#58708a; font-size:10px; }
		.empty { padding:26px 12px; color:var(--muted); text-align:center; font-size:12px; }
		.notice-description { margin:16px 0; color:#34485d; font-size:13px; line-height:1.75; white-space:pre-wrap; overflow-wrap:anywhere; }
		.notice-images { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:9px; margin-top:16px; }
		.notice-images a { display:block; overflow:hidden; border:1px solid var(--line); border-radius:6px; background:#f6f8fa; }
		.notice-images img { display:block; width:100%; max-height:360px; aspect-ratio:4/3; object-fit:cover; }
		.notice-audience { display:flex; flex-wrap:wrap; gap:5px; margin-top:12px; }
		.badge { padding:4px 7px; border-radius:4px; color:#28578e; background:#eaf3ff; font-size:9px; font-weight:700; }
		.private-note { color:var(--muted); font-size:10px; }
		.notice-detail-toolbar { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:12px; }
		.notice-detail-title { margin:0; color:#172638; font-size:26px; font-weight:800; line-height:1.3; overflow-wrap:anywhere; }
		.notice-detail-meta { display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:12px; color:#53687e; font-size:11px; }
		.notice-meta-item { display:inline-flex; align-items:center; gap:7px; }
		.notice-meta-item i { color:#3269ae; font-size:13px; }
		.notice-meta-item strong { color:#263b51; font-weight:800; }
		.notice-detail-panel .notice-description { margin:20px 0 0; color:#111827; font-size:13px; line-height:1.75; white-space:pre-wrap; overflow-wrap:anywhere; }
		.notice-detail-panel .notice-images { margin-top:18px; }
		@media(max-width:600px) { body { padding:14px 10px 90px; } .page-header { flex-direction:column; } .panel { padding:13px; } .notice-detail-panel { padding:16px; } .notice-detail-title { font-size:23px; } .notice-detail-meta { gap:8px 14px; } .notice-card { grid-template-columns:54px minmax(0,1fr); gap:9px; padding:9px; } .notice-date { min-height:48px; font-size:9px; } .notice-actions { gap:5px; } .notice-actions .button { flex:1; } .actions { width:100%; } .actions .button { flex:1; } .notice-detail-toolbar .button { flex:0 1 auto; } }
	</style>
</head>
<body>
	<main class="page">
		<% if (notice) { %>
			<div class="notice-detail-toolbar">
					<% if (!isPublicShare) { %><a class="button" href="/notice"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All notices</a><% } %>
					<% if (isAdmin && !isPublicShare) { %><a class="button" href="/notice/add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add notice</a><% } %>
					<% if (isAdmin && notice && !isPublicShare) { %><a class="button" href="/notice/<%= notice._id %>/edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</a><form class="action-form" method="post" action="/notice/<%= notice._id %>/delete" onsubmit="return confirm('Delete this notice and its images?')"><button class="button danger" type="submit"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete</button></form><% } %>
					<% if (notice.shareToFacebook) { %><a class="button primary" href="<%= facebookShareUrl %>" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook" aria-hidden="true"></i> Share on Facebook</a><% } else if (isAdmin && !isPublicShare) { %><a class="button facebook" href="/notice/<%= notice._id %>/edit?enableFacebook=1"><i class="fa-brands fa-facebook" aria-hidden="true"></i> Enable Facebook sharing</a><% } %>
			</div>
			<% if (message) { %><div class="message" role="status"><%= message %></div><% } %>
			<article class="panel notice-detail-panel">
				<div class="notice-detail-heading">
					<p class="eyebrow"><%= isPublicShare ? 'School notice' : 'Notices / Details' %></p>
					<h1 class="notice-detail-title"><%= notice.title %></h1>
					<div class="notice-detail-meta">
						<span class="notice-meta-item"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i><strong><%= notice.noticeDate %></strong></span>
						<span class="notice-meta-item"><i class="fa-regular fa-user" aria-hidden="true"></i><span>By: <strong><%= notice.addedBy %></strong></span></span>
					</div>
				</div>
				<% if (notice.description) { %><div class="notice-description"><%= notice.description %></div><% } %>
				<% if (notice.images?.length) { %>
					<div class="notice-images"><% notice.images.forEach((image, index) => { %><a href="<%= image.url %>" target="_blank" rel="noopener noreferrer"><img src="<%= image.url %>" alt="<%= notice.title %> image <%= index + 1 %>"></a><% }) %></div>
				<% } %>
				<% if (isAdmin && !isPublicShare) { %>
					<div class="notice-audience"><% if (notice.recipientRoles.includes('ALL')) { %><span class="badge">All roles</span><% } else { notice.recipientRoles.forEach((role) => { %><span class="badge"><%= role %></span><% }); } %></div>
				<% } %>
			</article>
		<% } else { %>
			<header class="page-header">
				<div><p class="eyebrow">School communications</p><h1>Notices</h1><p class="subtitle">Recent notices available to your account.</p></div>
				<div class="actions"><% if (isAdmin) { %><a class="button primary" href="/notice/add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add notice</a><% } %><a class="button" href="/"><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a></div>
			</header>
			<% if (message) { %><div class="message" role="status"><%= message %></div><% } %>
			<section class="panel">
				<% if (notices.length) { %>
					<div class="notice-list">
						<% notices.forEach((item) => { %>
							<article class="notice-card">
								<div class="notice-date"><span><%= item.noticeDate %></span></div>
								<div class="notice-copy"><h2><a href="/notice/<%= item._id %>"><%= item.title %></a></h2><p class="notice-meta">Added by <%= item.addedBy %></p><% if (item.description) { %><p class="notice-excerpt"><%= item.description.slice(0, 220) %><%= item.description.length > 220 ? '…' : '' %></p><% } %><% if (item.images?.length) { %><span class="image-count"><i class="fa-regular fa-image" aria-hidden="true"></i> <%= item.images.length %> image<%= item.images.length === 1 ? '' : 's' %></span><% } %></div>
								<div class="notice-actions">
									<a class="button small" href="/notice/<%= item._id %>"><i class="fa-regular fa-eye" aria-hidden="true"></i> Open</a>
									<% if (item.shareToFacebook) { %><a class="button facebook small" href="<%= item.facebookShareUrl %>" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook" aria-hidden="true"></i> Share</a><% } %>
									<% if (isAdmin) { %>
										<% if (!item.shareToFacebook) { %><a class="button facebook small" href="/notice/<%= item._id %>/edit?enableFacebook=1"><i class="fa-brands fa-facebook" aria-hidden="true"></i> Enable Facebook</a><% } %>
										<a class="button small" href="/notice/<%= item._id %>/edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</a>
										<form class="action-form" method="post" action="/notice/<%= item._id %>/delete" onsubmit="return confirm('Delete this notice and its images?')"><button class="button danger small" type="submit"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete</button></form>
									<% } %>
								</div>
							</article>
						<% }) %>
					</div>
				<% } else { %><div class="empty">No notices yet.</div><% } %>
			</section>
		<% } %>
	</main>
</body>
</html>
