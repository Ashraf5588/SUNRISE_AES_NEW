<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Library Dashboard</title>
  <style>
    :root {
      --bg: #f5f7fb;
      --panel: #ffffff;
      --sidebar: #0f172a;
      --sidebar-soft: #162236;
      --primary: #2563eb;
      --primary-soft: #dbeafe;
      --green: #16a34a;
      --green-soft: #dcfce7;
      --yellow: #f59e0b;
      --yellow-soft: #fef3c7;
      --red: #ef4444;
      --red-soft: #fee2e2;
      --text: #1f2937;
      --muted: #64748b;
      --border: #e5e7eb;
      --shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    a { text-decoration: none; color: inherit; }

    .library-shell {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 260px;
      background: linear-gradient(180deg, var(--sidebar) 0%, var(--sidebar-soft) 100%);
      color: #e5eefb;
      padding: 24px 18px;
      position: sticky;
      top: 0;
      height: 100vh;
    }

    .brand {
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, #60a5fa, #2563eb);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
    }

    .nav-group {
      margin-top: 24px;
    }

    .nav-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: rgba(255,255,255,0.6);
      padding: 0 12px 8px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      margin-bottom: 6px;
      border-radius: 10px;
      color: #dce9ff;
      transition: 0.2s ease;
    }

    .nav-item:hover,
    .nav-item.active {
      background: rgba(255,255,255,0.08);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06);
    }

    .content {
      flex: 1;
      padding: 28px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 24px;
    }

    .title {
      font-size: 30px;
      font-weight: 700;
      margin: 0;
    }

    .title-sub {
      color: var(--muted);
      font-size: 14px;
      margin-top: 4px;
    }

    .action-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 10px;
      padding: 10px 16px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.15s ease;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary { background: var(--primary); color: white; }
    .btn-success { background: var(--green); color: white; }
    .btn-secondary { background: #e2e8f0; color: var(--text); }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: var(--panel);
      border-radius: 16px;
      padding: 18px 18px 16px;
      box-shadow: var(--shadow);
      border: 1px solid rgba(148,163,184,0.12);
    }

    .stat-card .label {
      font-size: 12px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
    }

    .stat-card .value {
      margin-top: 12px;
      font-size: 30px;
      font-weight: 800;
      color: var(--text);
    }

    .stat-card .meta {
      margin-top: 8px;
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--muted);
    }

    .pill {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .pill-blue { background: var(--primary-soft); color: var(--primary); }
    .pill-green { background: var(--green-soft); color: var(--green); }
    .pill-yellow { background: var(--yellow-soft); color: #b45309; }
    .pill-red { background: var(--red-soft); color: var(--red); }

    .charts-grid {
      display: grid;
      grid-template-columns: 1.3fr 0.9fr;
      gap: 18px;
      margin-bottom: 24px;
    }

    .card {
      background: var(--panel);
      border-radius: 18px;
      box-shadow: var(--shadow);
      border: 1px solid rgba(148,163,184,0.12);
      padding: 18px;
    }

    .card h3 {
      margin: 0 0 16px;
      font-size: 18px;
    }

    .category-bars {
      display: grid;
      gap: 14px;
      margin-top: 10px;
    }

    .bar-row {
      display: grid;
      grid-template-columns: 90px 1fr 40px;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--muted);
    }

    .bar-track {
      position: relative;
      height: 12px;
      background: #e5edf8;
      border-radius: 999px;
      overflow: hidden;
    }

    .bar-fill {
      position: absolute;
      inset: 0 auto 0 0;
      border-radius: 999px;
      background: linear-gradient(90deg, #60a5fa, #2563eb);
    }

    .donut-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    .donut {
      width: 150px;
      height: 150px;
      border-radius: 50%;
      background: conic-gradient(
        #2563eb 0 45%,
        #16a34a 45% 72%,
        #f59e0b 72% 100%
      );
      position: relative;
      box-shadow: inset 0 0 14px rgba(15,23,42,0.08);
    }

    .donut::before {
      content: "";
      position: absolute;
      inset: 24px;
      background: white;
      border-radius: 50%;
    }

    .donut-center {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 26px;
      font-weight: 800;
      z-index: 1;
    }

    .legend {
      display: grid;
      gap: 10px;
      font-size: 13px;
      color: var(--muted);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .swatch {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      display: inline-block;
    }

    .table-card {
      margin-top: 8px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 12px;
      overflow: hidden;
    }

    th, td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      font-size: 14px;
    }

    th {
      background: #eef5ff;
      color: var(--text);
      font-weight: 700;
    }

    .status-tag {
      display: inline-flex;
      border-radius: 999px;
      padding: 5px 8px;
      font-size: 11px;
      font-weight: 700;
    }

    .status-issued { background: var(--green-soft); color: var(--green); }
    .status-returned { background: var(--primary-soft); color: var(--primary); }
    .status-overdue { background: var(--red-soft); color: var(--red); }

    @media (max-width: 1100px) {
      .stats-grid { grid-template-columns: repeat(2, minmax(180px, 1fr)); }
      .charts-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 840px) {
      .library-shell { display: block; }
      .sidebar {
        width: 100%;
        height: auto;
        position: static;
      }
      .content { padding: 18px; }
      .stats-grid { grid-template-columns: 1fr; }
      .bar-row { grid-template-columns: 80px 1fr 34px; }
    }
  </style>
</head>
<body>
  <div class="library-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark">L</div>
        <span>Library</span>
      </div>

      <div class="nav-group">
        <div class="nav-label">Overview</div>
        <a class="nav-item active" href="/library/dashboard">Dashboard</a>
        <a class="nav-item" href="/library/books">Books</a>
        <a class="nav-item" href="/library/categories">Categories</a>
        <a class="nav-item" href="/library/members">Members</a>
        <a class="nav-item" href="/library/issues">Book Issue</a>
      </div>
    </aside>

    <main class="content">
      <div class="topbar">
        <div>
          <h1 class="title">Library Dashboard</h1>
          <div class="title-sub">Monitor circulation, inventory, and member activity</div>
        </div>
        <div class="action-row">
          <a class="btn btn-primary" href="/library/books">Add Book</a>
          <a class="btn btn-success" href="/library/issues">Issue Book</a>
          <a class="btn btn-secondary" href="/library/members">Members</a>
        </div>
      </div>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="label">Total Books</div>
          <div class="value"><%= typeof totalBooks !== 'undefined' ? totalBooks : 0 %></div>
          <div class="meta">
            <span>Inventory</span>
            <span class="pill pill-blue"><%= typeof availablePct !== 'undefined' ? availablePct : 0 %>% free</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="label">Issued Books</div>
          <div class="value"><%= typeof issuedBooks !== 'undefined' ? issuedBooks : 0 %></div>
          <div class="meta">
            <span>Currently out</span>
            <span class="pill pill-green"><%= typeof issuedPct !== 'undefined' ? issuedPct : 0 %>%</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="label">Overdue</div>
          <div class="value"><%= typeof overdueBooks !== 'undefined' ? overdueBooks : 0 %></div>
          <div class="meta">
            <span>Need follow-up</span>
            <span class="pill pill-red">Alert</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="label">Returns</div>
          <div class="value"><%= typeof returnedBooks !== 'undefined' ? returnedBooks : 0 %></div>
          <div class="meta">
            <span>Completed</span>
            <span class="pill pill-blue">History</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="label">Total Members</div>
          <div class="value"><%= typeof totalMembers !== 'undefined' ? totalMembers : 0 %></div>
          <div class="meta">
            <span>Registered</span>
            <span class="pill pill-green">Active</span>
          </div>
        </div>
      </section>

      <section class="charts-grid">
        <div class="card">
          <h3>Inventory by Category</h3>
          <% if (categorySummary && categorySummary.length) { %>
            <%
              const maxCategoryCount = categorySummary.reduce((max, item) => Math.max(max, Number(item.count) || 0), 1);
            %>
            <div class="category-bars">
              <% categorySummary.forEach((item) => { %>
                <% const percent = Math.max(10, ((Number(item.count) || 0) / maxCategoryCount) * 100); %>
                <div class="bar-row">
                  <span><%= item.name %></span>
                  <div class="bar-track">
                    <div class="bar-fill" style="width:<%= percent %>%"></div>
                  </div>
                  <strong><%= item.count %></strong>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p>No category data available yet.</p>
          <% } %>
        </div>

        <div class="card">
          <h3>Issue Overview</h3>
          <div class="donut-wrap">
            <div class="donut">
              <div class="donut-center"><%= typeof issuedPct !== 'undefined' ? issuedPct : 0 %>%</div>
            </div>
            <div class="legend">
              <div class="legend-item"><span class="swatch" style="background:#2563eb"></span> Issued <strong><%= typeof issuedBooks !== 'undefined' ? issuedBooks : 0 %></strong></div>
              <div class="legend-item"><span class="swatch" style="background:#16a34a"></span> Returned <strong><%= typeof returnedBooks !== 'undefined' ? returnedBooks : 0 %></strong></div>
              <div class="legend-item"><span class="swatch" style="background:#f59e0b"></span> Overdue <strong><%= typeof overdueBooks !== 'undefined' ? overdueBooks : 0 %></strong></div>
            </div>
          </div>
        </div>
      </section>

      <div class="card table-card">
        <h3>Recent Transactions</h3>
        <table>
          <thead>
            <tr>
              <th>Book</th>
              <th>Member</th>
              <th>Qty</th>
              <th>Status</th>
              <th>Due Date</th>
            </tr>
          </thead>
          <tbody>
            <% if (allIssues && allIssues.length) { %>
              <% allIssues.slice(0, 8).forEach((issue) => { %>
                <tr>
                  <td><%= issue.bookTitle || '—' %></td>
                  <td><%= issue.memberName || '—' %></td>
                  <td><%= issue.quantity || 1 %></td>
                  <td>
                    <% if (issue.status === 'issued') { %>
                      <span class="status-tag status-issued">Issued</span>
                    <% } else if (issue.status === 'returned') { %>
                      <span class="status-tag status-returned">Returned</span>
                    <% } else { %>
                      <span class="status-tag status-overdue">Overdue</span>
                    <% } %>
                  </td>
                  <td><%= issue.dueDate ? new Date(issue.dueDate).toLocaleDateString() : '—' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5">No transactions yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
