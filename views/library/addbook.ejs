<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book Management</title>
  <link href="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/css/nepali.datepicker.v5.0.6.min.css" rel="stylesheet" type="text/css" />
  <style>
    :root {
      --bg: #f5f7fb;
      --panel: #ffffff;
      --sidebar: #0f172a;
      --sidebar-soft: #162236;
      --primary: #2563eb;
      --primary-soft: #dbeafe;
      --green: #16a34a;
      --green-soft: #dcfce7;
      --yellow: #f59e0b;
      --yellow-soft: #fef3c7;
      --red: #ef4444;
      --red-soft: #fee2e2;
      --text: #1f2937;
      --muted: #64748b;
      --border: #e5e7eb;
      --shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, sans-serif; background: var(--bg); color: var(--text); }
    a { text-decoration: none; color: inherit; }
    .library-shell { display: flex; min-height: 100vh; }
    .sidebar { width: 260px; background: linear-gradient(180deg, var(--sidebar) 0%, var(--sidebar-soft) 100%); color: #e5eefb; padding: 24px 18px; position: sticky; top: 0; height: 100vh; }
    .brand { font-size: 22px; font-weight: 700; margin-bottom: 18px; display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 10px; background: rgba(255,255,255,0.04); }
    .brand-mark { width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, #60a5fa, #2563eb); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; }
    .nav-group { margin-top: 24px; }
    .nav-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.6); padding: 0 12px 8px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 11px 12px; margin-bottom: 6px; border-radius: 10px; color: #dce9ff; transition: 0.2s ease; }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.08); }
    .content { flex: 1; padding: 28px; }
    .topbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
    .title { font-size: 30px; font-weight: 700; margin: 0; }
    .action-row { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; justify-content: center; border: none; border-radius: 10px; padding: 10px 16px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08); }
    .btn:hover { transform: translateY(-1px); filter: brightness(0.98); }
    .btn-primary { background: var(--primary); color: white; }
    .btn-success { background: var(--green); color: white; }
    .btn-secondary { background: #e2e8f0; color: var(--text); }
    .action-btns { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .table-action-btn { padding: 8px 12px; font-size: 12px; border-radius: 8px; line-height: 1.2; }
    .grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
    .card { background: var(--panel); border-radius: 18px; box-shadow: var(--shadow); border: 1px solid rgba(148,163,184,0.12); padding: 18px; }
    .card h3 { margin: 0 0 16px; font-size: 18px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(200px,1fr)); gap: 14px; }
    .field { display: flex; flex-direction: column; gap: 8px; }
    .field.full { grid-column: 1 / -1; }
    .field label { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .field input, .field select { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; font-size: 14px; }
    .btn-wrap { margin-top: 18px; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 0 0 18px; flex-wrap: wrap; }
    .search-box { flex: 1; min-width: 260px; position: relative; }
    .search-box input { width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; font-size: 14px; background: #fff; }
    .stock-modal { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.48); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 20px; }
    .stock-modal.show { display: flex; }
    .stock-modal-card { width: min(420px, 100%); background: var(--panel); border-radius: 18px; padding: 22px; box-shadow: var(--shadow); }
    .stock-modal-card h3 { margin: 0 0 14px; }
    .stock-field { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
    .stock-field input { width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px; }
    .stock-actions { display: flex; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }
    .print-modal { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.48); display: none; align-items: center; justify-content: center; z-index: 2100; padding: 20px; }
    .print-modal.show { display: flex; }
    .print-modal-card { width: min(720px, 100%); background: var(--panel); border-radius: 18px; padding: 22px; box-shadow: var(--shadow); max-height: 80vh; overflow: auto; }
    .bulk-print-modal-card { width: min(760px, 100%); }
    .bulk-print-list { max-height: 48vh; overflow: auto; border: 1px solid var(--border); border-radius: 10px; }
    .bulk-print-table { width: 100%; border-collapse: collapse; }
    .bulk-print-table th, .bulk-print-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); text-align: left; }
    .bulk-print-table th { position: sticky; top: 0; background: #eef5ff; z-index: 1; }
    .bulk-print-table tbody tr:nth-child(even) { background: #f8fafc; }
    .bulk-book-check { vertical-align: top; }
    .bulk-book-title { min-width: 150px; font-weight: 700; vertical-align: top; }
    .bulk-code-scroll { max-width: 430px; overflow-x: auto; white-space: nowrap; padding-bottom: 5px; }
    .bulk-code-option { display: inline-flex; align-items: center; gap: 5px; margin-right: 14px; white-space: nowrap; font-weight: 600; }
    .print-options { display: grid; grid-template-columns: repeat(2, minmax(150px, 1fr)); gap: 10px; margin: 14px 0; }
    .print-option-btn { width: 100%; }
    .batch-list { display: grid; gap: 8px; margin: 12px 0; }
    .batch-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px; }
    .code-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; margin-top: 10px; }
    .code-check { display: flex; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; font-size: 12px; background: #f8fafc; }
    .table-action-btn { padding: 8px 12px; font-size: 12px; border-radius: 8px; line-height: 1.2; }
    .table-scroll { width: 100%; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { padding: 12px 14px; border-bottom: 1px solid var(--border); text-align: left; }
    th { background: #eef5ff; }
    tbody tr:nth-child(even) { background: #f8fafc; }
    tbody tr:hover { background: #eff6ff; }
    .code-scroll { max-width: 220px; max-height: 42px; overflow-x: auto; overflow-y: hidden; white-space: nowrap; }
    .code-scroll small { white-space: nowrap; }
    .status-ok { color: var(--green); font-weight: 700; }
    .status-low { color: #b45309; font-weight: 700; }
    .message { margin-top: 12px; padding: 10px 12px; border-radius: 8px; font-size: 14px; }
    .success { background: var(--green-soft); color: #166534; }
    .error { background: var(--red-soft); color: #991b1b; }
    .upload-blocker { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; padding: 20px; background: rgba(15,23,42,.68); z-index: 5000; }
    .upload-blocker.show { display: flex; }
    .upload-progress-card { width: min(460px, 100%); padding: 24px; border-radius: 16px; background: #fff; box-shadow: 0 20px 60px rgba(15,23,42,.28); text-align: center; }
    .upload-progress-card h3 { margin: 0 0 8px; color: #111827; }
    .upload-progress-card p { margin: 0 0 16px; color: #475569; font-size: 13px; }
    .upload-progress-track { height: 12px; overflow: hidden; border-radius: 999px; background: #e2e8f0; }
    .upload-progress-bar { width: 0%; height: 100%; border-radius: inherit; background: var(--primary); transition: width .2s ease; }
    .upload-progress-value { display: block; margin-top: 10px; color: var(--primary); font-size: 13px; font-weight: 700; }
    @media (max-width: 900px) { .library-shell { display: block; } .sidebar { width: 100%; height: auto; position: static; } .content { padding: 18px; } .grid { grid-template-columns: 1fr; } .form-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="library-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark">L</div>
        <span>Library</span>
      </div>
      <div class="nav-group">
        <div class="nav-label">Overview</div>
        <a class="nav-item" href="/library/dashboard">Dashboard</a>
        <a class="nav-item active" href="/library/books">Books</a>
        <a class="nav-item" href="/library/categories">Categories</a>
        <a class="nav-item" href="/library/members">Members</a>
        <a class="nav-item" href="/library/issues">Book Issue</a>
        <a class="nav-item" href="/library/lost-books">Lost Books</a>
        <a class="nav-item" href="/library/analytics">Analytics</a>
        <a class="nav-item" href="/library/inventory">Book Inventory</a>
      </div>
    </aside>

    <main class="content">
      <div class="topbar">
        <div>
          <h1 class="title">Add Book</h1>
        </div>
        <div class="action-row">
          <a class="btn btn-primary" href="/library/dashboard">Dashboard</a>
          <a class="btn btn-secondary" href="/library/issues">Issue Book</a>
        </div>
      </div>

      <div class="toolbar">
        <div class="search-box">
          <input id="bookSearchInput" type="search" placeholder="Search by title, author, category, code..." aria-label="Search books" />
        </div>
        <button type="button" class="btn btn-secondary" id="clearSearchBtn">Clear</button>
      </div>

      <div class="grid">
        <div class="card">
          <h3>Book Details</h3>
          <form action="/library/books" method="POST" id="bookForm">
            <input type="hidden" id="bookId" name="bookId" />
            <div class="form-grid">
              <div class="field">
                <label for="date">Date</label>
                <input type="text" id="date" name="date" class="nepali-datepicker" placeholder="Select Nepali date" value="">
              </div>

              <div class="field full">
                <label for="title">Book Name</label>
                <input type="text" id="title" name="title" required>
              </div>

              <div class="field">
                <label for="author">Author</label>
                <input type="text" id="author" name="author" placeholder="Author name">
              </div>

              <div class="field">
                <label for="category">Category</label>
                <select id="category" name="category" required>
                  <% if (categories && categories.length) { %>
                    <% categories.forEach((category) => { %>
                      <option
                        value="<%= category.name %>"
                        data-color="<%= category.colorHex || '#2563eb' %>"
                        data-color-name="<%= category.colorName || category.name %>"
                        style="background-color:<%= category.colorHex || '#2563eb' %>; color:<%= (category.colorHex && category.colorHex.toLowerCase() === '#080808') ? '#ffffff' : '#111827' %>;"
                      >
                        <%= category.name %> (<%= category.colorName || category.colorHex || 'Default' %>)
                      </option>
                    <% }) %>
                  <% } %>
                </select>
                <div style="display:flex; align-items:center; gap:10px; margin-top:4px;">
                  <span id="categoryColorPreview" style="display:inline-block; width:18px; height:18px; border-radius:6px; border:1px solid var(--border); background:#2563eb;"></span>
                  <span id="categoryColorText" style="font-size:12px; color:var(--muted);">Default</span>
                </div>
              </div>

              <div class="field">
                <label for="edition">Edition</label>
                <input type="text" id="edition" name="edition" placeholder="Optional">
              </div>

              <div class="field">
                <label for="shelvesNo">Shelves No</label>
                <input type="text" id="shelvesNo" name="shelvesNo" placeholder="e.g. A-12 or Shelf 2">
              </div>

              <div class="field">
                <label for="publisherName">Publisher Name</label>
                <input type="text" id="publisherName" name="publisherName" placeholder="Optional">
              </div>

              <div class="field">
                <label for="publishedYear">Published Year</label>
                <input type="text" id="publishedYear" name="publishedYear" placeholder="Optional">
              </div>

              <div class="field">
                <label for="page">Page</label>
                <input type="text" id="page" name="page" placeholder="Optional">
              </div>

              <div class="field">
                <label for="source">Source</label>
                <input type="text" id="source" name="source" placeholder="Optional">
              </div>

              <div class="field">
                <label for="price">Book Cost</label>
                <input type="number" id="price" name="price" min="0" step="0.01" placeholder="0">
              </div>

              <div class="field full">
                <label for="remarks">Remarks</label>
                <input type="text" id="remarks" name="remarks" placeholder="Optional notes">
              </div>

              <div class="field">
                <label for="isbn">ISBN</label>
                <input type="text" id="isbn" name="isbn" placeholder="Optional">
              </div>

              <div class="field">
                <label for="totalQuantity">Total Quantity</label>
                <input type="number" id="totalQuantity" name="totalQuantity" min="1" value="1" required>
              </div>
            </div>

            <div class="field full">
              <label>Generated Copy Codes</label>
              <div id="generatedBookCodes" style="padding:10px 12px; border:1px solid var(--border); border-radius:10px; background:#f8fafc; min-height:48px; font-size:13px; color:var(--muted);">Enter quantity to preview generated book codes.</div>
            </div>

            <div class="btn-wrap" style="display:flex; gap:10px; flex-wrap:wrap;">
              <button type="submit" class="btn btn-primary" id="submitBookBtn">Add Book</button>
              <button type="button" class="btn btn-secondary" id="printBookCodesBtn">Print Sticker Labels</button>
              <button type="button" class="btn btn-secondary" id="downloadBookTemplateBtn">Download CSV Template</button>
              <button type="button" class="btn btn-success" id="uploadBookCsvBtn">Upload CSV</button>
              <input type="file" id="bookCsvInput" accept=".csv,text/csv" hidden>
            </div>
          </form>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="message error"><%= error %></div>
          <% } %>
          <% if (typeof success !== 'undefined' && success) { %>
            <div class="message success"><%= success %></div>
          <% } %>
        </div>

        <div class="card">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
            <h3 style="margin:0;">Book Inventory</h3>
            <button type="button" class="btn btn-primary" id="bulkPrintStickerBtn">Print Sticker</button>
          </div>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Book Code</th>
                  <th>Author</th>
                  <th>Title</th>
                  <th>Category</th>
                  <th>Shelves No</th>
                  <th>Edition</th>
                  <th>Publisher</th>
                  <th>Year</th>
                  <th>Page</th>
                  <th>Source</th>
                  <th>Cost</th>
                  <th>Remarks</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="bookTableBody">
              <% if (books && books.length) { %>
                <% books.forEach((book) => { %>
                  <tr data-book-id="<%= book._id %>" data-search-text="<%= [book.date, (book.bookCodes || []).map((copy) => copy.code).join(' '), book.author, book.title, book.category, book.shelvesNo, book.edition, book.publisherName, book.publishedYear, book.page, book.source, book.price, book.remarks].join(' ') %>">
                    <td><%= book.date || '—' %></td>
                    <td>
                      <div class="code-scroll" title="Scroll to view all book codes">
                        <small><%= (book.bookCodes || []).map((copy) => copy.code).join(', ') || book.bookCodePrefix || '—' %></small>
                      </div>
                    </td>
                    <td><%= book.author || '—' %></td>
                    <td><%= book.title || '—' %></td>
                    <td>
                      <div style="display:flex; align-items:center; gap:8px;">
                        <span style="display:inline-block; width:14px; height:14px; border-radius:4px; border:1px solid rgba(15,23,42,0.15); background:<%= book.categoryDisplayColor || book.categoryColor || '#2563eb' %>;"></span>
                        <span><%= book.category || '—' %></span>
                      </div>
                    </td>
                    <td><%= book.shelvesNo || '—' %></td>
                    <td><%= book.edition || '—' %></td>
                    <td><%= book.publisherName || '—' %></td>
                    <td><%= book.publishedYear || '—' %></td>
                    <td><%= book.page || '—' %></td>
                    <td><%= book.source || '—' %></td>
                    <td><%= Number(book.price || 0) %></td>
                    <td><%= book.remarks || '—' %></td>
                    <td>
                      <div class="action-btns">
                        <button type="button" class="btn btn-secondary table-action-btn edit-book" data-id="<%= book._id %>">Edit</button>
                        <button type="button" class="btn btn-primary table-action-btn add-stock-btn" data-id="<%= book._id %>">Add Stock</button>
                        <button type="button" class="btn btn-success table-action-btn print-book-codes" data-id="<%= book._id %>">Print Sticker</button>
                        <button type="button" class="btn btn-danger table-action-btn delete-book" data-id="<%= book._id %>" style="background:#ef4444; color:#fff;">Delete</button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="12">No books added yet.</td>
                </tr>
              <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div id="stockModal" class="stock-modal" aria-hidden="true">
    <div class="stock-modal-card">
      <h3 id="stockModalTitle">Add New Stock</h3>
      <div class="stock-field">
        <label for="stockQuantityInput">Quantity to add</label>
        <input id="stockQuantityInput" type="number" min="1" value="1" />
      </div>
      <div class="stock-actions">
        <button type="button" class="btn btn-secondary" id="cancelStockBtn">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmStockBtn">Add Stock</button>
      </div>
    </div>
  </div>

  <div id="printModal" class="print-modal" aria-hidden="true">
    <div class="print-modal-card">
      <h3 id="printModalTitle">Print Sticker Options</h3>
      <div class="stock-field">
        <label for="printBatchInput">Stock batch number</label>
        <input id="printBatchInput" type="number" min="1" value="1" placeholder="Enter stock number" />
      </div>
      <div class="print-options">
        <button type="button" class="btn btn-primary print-option-btn" data-print-mode="last">Print Last Stock</button>
        <button type="button" class="btn btn-secondary print-option-btn" data-print-mode="all">Print All Codes</button>
        <button type="button" class="btn btn-success print-option-btn" data-print-mode="batch">Print Batch</button>
        <button type="button" class="btn btn-secondary print-option-btn" data-print-mode="manual">Print Selected</button>
      </div>
      <div id="printBatchList" class="batch-list"></div>
      <div id="printCodeList" class="code-grid"></div>
      <div class="stock-actions" style="margin-top:16px;">
        <button type="button" class="btn btn-secondary" id="closePrintModalBtn">Close</button>
        <button type="button" class="btn btn-primary" id="confirmPrintBtn">Print Selected</button>
      </div>
    </div>
  </div>

  <div id="bulkPrintModal" class="print-modal" aria-hidden="true">
    <div class="print-modal-card bulk-print-modal-card">
      <h3>Print Sticker</h3>
      <p style="margin:0 0 14px; color:var(--muted); font-size:13px;">All books and copy codes are selected by default. Uncheck anything you do not want to print.</p>
      <div class="bulk-print-list">
        <table class="bulk-print-table">
          <thead><tr><th><input type="checkbox" id="bulkPrintAllCheck" checked aria-label="Select all books"></th><th>Book Name</th><th>Book Codes</th></tr></thead>
          <tbody id="bulkPrintList"></tbody>
        </table>
      </div>
      <div class="stock-actions" style="margin-top:16px;">
        <button type="button" class="btn btn-secondary" id="closeBulkPrintBtn">Close</button>
        <button type="button" class="btn btn-primary" id="confirmBulkPrintBtn">Print Checked Stickers</button>
      </div>
    </div>
  </div>

  <div id="uploadBlocker" class="upload-blocker" aria-hidden="true">
    <div class="upload-progress-card">
      <h3 id="uploadProgressTitle">Uploading books</h3>
      <p id="uploadProgressMessage">Please wait. Do not close or leave this page until the import finishes.</p>
      <div class="upload-progress-track"><div id="uploadProgressBar" class="upload-progress-bar"></div></div>
      <span id="uploadProgressValue" class="upload-progress-value">0%</span>
    </div>
  </div>

  <script src="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/js/nepali.datepicker.v5.0.6.min.js" type="text/javascript"></script>
  <script>
    function getTodayNepaliDate() {
      if (typeof NepaliFunctions !== 'undefined' && typeof NepaliFunctions.AD2BS === 'function') {
        try {
          const today = new Date();
          const adDate = today.toISOString().slice(0, 10);
          const bsDate = NepaliFunctions.AD2BS(adDate);
          if (bsDate && String(bsDate).trim() !== 'Invalid Date' && String(bsDate).trim() !== 'Invalid') {
            return String(bsDate).trim();
          }
        } catch (error) {
          console.warn('Nepali date conversion failed:', error);
        }
      }
      return '';
    }

    function normalizeNepaliDateValue(value) {
      if (!value) return '';
      if (typeof value === 'string') return value.trim();
      if (typeof value === 'number') return String(value);
      if (value instanceof Date) return value.toISOString().slice(0, 10);
      if (typeof value === 'object') {
        if (typeof value.bs === 'string' && value.bs.trim()) return value.bs.trim();
        if (typeof value.formatted === 'string' && value.formatted.trim()) return value.formatted.trim();
        const year = value.year ?? value.bsYear ?? value.enYear ?? value.englishYear;
        const month = value.month ?? value.bsMonth ?? value.monthNumber;
        const day = value.day ?? value.bsDay ?? value.date;
        if (year && month && day) {
          return `${String(year)}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        }
        if (value.year && value.month && value.day) {
          return `${String(value.year)}-${String(value.month).padStart(2, '0')}-${String(value.day).padStart(2, '0')}`;
        }
      }
      return String(value);
    }

    const dateInput = document.getElementById('date');
    if (dateInput && typeof dateInput.nepaliDatePicker === 'function') {
