    function collectUniqueNextCodes(prefix, quantity, existingCodes) {
      const used = new Set((existingCodes || []).map((code) => String(code || '').trim().toUpperCase()));
      const generated = [];
      let counter = 1;
      while (generated.length < Number(quantity || 0)) {
        const code = `${prefix}-${String(counter).padStart(3, '0')}`;
        if (!used.has(code.toUpperCase())) {
          generated.push(code);
          used.add(code.toUpperCase());
        }
        counter += 1;
      }
      return generated;
    }

