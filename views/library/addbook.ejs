      if (!file) return;
      if (!confirm(`Import books from ${file.name}? Existing matching titles will receive additional stock.`)) {
        bookCsvInput.value = '';
        return;
      }

      const formData = new FormData();
      formData.append('bookCsv', file);
      beginCsvUpload();
      uploadBookCsvBtn.disabled = true;
      uploadBookCsvBtn.textContent = 'Uploading...';
      const request = new XMLHttpRequest();
      request.open('POST', '/library/books/import-csv');
      request.upload.addEventListener('progress', (event) => {
        if (!event.lengthComputable) return;
        setCsvUploadProgress((event.loaded / event.total) * 90, 'Uploading books', 'Uploading the CSV file...');
      });
      request.addEventListener('load', () => {
        setCsvUploadProgress(95, 'Processing books', 'The file is uploaded. Generating unique book codes and saving records...');
        let result = {};
        try { result = JSON.parse(request.responseText || '{}'); } catch (error) { result = {}; }
        const details = result.errors?.length ? `\n\nSkipped rows:\n${result.errors.join('\n')}` : '';
        alert((result.message || 'CSV import finished.') + details);
        if (request.status >= 200 && request.status < 300) {
          setCsvUploadProgress(100, 'Import complete', 'Books and unique codes were saved successfully.');
          window.location.reload();
        } else {
          finishCsvUpload();
        }
      });
      request.addEventListener('error', () => {
        alert('CSV upload failed. Please check the file and try again.');
        finishCsvUpload();
      });
      request.addEventListener('abort', () => {
        alert('CSV upload was cancelled.');
        finishCsvUpload();
      });
      request.send(formData);
      const resetUploadControls = () => {
        uploadBookCsvBtn.disabled = false;
        uploadBookCsvBtn.textContent = 'Upload CSV';
        bookCsvInput.value = '';
      };
      request.addEventListener('loadend', resetUploadControls, { once: true });
