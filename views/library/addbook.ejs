        const stockBatches = Array.isArray(book.stockBatches) && book.stockBatches.length ? book.stockBatches : [{ batchNumber: 1, quantity: (book.bookCodes || []).length, codes: (book.bookCodes || []).map((copy) => copy.code || copy) }];

        if (mode === 'last') {
          const lastBatch = stockBatches[stockBatches.length - 1];
          const selected = lastBatch?.codes || [];
          printBatchInput.value = String(lastBatch?.batchNumber || stockBatches.length || 1);
          printCodeList.innerHTML = selected.map((code) => `
            <label class="code-check">
              <input type="checkbox" value="${code}" checked />
              <span>${code}</span>
            </label>
          `).join('');
          return;
        }

        if (mode === 'all') {
          const selected = stockBatches.flatMap((batch) => batch.codes || []);
          printCodeList.innerHTML = selected.map((code) => `
            <label class="code-check">
              <input type="checkbox" value="${code}" checked />
              <span>${code}</span>
            </label>
          `).join('');
          return;
        }

        if (mode === 'batch') {
          const batchNumber = Number(printBatchInput.value || 1);
          const match = stockBatches.find((batch) => Number(batch.batchNumber) === batchNumber) || stockBatches[0];
          const selected = match?.codes || [];
          printCodeList.innerHTML = selected.map((code) => `
            <label class="code-check">
              <input type="checkbox" value="${code}" checked />
              <span>${code}</span>
            </label>
          `).join('');
          return;
        }

        if (mode === 'manual') {
          const allCodes = stockBatches.flatMap((batch) => batch.codes || []);
          printCodeList.innerHTML = allCodes.map((code) => `
            <label class="code-check">
              <input type="checkbox" value="${code}" />
              <span>${code}</span>
            </label>
          `).join('');
        }
      });
    });

    confirmPrintBtn.addEventListener('click', () => {
      if (!activePrintBook) return;

      const selectedCodes = getSelectedPrintCodesFromModal();
      if (!selectedCodes.length) {
        alert('Please select at least one code to print.');
        return;
      }

      printStickerSheet({
        title: activePrintBook.title || 'Book',
        author: activePrintBook.author,
        category: activePrintBook.category,
        categoryColorName: activePrintBook.categoryColorName || activePrintBook.categoryColor || '',
        categoryColor: activePrintBook.categoryColor,
        shelvesNo: activePrintBook.shelvesNo,
        publisherName: activePrintBook.publisherName,
        publishedYear: activePrintBook.publishedYear,
        edition: activePrintBook.edition,
        price: activePrintBook.price,
        date: activePrintBook.date,
      }, selectedCodes);
      closePrintModal();
    });

    closePrintModalBtn.addEventListener('click', closePrintModal);
    printModal.addEventListener('click', (event) => {
      if (event.target === printModal) closePrintModal();
    });
    bulkPrintModal.addEventListener('click', (event) => {
      if (event.target === bulkPrintModal) closeBulkPrintModal();
    });

    document.querySelectorAll('.add-stock-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.dataset.id;
        const response = await fetch(`/library/books/${id}`);
        const book = await response.json();
        if (!book || !book._id) {
          alert('Book not found.');
          return;
        }
        openStockModal(book);
      });
    });

    confirmStockBtn.addEventListener('click', async () => {
      if (!activeStockBook) return;

      const quantity = Number(stockQuantityInput.value || 0);
      if (!Number.isFinite(quantity) || quantity <= 0) {
        alert('Please enter a valid quantity greater than zero.');
        return;
      }

      const excludedCodes = (activeStockBook.bookCodes || []).map((copy) => copy.code || copy).filter(Boolean);
      const prefix = String(activeStockBook.bookCodePrefix || buildPrefix(activeStockBook.title, activeStockBook.author, activeStockBook.publisherName)).trim();
      newStockCodes = collectUniqueNextCodes(prefix, quantity, excludedCodes);

      const response = await fetch(`/library/books/${activeStockBook._id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: activeStockBook.title,
          author: activeStockBook.author,
          isbn: activeStockBook.isbn,
          category: activeStockBook.category,
          publisherName: activeStockBook.publisherName,
          publishedYear: activeStockBook.publishedYear,
          price: activeStockBook.price,
          totalQuantity: Number(activeStockBook.totalQuantity || 0) + quantity
        })
      });

      const result = await response.json();
      if (!response.ok) {
        alert(result.message || 'Failed to add stock.');
        closeStockModal();
        return;
      }

      const continuePrint = confirm(`${quantity} new stock code(s) generated. Do you want to print the newly added sticker labels now?`);
      closeStockModal();
      if (continuePrint) {
        printStickerSheet({
          title: activeStockBook.title || 'Book',
          author: activeStockBook.author,
          category: activeStockBook.category,
          categoryColorName: activeStockBook.categoryColorName || activeStockBook.categoryColor || '',
          categoryColor: activeStockBook.categoryColor,
          shelvesNo: activeStockBook.shelvesNo,
          publisherName: activeStockBook.publisherName,
          publishedYear: activeStockBook.publishedYear,
          edition: activeStockBook.edition,
          page: activeStockBook.page,
          source: activeStockBook.source,
          price: activeStockBook.price,
          remarks: activeStockBook.remarks,
          date: activeStockBook.date,
          isbn: activeStockBook.isbn,
        }, newStockCodes);
      }
      window.location.reload();
    });

    cancelStockBtn.addEventListener('click', closeStockModal);
    stockModal.addEventListener('click', (event) => {
      if (event.target === stockModal) closeStockModal();
    });

    bookSearchInput.addEventListener('input', filterBookRows);
    clearSearchBtn.addEventListener('click', () => {
      bookSearchInput.value = '';
      filterBookRows();
      bookSearchInput.focus();
    });

    bookForm.addEventListener('submit', async function (event) {
      event.preventDefault();

      const method = bookIdField.value ? 'PUT' : 'POST';
      const url = bookIdField.value ? `/library/books/${bookIdField.value}` : '/library/books';
      const payload = {
        title: titleInput.value,
        author: authorInput.value,
        isbn: document.getElementById('isbn').value,
        category: categoryInput.value,
        categoryColor: categoryColorText.textContent || '#2563eb',
        publisherName: publisherInput.value,
        publishedYear: document.getElementById('publishedYear').value,
        shelvesNo: document.getElementById('shelvesNo').value,
        date: document.getElementById('date').value,
        edition: document.getElementById('edition').value,
        page: document.getElementById('page').value,
        source: document.getElementById('source').value,
        remarks: document.getElementById('remarks').value,
        price: document.getElementById('price').value,
        totalQuantity: quantityInput.value
      };

      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await response.json();
      alert(result.message || 'Book saved successfully.');
      if (response.ok) {
        window.location.reload();
      }
    });

    document.querySelectorAll('.edit-book').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.dataset.id;
        const response = await fetch(`/library/books/${id}`);
        const book = await response.json();

        if (!book || !book._id) {
          alert('Book not found.');
          return;
        }

        bookIdField.value = book._id;
        titleInput.value = book.title || '';
        authorInput.value = book.author || '';
        document.getElementById('isbn').value = book.isbn || '';
        categoryInput.value = book.category || '';
        syncCategoryColorDisplay();
        publisherInput.value = book.publisherName || '';
        document.getElementById('publishedYear').value = book.publishedYear || '';
        document.getElementById('shelvesNo').value = book.shelvesNo || '';
        document.getElementById('date').value = book.date || '';
        document.getElementById('edition').value = book.edition || '';
        document.getElementById('page').value = book.page || '';
        document.getElementById('source').value = book.source || '';
        document.getElementById('remarks').value = book.remarks || '';
        document.getElementById('price').value = book.price || 0;
        quantityInput.value = book.totalQuantity || 1;
        submitBookBtn.textContent = 'Update Book';
        generateCodes();
        titleInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    document.querySelectorAll('.delete-book').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.dataset.id;
        const confirmDelete = confirm('Delete this book permanently?');
        if (!confirmDelete) return;

        const response = await fetch(`/library/books/${id}`, { method: 'DELETE' });
        const result = await response.json();
        alert(result.message || 'Book deleted.');
        if (response.ok) window.location.reload();
      });
    });
  </script>
</body>
</html>