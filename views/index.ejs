<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>eAnalyst</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/nav.css">
    <link rel="stylesheet" href="/subject-selector.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Agbalumo&family=Alexandria:wght@100..900&family=Lexend:wght@100..900&family=Manrope:wght@200..800&display=swap" rel="stylesheet">
    <!-- Add Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Add custom styles -->
      <script src="https://unpkg.com/mammoth/mammoth.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Agbalumo&family=Alexandria:wght@100..900&family=Lexend:wght@100..900&family=Manrope:wght@200..800&display=swap');
          :root {
            --primary: #1954a6;  /* skyblue */
            --primary-dark: #0e2c5c;  /* darker skyblue */
            --secondary: #f0841f;  /* brown */
            --secondary-dark: #9d4a06;  /* darker brown */
            --light: #f8fafc;
            --dark: #1e293b;
            --accent: #e08d19;  /* amber brown for accent */
            --gray: #db8025;
            --surface: rgba(255, 255, 255, 0.88);
            --surface-strong: #ffffff;
            --ring: rgba(25, 84, 166, 0.12);
            --tile-border: rgba(148, 163, 184, 0.18);
        }
        
        body {
            background:
                radial-gradient(circle at top left, rgba(25, 84, 166, 0.12), transparent 28%),
                radial-gradient(circle at top right, rgba(240, 132, 31, 0.14), transparent 24%),
                linear-gradient(180deg, #f6f8fc 0%, #eef3f9 100%);
            font-family: 'Lexend', sans-serif;
            color: var(--dark);
        }
        
        /* Subject selector styles */
        .subject-selector-container {
            background: var(--surface-strong);
            border-radius: 18px;
            padding: 1.75rem;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
            border: 1px solid rgba(148, 163, 184, 0.22);
            transition: all 0.3s ease;
        }
        
        .subject-selector-container:hover {
            box-shadow: 0 22px 48px rgba(15, 23, 42, 0.12);
        }
        
        #subjectSelector {
            font-size: 1rem;
            padding: 0.75rem;
            border: 1px solid #d7e0ea;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        #subjectSelector:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--ring);
        }
        
        #enterDataBtn, #viewReportBtn {
            transition: all 0.3s ease;
            font-weight: 600;
        }
        
        #enterDataBtn:hover, #viewReportBtn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
        }
        
          header {
            padding-bottom: 1rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 80%);
            margin-bottom: 2rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
        }
        
        .hero-section {
            padding: 2rem 1rem;
            color: white;
            text-align: center;
        }
        
        #firstheading {
            font-size: 3rem;
            font-weight: 700;
            margin-top: 0;
            color: white;
        }
        
        #firstspan {
            color: var(--accent);
            font-weight: 800;
        }
        
        .subheading {
            color: rgba(255, 255, 255, 0.85);
            font-size: 1.2rem;
            display: block;
            margin-top: 0.5rem;
        }
        .action-section {
            background: var(--surface);
            backdrop-filter: blur(14px);
            border-radius: 24px;
            padding: 1.5rem;
            margin: 2rem auto;
            max-width: 1200px;
            box-shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
            border: 1px solid rgba(148, 163, 184, 0.22);
        }

        .quick-groups {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.25rem;
            margin-bottom: 1.5rem;
            align-items: start;
        }

        .quick-groups > .quick-group {
            min-width: 0;
        }

        .quick-group {
            background: rgba(255, 255, 255, 0.94);
            border: 1px solid rgba(148, 163, 184, 0.24);
            border-radius: 20px;
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.09);
            padding: 1.1rem;
            position: relative;
            overflow: hidden;
            height: fit-content;
        }

        .quick-group-academic { grid-area: academic; }
        .quick-group-analysis { grid-area: analysis; }
        .quick-group-more { grid-area: more; }
        .quick-group-admin { grid-area: admin; }

        .quick-group::before {
            content: '';
            position: absolute;
            inset: 0 0 auto;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }

        .group-title {
            margin: 0 0 0.9rem;
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--dark);
            text-align: left;
            letter-spacing: -0.01em;
        }
        
        .section-title {
            color: var(--dark);
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid #e2e8f0;
            position: relative;
        }
          .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -2px;
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
        }
        
        .action-buttons {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.65rem;
            margin-bottom: 0;
        }

        .action-buttons.answeranalysis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .action-buttons.academic {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .action-buttons.more {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        
        .action-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1rem 0.75rem;
            border-radius: 18px;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s ease;
            color: var(--dark) !important;
            gap: 0.6rem;
            min-width: 0;
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: #f8fafc;
            min-height: 110px;
        }

        .action-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.12);
        }

        .icon-wrapper {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.18);
            box-shadow: 0 8px 16px rgba(15, 23, 42, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.2);
            flex-shrink: 0;
        }

        .card-blue { background: #eff6ff; border-color: #bfdbfe; }
        .card-orange, .card-oranges { background: #fff7ed; border-color: #fed7aa; }
        .card-green, .card-emerald { background: #ecfdf5; border-color: #a7f3d0; }
        .card-yellow { background: #fffbeb; border-color: #fde68a; }
        .card-skyblue { background: #f0f9ff; border-color: #bae6fd; }
        .card-violet { background: #eef2ff; border-color: #c7d2fe; }
        .card-darkgreen { background: #f0fdf4; border-color: #bbf7d0; }
        .card-slate { background: #f1f5f9; border-color: #cbd5e1; }
        .card-rose { background: #fff1f2; border-color: #fecdd3; }
        .card-lightgreen { background: #bbf7d0; border-color: #a3ffbf; }

        .card-blue .icon-wrapper { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: #fff; }
        .card-orange .icon-wrapper { background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-dark) 100%); color: #fff; }
        .card-green .icon-wrapper { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; }
        .card-yellow .icon-wrapper { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff; }
        .card-skyblue .icon-wrapper { background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%); color: #fff; }
        .card-oranges .icon-wrapper { background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); color: #fff; }
        .card-violet .icon-wrapper { background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%); color: #fff; }
        .card-darkgreen .icon-wrapper { background: linear-gradient(135deg, #1d6c03 0%, #053c2b 100%); color: #fff; }
        .card-emerald .icon-wrapper { background: linear-gradient(135deg, #14b8a6 0%, #0f766e 100%); color: #fff; }
        .card-slate .icon-wrapper { background: linear-gradient(135deg, #475569 0%, #1e293b 100%); color: #fff; }
        .card-rose .icon-wrapper { background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%); color: #fff; }

        .text-wrapper {
            width: 100%;
            text-align: center;
            line-height: 1.25;
            overflow-wrap: anywhere;
            word-break: break-word;
            font-size: 0.82rem;
        }
        
        .subject-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }
        
        .subject-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        
        .subject-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
          .subject-header {
            padding: 1.25rem;
            background: linear-gradient(45deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            position: relative;
            overflow: hidden;
        }
        
        .subject-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.1);
            transform: rotate(45deg);
        }
        
        .subject-icon {
            background-color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        
        .subject-name {
            font-size: 1.25rem;
            font-weight: 600;
            margin: 0;
        }
        
        .subject-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-grow: 1;
            justify-content: center;
        }
        
        .subject-action {
            margin-top: auto;
            padding: 0.75rem 1.25rem;
            text-align: center;
            border-top: 1px solid #e2e8f0;
        }
          .subject-btn {
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 0.5rem 0.75rem;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.3s ease;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .subject-btn:hover {
            background: var(--primary-dark);
            color: white;
            text-decoration: none;
        }
          .btn-enter {
            background: var(--primary);
        }
        
        .btn-report {
            background: var(--secondary);
        }
        
        .btn-enter:hover {
            background: var(--primary-dark);
        }
        
        .btn-report:hover {
            background: var(--secondary-dark);
        }
          footer {
            background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-dark) 100%);
            color: white;
            padding: 1rem 0;
            margin-top: 3rem;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
        }
        
        .footer-content {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
        }
        
        @media (max-width: 768px) {
            body {
                padding: 0.5rem;
            }

            #firstheading {
                font-size: 2rem;
            }
            
            .subject-grid {
                grid-template-columns: 1fr;
            }
            
            .action-buttons {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.6rem;
            }

            .action-card {
                min-height: 104px;
                text-align: center;
                padding: 0.85rem 0.5rem;
                border-radius: 16px;
            }

            .action-card .icon-wrapper {
                width: 42px;
                height: 42px;
                font-size: 1rem;
                border-radius: 14px;
                margin: 0;
            }

            .action-card .text-wrapper {
                font-size: 0.72rem;
                line-height: 1.25;
                font-weight: 700;
                color: var(--dark);
                text-align: center;
                min-height: 1.8em;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .quick-groups {
                display: block;
            }

            .quick-group {
                width: 100%;
                padding: 0.9rem;
                margin-bottom: 1rem;
                border-radius: 16px;
                height: auto;
            }

            .action-section {
                padding: 1rem;
                margin: 0.75rem auto;
                border-radius: 18px;
            }
            
            .section-title {
                font-size: 1.3rem;
                margin-bottom: 1rem;
                padding-bottom: 0.5rem;
            }
            
            .section-title::after {
                width: 60px;
            }
            
            .hero-section {
                padding: 1.5rem 1rem;
            }
            
            .subheading {
                font-size: 1rem;
                padding: 0 1rem;
            }
        }
        
        /* Extra small devices (phones, 576px and down) */
        @media (max-width: 576px) {
            #firstheading {
                font-size: 1.8rem;
            }
            
            .footer-content p {
                font-size: 0.8rem;
                text-align: center;
                line-height: 1.4;
            }
            
            .container {
                padding-left: 0.75rem;
                padding-right: 0.75rem;
            }
        }

        @media (min-width: 769px) {
            .action-buttons.answeranalysis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
            .action-buttons.academic { grid-template-columns: repeat(4, minmax(0, 1fr)); }
            .action-buttons.more { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }

        @media (min-width: 769px) {
            .quick-groups {
                grid-template-columns: minmax(0, 1fr) minmax(280px, 0.86fr);
                grid-template-areas:
                    "academic more"
                    "analysis more"
                    "admin more";
                align-items: start;
            }
        }

        @media (min-width: 769px) and (max-width: 991px) {
            .quick-groups {
                grid-template-columns: minmax(0, 1fr) minmax(230px, 0.8fr);
            }
        }

        @media (max-width: 768px) {
            .quick-groups {
                grid-template-columns: 1fr;
                grid-template-areas: none;
            }

            .quick-group-academic,
            .quick-group-analysis,
            .quick-group-more,
            .quick-group-admin {
                grid-area: auto;
            }
        }

        @media (max-width: 420px) {
            .quick-group {
                padding: 0.85rem;
            }

            .action-buttons {
                grid-template-columns: repeat(1, minmax(0, 1fr));
                gap: 0.6rem;
            }

            .action-card {
                min-height: 96px;
                padding: 0.7rem 0.4rem;
                border-radius: 14px;
            }

            .action-card .icon-wrapper {
                width: 38px;
                height: 38px;
            }

            .action-card .text-wrapper {
                font-size: 0.68rem;
            }
        }

        .mobile-dashboard { display: none; }

        @media (max-width: 768px) {
            body {
                padding: 0 0 calc(82px + env(safe-area-inset-bottom));
                background: #f2f5f1;
            }

            body > header,
            #side-nav,
            #sidebarToggle,
            .mobile-nav-toggle,
            body > .container,
            body > footer { display: none !important; }

            .mobile-dashboard {
                display: grid;
                gap: 12px;
                width: min(100%, 640px);
                margin: 0 auto;
                padding: 16px 16px 24px;
                color: #1d2925;
                font-family: 'Lexend', sans-serif;
            }

            .mobile-dashboard [hidden] { display: none !important; }

            .mobile-welcome {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                min-width: 0;
                margin: 0;
                padding: 0;
                border: 0;
                border-radius: 0;
                background: transparent;
                box-shadow: none;
            }

            .mobile-user-avatar {
                display: grid;
                width: 52px;
                height: 52px;
                flex: 0 0 52px;
                place-items: center;
                border: 2px solid #fff;
                border-radius: 50%;
                background: #1954a6;
                box-shadow: 0 3px 12px rgba(25, 84, 166, .2);
                color: #fff;
                font-size: 17px;
                font-weight: 800;
            }

            .mobile-welcome-copy { min-width: 0; flex: 1; text-align: left; }
            .mobile-logout-button {
                display: grid;
                width: 40px;
                height: 40px;
                flex: 0 0 40px;
                place-items: center;
                border: 1px solid #d5e2f2;
                border-radius: 9px;
                background: #fff;
                color: #3269ae;
                font-size: 16px;
                text-decoration: none;
                -webkit-tap-highlight-color: transparent;
            }
            .mobile-logout-button:focus-visible { outline: 2px solid #3269ae; outline-offset: 2px; }
            .mobile-welcome-kicker { display: block; color: #78857f; font-size: 9px; font-weight: 800; }
            .mobile-welcome h1 { margin: 2px 0 5px; font-size: 15px; font-weight: 500; line-height: 1.25; }
            .mobile-welcome h1 strong { color: #14231e; font-size: 19px; font-weight: 800; overflow-wrap: anywhere; }

            .mobile-role {
                display: inline-flex;
                align-items: center;
                min-height: 19px;
                padding: 2px 8px;
                border: 1px solid #d8e6de;
                border-radius: 999px;
                background: #e8f2ec;
                color: #272860;
                font-size: 9px;
                font-weight: 700;
            }

            .mobile-ad-card {
                position: relative;
                display: flex;
                min-height: 106px;
                align-items: center;
                justify-content: space-between;
                overflow: hidden;
                padding: 18px;
                border: 1px solid rgba(255, 255, 255, .12);
                border-radius: 8px;
                background: repeating-linear-gradient(135deg, transparent 0 18px, rgba(255,255,255,.035) 18px 19px), linear-gradient(115deg, #132da1 0%, #0846aa 58%, #b85c36 150%);
                color: #fff;
            }

            .mobile-ad-copy { position: relative; z-index: 1; max-width: 75%; }
            .mobile-ad-label { margin: 0 0 9px; color: #c4e4d7; font-size: 9px; font-weight: 800; }
            .mobile-ad-card h2 { margin: 0 0 5px; color: #fff; font-size: 19px; font-weight: 800; }
            .mobile-ad-card p:last-child { margin: 0; color: rgba(255,255,255,.78); font-size: 10px; }
            .mobile-ad-mark { display: grid; width: 44px; height: 34px; place-items: center; border: 1px solid rgba(255,255,255,.48); border-radius: 5px; color: rgba(255,255,255,.9); font-size: 11px; font-weight: 800; letter-spacing: 1px; }

            .mobile-search-wrap { position: relative; }
            .mobile-search-icon { position: absolute; top: 50%; left: 15px; transform: translateY(-50%); color: #718078; font-size: 14px; }
            .mobile-search {
                width: 100%;
                height: 46px;
                padding: 0 14px 0 42px;
                border: 1px solid #dce4de;
                border-radius: 8px;
                outline: none;
                background: #fff;
                color: #1d2925;
                font: 500 12px 'Lexend', sans-serif;
                box-shadow: 0 2px 8px rgba(33, 50, 41, .035);
            }
            .mobile-search:focus { border-color: #39836b; box-shadow: 0 0 0 3px rgba(57, 131, 107, .12); }

            .mobile-section-heading { margin: 0 0 10px; color: #25342e; font-size: 13px; font-weight: 800; }

            .mobile-app-grid,
            .mobile-module-grid {
                display: grid;
                grid-template-columns: repeat(5, minmax(0, 1fr));
                gap: 6px;
            }

            .mobile-app-tile {
                display: flex;
                min-width: 0;
                min-height: 75px;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 5px;
                padding: 7px 3px;
                border: 1px solid #e4e9e5;
                border-radius: 8px;
                background: #fff;
                color: #293730;
                text-align: center;
                text-decoration: none;
                -webkit-tap-highlight-color: transparent;
            }

            .mobile-app-icon {
                display: grid;
                width: 32px;
                height: 32px;
                flex: 0 0 32px;
                place-items: center;
                border-radius: 8px;
                color: #fff;
                font-size: 16px;
            }

            .mobile-app-tile:nth-child(5n + 1) .mobile-app-icon { background: #24745c; }
            .mobile-app-tile:nth-child(5n + 2) .mobile-app-icon { background: #d56842; }
            .mobile-app-tile:nth-child(5n + 3) .mobile-app-icon { background: #3566a0; }
            .mobile-app-tile:nth-child(5n + 4) .mobile-app-icon { background: #bd8a2b; }
            .mobile-app-tile:nth-child(5n) .mobile-app-icon { background: #397f83; }

            .mobile-app-name {
                display: -webkit-box;
                width: 100%;
                overflow: hidden;
                color: inherit;
                font-size: 9px;
                font-weight: 700;
                line-height: 1.2;
                overflow-wrap: anywhere;
                -webkit-box-orient: vertical;
                line-clamp: 3;
                -webkit-line-clamp: 3;
            }

            .mobile-module-panel {
                padding: 10px 8px 8px;
                border: 1px solid #d5e2f2;
                border-radius: 8px;
                background: rgba(244,248,255,.9);
            }

            .mobile-module-slider {
                overflow-x: auto;
                overflow-y: hidden;
                overscroll-behavior-x: contain;
                scrollbar-width: none;
                scroll-snap-type: x mandatory;
                touch-action: pan-x pan-y;
            }
            .mobile-module-slider::-webkit-scrollbar { display: none; }
            .mobile-module-track { display: flex; align-items: stretch; }
            .mobile-module-slide { flex: 0 0 100%; min-width: 100%; scroll-snap-align: start; scroll-snap-stop: always; }
            .mobile-module-grid { gap: 4px 2px; }
            .mobile-slider-dots { display: flex; min-height: 20px; align-items: center; justify-content: center; gap: 8px; padding-top: 5px; }
            .mobile-slider-dot { width: 8px; height: 8px; flex: 0 0 8px; padding: 0; border: 0; border-radius: 50%; background: #b4c9e4; }
            .mobile-slider-dot[aria-selected="true"] { background: #3269ae; transform: scale(1.25); }
            .mobile-slider-dot:focus-visible { outline: 2px solid #3269ae; outline-offset: 3px; }
            .mobile-slider-dot[hidden] { display: none; }
            .mobile-module-link {
                display: flex;
                min-width: 0;
                min-height: 60px;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 4px;
                padding: 6px 2px;
                border: 1px solid transparent;
                border-radius: 7px;
                color: #30445f;
                text-align: center;
                text-decoration: none;
                -webkit-tap-highlight-color: transparent;
            }
            .mobile-module-link:active { border-color: #c5d9f3; background: #edf4ff; }
            .mobile-module-link i { color: #3269ae; font-size: 20px; }
            .mobile-module-link span { font-size: 9px; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }

            .mobile-no-results { margin: 10px 0 0; color: #718078; font-size: 11px; }

            .mobile-notice-list {
                display: grid;
                align-content: start;
                max-height: 230px;
                min-height: 64px;
                gap: 8px;
                overflow-y: auto;
                overscroll-behavior: contain;
                padding: 8px 8px 10px;
                scrollbar-color: #a8b9ae transparent;
                scrollbar-width: thin;
            }
            .mobile-notice-card {
                display: grid;
                grid-template-columns: 38px minmax(0, 1fr) 13px;
                align-items: center;
                gap: 10px;
                min-width: 0;
                min-height: 70px;
                padding: 10px 11px;
                border: 1px solid rgba(125, 151, 182, .18);
                border-radius: 13px;
                background: linear-gradient(135deg, #fff 0%, #f7faff 100%);
                box-shadow: 0 8px 18px rgba(41, 65, 91, .12), 0 2px 5px rgba(41, 65, 91, .06);
                transform: translateY(-1px);
                color: #253b57;
                text-decoration: none;
                -webkit-tap-highlight-color: transparent;
            }
            .mobile-notice-card:active { background: #edf4ff; transform: translateY(1px); }
            .mobile-notice-card-latest {
                position: relative;
                z-index: 1;
                min-height: 76px;
                border-color: rgba(85, 127, 177, .3);
                box-shadow: 0 11px 22px rgba(35, 64, 99, .17), 0 4px 8px rgba(35, 64, 99, .09);
                transform: translateY(-2px) scale(1.015);
            }
            .mobile-notice-card-latest .mobile-notice-heading strong { font-size: 12.5px; }
            .mobile-notice-calendar { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid #dce8f7; border-radius: 11px; background: #edf4ff; color: #3269ae; font-size: 16px; }
            .mobile-notice-content { display: block; min-width: 0; }
            .mobile-notice-heading { display: flex; min-width: 0; align-items: center; gap: 6px; }
            .mobile-notice-heading strong { min-width: 0; overflow: hidden; color: #1e3550; font-size: 12px; font-weight: 800; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
            .mobile-notice-new { flex: 0 0 auto; padding: 2px 5px; border: 1px solid #f1c8cc; border-radius: 4px; color: #b42332; background: #fff0f1; font-size: 7px; font-weight: 800; line-height: 1.2; }
            .mobile-notice-description { display: block; overflow: hidden; margin-top: 3px; color: #64778c; font-size: 9px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
            .mobile-notice-meta { display: block; overflow: hidden; margin-top: 3px; color: #8695a5; font-size: 8px; text-overflow: ellipsis; white-space: nowrap; }
            .mobile-notice-arrow { color: #91a3b7; font-size: 12px; }
            .mobile-notices-all { display: flex; min-height: 34px; align-items: center; justify-content: center; gap: 7px; color: #3269ae; font-size: 10px; font-weight: 800; text-decoration: none; }
            .mobile-notice-empty { display: grid; min-height: 56px; margin: 0; place-items: center; color: #78857e; font-size: 11px; }

            .mobile-subject-dialog {
                width: min(calc(100% - 32px), 380px);
                padding: 20px;
                border: 1px solid #dfe6e0;
                border-radius: 10px;
                color: #1d2925;
                box-shadow: 0 20px 60px rgba(15, 30, 22, .24);
            }
            .mobile-subject-dialog::backdrop { background: rgba(18, 31, 24, .48); }
            .mobile-subject-dialog h2 { margin: 0 0 16px; font-size: 18px; font-weight: 800; }
            .mobile-subject-dialog label { display: block; margin-bottom: 6px; font-size: 11px; font-weight: 700; }
            .mobile-subject-dialog select { width: 100%; min-height: 44px; padding: 8px; border: 1px solid #cfdad2; border-radius: 7px; background: #fff; font: 12px 'Lexend', sans-serif; }
            .mobile-dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
            .mobile-dialog-actions button { min-height: 40px; padding: 0 13px; border: 1px solid #ccd8d0; border-radius: 7px; background: #fff; color: #31433a; font: 700 11px 'Lexend', sans-serif; }
            .mobile-dialog-actions button[type="submit"] { border-color: #1954a6; background: #1954a6; color: #fff; }
        }

        @media (max-width: 768px) and (max-height: 600px) {
            .mobile-dashboard { gap: 0; padding-top: 4px; }
            .mobile-welcome-kicker { font-size: 8px; }
            .mobile-welcome h1 { font-size: 13px; }
            .mobile-welcome h1 strong { font-size: 16px; }
            .mobile-role { min-height: 17px; font-size: 8px; }
            .mobile-user-avatar { width: 42px; height: 42px; flex-basis: 42px; font-size: 15px; }
            .mobile-ad-card { min-height: 52px; padding: 6px 10px; }
            .mobile-ad-label { margin-bottom: 2px; font-size: 8px; line-height: 1.1; }
            .mobile-ad-card h2 { margin-bottom: 2px; font-size: 14px; line-height: 1.1; }
            .mobile-ad-card p:last-child { font-size: 8px; line-height: 1.1; }
            .mobile-ad-mark { width: 36px; height: 28px; font-size: 9px; }
            .mobile-search { height: 36px; }
            .mobile-app-grid { gap: 4px; }
            .mobile-app-tile { min-height: 58px; gap: 4px; padding: 5px 2px; }
            .mobile-app-icon { width: 27px; height: 27px; flex-basis: 27px; font-size: 12px; }
            .mobile-app-name { font-size: 8px; }
            .mobile-module-panel { padding: 4px 6px; }
            .mobile-slider-dots { min-height: 12px; padding-top: 0; }
            .mobile-module-panel .mobile-section-heading { display: none; }
            .mobile-module-panel .mobile-section-heading,
            #mobileNoticesHeading { margin-bottom: 4px; }
            .mobile-module-grid { gap: 2px; }
            .mobile-module-link { min-height: 42px; gap: 2px; padding: 4px 2px; }
            .mobile-module-link i { font-size: 17px; }
            .mobile-module-link span { font-size: 8px; }
            .mobile-notice-list { max-height: 116px; min-height: 34px; gap: 5px; padding: 6px 6px 8px; }
            .mobile-notice-card { grid-template-columns: 29px minmax(0, 1fr) 11px; gap: 7px; min-height: 54px; padding: 6px 8px; border-radius: 10px; }
            .mobile-notice-card-latest { min-height: 60px; box-shadow: 0 8px 16px rgba(35, 64, 99, .16), 0 3px 6px rgba(35, 64, 99, .08); transform: translateY(-1px) scale(1.015); }
            .mobile-notice-card-latest .mobile-notice-heading strong { font-size: 10.5px; }
            .mobile-notice-calendar { width: 29px; height: 29px; border-radius: 8px; font-size: 13px; }
            .mobile-notice-heading strong { font-size: 10px; }
            .mobile-notice-description { margin-top: 2px; font-size: 8px; }
            .mobile-notice-meta { font-size: 7px; }
            .mobile-notices-all { min-height: 26px; font-size: 9px; }
            .mobile-notice-empty { min-height: 24px; font-size: 10px; }
        }
    </style>
</head>
<body>
    <header>
        <%- include('partials/nav') %>

        <div class="hero-section">
            <h1 id="firstheading">Answersheet Analysis <span id="firstspan">System</span></h1>
            <span class="subheading">A professional system designed to analyze and evaluate student performance</span>
        </div>
    </header>
    <%- include('partials/sidenav', { 
        subjects: subjects, 
        studentClassdata: studentClassdata,
        terminals: terminals 
    }) %>

    <% const mobileTeacherName = typeof teacherName === 'string' && teacherName.trim() ? teacherName.trim() : 'Teacher'; %>
    <% const mobileNameParts = mobileTeacherName.split(/\s+/).filter(Boolean); %>
    <% const mobileInitials = mobileNameParts.length > 1 ? `${mobileNameParts[0][0]}${mobileNameParts[mobileNameParts.length - 1][0]}` : (mobileNameParts[0]?.[0] || 'T'); %>
    <main class="mobile-dashboard" aria-label="Home dashboard">
        <header class="mobile-welcome">
            <div class="mobile-user-avatar" aria-hidden="true"><%= mobileInitials.toUpperCase() %></div>
