                            <a class="mobile-module-link" data-app-link data-search="cas counter" href="/cascounter"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i><span>CAS Counter</span></a>
                            <a class="mobile-module-link" data-app-link data-search="project work counter" href="/projectcounter"><i class="fa-solid fa-list-ol" aria-hidden="true"></i><span>Project Counter</span></a>
                            <a class="mobile-module-link" data-app-link data-search="project work list" href="/projectlist"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span>Project List</span></a>
                        </div>
                    </div>
                    <div class="mobile-module-slide" data-module-slide="2" role="tabpanel" aria-label="Admin modules page 2">
                        <div class="mobile-module-grid">
                            <a class="mobile-module-link" data-app-link data-search="entry form locker" href="/entryformlocker"><i class="fa-solid fa-lock" aria-hidden="true"></i><span>Entry Form Locker</span></a>
                            <a class="mobile-module-link" data-app-link data-search="print portfolio" href="/printportfolio"><i class="fa-solid fa-print" aria-hidden="true"></i><span>Print Portfolio</span></a>
                            <a class="mobile-module-link" data-app-link data-search="analysis entry counter" href="/analysisentrycounter"><i class="fa-solid fa-chart-column" aria-hidden="true"></i><span>Analysis Counter</span></a>
                            <a class="mobile-module-link" data-app-link data-search="principal dashboard" href="/principaldashboard"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i><span>Principal Dashboard</span></a>
                            <a class="mobile-module-link" data-app-link data-search="admin dashboard terminal" href="/admin/term/FIRST"><i class="fa-solid fa-user-gear" aria-hidden="true"></i><span>Admin Dashboard</span></a>
                            <a class="mobile-module-link" data-app-link data-search="exam management dashboard" href="/exammanagement"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i><span>Exam Management</span></a>
                            <a class="mobile-module-link" data-app-link data-search="add notice create notice" href="/notice/add"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i><span>Add Notice</span></a>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
            <% if (userrole === 'ADMIN') { %>
            <div class="mobile-slider-dots" id="mobileModuleDots" role="tablist" aria-label="Module pages">
                <button class="mobile-slider-dot" type="button" role="tab" aria-label="Show module page 1" aria-selected="true" data-module-dot="0"></button>
                <button class="mobile-slider-dot" type="button" role="tab" aria-label="Show admin module page 1" aria-selected="false" data-module-dot="1"></button>
                <button class="mobile-slider-dot" type="button" role="tab" aria-label="Show admin module page 2" aria-selected="false" data-module-dot="2"></button>
            </div>
            <% } %>
        </section>

        <section aria-labelledby="mobileNoticesHeading">
            <h2 class="mobile-section-heading" id="mobileNoticesHeading">Recent notices</h2>
            <div class="mobile-notice-list" role="region" aria-label="Recent notices" tabindex="0">
                <% if (recentNotices?.length) { %>
                    <% recentNotices.forEach((notice, index) => { %>
                    <a class="mobile-notice-card <%= index === 0 ? 'mobile-notice-card-latest' : '' %>" href="/notice/<%= notice._id %>">
                        <span class="mobile-notice-calendar"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></span>
                        <span class="mobile-notice-content">
                            <span class="mobile-notice-heading"><strong><%= notice.title %></strong><% if (notice.isNew) { %><span class="mobile-notice-new">NEW</span><% } %></span>
                            <span class="mobile-notice-description"><%= notice.description || 'Open this notice for more details.' %></span>
                            <span class="mobile-notice-meta"><%= notice.noticeDate %> · <%= notice.addedBy %></span>
                        </span>
                        <i class="fa-solid fa-chevron-right mobile-notice-arrow" aria-hidden="true"></i>
                    </a>
                    <% }) %>
                <% } else { %>
                    <p class="mobile-notice-empty">No notices yet</p>
                <% } %>
            </div>
            <a class="mobile-notices-all" href="/notice">See all notices <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
