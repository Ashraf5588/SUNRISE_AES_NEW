                <a class="mobile-module-link" data-app-link data-search="homework assignments" href="/homework"><i class="fa-solid fa-book" aria-hidden="true"></i><span>Homework</span></a>
                <a class="mobile-module-link" data-app-link data-search="portfolio student" href="/studentportfolio"><i class="fa-solid fa-address-card" aria-hidden="true"></i><span>Portfolio</span></a>
                        </div>
                    </div>
                    <% if (userrole === 'ADMIN') { %>
