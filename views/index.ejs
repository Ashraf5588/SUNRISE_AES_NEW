    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const subjectSelector = document.getElementById('subjectSelector');
            const enterDataBtn = document.getElementById('enterDataBtn');
            const viewReportBtn = document.getElementById('viewReportBtn');
            
            // Enable/disable buttons based on selection
            subjectSelector.addEventListener('change', function() {
                const selectedSubject = this.value;
                if (selectedSubject) {
                    enterDataBtn.disabled = false;
                    viewReportBtn.disabled = false;
                } else {
                    enterDataBtn.disabled = true;
                    viewReportBtn.disabled = true;
                }
            });
            
            // Handle enter data button click
            enterDataBtn.addEventListener('click', function() {
                const selectedSubject = subjectSelector.value;
                if (selectedSubject) {
                    window.location.href = `/forms/${selectedSubject.trim()}`;
                }
            });
            
            // Handle view report button click
            viewReportBtn.addEventListener('click', function() {
                const selectedSubject = subjectSelector.value;
                if (selectedSubject) {
                    window.location.href = `/teacher/${selectedSubject.trim()}/findData`;
                }
            });
        });
    </script>
    
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                const searchInput = document.getElementById('mobileAppSearch');
                const appLinks = Array.from(document.querySelectorAll('.mobile-dashboard [data-app-link]'));
                const noResults = document.getElementById('mobileSearchNoResults');
                const moduleSlider = document.getElementById('mobileModuleSlider');
                const moduleSlides = Array.from(document.querySelectorAll('[data-module-slide]'));
                const moduleDots = Array.from(document.querySelectorAll('[data-module-dot]'));
                const subjectDialog = document.getElementById('mobileSubjectDialog');
                const subjectForm = document.getElementById('mobileSubjectForm');
                const subjectSelect = document.getElementById('mobileSubjectSelect');
                let subjectAction = 'enter';

                const visibleModuleSlides = () => moduleSlides.filter((slide) => !slide.hidden);
                const updateActiveModuleDot = () => {
                    if (!moduleSlider || !moduleDots.length) return;
                    const visibleSlides = visibleModuleSlides();
                    if (!visibleSlides.length) return;
                    const visibleIndex = Math.min(
                        Math.round(moduleSlider.scrollLeft / moduleSlider.clientWidth),
                        visibleSlides.length - 1
                    );
                    const activeSlideIndex = visibleSlides[visibleIndex].dataset.moduleSlide;
                    moduleDots.forEach((dot) => {
                        dot.setAttribute('aria-selected', String(dot.dataset.moduleDot === activeSlideIndex));
                    });
                };

                if (moduleSlider) {
                    moduleSlider.addEventListener('scroll', updateActiveModuleDot, { passive: true });
                }

                moduleDots.forEach((dot) => {
                    dot.addEventListener('click', function() {
                        const visibleSlides = visibleModuleSlides();
                        const visibleIndex = visibleSlides.findIndex((slide) => slide.dataset.moduleSlide === this.dataset.moduleDot);
                        if (visibleIndex < 0) return;
                        moduleSlider.scrollTo({ left: visibleIndex * moduleSlider.clientWidth, behavior: 'smooth' });
                    });
                });

                searchInput.addEventListener('input', function() {
                    const query = this.value.trim().toLocaleLowerCase();
                    let visibleCount = 0;
                    appLinks.forEach((link) => {
                        const searchText = `${link.dataset.search || ''} ${link.textContent}`.toLocaleLowerCase();
                        const matches = !query || searchText.includes(query);
                        link.hidden = !matches;
                        if (matches) visibleCount += 1;
                    });
                    moduleSlides.forEach((slide) => {
                        const hasMatches = Array.from(slide.querySelectorAll('[data-app-link]')).some((link) => !link.hidden);
                        slide.hidden = query.length > 0 && !hasMatches;
                    });
                    moduleDots.forEach((dot) => {
                        const slide = moduleSlides.find((item) => item.dataset.moduleSlide === dot.dataset.moduleDot);
                        dot.hidden = !slide || slide.hidden;
                    });
                    if (moduleSlider) moduleSlider.scrollTo({ left: 0, behavior: 'auto' });
                    updateActiveModuleDot();
                    noResults.hidden = visibleCount > 0;
                });

                document.querySelectorAll('[data-subject-action]').forEach((link) => {
                    link.addEventListener('click', function(event) {
                        event.preventDefault();
                        subjectAction = this.dataset.subjectAction;
                        document.getElementById('mobileSubjectDialogTitle').textContent = subjectAction === 'report' ? 'View report' : 'Enter analysis';
                        document.getElementById('mobileSubjectContinue').textContent = subjectAction === 'report' ? 'View Report' : 'Enter Data';
                        if (typeof subjectDialog.showModal === 'function') subjectDialog.showModal();
                        else subjectDialog.setAttribute('open', '');
                        subjectSelect.focus();
                    });
                });

                document.getElementById('mobileSubjectCancel').addEventListener('click', function() {
                    if (typeof subjectDialog.close === 'function') subjectDialog.close();
                    else subjectDialog.removeAttribute('open');
                });

                subjectForm.addEventListener('submit', function(event) {
                    event.preventDefault();
                    if (!subjectSelect.value) return subjectSelect.reportValidity();
                    const subject = encodeURIComponent(subjectSelect.value.trim());
                    window.location.href = subjectAction === 'report' ? `/teacher/${subject}/findData` : `/forms/${subject}`;
                });
            });

      // Home page loader handling
      document.addEventListener('DOMContentLoaded', function() {
        // Show loader for subject cards
        const subjectCards = document.querySelectorAll('.subject-card a');
        subjectCards.forEach(link => {
          link.addEventListener('click', function(e) {
            if (window.pageLoader) {
              const subjectName = this.querySelector('h3')?.textContent || 'Subject';
              window.pageLoader.show(
                `Loading ${subjectName}...`,
                'Preparing class selection for this subject'
              );
            }
          });
        });
        
        // Show loader for quick analysis button
        const quickAnalysisBtn = document.getElementById('quickAnalysis');
        if (quickAnalysisBtn) {
          quickAnalysisBtn.addEventListener('click', function(e) {
            if (window.pageLoader) {
              window.pageLoader.show(
                'Loading Quick Analysis...',
                'Preparing data analysis tools'
              );
            }
          });
        }
      });
    </script>
    
