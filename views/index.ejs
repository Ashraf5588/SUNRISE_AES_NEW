                            <a class="mobile-module-link" data-app-link data-search="call response frontdesk" href="/frontdesk"><i class="fa-solid fa-phone" aria-hidden="true"></i><span>Call Response</span></a>
                            <a class="mobile-module-link" data-app-link data-search="teacher record" href="/teacher-record"><i class="fa-solid fa-user" aria-hidden="true"></i><span>Teacher Record</span></a>
                            <a class="mobile-module-link" data-app-link data-search="health record" href="/healthrecord"><i class="fa-solid fa-kit-medical" aria-hidden="true"></i><span>Health Record</span></a>
