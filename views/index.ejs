                </a>
                <a class="mobile-app-tile" data-app-link data-search="internal assessment" href="/class" aria-label="Internal Assessment">
                    <span class="mobile-app-icon"><i class="fa-solid fa-pen-ruler" aria-hidden="true"></i></span><span class="mobile-app-name">Internal Assessment</span>
                </a>
                <a class="mobile-app-tile" data-app-link data-search="exam marks marks entry" href="/examform" aria-label="Exam Marks">
                    <span class="mobile-app-icon"><i class="fa-solid fa-file-signature" aria-hidden="true"></i></span><span class="mobile-app-name">Exam Marks</span>
                </a>
                <a class="mobile-app-tile" data-app-link data-search="add chapter chapter name" href="/addchapterselect" aria-label="Add Chapter">
                    <span class="mobile-app-icon"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span><span class="mobile-app-name">Add Chapter</span>
                </a>
                <a class="mobile-app-tile" data-app-link data-search="question format question paper" href="/admin/subject" aria-label="Question Format">
                    <span class="mobile-app-icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span><span class="mobile-app-name">Question Format</span>
                </a>
            </div>
        </section>

        <section class="mobile-module-panel" aria-label="More modules">
            <h2 class="mobile-section-heading" id="mobileModulesHeading">More modules</h2>
            <div class="mobile-module-slider" id="mobileModuleSlider" aria-label="Swipe to browse modules">
                <div class="mobile-module-track">
                    <div class="mobile-module-slide" data-module-slide="0" role="tabpanel" aria-label="Modules page 1">
                        <div class="mobile-module-grid">
                <a class="mobile-module-link" data-app-link data-search="enter analysis data entry" href="#" data-subject-action="enter"><i class="fa-solid fa-chart-column" aria-hidden="true"></i><span>Enter Analysis</span></a>
                <a class="mobile-module-link" data-app-link data-search="view report analysis reports" href="#" data-subject-action="report"><i class="fa-solid fa-chart-line" aria-hidden="true"></i><span>View Report</span></a>
                <a class="mobile-module-link" data-app-link data-search="leave form request" href="/leave"><i class="fa-solid fa-file-circle-check" aria-hidden="true"></i><span>Leave Form</span></a>
                <a class="mobile-module-link" data-app-link data-search="product request inventory" href="/inventory/productrequests"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i><span>Product Request</span></a>
                <a class="mobile-module-link" data-app-link data-search="events event list" href="/createevent"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i><span>Events</span></a>
                <a class="mobile-module-link" data-app-link data-search="event create event" href="/lessonplanselect"><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i><span>Lesson Plan</span></a>
                <a class="mobile-module-link" data-app-link data-search="student update transfer" href="/student-transfer"><i class="fa-solid fa-user-pen" aria-hidden="true"></i><span>Student Update</span></a>
