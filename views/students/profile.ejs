<%- include('../partials/head', { title: student.name }) %>
<%- include('../partials/navbar') %>
<div class="fee-page-shell"><%- include('../billingfirst/feesidenav') %><main class="fee-page-main"><div class="container mt-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h3><%= student.name %> <small class="text-muted">(<%= student.studentCode %>)</small></h3>
      <p class="mb-0">Class: <%= student.class ? student.class.name : '-' %><% if (student.section) { %> - <%= student.section %><% } %></p>
      <p class="mb-0">Guardian: <%= student.guardianName %> (<%= student.guardianPhone %>)</p>
      <p class="mb-0">Admission Date: <%= student.admissionDateAD.toDateString() %></p>
    </div>
    <div class="text-end">
      <h4 class="<%= balance > 0 ? 'text-danger' : 'text-success' %>">Rs <%= balance.toFixed(2) %></h4>
      <p class="text-muted mb-2">Current Due</p>
      <a href="/students/<%= student._id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
      <a href="/payments/new/<%= student._id %>" class="btn btn-success btn-sm">Record Payment</a>
    </div>
  </div>

  <ul class="nav nav-tabs" id="profileTabs">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#invoices">Invoices</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#payments">Payments</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#ledger">Transaction History (Ledger)</button></li>
  </ul>

  <div class="tab-content bg-white p-3 border border-top-0">
    <div class="tab-pane fade show active" id="invoices">
      <table class="table table-sm">
        <thead><tr><th>Invoice #</th><th>Month</th><th>Prev Due</th><th>This Month</th><th>Grand Total</th><th>Paid</th><th>Balance</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% invoices.forEach(inv => { %>
          <tr>
            <td><%= inv.invoiceNumber %></td>
            <td><%= inv.billMonthBS %></td>
            <td><%= inv.previousDue.toFixed(2) %></td>
            <td><%= inv.currentTotal.toFixed(2) %></td>
            <td><%= inv.grandTotal.toFixed(2) %></td>
            <td><%= inv.paidAmount.toFixed(2) %></td>
            <td><%= inv.balanceDue.toFixed(2) %></td>
            <td><span class="badge bg-<%= inv.status === 'PAID' ? 'success' : inv.status === 'PARTIAL' ? 'warning' : 'danger' %>"><%= inv.status %></span></td>
            <td><a href="/billing/invoice/<%= inv._id %>" target="_blank">Print</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="tab-pane fade" id="payments">
      <table class="table table-sm">
        <thead><tr><th>Receipt #</th><th>Date</th><th>Amount</th><th>Mode</th><th></th></tr></thead>
        <tbody>
          <% payments.forEach(p => { %>
          <tr>
            <td><%= p.receiptNumber %></td>
            <td><%= p.paymentDateAD.toDateString() %></td>
            <td><%= p.amount.toFixed(2) %></td>
            <td><%= p.mode %></td>
            <td><a href="/payments/<%= p._id %>" target="_blank">Print Receipt</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="tab-pane fade" id="ledger">
      <table class="table table-sm">
        <thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Reference</th><th>Description</th><th>Running Balance</th></tr></thead>
        <tbody>
          <% ledger.forEach(l => { %>
          <tr>
            <td><%= l.date.toDateString() %></td>
            <td><span class="badge bg-<%= l.type === 'DEBIT' ? 'danger' : 'success' %>"><%= l.type %></span></td>
            <td><%= l.amount.toFixed(2) %></td>
            <td><%= l.referenceType %></td>
            <td><%= l.description %></td>
            <td><%= l.runningBalance !== undefined && l.runningBalance !== null ? l.runningBalance.toFixed(2) : '-' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
 </main></div>
<%- include('../partials/footer') %>
