<%- include('../partials/head', { title: 'Student Register', setupStylesheet: true, nepaliDatePicker: true }) %>
<%- include('../partials/navbar') %>
<%
  const activeCount = studentCounts ? studentCounts.active : students.filter(student => student.status === 'ACTIVE').length;
  const busCount = studentCounts ? studentCounts.busUsers : students.filter(student => student.usesSchoolBus && student.transportRoute).length;
  const currentSession = sessions.find(session => session.isActive) || sessions[0];
%>
<div class="fee-page-shell setup-page student-register-page">
  <%- include('../billingfirst/feesidenav') %>
  <main class="fee-page-main">
    <div class="container student-register-workspace">
      <header class="student-register-hero">
        <div class="student-register-hero-copy">
          <div class="student-register-breadcrumb"><span>School billing</span><i>/</i><strong>Students</strong></div>
          <div class="student-register-title-row">
            <span class="student-register-title-icon" aria-hidden="true">S</span>
            <div>
              <h1>Student register</h1>
              <p>Manage student admissions, class placements, and school transport in one place.</p>
            </div>
          </div>
        </div>
        <div class="student-register-actions">
          <a href="/students/import-template.csv" class="btn student-register-secondary-action">Download CSV template</a>
          <button type="button" class="btn student-register-primary-action" data-open-student-modal>
            <span aria-hidden="true">+</span> Add student
          </button>
        </div>
      </header>

      <div id="studentRegisterNotice" class="student-register-notice" role="status" hidden></div>

      <section class="student-register-stats" aria-label="Student summary">
        <article class="student-stat-card">
          <span class="student-stat-icon stat-icon-blue" aria-hidden="true">◎</span>
          <span class="student-stat-label">Total students</span>
          <strong><%= studentCounts ? studentCounts.total : students.length %></strong>
          <small>Across all classes</small>
        </article>
        <article class="student-stat-card">
          <span class="student-stat-icon stat-icon-green" aria-hidden="true">✓</span>
          <span class="student-stat-label">Active students</span>
          <strong><%= activeCount %></strong>
          <small>Currently enrolled</small>
        </article>
        <article class="student-stat-card">
          <span class="student-stat-icon stat-icon-violet" aria-hidden="true">▦</span>
          <span class="student-stat-label">Classes</span>
          <strong><%= classes.length %></strong>
          <small>Available class groups</small>
        </article>
        <article class="student-stat-card">
          <span class="student-stat-icon stat-icon-amber" aria-hidden="true">B</span>
          <span class="student-stat-label">School bus</span>
          <strong><%= busCount %></strong>
          <small>Students with a saved route</small>
        </article>
      </section>

      <section class="student-register-panel" aria-labelledby="studentTableTitle">
        <div class="student-register-panel-heading">
          <div>
            <p class="student-register-overline">Enrolment overview</p>
            <h2 id="studentTableTitle">All students <span><%= students.length %></span></h2>
          </div>
          <div class="student-register-filters">
            <label class="student-search-box" for="studentSearch">
              <span aria-hidden="true">⌕</span>
              <input id="studentSearch" type="search" placeholder="Search name or student code" autocomplete="off">
            </label>
            <select id="classFilter" class="form-select" aria-label="Filter by class">
              <option value="">All classes</option>
              <% classes.forEach(classItem => { %>
                <option value="<%= String(classItem._id) %>"><%= classItem.studentClass %><%= classItem.section ? ' · ' + classItem.section : '' %></option>
              <% }) %>
            </select>
            <select id="statusFilter" class="form-select" aria-label="Filter by status">
              <option value="">All statuses</option>
              <option value="ACTIVE">Active</option>
              <option value="INACTIVE">Inactive</option>
              <option value="TRANSFERRED">Transferred</option>
            </select>
          </div>
        </div>

        <div class="student-register-table-wrap">
          <table class="table student-register-table">
            <thead>
              <tr><th>Student</th><th>Class &amp; section</th><th>Guardian contact</th><th>Transport</th><th>Admission date</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody id="studentTableBody">
              <% if (!students.length) { %>
                <tr class="student-register-empty-row"><td colspan="7">
                  <div class="student-register-empty">
                    <span aria-hidden="true">S</span>
                    <strong>Your student register is ready</strong>
                    <p>Add your first student to get started with admissions and billing.</p>
                    <button type="button" class="btn student-register-primary-action" data-open-student-modal>Add first student</button>
                  </div>
                </td></tr>
              <% } %>
              <% students.forEach(student => { %>
                <%
                  const className = student.class ? (student.class.studentClass || student.class.name || '—') : '—';
                  const sectionName = student.section || (student.class && student.class.section) || '';
                  const status = student.status || 'ACTIVE';
                  const statusLabel = status.charAt(0) + status.slice(1).toLowerCase();
                  const admissionDate = student.admissionDateAD ? new Date(student.admissionDateAD) : null;
                %>
                <tr class="student-register-row" data-name="<%= String(student.name || '').toLowerCase() %>" data-code="<%= String(student.studentCode || '').toLowerCase() %>" data-class="<%= student.class ? String(student.class._id) : '' %>" data-status="<%= status %>">
                  <td>
                    <a class="student-register-student" href="/students/<%= student._id %>">
                      <span class="student-avatar"><%= String(student.name || 'S').trim().charAt(0).toUpperCase() %></span>
                      <span class="student-register-identity"><strong><%= student.name %></strong><small><%= student.studentCode %></small></span>
                    </a>
                  </td>
                  <td><span class="student-register-class"><%= className %></span><% if (sectionName) { %><small class="student-register-subtext">Section <%= sectionName %></small><% } %></td>
                  <td><strong class="student-register-guardian"><%= student.guardianName || '—' %></strong><% if (student.guardianPhone) { %><small class="student-register-subtext"><%= student.guardianPhone %></small><% } %></td>
                  <td>
                    <% if (student.usesSchoolBus && student.transportRoute) { %>
                      <span class="student-transport-badge"><span aria-hidden="true">B</span><%= student.transportRoute.routeName || 'Route assigned' %></span>
                    <% } else { %><span class="student-transport-none">No bus</span><% } %>
                  </td>
                  <td><%= admissionDate && !Number.isNaN(admissionDate.getTime()) ? admissionDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %></td>
                  <td><span class="student-status-badge status-<%= status.toLowerCase() %>"><i></i><%= statusLabel %></span></td>
                  <td><a class="student-register-view-link" href="/students/<%= student._id %>">View <span aria-hidden="true">→</span></a></td>
                </tr>
              <% }) %>
              <tr id="studentSearchEmpty" hidden><td colspan="7"><div class="student-filter-empty">No students match those filters. Try another search.</div></td></tr>
            </tbody>
          </table>
        </div>
        <footer class="student-register-footer">
          <span id="studentResultCount">Showing <strong><%= students.length %></strong> of <strong><%= students.length %></strong> students</span>
          <span><%= currentSession ? 'Current session · ' + currentSession.titleBS : 'No academic session configured' %></span>
        </footer>
      </section>
    </div>
  </main>
</div>

<div class="student-admission-modal" id="studentAdmissionModal" hidden aria-hidden="true">
  <button type="button" class="student-modal-backdrop" data-close-student-modal aria-label="Close admission form"></button>
  <div class="student-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="studentAdmissionModalTitle">
    <div class="student-modal-content">
      <form id="studentAdmissionModalForm" action="/students" method="POST" novalidate>
        <div class="student-modal-header">
          <div class="student-modal-heading">
            <span class="student-modal-heading-icon" aria-hidden="true">+</span>
            <div><p>STUDENT ENROLMENT</p><h2 id="studentAdmissionModalTitle">Add a new student</h2><span>Enter the student's details and choose their transport option.</span></div>
          </div>
          <button type="button" class="student-modal-close" data-close-student-modal aria-label="Close">&times;</button>
        </div>
        <div class="student-modal-body">
          <div id="studentModalErrorSummary" class="student-modal-error-summary" role="alert" hidden></div>
          <section class="student-modal-section">
            <div class="student-modal-section-heading"><span>01</span><div><h3>Student information</h3><p>Basic details for the school register.</p></div></div>
            <div class="student-modal-fields">
              <div class="student-modal-field">
                <label for="modalStudentCode">Student code <b>*</b></label>
                <input id="modalStudentCode" name="studentCode" class="form-control" placeholder="e.g. STU-2083-001" required>
                <small class="student-modal-field-error" data-error-for="studentCode"></small>
              </div>
              <div class="student-modal-field">
                <label for="modalStudentName">Full name <b>*</b></label>
                <input id="modalStudentName" name="name" class="form-control" placeholder="Enter student's full name" autocomplete="name" required>
                <small class="student-modal-field-error" data-error-for="name"></small>
              </div>
              <div class="student-modal-field">
                <label for="modalStudentClass">Class <b>*</b></label>
                <select id="modalStudentClass" name="class" class="form-select" required>
                  <option value="">Select class</option>
                  <% classes.forEach(classItem => { %><option value="<%= classItem._id %>"><%= classItem.studentClass %><%= classItem.section ? ' · ' + classItem.section : '' %></option><% }) %>
                </select>
                <small class="student-modal-field-error" data-error-for="class"></small>
              </div>
              <div class="student-modal-field">
                <label for="modalStudentSection">Section</label>
                <input id="modalStudentSection" name="section" class="form-control" placeholder="e.g. A">
              </div>
              <div class="student-modal-field">
                <label for="modalStudentSession">Academic session <b>*</b></label>
                <select id="modalStudentSession" name="academicSession" class="form-select" required>
                  <option value="">Select session</option>
                  <% sessions.forEach(session => { %><option value="<%= session._id %>" <%= currentSession && String(currentSession._id) === String(session._id) ? 'selected' : '' %>><%= session.titleBS %><%= session.isActive ? ' · Current' : '' %></option><% }) %>
                </select>
                <small class="student-modal-field-error" data-error-for="academicSession"></small>
              </div>
              <div class="student-modal-field">
                <label for="modalAdmissionDate">Admission date (BS) <b>*</b></label>
                <input id="modalAdmissionDate" name="admissionDateBS" type="text" class="form-control nepali-datepicker" placeholder="YYYY-MM-DD" pattern="[0-9]{4}-[0-9]{2}-[0-9]{2}" autocomplete="off" required>
                <small class="student-modal-field-error" data-error-for="admissionDateBS"></small>
              </div>
            </div>
          </section>

          <section class="student-modal-section">
            <div class="student-modal-section-heading"><span>02</span><div><h3>Parent or guardian</h3><p>Contact details for school communication.</p></div></div>
            <div class="student-modal-fields">
              <div class="student-modal-field"><label for="modalGuardianName">Guardian name</label><input id="modalGuardianName" name="guardianName" class="form-control" placeholder="Parent or guardian's name" autocomplete="name"></div>
              <div class="student-modal-field"><label for="modalGuardianPhone">Phone number</label><input id="modalGuardianPhone" name="guardianPhone" type="tel" class="form-control" placeholder="e.g. 98XXXXXXXX" autocomplete="tel"></div>
            </div>
          </section>

          <section class="student-modal-section student-modal-transport-section">
            <div class="student-modal-section-heading"><span>03</span><div><h3>School transport</h3><p>The saved route fare will be included in this student's billing.</p></div></div>
            <label class="student-modal-bus-toggle" for="modalUsesSchoolBus">
              <span class="student-modal-bus-icon" aria-hidden="true">B</span>
              <span><strong>This student uses the school bus</strong><small>On by default. Switch off if transport is not needed.</small></span>
              <input id="modalUsesSchoolBus" type="checkbox" name="usesSchoolBus" checked>
            </label>
            <div class="student-modal-transport-fields">
              <div class="student-modal-field">
                <label for="modalTransportRoute">Transport route <b id="modalRouteRequired">*</b></label>
                <select id="modalTransportRoute" name="transportRoute" class="form-select">
                  <option value="">Select a route</option>
                  <% transportRoutes.forEach(route => { %><option value="<%= route._id %>" data-session="<%= route.academicSession ? route.academicSession._id : '' %>" data-fee="<%= route.transportFee %>"><%= route.routeName %> · Rs. <%= Number(route.transportFee).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %><%= route.academicSession ? ' · ' + route.academicSession.titleBS : '' %></option><% }) %>
                </select>
                <small class="student-modal-field-error" data-error-for="transportRoute"></small>
                <small class="student-modal-route-help" id="modalRouteHelp"><%= transportRoutes.length ? 'Routes are filtered to the selected academic session.' : 'No routes configured. Add one in Transport fee setup.' %></small>
              </div>
              <div class="student-modal-route-fare"><span>Route fee</span><strong id="modalRouteFare">Select a route</strong></div>
            </div>
          </section>
          <p class="student-modal-required-note"><b>*</b> Required information</p>
        </div>
        <div class="student-modal-footer">
          <a class="student-modal-more-link" href="/students/new">More admission options <span aria-hidden="true">↗</span></a>
          <div><button type="button" class="btn student-modal-cancel" data-close-student-modal>Cancel</button><button type="submit" class="btn student-modal-submit" id="studentModalSubmit"><span class="student-submit-label">Save student</span><span class="student-submit-spinner" hidden></span></button></div>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .student-register-page { --register-ink: #172b49; --register-muted: #78889f; --register-line: #e6ecf4; }
  .student-register-workspace { max-width: 1500px; }
  .student-register-hero { display:flex; align-items:center; justify-content:space-between; gap:20px; margin:2px 0 23px; padding:24px 26px; border:1px solid #e0e9f5; border-radius:16px; background:radial-gradient(ellipse at 86% 0%,rgba(116,166,235,.16),transparent 40%),linear-gradient(112deg,#fff 8%,#f8fbff 100%); box-shadow:0 10px 26px rgba(27,52,87,.045); }
  .student-register-breadcrumb { display:flex; gap:9px; align-items:center; margin-bottom:16px; color:#8b98aa; font-size:10px; font-weight:650; }
  .student-register-breadcrumb i { color:#b6c1cf; font-style:normal; }
  .student-register-breadcrumb strong { color:#44658f; font-weight:750; }
  .student-register-title-row { display:flex; gap:13px; align-items:center; }
  .student-register-title-icon { display:grid; width:45px; height:45px; place-items:center; border-radius:13px; background:#e9f1ff; color:#346dbc; font-size:19px; font-weight:900; }
  .student-register-title-row h1 { margin:0; color:var(--register-ink); font-size:25px; font-weight:850; letter-spacing:-.4px; }
  .student-register-title-row p { margin:5px 0 0; color:var(--register-muted); font-size:11px; }
  .student-register-actions { display:flex; flex-wrap:wrap; gap:9px; }
  .student-register-actions .btn { min-height:40px; padding:10px 14px; border-radius:9px; font-size:11px; font-weight:750; }
  .student-register-secondary-action { border:1px solid #dfe7f1; background:#fff; color:#4e6380; }
  .student-register-secondary-action:hover { border-color:#c5d5e9; background:#f7faff; color:#305e9d; }
  .student-register-primary-action { display:inline-flex; align-items:center; justify-content:center; gap:7px; border:1px solid #326dc0; background:#3979d6; color:#fff; box-shadow:0 5px 12px rgba(57,121,214,.18); font-size:11px; font-weight:750; }
  .student-register-primary-action:hover { border-color:#285da8; background:#306dc4; color:#fff; }
  .student-register-primary-action span { font-size:18px; font-weight:400; line-height:11px; }
  .student-register-notice { margin-bottom:15px; padding:12px 15px; border:1px solid #cce6d5; border-radius:10px; background:#f0faf3; color:#286b42; font-size:12px; font-weight:700; }
  .student-register-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:13px; margin-bottom:20px; }
  .student-stat-card { position:relative; display:grid; grid-template-columns:40px 1fr; grid-template-rows:auto auto auto; align-items:center; column-gap:12px; min-height:103px; padding:16px 17px; overflow:hidden; border:1px solid var(--register-line); border-radius:12px; background:#fff; box-shadow:0 7px 20px rgba(27,52,87,.035); }
  .student-stat-icon { display:grid; grid-row:1 / 4; width:39px; height:39px; place-items:center; border-radius:12px; font-size:16px; font-weight:900; }
  .stat-icon-blue { background:#edf4ff; color:#3474cb; }.stat-icon-green { background:#eaf7ef; color:#348657; }.stat-icon-violet { background:#f2efff; color:#775ac5; }.stat-icon-amber { background:#fff5e5; color:#b87a1b; }
  .student-stat-label { color:#77879c; font-size:10px; font-weight:700; }
  .student-stat-card strong { color:var(--register-ink); font-size:22px; font-weight:850; line-height:1.15; }
  .student-stat-card small { color:#98a4b4; font-size:9px; }
  .student-register-panel { overflow:hidden; border:1px solid var(--register-line); border-radius:14px; background:#fff; box-shadow:0 9px 26px rgba(27,52,87,.045); }
  .student-register-panel-heading { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:19px 21px; border-bottom:1px solid #edf1f6; }
  .student-register-overline { margin:0 0 4px; color:#7790b3; font-size:9px; font-weight:850; letter-spacing:.8px; text-transform:uppercase; }
  .student-register-panel-heading h2 { display:flex; align-items:center; gap:8px; margin:0; color:var(--register-ink); font-size:15px; font-weight:850; }
  .student-register-panel-heading h2 span { display:inline-grid; min-width:22px; height:21px; padding:0 5px; place-items:center; border-radius:7px; background:#eff4fb; color:#5f7696; font-size:9px; }
  .student-register-filters { display:flex; align-items:center; gap:8px; }
  .student-search-box { display:flex; min-width:245px; align-items:center; gap:8px; padding:0 10px; border:1px solid #e1e8f1; border-radius:8px; background:#fff; color:#8292a8; }
  .student-search-box > span { font-size:19px; line-height:1; }
  .student-search-box input { width:100%; min-width:0; height:36px; border:0; outline:0; color:#334b69; font:inherit; font-size:10px; }
  .student-search-box input::placeholder { color:#a0acbb; }
  .student-register-filters select { width:auto; min-width:122px; min-height:38px; border-color:#e1e8f1; border-radius:8px; color:#50647f; font-size:10px; }
  .student-register-table-wrap { width:100%; overflow-x:auto; }
  .student-register-table { min-width:930px; margin:0; border-collapse:separate; border-spacing:0; }
  .student-register-table thead th { padding:12px 14px; border-bottom:1px solid #e9eef5; background:#f8fafd; color:#8391a4; font-size:9px; font-weight:800; letter-spacing:.45px; text-transform:uppercase; white-space:nowrap; }
  .student-register-table thead th:first-child,.student-register-table tbody td:first-child { padding-left:21px; }
  .student-register-table tbody td { padding:13px 14px; border-bottom:1px solid #eff2f6; color:#51647d; font-size:10px; vertical-align:middle; }
  .student-register-row:last-of-type td { border-bottom:0; }
  .student-register-row:hover td { background:#fbfdff; }
  .student-register-student { display:flex; align-items:center; gap:10px; color:inherit; text-decoration:none; }
  .student-register-student:hover strong { color:#326fc4; }
  .student-avatar { display:grid; width:35px; height:35px; flex:0 0 35px; place-items:center; border:1px solid #dfebfb; border-radius:11px; background:linear-gradient(145deg,#eff5ff,#e6effc); color:#4376b8; font-size:12px; font-weight:850; }
  .student-register-identity { display:grid; gap:3px; }
  .student-register-identity strong,.student-register-guardian { color:#2e425e; font-size:10px; font-weight:800; }
  .student-register-identity small,.student-register-subtext { color:#8b99ab; font-size:9px; }
  .student-register-class { color:#415673; font-weight:750; }
  .student-register-subtext { display:block; margin-top:3px; }
  .student-transport-badge { display:inline-flex; align-items:center; gap:5px; padding:5px 8px; border:1px solid #dceaf8; border-radius:20px; background:#f1f7ff; color:#376cae; font-size:9px; font-weight:750; white-space:nowrap; }
  .student-transport-badge span { display:grid; width:15px; height:15px; place-items:center; border-radius:5px; background:#deebfc; font-size:8px; font-weight:900; }
  .student-transport-none { color:#9aa6b5; font-size:9px; }
  .student-status-badge { display:inline-flex; align-items:center; gap:6px; padding:5px 8px; border-radius:20px; font-size:9px; font-weight:750; white-space:nowrap; }
  .student-status-badge i { width:6px; height:6px; border-radius:50%; background:currentColor; }
  .status-active { background:#eaf7ef; color:#338452; }.status-inactive { background:#f0f2f5; color:#798697; }.status-transferred { background:#fff3e5; color:#a86a20; }
  .student-register-view-link { color:#3975c5; font-size:10px; font-weight:750; text-decoration:none; white-space:nowrap; }
  .student-register-view-link span { padding-left:3px; font-size:13px; }
  .student-register-view-link:hover { color:#214f91; }
  .student-register-footer { display:flex; justify-content:space-between; gap:12px; padding:12px 20px; border-top:1px solid #edf1f6; color:#8997a9; font-size:9px; }
  .student-register-footer strong { color:#516782; }
  .student-register-empty-row td { padding:0 !important; }
  .student-register-empty { display:grid; justify-items:center; padding:45px 20px; text-align:center; }
  .student-register-empty > span { display:grid; width:52px; height:52px; margin-bottom:14px; place-items:center; border-radius:16px; background:#edf4ff; color:#3979d6; font-size:20px; font-weight:900; }
  .student-register-empty strong { color:#304764; font-size:14px; }
  .student-register-empty p,.student-filter-empty { margin:6px 0 15px; color:#8391a4; font-size:11px; }
  .student-filter-empty { padding:25px; text-align:center; }
  .student-admission-modal[hidden] { display:none !important; }
  .student-admission-modal { position:fixed; z-index:2000; inset:0; display:grid; place-items:center; padding:20px; }
  .student-modal-backdrop { position:absolute; inset:0; width:100%; height:100%; border:0; background:rgba(15,31,53,.58); cursor:default; }
  .student-modal-dialog { position:relative; z-index:1; width:min(100%,900px); max-height:calc(100vh - 40px); }
  .student-modal-content { max-height:calc(100vh - 40px); overflow:hidden; border:0; border-radius:17px; background:#fff; box-shadow:0 25px 80px rgba(15,35,62,.24); }
  .student-modal-content > form { display:flex; max-height:inherit; min-height:0; flex-direction:column; }
  .student-modal-header { display:flex; align-items:flex-start; justify-content:space-between; gap:15px; padding:21px 25px; border-bottom:1px solid #eaf0f6; background:radial-gradient(ellipse at 90% 0%,rgba(116,166,235,.16),transparent 40%),#fbfdff; }
  .student-modal-close { display:grid; width:32px; height:32px; flex:0 0 32px; place-items:center; border:1px solid #e2e8f0; border-radius:9px; background:#fff; color:#65778f; font-size:22px; line-height:1; }
  .student-modal-close:hover { background:#f2f6fb; color:#263f61; }
  .student-modal-heading { display:flex; align-items:center; gap:12px; }
  .student-modal-heading-icon { display:grid; width:39px; height:39px; place-items:center; border-radius:12px; background:#e8f1ff; color:#3776ca; font-size:23px; font-weight:500; }
  .student-modal-heading p { margin:0 0 3px; color:#526986; font-size:10px; font-weight:850; letter-spacing:.9px; }
  .student-modal-heading h2 { margin:0; color:#111827; font-size:21px; font-weight:850; }
  .student-modal-heading div > span { display:block; margin-top:4px; color:#4b5563; font-size:12px; }
  .student-modal-body { display:grid; min-height:0; flex:1; gap:17px; overflow-y:auto; padding:19px 25px 12px; background:#fff; overscroll-behavior:contain; }
  .student-modal-section { padding:15px 16px 17px; border:1px solid #e8edf4; border-radius:12px; background:#fff; }
  .student-modal-section-heading { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .student-modal-section-heading > span { display:grid; width:28px; height:28px; place-items:center; border-radius:9px; background:#edf4ff; color:#3874c2; font-size:9px; font-weight:850; }
  .student-modal-section-heading h3 { margin:0; color:#172b49; font-size:15px; font-weight:850; }
  .student-modal-section-heading p { margin:3px 0 0; color:#4b5563; font-size:11px; }
  .student-modal-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px 18px; }
