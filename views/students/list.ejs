  .student-modal-field label b,.student-modal-required-note b { color:#d24c55; }
  .student-modal-field .form-control,.student-modal-field .form-select { min-height:44px; padding:9px 12px; border:1px solid #cbd5e1; border-radius:7px; background:#fff; color:#111827; font-size:13px; }
  .student-modal-field .form-control:focus,.student-modal-field .form-select:focus { border-color:#82ade7; box-shadow:0 0 0 3px rgba(57,121,214,.12); }
  .student-modal-field .is-invalid { border-color:#dc3545; background:#fff8f8; }
  .student-modal-field-error { display:none; color:#c33d48; font-size:9px; }
  .student-modal-field-error:not(:empty) { display:block; }
  .student-modal-bus-toggle { display:flex; align-items:center; gap:10px; margin:0 0 13px; padding:11px 12px; border:1px solid #dce8f7; border-radius:9px; background:#f6f9ff; cursor:pointer; }
  .student-modal-bus-icon { display:grid; width:32px; height:32px; flex:0 0 32px; place-items:center; border-radius:10px; background:#e4efff; color:#2f67b8; font-size:12px; font-weight:900; }
  .student-modal-bus-toggle > span:nth-child(2) { display:grid; flex:1; gap:3px; }
  .student-modal-bus-toggle strong { color:#1f2937; font-size:12px; }
  .student-modal-bus-toggle small { color:#4b5563; font-size:10px; }
  .student-modal-bus-toggle input { width:17px; height:17px; accent-color:#3979d6; }
  .student-modal-transport-fields { display:grid; grid-template-columns:minmax(0,1fr) 175px; gap:13px; align-items:end; }
  .student-modal-route-help { color:#4b5563; font-size:10px; }
  .student-modal-route-fare { display:grid; min-height:59px; align-content:center; gap:4px; padding:9px 12px; border:1px solid #e5ebf3; border-radius:8px; background:#fbfdff; }
  .student-modal-route-fare span { color:#4b5563; font-size:10px; }
  .student-modal-route-fare strong { color:#111827; font-size:16px; }
  .student-modal-required-note { margin:0; color:#4b5563; font-size:10px; }
  .student-modal-error-summary { padding:10px 12px; border:1px solid #f0c5c8; border-radius:9px; background:#fff6f6; color:#a4323d; font-size:10px; }
  .student-modal-error-summary strong { display:block; margin-bottom:3px; }
  .student-modal-footer { display:flex; justify-content:space-between; gap:12px; padding:13px 25px; border-top:1px solid #eaf0f6; background:#fbfcfe; }
  .student-modal-footer > div { display:flex; gap:8px; }
  .student-modal-more-link { align-self:center; color:#334155; font-size:11px; font-weight:700; text-decoration:none; }
  .student-modal-more-link:hover { color:#285a9a; }
  .student-modal-cancel,.student-modal-submit { min-height:42px; padding:10px 16px; border-radius:7px; font-size:12px; font-weight:750; }
  .student-modal-cancel { border:1px solid #dde5ef; background:#fff; color:#54677f; }
  .student-modal-submit { min-width:115px; border:1px solid #326dc0; background:#3979d6; color:#fff; }
  .student-modal-submit:hover { background:#306dc4; color:#fff; }
  .student-submit-spinner { display:inline-block; width:14px; height:14px; border:2px solid rgba(255,255,255,.5); border-top-color:#fff; border-radius:50%; animation:student-modal-spin .7s linear infinite; }
  .student-submit-spinner[hidden] { display:none !important; }
  .nepali-datepicker { cursor:pointer; }
  .nepali-datepicker + .ndp-nepali-calendar { z-index:2100; }
  body.student-admission-modal-open { overflow:hidden; }
  @keyframes student-modal-spin { to { transform:rotate(360deg); } }
  @media(max-width:1100px) { .student-register-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } .student-register-panel-heading { align-items:flex-start; flex-direction:column; } .student-register-filters { width:100%; } .student-search-box { flex:1; } }
  @media(max-width:680px) { .student-register-page .fee-page-main { padding:20px 13px 35px; } .student-register-hero { align-items:flex-start; flex-direction:column; padding:19px; } .student-register-actions { width:100%; } .student-register-actions .btn { flex:1; } .student-register-title-row h1 { font-size:21px; } .student-register-title-row p { line-height:1.5; } .student-register-stats { gap:9px; } .student-stat-card { min-height:91px; grid-template-columns:32px 1fr; column-gap:8px; padding:12px 10px; } .student-stat-icon { width:31px; height:31px; border-radius:9px; font-size:13px; } .student-stat-card strong { font-size:19px; } .student-stat-label { font-size:9px; } .student-stat-card small { font-size:8px; } .student-register-panel-heading { padding:15px; } .student-register-filters { display:grid; grid-template-columns:1fr 1fr; } .student-search-box { grid-column:1 / -1; min-width:0; } .student-register-footer { padding:11px 14px; font-size:8px; } .student-admission-modal { padding:8px; } .student-modal-dialog,.student-modal-content { max-height:calc(100vh - 16px); } .student-modal-header,.student-modal-body,.student-modal-footer { padding-left:14px; padding-right:14px; } .student-modal-fields { grid-template-columns:1fr; } .student-modal-transport-fields { grid-template-columns:1fr; } .student-modal-route-fare { min-height:52px; } .student-modal-footer { align-items:stretch; flex-direction:column; } .student-modal-more-link { order:2; } .student-modal-footer > div { justify-content:flex-end; } }
</style>

<script src="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/js/nepali.datepicker.v5.0.6.min.js"></script>
<script>
  (() => {
    const search = document.getElementById('studentSearch');
    const classFilter = document.getElementById('classFilter');
    const statusFilter = document.getElementById('statusFilter');
    const studentRows = [...document.querySelectorAll('.student-register-row')];
    const searchEmpty = document.getElementById('studentSearchEmpty');
    const resultCount = document.getElementById('studentResultCount');
    const totalStudents = studentRows.length;
    const filterRows = () => {
      const query = search.value.trim().toLowerCase();
      const classId = classFilter.value;
      const status = statusFilter.value;
      let visible = 0;
      studentRows.forEach(row => {
        const matches = (!query || row.dataset.name.includes(query) || row.dataset.code.includes(query))
          && (!classId || row.dataset.class === classId)
          && (!status || row.dataset.status === status);
        row.hidden = !matches;
        if (matches) visible += 1;
      });
      searchEmpty.hidden = visible > 0 || !totalStudents;
      resultCount.innerHTML = `Showing <strong>${visible}</strong> of <strong>${totalStudents}</strong> students`;
    };
    [search, classFilter, statusFilter].forEach(control => control.addEventListener('input', filterRows));
    [classFilter, statusFilter].forEach(control => control.addEventListener('change', filterRows));

    const notice = document.getElementById('studentRegisterNotice');
    const modal = document.getElementById('studentAdmissionModal');
    const form = document.getElementById('studentAdmissionModalForm');
    const session = document.getElementById('modalStudentSession');
    const bus = document.getElementById('modalUsesSchoolBus');
    const route = document.getElementById('modalTransportRoute');
    const fare = document.getElementById('modalRouteFare');
    const routeHelp = document.getElementById('modalRouteHelp');
    const submit = document.getElementById('studentModalSubmit');
    const submitLabel = submit.querySelector('.student-submit-label');
    const spinner = submit.querySelector('.student-submit-spinner');
    const errorSummary = document.getElementById('studentModalErrorSummary');
    const requiredRouteMark = document.getElementById('modalRouteRequired');
    const openButtons = [...document.querySelectorAll('[data-open-student-modal]')];
    let lastModalTrigger = null;
    const defaultAdmissionDateBS = '<%= todayBS %>';
    document.getElementById('modalAdmissionDate').value = defaultAdmissionDateBS;

    const updateRoute = (filterRoutes = false) => {
      const sessionId = session.value;
      if (filterRoutes) {
        [...route.options].forEach(option => {
          if (option.value) option.hidden = !sessionId || option.dataset.session !== sessionId;
        });
        if (!sessionId || route.selectedOptions[0]?.dataset.session !== sessionId) route.value = '';
      }
      route.disabled = !bus.checked || !sessionId;
      route.required = bus.checked;
      requiredRouteMark.hidden = !bus.checked;
      routeHelp.textContent = !bus.checked
        ? 'No transport route will be billed while school bus is switched off.'
        : !sessionId
          ? 'Select an academic session to see its routes.'
          : route.options.length > 1
            ? 'Routes are filtered to the selected academic session.'
            : 'No routes configured. Add one in Transport fee setup.';
      const selectedRoute = route.selectedOptions[0];
      fare.textContent = bus.checked && selectedRoute && selectedRoute.value
        ? `Rs. ${Number(selectedRoute.dataset.fee).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
        : bus.checked ? 'Select a route' : 'Not applicable';
      if (!bus.checked) clearFieldError('transportRoute');
    };
    const clearFieldError = name => {
      const field = form.elements.namedItem(name);
      if (field) field.classList.remove('is-invalid');
      const error = form.querySelector(`[data-error-for="${name}"]`);
      if (error) error.textContent = '';
    };
    const showFieldErrors = fieldErrors => {
      Object.entries(fieldErrors || {}).forEach(([name, message]) => {
        const field = form.elements.namedItem(name);
        if (field) field.classList.add('is-invalid');
        const error = form.querySelector(`[data-error-for="${name}"]`);
        if (error) error.textContent = message;
      });
      const messages = Object.values(fieldErrors || {});
      errorSummary.hidden = false;
      errorSummary.replaceChildren();
      const heading = document.createElement('strong');
      heading.textContent = 'Please review the highlighted information.';
      errorSummary.appendChild(heading);
      messages.forEach(message => {
        const line = document.createElement('div');
        line.textContent = message;
        errorSummary.appendChild(line);
      });
    };
    const resetErrors = () => {
      form.querySelectorAll('.is-invalid').forEach(field => field.classList.remove('is-invalid'));
      form.querySelectorAll('.student-modal-field-error').forEach(error => { error.textContent = ''; });
      errorSummary.hidden = true;
      errorSummary.replaceChildren();
    };
    const openAdmissionModal = trigger => {
      lastModalTrigger = trigger;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('student-admission-modal-open');
      updateRoute(true);
      window.requestAnimationFrame(() => document.getElementById('modalStudentCode').focus());
    };
    const closeAdmissionModal = () => {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('student-admission-modal-open');
      form.reset();
      resetErrors();
      document.getElementById('modalAdmissionDate').value = defaultAdmissionDateBS;
      session.value = '<%= currentSession ? String(currentSession._id) : '' %>';
      bus.checked = true;
      updateRoute(true);
      if (lastModalTrigger) lastModalTrigger.focus();
    };

    bus.addEventListener('change', () => updateRoute());
    session.addEventListener('change', () => updateRoute(true));
    route.addEventListener('change', () => updateRoute());
    form.addEventListener('input', event => {
      if (event.target.name) clearFieldError(event.target.name);
    });
    form.addEventListener('change', event => {
      if (event.target.name) clearFieldError(event.target.name);
    });
    form.addEventListener('submit', async event => {
      event.preventDefault();
      resetErrors();
      const invalidFields = [...form.querySelectorAll('[required]')].filter(field => !field.disabled && !field.checkValidity());
      if (invalidFields.length) {
        const fieldErrors = {};
        invalidFields.forEach(field => {
          field.classList.add('is-invalid');
          const label = form.querySelector(`label[for="${field.id}"]`);
          fieldErrors[field.name] = field.name === 'admissionDateBS'
            ? 'Enter a valid Nepali date in YYYY-MM-DD format.'
            : `${label ? label.textContent.replace('*', '').trim() : 'This field'} is required.`;
        });
        showFieldErrors(fieldErrors);
        invalidFields[0].focus();
        return;
      }

      submit.disabled = true;
      submitLabel.textContent = 'Saving…';
      spinner.hidden = false;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form)),
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          },
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
          if (result.fieldErrors) showFieldErrors(result.fieldErrors);
          else throw new Error(result.error || 'Unable to save the student. Please try again.');
          return;
        }
        sessionStorage.setItem('student-register-notice', 'Student admission saved successfully.');
        window.location.assign('/students');
      } catch (error) {
        errorSummary.hidden = false;
        errorSummary.textContent = error.message || 'Unable to save the student. Please try again.';
      } finally {
        submit.disabled = false;
        submitLabel.textContent = 'Save student';
        spinner.hidden = true;
      }
    });
    openButtons.forEach(button => button.addEventListener('click', () => openAdmissionModal(button)));
    modal.querySelectorAll('[data-close-student-modal]').forEach(button => {
      button.addEventListener('click', closeAdmissionModal);
    });
    document.addEventListener('keydown', event => {
      if (modal.hidden) return;
      if (event.key === 'Escape') {
        closeAdmissionModal();
      } else if (event.key === 'Tab') {
        const focusable = [...modal.querySelectorAll('button:not(:disabled), input:not(:disabled), select:not(:disabled), a[href]')]
          .filter(element => !element.hidden);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
    const savedNotice = sessionStorage.getItem('student-register-notice');
    if (savedNotice) {
      notice.textContent = savedNotice;
      notice.hidden = false;
      sessionStorage.removeItem('student-register-notice');
    }
    const admissionDateInput = document.getElementById('modalAdmissionDate');
    if (typeof admissionDateInput.nepaliDatePicker === 'function') {
      admissionDateInput.nepaliDatePicker({ dateFormat: 'YYYY-MM-DD', language: 'en' });
    }
    updateRoute(true);
  })();
</script>
<%- include('../partials/footer') %>
