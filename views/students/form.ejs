<%- include('../partials/head', { title: student ? 'Edit Student' : 'New Student' }) %>
<%- include('../partials/navbar') %>
<div class="fee-page-shell"><%- include('../billingfirst/feesidenav') %><main class="fee-page-main"><div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h3 class="mb-0"><%= student ? 'Edit Student' : 'New Student' %></h3>
    <% if (!student) { %>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-primary" href="/students/import-template.csv">Download CSV Template</a>
      <button class="btn btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#csvImportPanel">Upload CSV</button>
    </div>
    <% } %>
  </div>
  <% if (importResult) { %>
  <div class="alert alert-<%= importResult.errors.length ? 'warning' : 'success' %>">
    Imported <strong><%= importResult.inserted %></strong> student(s); skipped <strong><%= importResult.skipped %></strong>.
    <% if (importResult.errors.length) { %><ul class="mb-0 mt-2"><% importResult.errors.slice(0, 10).forEach(error => { %><li><%= error %></li><% }) %></ul><% } %>
  </div>
  <% } %>
  <% if (!student) { %>
  <div id="csvImportPanel" class="collapse mb-3">
    <form method="POST" action="/students/import-csv" enctype="multipart/form-data" class="bg-white p-3 rounded shadow-sm">
      <label for="studentCsv" class="form-label">Student CSV file</label>
      <input id="studentCsv" name="studentCsv" type="file" accept=".csv,text/csv" class="form-control" required>
      <div class="form-text">Required columns: studentCode, name, class, admissionDateAD, academicSession. Class and academic session must match existing records.</div>
      <button type="submit" class="btn btn-success mt-3">Import Students</button>
    </form>
  </div>
  <% } %>
  <form method="POST" action="<%= student ? '/students/' + student._id : '/students' %>" class="bg-white p-4 rounded shadow-sm">
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label">Student Code (old roll no.)</label>
        <input type="text" name="studentCode" class="form-control" value="<%= student ? student.studentCode : '' %>" required>
      </div>
      <div class="col-md-8">
        <label class="form-label">Full Name</label>
        <input type="text" name="name" class="form-control" value="<%= student ? student.name : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Class</label>
        <select name="class" class="form-select" required>
          <% classes.forEach(c => { %>
          <option value="<%= c._id %>" <%= student && student.class && String(student.class._id) === String(c._id) ? 'selected' : '' %>><%= c.studentClass %>-<%= c.section %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Section</label>
        <input type="text" name="section" class="form-control" value="<%= student ? student.section : '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Academic Session</label>
        <select name="academicSession" class="form-select" required>
          <% sessions.forEach(s => { %>
          <option value="<%= s._id %>" <%= student && student.academicSession && String(student.academicSession._id) === String(s._id) ? 'selected' : '' %>><%= s.titleBS %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Guardian Name</label>
        <input type="text" name="guardianName" class="form-control" value="<%= student ? student.guardianName : '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label">Guardian Phone</label>
        <input type="text" name="guardianPhone" class="form-control" value="<%= student ? student.guardianPhone : '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label">Admission Date</label>
        <input type="date" name="admissionDateAD" class="form-control"
          value="<%= student ? student.admissionDateAD.toISOString().slice(0,10) : '' %>" required>
        <div class="form-text">If the student joins partway through the session, bills for earlier months are skipped automatically.</div>
      </div>
      <% if (student) { %>
      <div class="col-md-6">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="ACTIVE" <%= student.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
          <option value="INACTIVE" <%= student.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
          <option value="TRANSFERRED" <%= student.status === 'TRANSFERRED' ? 'selected' : '' %>>Transferred</option>
        </select>
      </div>
      <% } %>
    </div>

    <% if (!student) { %>
    <hr>
    <h5>Migrating from old software?</h5>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" name="migratedFromOldSystem" id="migrated"
        onclick="document.getElementById('openingDueFields').classList.toggle('d-none')">
      <label class="form-check-label" for="migrated">This student has an existing due from the old system</label>
    </div>
    <div id="openingDueFields" class="row g-3 d-none">
      <div class="col-md-4">
        <label class="form-label">Opening Due Amount (Rs)</label>
        <input type="number" step="0.01" name="openingDueAmount" class="form-control">
      </div>
      <div class="col-md-4">
        <label class="form-label">As Of Date</label>
        <input type="date" name="openingDueAsOfDate" class="form-control">
      </div>
      <div class="col-md-4">
        <label class="form-label">Note</label>
        <input type="text" name="openingDueNote" class="form-control" placeholder="Migrated from XYZ software">
      </div>
    </div>
    <% } %>

    <button type="submit" class="btn btn-primary mt-4">Save Student</button>
  </form>
</div>
 </main></div>
<%- include('../partials/footer') %>
