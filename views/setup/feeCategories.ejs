<%- include('../partials/head', { title: 'Fee Categories' }) %>
<%- include('../partials/navbar') %>
<div class="container mt-4">
  <h3>Fee Categories</h3>
  <div class="row">
    <div class="col-md-5">
      <form method="POST" action="/setup/fee-categories" class="bg-white p-3 rounded shadow-sm">
        <div class="mb-2"><label class="form-label">Name</label><input class="form-control" name="name" required placeholder="Tuition Fee"></div>
        <div class="mb-2">
          <label class="form-label">Frequency</label>
          <select class="form-select" name="frequency" required>
            <option value="MONTHLY">Monthly</option>
            <option value="ONE_TIME">One Time (e.g. Admission Fee)</option>
            <option value="ANNUAL">Annual</option>
            <option value="QUARTERLY">Quarterly</option>
          </select>
        </div>
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" name="isTaxable" id="isTaxable">
          <label class="form-check-label" for="isTaxable">Taxable</label>
        </div>
        <button class="btn btn-primary">Add Category</button>
      </form>
    </div>
    <div class="col-md-7">
      <table class="table table-bordered bg-white">
        <thead><tr><th>Name</th><th>Frequency</th></tr></thead>
        <tbody>
          <% feeCategories.forEach(f => { %>
          <tr><td><%= f.name %></td><td><%= f.frequency %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
