<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= invoice.invoiceNo %></title><style>body{margin:0;padding:35px;background:#f4f7fb;color:#17233b;font-family:"Segoe UI",Arial,sans-serif}.receipt{max-width:760px;margin:auto;background:#fff;padding:35px;border:1px solid #e4eaf3;border-radius:12px}h1{color:#07152f}.meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;color:#71809b;font-size:13px}table{width:100%;margin:25px 0;border-collapse:collapse}th,td{text-align:left;padding:12px;border-bottom:1px solid #e4eaf3}th{color:#71809b;font-size:11px;text-transform:uppercase}.right{text-align:right}.button{display:inline-block;padding:10px 15px;background:#07152f;color:#fff;text-decoration:none;border-radius:7px}@media print{body{background:#fff;padding:0}.button{display:none}}</style></head><body><article class="receipt"><h1>Fee Invoice</h1><p><strong><%= invoice.invoiceNo %></strong></p><div class="meta"><span>Student: <strong><%= invoice.studentName %></strong></span><span>Registration: <%= invoice.reg %></span><span>Class: <%= invoice.studentClass %>-<%= invoice.section %></span><span>Period: <%= invoice.academicYear %> · <%= invoice.nepaliMonth %></span></div><table><thead><tr><th>Fee head</th><th class="right">Amount (NPR)</th></tr></thead><tbody><% invoice.items.forEach(item=>{ %><tr><td><%= item.feehead %></td><td class="right"><%= Number(item.amount).toFixed(2) %></td></tr><% }) %><tr><td>Discount</td><td class="right">- <%= Number(invoice.discount).toFixed(2) %></td></tr><tr><th>Total</th><th class="right">NPR <%= Number(invoice.totalAmount).toFixed(2) %></th></tr><tr><td>Paid</td><td class="right">NPR <%= Number(invoice.paidAmount).toFixed(2) %></td></tr><tr><th>Balance</th><th class="right">NPR <%= (invoice.totalAmount-invoice.paidAmount).toFixed(2) %></th></tr></tbody></table><p><%= invoice.notes || '' %></p><a class="button" href="/fee-payments">Collect payment</a> <a class="button" href="javascript:window.print()">Print</a></article></body></html>
