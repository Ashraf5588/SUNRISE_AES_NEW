<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= payment.receiptNo %></title><style>body{margin:0;padding:35px;background:#f4f7fb;color:#17233b;font-family:"Segoe UI",Arial,sans-serif}.receipt{max-width:650px;margin:auto;background:#fff;padding:35px;border:1px solid #e4eaf3;border-radius:12px}h1{margin-bottom:4px;color:#07152f}.muted{color:#71809b;font-size:13px}.row{display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid #e4eaf3}.total{font-size:22px;font-weight:800;color:#159570}.button{display:inline-block;margin-top:22px;padding:10px 15px;background:#07152f;color:#fff;text-decoration:none;border-radius:7px}@media print{body{background:#fff;padding:0}.button{display:none}}</style></head><body><article class="receipt"><h1>Payment Receipt</h1><p class="muted"><%= payment.receiptNo %> · <%= new Date(payment.paidAt).toLocaleString('en-GB') %></p><div class="row"><span>Student</span><strong><%= payment.studentName %></strong></div><div class="row"><span>Registration</span><strong><%= payment.reg %></strong></div><div class="row"><span>Invoice</span><strong><%= invoice ? invoice.invoiceNo : '-' %></strong></div><div class="row"><span>Payment method</span><strong><%= payment.paymentMethod %></strong></div><div class="row total"><span>Received</span><span>NPR <%= Number(payment.amount).toFixed(2) %></span></div><p class="muted">Received by: <%= payment.receivedBy || '-' %><br>Reference: <%= payment.referenceNo || '-' %><br><%= payment.remarks || '' %></p><a class="button" href="javascript:window.print()">Print receipt</a> <a class="button" href="/fee-payments">Back to payments</a></article></body></html>
