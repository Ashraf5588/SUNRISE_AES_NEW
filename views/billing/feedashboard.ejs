<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fee Dashboard</title>
  <style>
    :root { --navy:#07152f; --navy2:#0d2854; --blue:#3b82f6; --pale:#edf4ff; --ink:#17233b; --muted:#71809b; --line:#e5ebf4; --page:#f4f7fb; --green:#159570; --orange:#dc8a32; --red:#d6535d; --shadow:0 14px 34px rgba(13,35,71,.08); }
    * { box-sizing:border-box; } body { margin:0; background:var(--page); color:var(--ink); font-family:"Segoe UI",Arial,sans-serif; }
    .fee-shell { min-height:100vh; padding-left:268px; }
    .fee-main { max-width:1500px; margin:0 auto; padding:34px 40px 46px; } .fee-topbar { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:28px; } .fee-eyebrow { margin:0 0 7px; color:var(--blue); font-size:11px; font-weight:800; letter-spacing:1.3px; text-transform:uppercase; } h1 { margin:0; color:var(--navy); font-size:clamp(26px,3vw,34px); letter-spacing:-.8px; } .fee-subtitle { margin:8px 0 0; color:var(--muted); font-size:14px; } .fee-date { padding:10px 14px; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--muted); font-size:12px; box-shadow:0 4px 14px rgba(13,35,71,.04); }
    .fee-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:22px; } .fee-card { border:1px solid var(--line); border-radius:14px; background:#fff; box-shadow:var(--shadow); } .fee-kpi { position:relative; min-height:135px; padding:20px; overflow:hidden; } .fee-kpi-label { color:var(--muted); font-size:12px; font-weight:700; } .fee-kpi-value { margin-top:14px; color:var(--navy); font-size:27px; font-weight:750; } .fee-kpi-note { margin-top:5px; color:var(--green); font-size:11px; font-weight:700; } .fee-kpi-icon { position:absolute; top:18px; right:18px; display:grid; place-items:center; width:32px; height:32px; border-radius:9px; background:var(--pale); color:var(--blue); font-weight:800; }
    .fee-grid { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(280px,.8fr); gap:18px; margin-bottom:18px; } .fee-panel { padding:20px; } .fee-panel-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:20px; } .fee-panel-heading h2 { margin:0; color:var(--navy); font-size:15px; } .fee-panel-heading span { color:var(--muted); font-size:11px; }
    .fee-chart { display:flex; align-items:flex-end; gap:clamp(8px,2vw,18px); height:220px; padding:18px 8px 0; border-bottom:1px solid var(--line); background:repeating-linear-gradient(to bottom,transparent 0,transparent 54px,#eef2f8 55px); } .fee-bar-group { display:flex; flex:1; align-items:center; flex-direction:column; gap:8px; height:100%; justify-content:flex-end; } .fee-bar { width:min(34px,70%); min-height:18px; border-radius:7px 7px 2px 2px; background:linear-gradient(180deg,#5d9bff,#2868d5); } .fee-bar.alt { background:linear-gradient(180deg,#77d1b2,#1c9a70); } .fee-bar-label { color:var(--muted); font-size:10px; } .fee-legend { display:flex; gap:18px; margin-top:15px; color:var(--muted); font-size:11px; } .fee-legend i { display:inline-block; width:8px; height:8px; margin-right:5px; border-radius:2px; background:var(--blue); } .fee-legend i.alt { background:var(--green); }
    .fee-donut-wrap { display:grid; place-items:center; min-height:220px; } .fee-donut { display:grid; place-items:center; width:158px; height:158px; border-radius:50%; background:conic-gradient(var(--blue) 0 62%,var(--green) 62% 82%,#f2b55d 82% 100%); } .fee-donut:after { display:grid; place-items:center; width:105px; height:105px; border-radius:50%; background:#fff; color:var(--navy); content:"62%\A collected"; white-space:pre; text-align:center; font-size:14px; font-weight:800; } .fee-summary { display:grid; gap:10px; width:100%; } .fee-summary-row { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:12px; } .fee-summary-row strong { color:var(--ink); } .fee-summary-row i { display:inline-block; width:8px; height:8px; margin-right:6px; border-radius:50%; background:var(--blue); } .fee-summary-row i.green { background:var(--green); } .fee-summary-row i.orange { background:#f2b55d; }
    .fee-table { width:100%; border-collapse:collapse; font-size:12px; } .fee-table th { padding:0 10px 12px; color:var(--muted); font-size:10px; letter-spacing:.6px; text-align:left; text-transform:uppercase; } .fee-table td { padding:13px 10px; border-top:1px solid var(--line); } .fee-table td:last-child,.fee-table th:last-child { text-align:right; } .fee-person { display:flex; align-items:center; gap:9px; font-weight:700; } .fee-avatar { display:grid; place-items:center; width:28px; height:28px; border-radius:9px; background:var(--pale); color:var(--blue); font-size:11px; } .fee-badge { display:inline-block; padding:4px 7px; border-radius:5px; background:#e8f8f2; color:var(--green); font-size:10px; font-weight:800; } .fee-badge.pending { background:#fff3e5; color:var(--orange); } .fee-badge.overdue { background:#ffeaec; color:var(--red); }
    @media (max-width:1050px) { .fee-kpis { grid-template-columns:repeat(2,1fr); } .fee-grid { grid-template-columns:1fr; } } @media (max-width:760px) { .fee-shell { padding-left:0; } .fee-main { padding:25px 16px 35px; } .fee-topbar { flex-direction:column; } } @media (max-width:480px) { .fee-kpis { grid-template-columns:1fr; } .fee-panel { overflow-x:auto; } }
  </style>
</head>
<body>
  <div class="fee-shell">
    <%- include('feesidenav') %>
    <main class="fee-main">
      <header class="fee-topbar"><div><p class="fee-eyebrow">Finance overview</p><h1>Fee dashboard</h1><p class="fee-subtitle">A clear view of collections, pending balances, and recent activity.</p></div><div class="fee-date">Today · 06 September 2026</div></header>
      <section class="fee-kpis"><article class="fee-card fee-kpi"><span class="fee-kpi-icon">♙</span><div class="fee-kpi-label">Total students</div><div class="fee-kpi-value">1,248</div><div class="fee-kpi-note">+4.8% this term</div></article><article class="fee-card fee-kpi"><span class="fee-kpi-icon">↗</span><div class="fee-kpi-label">Collection today</div><div class="fee-kpi-value">Rs. 84,650</div><div class="fee-kpi-note">+12.6% vs yesterday</div></article><article class="fee-card fee-kpi"><span class="fee-kpi-icon">▣</span><div class="fee-kpi-label">Total fee billed</div><div class="fee-kpi-value">Rs. 8.42M</div><div class="fee-kpi-note">For current session</div></article><article class="fee-card fee-kpi"><span class="fee-kpi-icon">!</span><div class="fee-kpi-label">Pending fee</div><div class="fee-kpi-value">Rs. 1.16M</div><div class="fee-kpi-note" style="color:var(--red)">Review required</div></article></section>
      <section class="fee-grid"><article class="fee-card fee-panel"><div class="fee-panel-heading"><h2>Fee collection trend</h2><span>Last 7 months</span></div><div class="fee-chart"><% ['Mar','Apr','May','Jun','Jul','Aug','Sep'].forEach((month,index) => { %><div class="fee-bar-group"><div class="fee-bar <%= index % 2 ? 'alt' : '' %>" style="height:<%= [42,56,50,68,62,79,88][index] %>%"></div><span class="fee-bar-label"><%= month %></span></div><% }) %></div><div class="fee-legend"><span><i></i>Collected</span><span><i class="alt"></i>Target</span></div></article><article class="fee-card fee-panel"><div class="fee-panel-heading"><h2>Income and expense</h2><span>Current session</span></div><div class="fee-donut-wrap"><div class="fee-donut"></div></div><div class="fee-summary"><div class="fee-summary-row"><span><i></i>Fee income</span><strong>Rs. 8.42M</strong></div><div class="fee-summary-row"><span><i class="green"></i>Other income</span><strong>Rs. 1.06M</strong></div><div class="fee-summary-row"><span><i class="orange"></i>Expenses</span><strong>Rs. 2.18M</strong></div></div></article></section>
      <section class="fee-grid"><article class="fee-card fee-panel"><div class="fee-panel-heading"><h2>Recent transactions</h2><span>Latest activity</span></div><table class="fee-table"><thead><tr><th>Student</th><th>Fee head</th><th>Status</th><th>Amount</th></tr></thead><tbody><tr><td><div class="fee-person"><span class="fee-avatar">AS</span>Anisha Shrestha</div></td><td>Tuition fee</td><td><span class="fee-badge">Paid</span></td><td>Rs. 12,500</td></tr><tr><td><div class="fee-person"><span class="fee-avatar">RK</span>Rohan Karki</div></td><td>Transport</td><td><span class="fee-badge">Paid</span></td><td>Rs. 4,200</td></tr><tr><td><div class="fee-person"><span class="fee-avatar">SP</span>Smriti Poudel</div></td><td>Exam fee</td><td><span class="fee-badge pending">Pending</span></td><td>Rs. 2,800</td></tr></tbody></table></article><article class="fee-card fee-panel"><div class="fee-panel-heading"><h2>Defaulters</h2><span>Needs attention</span></div><table class="fee-table"><thead><tr><th>Student</th><th>Due</th></tr></thead><tbody><tr><td><div class="fee-person"><span class="fee-avatar">BP</span>Bibek Panta</div></td><td><span class="fee-badge overdue">Rs. 18,400</span></td></tr><tr><td><div class="fee-person"><span class="fee-avatar">NM</span>Nisha Magar</div></td><td><span class="fee-badge overdue">Rs. 9,750</span></td></tr><tr><td><div class="fee-person"><span class="fee-avatar">KS</span>Kiran Shah</div></td><td><span class="fee-badge pending">Rs. 6,200</span></td></tr></tbody></table></article></section>
    </main>
  </div>
</body>
</html>
