<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Fee Structure</title>
	<style>
		:root { --navy:#07152f; --blue:#3b82f6; --ink:#17233b; --muted:#71809b; --line:#e4eaf3; --page:#f4f7fb; --danger:#c43d4d; }
		* { box-sizing:border-box; }
		body { margin:0; background:var(--page); color:var(--ink); font-family:"Segoe UI",Arial,sans-serif; }
		.fee-main { min-height:100vh; margin-left:268px; padding:34px 40px 46px; }
		.fee-content { max-width:1500px; margin:0 auto; }
		.fee-heading { margin-bottom:24px; }
		.fee-eyebrow { margin:0 0 7px; color:var(--blue); font-size:11px; font-weight:800; letter-spacing:1.3px; text-transform:uppercase; }
		h1 { margin:0; color:var(--navy); font-size:32px; letter-spacing:-.8px; }
		.fee-subtitle { margin:8px 0 0; color:var(--muted); font-size:14px; }
		.fee-panel { border:1px solid var(--line); border-radius:14px; background:#fff; box-shadow:0 14px 34px rgba(13,35,71,.08); }
		.fee-form-panel { padding:24px; }
		.fee-panel-title { margin:0 0 20px; color:var(--navy); font-size:16px; }
		.fee-form-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:18px 22px; }
		.fee-field { display:grid; gap:7px; }
		.fee-field label, .field-label { color:var(--muted); font-size:12px; font-weight:750; }
		.fee-field input, .fee-field select, .fee-field textarea { width:100%; padding:11px 13px; border:1px solid var(--line); border-radius:8px; color:var(--ink); font:inherit; outline:none; background:#fff; }
		.fee-field textarea { min-height:84px; resize:vertical; }
		.fee-field input:focus, .fee-field select:focus, .fee-field textarea:focus { border-color:var(--blue); box-shadow:0 0 0 3px rgba(59,130,246,.12); }
		.full-width { grid-column:1 / -1; }
		.class-field { display:grid; gap:10px; }
		.class-grid { display:grid; grid-template-columns:repeat(6, minmax(95px, 1fr)); gap:9px; }
		.class-option { display:flex; align-items:center; gap:8px; min-height:40px; padding:9px 10px; border:1px solid var(--line); border-radius:8px; cursor:pointer; font-size:12px; }
		.class-option:has(input:checked) { border-color:#9bc0ff; background:#f0f6ff; color:var(--blue); font-weight:700; }
		.class-option input { width:15px; height:15px; accent-color:var(--blue); }
		.form-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:22px; }
		.button { border:0; border-radius:8px; background:var(--navy); color:#fff; cursor:pointer; padding:11px 18px; font:700 13px inherit; text-decoration:none; }
		.button.secondary { background:#eef2f8; color:var(--ink); }
		.table-panel { margin-top:24px; overflow:hidden; }
		.table-heading { display:flex; align-items:center; justify-content:space-between; padding:20px 22px 15px; }
		.table-heading h2 { margin:0; color:var(--navy); font-size:16px; }
		.table-heading span { color:var(--muted); font-size:12px; }
		.table-scroll { overflow-x:auto; }
		.fee-table { width:100%; min-width:900px; border-collapse:collapse; font-size:12px; }
		.fee-table th { padding:0 14px 12px; color:var(--muted); font-size:10px; letter-spacing:.6px; text-align:left; text-transform:uppercase; white-space:nowrap; }
		.fee-table td { padding:14px; border-top:1px solid var(--line); white-space:nowrap; }
		.fee-table .classes { white-space:normal; min-width:180px; }
		.fee-actions { display:flex; align-items:center; gap:8px; }
		.fee-action { display:grid; place-items:center; width:30px; height:30px; border:0; border-radius:7px; color:#fff; cursor:pointer; text-decoration:none; font-size:15px; }
		.fee-action.edit { background:#007bff; }
		.fee-action.delete { background:#e3344b; }
		.empty-state { padding:30px 22px; color:var(--muted); text-align:center; }
		@media (max-width:760px) { .fee-main { margin-left:0; padding:25px 16px 35px; } .fee-form-grid { grid-template-columns:1fr; } .full-width { grid-column:auto; } .class-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); } }
	</style>
</head>
<body>
	<%- include('feesidenav') %>
	<main class="fee-main">
		<div class="fee-content">
			<header class="fee-heading"><p class="fee-eyebrow">Fee management</p><h1>Fee structure</h1><p class="fee-subtitle">Set amounts and assign each fee to one or more classes.</p></header>
			<section class="fee-panel fee-form-panel">
				<h2 class="fee-panel-title"><%= editFeeStructure ? 'Edit fee structure' : 'Add fee structure' %></h2>
				<form action="<%= editFeeStructure ? '/feestructure/' + editFeeStructure._id + '/edit' : '/feestructure' %>" method="POST">
					<div class="fee-form-grid">
						<div class="fee-field"><label for="feeheadId">Fee head</label><select id="feeheadId" name="feeheadId" required><option value="">Select fee head</option><% feeheads.forEach((item) => { %><option value="<%= item._id %>" <%= editFeeStructure && String(editFeeStructure.feeheadId) === String(item._id) ? 'selected' : '' %>><%= item.feehead %></option><% }) %></select></div>
						<div class="fee-field"><label for="amount">Amount</label><input type="number" id="amount" name="amount" min="0" step="0.01" value="<%= editFeeStructure ? editFeeStructure.amount : '' %>" placeholder="e.g. 2500" required></div>
						<div class="fee-field"><label for="frequency">Frequency</label><select id="frequency" name="frequency" required><option value="">Select frequency</option><% ['monthly','quarterly','half-yearly','yearly','one-time'].forEach((item) => { %><option value="<%= item %>" <%= editFeeStructure && editFeeStructure.frequency === item ? 'selected' : '' %>><%= item.replace('-', ' ').replace(/\b\w/g, character => character.toUpperCase()) %></option><% }) %></select></div>
						<div class="fee-field"><label for="group">Group</label><input type="text" id="group" name="group" value="<%= editFeeStructure ? editFeeStructure.group : '' %>" placeholder="e.g. Academic" required></div>
						<div class="class-field full-width"><span class="field-label">Apply for class</span><div class="class-grid"><% classes.forEach((className) => { %><label class="class-option"><input type="checkbox" name="forClasses" value="<%= className %>" <%= editFeeStructure && (editFeeStructure.forClasses || []).includes(className) ? 'checked' : '' %>><span><%= className %></span></label><% }) %></div></div>
						<div class="fee-field full-width"><label for="description">Description</label><textarea id="description" name="description" placeholder="Optional details"><%= editFeeStructure ? editFeeStructure.description || '' : '' %></textarea></div>
					</div>
					<div class="form-actions"><% if (editFeeStructure) { %><a class="button secondary" href="/feestructure">Cancel</a><% } %><button class="button" type="submit"><%= editFeeStructure ? 'Update fee structure' : 'Save fee structure' %></button></div>
				</form>
			</section>
			<section class="fee-panel table-panel">
				<div class="table-heading"><h2>Saved fee structures</h2><span><%= feeStructures.length %> saved</span></div>
				<% if (feeStructures.length) { %><div class="table-scroll"><table class="fee-table"><thead><tr><th>SN</th><th>Fee head</th><th>Classes</th><th>Frequency</th><th>Group</th><th>Amount</th><th>Description</th><th>Actions</th></tr></thead><tbody><% feeStructures.forEach((item, index) => { %><tr><td><%= index + 1 %></td><td><strong><%= item.feehead %></strong></td><td class="classes"><%= (item.forClasses || []).join(', ') || '-' %></td><td><%= item.frequency %></td><td><%= item.group %></td><td><strong><%= Number(item.amount).toFixed(2) %></strong></td><td class="classes"><%= item.description || '-' %></td><td><div class="fee-actions"><a class="fee-action edit" href="/feestructure/<%= item._id %>/edit" title="Edit fee structure" aria-label="Edit fee structure">✎</a><form action="/feestructure/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Delete this fee structure?');"><button class="fee-action delete" type="submit" title="Delete fee structure" aria-label="Delete fee structure">⌫</button></form></div></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state">No fee structures have been added yet.</div><% } %>
			</section>
		</div>
	</main>
</body>
</html>
