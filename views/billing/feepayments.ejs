<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fee Payments</title><style>
:root{--navy:#07152f;--ink:#17233b;--muted:#71809b;--line:#e4eaf3;--page:#f4f7fb}*{box-sizing:border-box}body{margin:0;background:var(--page);color:var(--ink);font-family:"Segoe UI",Arial,sans-serif}.main{margin-left:268px;padding:34px 40px;max-width:1600px}.panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px;margin-bottom:22px;box-shadow:0 14px 34px #0d234712}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px 22px}.field{display:grid;gap:7px}.field label{font-size:12px;font-weight:700;color:var(--muted)}input,select,textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:8px;font:inherit}textarea{min-height:65px}.full{grid-column:1/-1}.button{border:0;border-radius:8px;background:var(--navy);color:#fff;padding:11px 18px;font-weight:700;cursor:pointer}.actions{display:flex;justify-content:flex-end;margin-top:20px}.scroll{overflow:auto}table{width:100%;min-width:800px;border-collapse:collapse;font-size:12px}th{padding:0 12px 12px;text-align:left;color:var(--muted);font-size:10px;text-transform:uppercase}td{padding:13px 12px;border-top:1px solid var(--line)}a{color:#3b82f6;font-weight:700;text-decoration:none}h1{color:var(--navy)}.sub{color:var(--muted);font-size:14px}@media(max-width:760px){.main{margin-left:0;padding:24px 16px}.grid{grid-template-columns:1fr}.full{grid-column:auto}}
</style></head><body><%- include('feesidenav') %><main class="main"><h1>Fee payments</h1><p class="sub">Collect cash, bank, online, or cheque payments and issue a receipt.</p><section class="panel"><form method="post" action="/fee-payments"><div class="grid"><div class="field full"><label>Invoice</label><select name="invoiceId" id="invoice" required><option value="">Select outstanding invoice</option><% invoices.forEach(item=>{ %><option value="<%= item._id %>" data-balance="<%= item.totalAmount-item.paidAmount %>"><%= item.invoiceNo %> · <%= item.studentName %> · Balance NPR <%= (item.totalAmount-item.paidAmount).toFixed(2) %></option><% }) %></select></div><div class="field"><label>Amount (NPR)</label><input id="amount" name="amount" type="number" min="0.01" step="0.01" required></div><div class="field"><label>Payment method</label><select name="paymentMethod" required><option value="">Select method</option><option>CASH</option><option>BANK</option><option>ONLINE</option><option>CHEQUE</option></select></div><div class="field"><label>Reference / cheque number</label><input name="referenceNo"></div><div class="field"><label>Remarks</label><input name="remarks"></div></div><div class="actions"><button class="button">Record payment and issue receipt</button></div></form></section><section class="panel"><h2>Recent receipts</h2><div class="scroll"><table><thead><tr><th>Receipt</th><th>Student</th><th>Amount</th><th>Method</th><th>Date</th><th>Action</th></tr></thead><tbody><% payments.forEach(item=>{ %><tr><td><%= item.receiptNo %></td><td><%= item.studentName %><br><%= item.reg %></td><td>NPR <%= Number(item.amount).toFixed(2) %></td><td><%= item.paymentMethod %></td><td><%= new Date(item.paidAt).toLocaleDateString('en-GB') %></td><td><a href="/fee-receipts/<%= item._id %>">Receipt</a></td></tr><% }) %><% if(!payments.length){ %><tr><td colspan="6">No payments recorded yet.</td></tr><% } %></tbody></table></div></section></main><script>const invoice=document.getElementById('invoice');const amount=document.getElementById('amount');invoice.addEventListener('change',()=>{amount.value=invoice.selectedOptions[0]?.dataset.balance||'';amount.max=amount.value});</script></body></html>
