<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Employee leave report</title>
	<link rel="stylesheet" href="/leave-management.css">
	<style>
		.report-filters { display:grid; grid-template-columns:minmax(140px,1fr) auto; align-items:end; gap:12px; }
		.report-field label { display:block; margin-bottom:6px; color:#3e4b46; font-size:13px; font-weight:700; }
		.report-field select,.report-field input { width:100%; min-height:43px; padding:9px 11px; border:1px solid #d7e1da; border-radius:4px; background:#fff; color:var(--leave-ink); }
		.employee-search { grid-column:1 / -1; }
		.employee-picker { grid-column:1 / -1; display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:7px; max-height:260px; overflow:auto; padding:10px; border:1px solid var(--leave-line); border-radius:5px; background:#fbfdfb; }
		.employee-choice { display:flex; align-items:center; gap:9px; min-width:0; padding:8px; border:1px solid var(--leave-line); border-radius:4px; background:#fff; cursor:pointer; }
		.employee-choice[hidden] { display:none; }
		.employee-choice input,.select-all-employees input { width:18px; min-height:18px; flex:0 0 auto; margin:0; accent-color:var(--leave-deep); }
		.employee-choice span { overflow-wrap:anywhere; font-size:12px; }
		.employee-choice small { color:var(--leave-muted); }
		.employee-picker-toolbar { display:flex; grid-column:1 / -1; align-items:center; justify-content:space-between; gap:8px; }
		.select-all-employees { display:inline-flex; align-items:center; gap:8px; font-size:12px; font-weight:700; }
		.selection-count { color:var(--leave-muted); font-size:12px; }
		.report-actions { display:flex; flex-wrap:wrap; gap:8px; }
		.report-button { display:inline-flex; min-height:40px; align-items:center; justify-content:center; padding:0 15px; border:1px solid var(--leave-deep); border-radius:4px; background:var(--leave-deep); color:#fff; cursor:pointer; font-weight:700; }
		.report-button.secondary { border-color:var(--leave-line); background:#fff; color:var(--leave-ink); }
		.report-message { margin:0; color:var(--leave-red); font-weight:700; }
		.report-sheet { padding:18px; border:1px solid var(--leave-line); border-radius:7px; background:#fff; box-shadow:0 7px 20px rgba(24,54,43,.045); }
		.report-title { margin:0 0 14px; font:800 20px Manrope,sans-serif; }
		.report-table-wrap { overflow-x:auto; }
		.report-table { width:100%; min-width:1120px; border-collapse:collapse; font-size:12px; }
		.report-table th,.report-table td { padding:8px 9px; border:1px solid #aeb8c2; text-align:left; vertical-align:middle; }
		.report-table thead { position:sticky; top:0; z-index:2; }
		.report-table thead th { background:#f2f6f3; color:#17212b; font-size:11px; font-weight:800; }
		.report-table .group-heading { text-align:center; }
		.report-table .employee-number,.report-table .summary-cell { text-align:center; vertical-align:middle; }
		.report-table .employee-number { font-weight:800; }
		.report-table .employee-name { min-width:125px; font-weight:800; }
		.report-table .detail-number,.report-table .duration-cell,.report-table .summary-cell { white-space:nowrap; }
		.report-table .reason-cell { min-width:130px; white-space:normal; overflow-wrap:anywhere; }
		.report-table .approver-cell { min-width:125px; white-space:normal; overflow-wrap:anywhere; }
		.report-table .date-cell { white-space:nowrap; }
		.report-table .summary-cell { min-width:130px; font-weight:700; }
		.balance-line,.balance-total { display:block; margin:2px 0; white-space:normal; }
		.balance-total { margin-top:7px; padding-top:5px; border-top:1px solid #cbd3da; }
		.report-table .leave-status { display:block; margin-top:3px; color:var(--leave-muted); font-size:10px; font-weight:700; }
		.report-table .empty-detail { color:var(--leave-muted); font-style:italic; }
		.status-badge { display:inline-block; padding:3px 7px; border-radius:99px; background:#edf2f7; color:#334155; font-size:10px; font-weight:800; }
		.status-badge.approved { background:#e8f5eb; color:#17633b; }
		.status-badge.pending { background:#fff5d9; color:#805c00; }
		.status-badge.rejected,.status-badge.reverted { background:#fff0ee; color:#993c32; }
		.report-empty { padding:18px; border:1px dashed var(--leave-line); color:var(--leave-muted); text-align:center; }
		.report-footnote { margin:12px 0 0; color:var(--leave-muted); font-size:11px; }
		@media(max-width:700px) {
			.report-filters { grid-template-columns:1fr; }
			.report-sheet { padding:12px 8px; }
			.report-actions .report-button { flex:1; }
		}
		@media print {
			@page { size:landscape; margin:12mm; }
			body { min-width:0; background:#fff !important; color:#111; font-size:10pt; print-color-adjust:exact; -webkit-print-color-adjust:exact; }
			body.employee-nav-visible .leave-shell,body.employee-nav-visible.employee-nav-collapsed .leave-shell,body.employee-nav-collapsed .leave-shell { width:100% !important; margin:0 !important; }
			.employee-sidenav,.leave-topbar,.leave-page-heading,.report-filter-panel,.screen-only { display:none !important; }
			.leave-main { width:100%; max-width:none; padding:0; }
			.report-sheet { padding:0; border:0; border-radius:0; box-shadow:none; }
			.report-title { margin-bottom:8px; }
			.report-table-wrap { overflow:visible; }
			.report-table { font-size:9pt; }
			.report-table th,.report-table td { padding:6px 7px; }
			.report-table thead { position:static; display:table-row-group; }
			.report-table tr { break-inside:avoid; }
		}
	</style>
</head>
<body>
	<%- include('../employee/employeesidenav', { currentPage: 'leave-report', selectedEmployee: null, isAdmin: true }) %>
	<div class="leave-shell">
		<header class="leave-topbar">
			<a class="leave-brand" href="/leave">Staff leave management</a>
			<nav aria-label="Leave navigation"><a href="/leave">Applications</a><a href="/leave/setup">Leave setup</a><a class="active" href="/leave/report">Leave report</a></nav>
		</header>
		<main class="leave-main">
			<header class="leave-page-heading"><div><p class="leave-eyebrow">Administration / Reports</p><h1>Employee leave report</h1><p>Preview leave applications and annual allocation for employees.</p></div></header>

			<section class="leave-panel report-filter-panel">
				<div class="leave-section-heading"><div><h2>Choose report criteria</h2><p>Select an employee and Nepali calendar year, then generate the report preview.</p></div></div>
				<form method="get" action="/leave/report" class="report-filters">
					<div class="report-field"><label for="year">Nepali year (BS)</label><input id="year" name="year" type="number" min="1970" max="2100" step="1" value="<%= selectedYear %>" required></div>
					<div class="report-field employee-search"><label for="employeeSearch">Search staff by name or employee code</label><input id="employeeSearch" type="search" placeholder="Type a staff name or code"></div>
					<div class="employee-picker" role="group" aria-label="Select employees">
						<div class="employee-picker-toolbar"><label class="select-all-employees"><input type="checkbox" id="selectAllEmployees"><span>Select all shown staff</span></label><span class="selection-count" id="selectionCount" aria-live="polite"></span></div>
						<% employees.forEach(employee => { %><label class="employee-choice" data-search="<%= `${employee.name} ${employee.employeeCode} ${employee.department}`.toLowerCase() %>"><input type="checkbox" name="employeeId" value="<%= employee.id %>" <%= selectedEmployeeIds.includes(employee.id) ? 'checked' : '' %>><span><strong><%= employee.name %></strong><% if (employee.employeeCode || employee.department) { %><br><small><%= [employee.employeeCode, employee.department].filter(Boolean).join(' / ') %></small><% } %></span></label><% }) %>
					</div>
					<div class="report-actions"><button class="report-button" type="submit">Generate preview</button><% if (reportData.length) { %><button class="report-button secondary" type="button" onclick="window.print()">Print all reports</button><% } %></div>
				</form>
			</section>

			<% if (errorMessage) { %><section class="leave-panel"><p class="report-message" role="alert"><%= errorMessage %></p></section><% } %>
			<% if (reportData.length) { %>
			<section class="report-sheet">
				<h2 class="report-title">Employee Leave Report — BS <%= selectedYear %></h2>
				<div class="report-table-wrap"><table class="report-table">
					<thead>
						<tr><th rowspan="2">SN</th><th rowspan="2">Employee</th><th colspan="7" class="group-heading">Leave Detail</th><th rowspan="2">Allocated Leave</th><th rowspan="2">Total Taken</th><th rowspan="2">Remaining</th></tr>
						<tr><th>SN</th><th>Leave Type</th><th>Taken from</th><th>Taken to</th><th>Duration</th><th>Reason</th><th>Approved by</th></tr>
					</thead>
					<tbody><% reportData.forEach(({ employee, applications, leaveBalances, totalTakenDays }, employeeIndex) => {
					const detailRows = applications.length ? applications : [null];
					const finiteBalances = leaveBalances.filter(balance => balance.allocatedDays !== null);
					const allocatedTotal = finiteBalances.reduce((total, balance) => total + balance.allocatedDays, 0);
					const remainingTotal = finiteBalances.reduce((total, balance) => total + balance.remainingDays, 0);
					const hasUnlimitedBalance = leaveBalances.some(balance => balance.allocatedDays === null);
					%><% detailRows.forEach((application, detailIndex) => { %><tr>
						<% if (detailIndex === 0) { %>
						<td class="employee-number" rowspan="<%= detailRows.length %>"><%= employeeIndex + 1 %></td>
						<td class="employee-name" rowspan="<%= detailRows.length %>"><%= employee.name %><% if (employee.employeeCode) { %><br><small><%= employee.employeeCode %></small><% } %></td>
						<% } %>
						<td class="detail-number"><%= detailIndex + 1 %></td>
						<td><% if (application) { %><%= application.leaveTypeName %><span class="leave-status"><%= application.statusLabel %><%= application.isPaid ? ' / Paid' : ' / Unpaid' %></span><% } else { %><span class="empty-detail">No leave applications in this year</span><% } %></td>
						<td class="date-cell"><%= application?.startDateNepali || '—' %></td>
						<td class="date-cell"><%= application?.endDateNepali || '—' %></td>
						<td class="duration-cell"><% if (application) { %><%= application.daysInYear %> <%= application.daysInYear === 1 ? 'day' : 'days' %><% if (application.leaveDay && application.leaveDay !== 'Full day') { %><br><small><%= application.leaveDay %></small><% } %><% } else { %>—<% } %></td>
						<td class="reason-cell"><%= application?.reason || '—' %></td>
						<td class="approver-cell"><%= application?.approvedBy || '—' %></td>
						<% if (detailIndex === 0) { %>
						<td class="summary-cell" rowspan="<%= detailRows.length %>"><% leaveBalances.forEach(balance => { %><span class="balance-line"><%= balance.name %>: <%= balance.allocatedDays === null ? 'No limit' : `${balance.allocatedDays} days` %></span><% }); %><strong class="balance-total">Total: <%= hasUnlimitedBalance ? 'No limit' : finiteBalances.length ? `${allocatedTotal} days` : '—' %></strong></td>
						<td class="summary-cell" rowspan="<%= detailRows.length %>"><% leaveBalances.forEach(balance => { %><span class="balance-line"><%= balance.name %>: <%= balance.takenDays %> <%= balance.takenDays === 1 ? 'day' : 'days' %></span><% }); %><strong class="balance-total">Total: <%= totalTakenDays %> <%= totalTakenDays === 1 ? 'day' : 'days' %></strong></td>
						<td class="summary-cell" rowspan="<%= detailRows.length %>"><% leaveBalances.forEach(balance => { %><span class="balance-line"><%= balance.name %>: <%= balance.remainingDays === null ? 'No limit' : `${balance.remainingDays} days` %></span><% }); %><strong class="balance-total">Total: <%= hasUnlimitedBalance ? 'No limit' : finiteBalances.length ? `${remainingTotal} days` : '—' %></strong></td>
						<% } %>
					</tr><% }) %>
					<% }) %></tbody>
				</table></div>
				<p class="report-footnote">Leave totals sum the durations of all listed applications, including rejected applications. Application status is shown in the leave detail.</p>
			</section>
			<p class="report-footnote screen-only">Generated on <%= new Date().toLocaleString('en-GB', { timeZone: 'Asia/Kathmandu' }) %> (Nepal Time)</p>
			<% } else if (!errorMessage) { %>
			<section class="report-sheet"><div class="report-empty">Check one or more employees and choose <strong>Generate preview</strong> to view their leave reports.</div></section>
			<% } %>
		</main>
	</div>
<script>
	const employeeCheckboxes = [...document.querySelectorAll('input[name="employeeId"]')];
	const selectAllEmployees = document.getElementById('selectAllEmployees');
	const selectionCount = document.getElementById('selectionCount');
	const employeeSearch = document.getElementById('employeeSearch');
	const employeeChoices = [...document.querySelectorAll('.employee-choice')];
	function filterEmployees() {
		const query = employeeSearch.value.trim().toLowerCase();
		employeeChoices.forEach(choice => {
			choice.hidden = !choice.dataset.search.includes(query);
		});
		updateEmployeeSelection();
	}
	function updateEmployeeSelection() {
		const checkedCount = employeeCheckboxes.filter(checkbox => checkbox.checked).length;
		const visibleCheckboxes = employeeChoices.filter(choice => !choice.hidden).map(choice => choice.querySelector('input'));
		const visibleCheckedCount = visibleCheckboxes.filter(checkbox => checkbox.checked).length;
		selectAllEmployees.checked = visibleCheckboxes.length > 0 && visibleCheckedCount === visibleCheckboxes.length;
		selectAllEmployees.indeterminate = visibleCheckedCount > 0 && visibleCheckedCount < visibleCheckboxes.length;
		selectionCount.textContent = `${checkedCount} selected`;
	}
	selectAllEmployees.addEventListener('change', () => {
		employeeChoices.filter(choice => !choice.hidden).forEach(choice => {
			choice.querySelector('input').checked = selectAllEmployees.checked;
		});
		updateEmployeeSelection();
	});
	employeeCheckboxes.forEach(checkbox => checkbox.addEventListener('change', updateEmployeeSelection));
	employeeSearch.addEventListener('input', filterEmployees);
	updateEmployeeSelection();
</script>
</body>
</html>
