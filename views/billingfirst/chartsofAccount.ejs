<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    :root { --navy:#102a52; --blue:#3979d6; --blue-soft:#edf5ff; --ink:#1d2b42; --muted:#73829a; --line:#e2eaf4; --page:#f5f8fc; --green:#16846a; --red:#b6404a; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--page); color:var(--ink); font-family:"Segoe UI",Arial,sans-serif; }
    .accounts-main { min-height:100vh; margin-left:268px; padding:32px 38px 48px; }
    .accounts-content { max-width:1500px; margin:0 auto; }
    .page-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:22px; }
    .eyebrow { margin:0 0 7px; color:var(--blue); font-size:11px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; }
    h1 { margin:0; color:var(--navy); font-size:30px; letter-spacing:-.7px; }
    .subtitle { margin:8px 0 0; color:var(--muted); font-size:14px; line-height:1.5; }
    .accounting-note { max-width:330px; padding:11px 14px; border:1px solid #d6e7ff; border-radius:10px; background:#f0f7ff; color:#496787; font-size:12px; line-height:1.5; }
    .summary-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-bottom:20px; }
    .summary-card,.panel { border:1px solid var(--line); border-radius:13px; background:#fff; box-shadow:0 8px 24px rgba(24,52,91,.045); }
    .summary-card { display:flex; align-items:center; gap:13px; padding:16px 18px; }
    .summary-icon { display:grid; place-items:center; width:39px; height:39px; border-radius:11px; background:var(--blue-soft); color:var(--blue); font-weight:800; }
    .summary-card strong { display:block; color:var(--navy); font-size:19px; }
    .summary-card span:last-child { color:var(--muted); font-size:11px; }
    .forms-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .panel { overflow:hidden; }
    .form-panel { padding:21px; }
    .panel-heading { display:flex; align-items:flex-start; gap:11px; margin-bottom:18px; }
    .step-number { display:grid; flex:none; place-items:center; width:29px; height:29px; border-radius:9px; background:#e9f2ff; color:#2d6fc8; font-size:12px; font-weight:800; }
    .panel-heading h2,.list-heading h2 { margin:0; color:var(--navy); font-size:16px; }
    .panel-heading p { margin:5px 0 0; color:var(--muted); font-size:12px; }
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .field { display:grid; gap:6px; min-width:0; }
    .field.full { grid-column:1/-1; }
    .field label { color:#53647d; font-size:11px; font-weight:750; }
    .field input,.field select { width:100%; min-height:41px; padding:9px 11px; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); font:inherit; font-size:13px; outline:none; }
    .field input:focus,.field select:focus { border-color:#83b0ed; box-shadow:0 0 0 3px rgba(57,121,214,.1); }
    .field-hint { color:#8794a8; font-size:10px; line-height:1.4; }
    .form-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:17px; }
    .form-footer small { color:var(--muted); font-size:10px; }
    .submit-button { min-height:39px; padding:0 15px; border:0; border-radius:8px; background:var(--navy); color:#fff; cursor:pointer; font:700 12px "Segoe UI",Arial,sans-serif; }
    .submit-button:hover { background:#214d86; }
    .alert { margin-bottom:16px; padding:12px 15px; border:1px solid #bce5d8; border-radius:9px; background:#effaf6; color:#176c57; font-size:13px; }
    .alert.error { border-color:#f0c7ca; background:#fff5f5; color:var(--red); }
    .list-panel { margin-top:20px; }
    .list-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:18px 20px; }
    .list-heading p { margin:5px 0 0; color:var(--muted); font-size:11px; }
    .search-input { width:min(270px,100%); min-height:36px; padding:8px 11px; border:1px solid var(--line); border-radius:8px; font:inherit; font-size:12px; }
    .table-scroll { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; text-align:left; }
    .accounts-table { min-width:760px; }
    th { padding:11px 15px; background:#f8fafd; color:#74839a; font-size:9px; font-weight:800; letter-spacing:.7px; text-transform:uppercase; white-space:nowrap; }
    td { padding:13px 15px; border-top:1px solid #edf1f6; color:#45546b; font-size:12px; white-space:nowrap; }
    tbody tr:hover { background:#fbfdff; }
    .code { color:#62718a; font-family:Consolas,monospace; font-size:11px; }
    .name { color:var(--navy); font-weight:700; }
    .nature-badge,.type-badge { display:inline-flex; align-items:center; padding:5px 8px; border:1px solid #e1ebf8; border-radius:20px; background:#f2f7fd; color:#41658f; font-size:10px; font-weight:750; }
    .nature-badge.debit { border-color:#d6e8df; background:#f0f8f4; color:#35735c; }
    .empty-state { padding:24px; color:var(--muted); font-size:12px; text-align:center; }
    .list-divider { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:20px 20px 12px; }
    .list-divider h3 { margin:0; color:var(--navy); font-size:14px; }
    .count-pill { padding:4px 8px; border-radius:20px; background:#edf4fd; color:#52749d; font-size:10px; font-weight:750; }
    .account-note { color:#8290a4; font-size:10px; white-space:normal; }
    @media (max-width:1000px) { .accounts-main { padding:27px 22px 40px; } .forms-grid { grid-template-columns:1fr; } }
    @media (max-width:760px) { .accounts-main { margin-left:0; padding:23px 15px 34px; } .page-heading { align-items:flex-start; flex-direction:column; } .accounting-note { max-width:none; } .summary-grid { gap:9px; } .summary-card { padding:12px 10px; gap:8px; } .summary-icon { width:32px; height:32px; } .summary-card strong { font-size:16px; } .summary-card span:last-child { font-size:10px; } }
    @media (max-width:480px) { .summary-grid { grid-template-columns:1fr 1fr; } .summary-card:last-child { grid-column:1/-1; } .form-grid { grid-template-columns:1fr; } .field.full { grid-column:auto; } .form-footer { align-items:stretch; flex-direction:column; } .submit-button { width:100%; } .list-heading { align-items:stretch; flex-direction:column; } .search-input { width:100%; } h1 { font-size:26px; } }
  </style>
</head>
<body>
  <%- include('feesidenav') %>
  <main class="accounts-main">
    <div class="accounts-content">
      <header class="page-heading">
        <div><p class="eyebrow">Finance setup</p><h1>Chart of accounts</h1><p class="subtitle">Build a clear double-entry account structure before recording transactions.</p></div>
        <div class="accounting-note"><strong>Double-entry foundation</strong><br>Assets and expenses normally carry debit balances. Liabilities, equity and income normally carry credit balances.</div>
      </header>

      <% if (message) { %><div class="alert" role="status"><%= message %></div><% } %>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>

      <section class="summary-grid" aria-label="Chart of accounts totals">
        <div class="summary-card"><span class="summary-icon">G</span><div><strong><%= groups.length %></strong><span>Account groups</span></div></div>
        <div class="summary-card"><span class="summary-icon">L</span><div><strong><%= ledgers.length %></strong><span>Ledger accounts</span></div></div>
        <div class="summary-card"><span class="summary-icon">5</span><div><strong>5</strong><span>Account natures</span></div></div>
      </section>

      <section class="forms-grid">
        <div class="panel form-panel">
          <div class="panel-heading"><span class="step-number">01</span><div><h2>Create account group</h2><p>Groups organize ledgers by their accounting nature.</p></div></div>
          <form action="/chartsofAccount/groups" method="POST">
            <div class="form-grid">
              <div class="field"><label for="group-code">Group code</label><input id="group-code" name="code" maxlength="24" value="<%= groupForm.code || '' %>" placeholder="e.g. AS-01" required></div>
              <div class="field"><label for="group-name">Group name</label><input id="group-name" name="name" maxlength="80" value="<%= groupForm.name || '' %>" placeholder="e.g. Current Assets" required></div>
              <div class="field"><label for="group-nature">Account nature</label><select id="group-nature" name="nature" required><option value="">Select nature</option><% accountNatures.forEach(nature => { %><option value="<%= nature.value %>" <%= groupForm.nature === nature.value ? 'selected' : '' %>><%= nature.label %> · normal <%= nature.normalBalance.toLowerCase() %></option><% }); %></select></div>
              <div class="field"><label for="parent-group">Parent group <span class="field-hint">(optional)</span></label><select id="parent-group" name="parentGroup"><option value="">Top-level group</option><% groups.forEach(group => { %><option value="<%= group._id %>" data-nature="<%= group.nature %>" <%= String(groupForm.parentGroup || '') === String(group._id) ? 'selected' : '' %>><%= group.code %> · <%= group.name %></option><% }); %></select></div>
            </div>
            <div class="form-footer"><small>Sub-groups must match their parent’s account nature.</small><button class="submit-button" type="submit">Create group</button></div>
          </form>
        </div>

        <div class="panel form-panel">
          <div class="panel-heading"><span class="step-number">02</span><div><h2>Create ledger account</h2><p>Add a posting account under an existing group.</p></div></div>
          <form action="/chartsofAccount/ledgers" method="POST">
            <div class="form-grid">
              <div class="field"><label for="ledger-code">Ledger code</label><input id="ledger-code" name="code" maxlength="24" value="<%= ledgerForm.code || '' %>" placeholder="e.g. CASH-01" required></div>
              <div class="field"><label for="ledger-name">Ledger name</label><input id="ledger-name" name="name" maxlength="100" value="<%= ledgerForm.name || '' %>" placeholder="e.g. Main Cash" required></div>
              <div class="field"><label for="ledger-group">Under group</label><select id="ledger-group" name="group" required <%= groups.length ? '' : 'disabled' %>><option value="">Select account group</option><% groups.forEach(group => { %><option value="<%= group._id %>" data-nature="<%= group.nature %>" <%= String(ledgerForm.group || '') === String(group._id) ? 'selected' : '' %>><%= group.code %> · <%= group.name %> (<%= group.nature.toLowerCase() %>)</option><% }); %></select></div>
              <div class="field"><label for="ledger-type">Ledger type</label><select id="ledger-type" name="ledgerType" required <%= groups.length ? '' : 'disabled' %>><% ledgerTypes.forEach(type => { %><option value="<%= type.value %>" data-nature="<%= type.nature || '' %>" <%= (ledgerForm.ledgerType || 'GENERAL') === type.value ? 'selected' : '' %>><%= type.label %></option><% }); %></select></div>
            </div>
            <div class="form-footer"><small><%= groups.length ? 'Type and group must have compatible account natures.' : 'Create an account group first to enable ledger setup.' %></small><button class="submit-button" type="submit" <%= groups.length ? '' : 'disabled' %>>Create ledger</button></div>
          </form>
        </div>
      </section>

      <section class="panel list-panel">
        <div class="list-heading"><div><h2>Saved accounts</h2><p>Account codes are unique. Only active ledgers can be used for new postings; historical entries remain visible when an account is deactivated.</p></div><input class="search-input" id="account-search" type="search" placeholder="Search code, name, group or type" aria-label="Search accounts"></div>
        <div class="list-divider"><h3>Ledger accounts</h3><span class="count-pill"><%= ledgers.length %> saved</span></div>
        <% if (ledgers.length) { %>
          <div class="table-scroll"><table class="accounts-table" id="ledger-table"><thead><tr><th>Code</th><th>Account name</th><th>Under group</th><th>Account nature</th><th>Ledger type</th><th>Normal balance</th><th>Status</th><th>Action</th></tr></thead><tbody>
            <% ledgers.forEach(ledger => { %><tr><td class="code"><%= ledger.code %></td><td class="name"><%= ledger.name %></td><td><%= ledger.group ? ledger.group.name : 'Group unavailable' %></td><td><span class="nature-badge <%= ledger.normalBalance === 'DEBIT' ? 'debit' : '' %>"><%= ledger.nature %></span></td><td><span class="type-badge"><%= (ledgerTypes.find(type => type.value === ledger.ledgerType) || {}).label || ledger.ledgerType %></span></td><td><%= ledger.normalBalance %></td><td><%= ledger.isActive === false ? 'Inactive' : 'Active' %></td><td><form action="/chartsofAccount/ledgers/<%= ledger._id %>/status" method="post" onsubmit="return confirm('Change the active status for this account?')"><input type="hidden" name="isActive" value="<%= ledger.isActive === false ? 'true' : 'false' %>"><button class="fee-action" type="submit"><%= ledger.isActive === false ? 'Activate' : 'Deactivate' %></button></form></td></tr><% }); %>
          </tbody></table></div>
        <% } else { %><div class="empty-state">No ledger accounts yet. Create an account group, then add its ledgers above.</div><% } %>

        <div class="list-divider"><h3>Account groups</h3><span class="count-pill"><%= groups.length %> saved</span></div>
        <% if (groups.length) { %>
          <div class="table-scroll"><table class="accounts-table" id="group-table"><thead><tr><th>Code</th><th>Group name</th><th>Under group</th><th>Account nature</th><th>Normal balance</th><th>Ledgers</th></tr></thead><tbody>
            <% groups.forEach(group => { const ledgerCount = ledgers.filter(ledger => ledger.group && String(ledger.group._id) === String(group._id)).length; %><tr><td class="code"><%= group.code %></td><td class="name"><%= group.name %></td><td><%= group.parentGroup ? group.parentGroup.name : 'Top-level' %></td><td><span class="nature-badge <%= group.normalBalance === 'DEBIT' ? 'debit' : '' %>"><%= group.nature %></span></td><td><%= group.normalBalance %></td><td><%= ledgerCount %></td></tr><% }); %>
          </tbody></table></div>
        <% } else { %><div class="empty-state">No account groups created yet.</div><% } %>
      </section>
    </div>
  </main>
  <script>
    const groupNature = document.getElementById('group-nature');
    const parentGroup = document.getElementById('parent-group');
    const ledgerGroup = document.getElementById('ledger-group');
    const ledgerType = document.getElementById('ledger-type');

    function filterParentGroups() {
      Array.from(parentGroup.options).forEach(option => {
        option.hidden = Boolean(option.value && groupNature.value && option.dataset.nature !== groupNature.value);
        if (option.selected && option.hidden) parentGroup.value = '';
      });
    }

    function filterLedgerTypes() {
      const selectedGroup = ledgerGroup.options[ledgerGroup.selectedIndex];
      const nature = selectedGroup ? selectedGroup.dataset.nature : '';
      Array.from(ledgerType.options).forEach(option => {
        option.hidden = Boolean(option.dataset.nature && nature && option.dataset.nature !== nature);
        if (option.selected && option.hidden) ledgerType.value = 'GENERAL';
      });
    }

    groupNature.addEventListener('change', filterParentGroups);
    ledgerGroup.addEventListener('change', filterLedgerTypes);
    filterParentGroups();
    filterLedgerTypes();

    document.getElementById('account-search').addEventListener('input', event => {
      const query = event.target.value.trim().toLowerCase();
      document.querySelectorAll('.accounts-table tbody tr').forEach(row => {
        row.hidden = !row.textContent.toLowerCase().includes(query);
      });
    });
  </script>
</body>
</html>