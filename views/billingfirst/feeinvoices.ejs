<!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fee Invoices</title><style>
:root{--navy:#07152f;--blue:#3b82f6;--ink:#17233b;--muted:#71809b;--line:#e4eaf3;--page:#f4f7fb}*{box-sizing:border-box}body{margin:0;background:var(--page);color:var(--ink);font-family:"Segoe UI",Arial,sans-serif}.main{margin-left:268px;padding:34px 40px;max-width:1600px}.panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px;margin-bottom:22px;box-shadow:0 14px 34px #0d234712}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 22px}.field{display:grid;gap:7px}.field label,.label{font-size:12px;font-weight:700;color:var(--muted)}input,select,textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:8px;font:inherit;color:var(--ink);background:#fff}textarea{min-height:70px;resize:vertical}.full{grid-column:1/-1}.checks{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px}.check{padding:10px;border:1px solid var(--line);border-radius:8px;font-size:12px}.check:has(input:checked){background:#f0f6ff;border-color:#9bc0ff;color:var(--blue);font-weight:700}.actions{display:flex;justify-content:flex-end;margin-top:20px}.button{border:0;border-radius:8px;background:var(--navy);color:#fff;padding:11px 18px;font-weight:700;cursor:pointer}.scroll{overflow:auto}table{width:100%;min-width:900px;border-collapse:collapse;font-size:12px}th{padding:0 12px 12px;text-align:left;color:var(--muted);font-size:10px;text-transform:uppercase}td{padding:13px 12px;border-top:1px solid var(--line)}a{color:var(--blue);font-weight:700;text-decoration:none}.danger{color:#c43d4d}h1{color:var(--navy)}.sub{color:var(--muted);font-size:14px}@media(max-width:760px){.main{margin-left:0;padding:24px 16px}.grid{grid-template-columns:1fr}.full{grid-column:auto}.checks{grid-template-columns:repeat(2,1fr)}}
</style></head><body><%- include('feesidenav') %><main class="main"><h1>Fee invoices</h1><p class="sub">Create a demand invoice for a student and academic period.</p><section class="panel"><form method="post" action="/fee-invoices"><div class="grid"><div class="field"><label>Student</label><select name="studentId" required><option value="">Select student</option><% students.forEach(student=>{ %><option value="<%= student._id %>"><%= student.name %> | <%= student.reg || student.regdNo || '-' %> | <%= student.studentClass || '-' %>-<%= student.section || '-' %></option><% }) %></select></div><div class="field"><label>Academic year</label><input name="academicYear" placeholder="2082/83" required></div><div class="field"><label>Nepali month</label><select name="nepaliMonth" required><option value="">Select month</option><% nepaliMonths.forEach(month=>{ %><option><%= month %></option><% }) %></select></div><div class="field"><label>Discount (NPR)</label><input name="discount" type="number" min="0" step="0.01" value="0"></div><div class="field full"><span class="label">Fee items</span><div class="checks"><% feeStructures.forEach(item=>{ %><label class="check"><input type="checkbox" name="feeStructureIds" value="<%= item._id %>"> <%= item.feehead %> · NPR <%= Number(item.amount).toFixed(2) %></label><% }) %></div></div><div class="field full"><label>Notes</label><textarea name="notes" placeholder="Optional note for the parent or student"></textarea></div></div><div class="actions"><button class="button">Create invoice</button></div></form></section><section class="panel"><h2>Recent invoices</h2><div class="scroll"><table><thead><tr><th>Invoice</th><th>Student</th><th>Period</th><th>Total</th><th>Paid</th><th>Status</th><th>Action</th></tr></thead><tbody><% invoices.forEach(item=>{ %><tr><td><%= item.invoiceNo %></td><td><strong><%= item.studentName %></strong><br><%= item.reg %></td><td><%= item.academicYear %> · <%= item.nepaliMonth %></td><td>NPR <%= Number(item.totalAmount).toFixed(2) %></td><td>NPR <%= Number(item.paidAmount).toFixed(2) %></td><td><%= item.status %></td><td><a href="/fee-invoices/<%= item._id %>">View</a> · <form style="display:inline" method="post" action="/fee-invoices/<%= item._id %>/delete" onsubmit="return confirm('Delete this unpaid invoice?')"><button class="danger" style="border:0;background:none;cursor:pointer">Delete</button></form></td></tr><% }) %><% if(!invoices.length){ %><tr><td colspan="7">No invoices created yet.</td></tr><% } %></tbody></table></div></section></main></body></html>
