<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Tax schemes' %></title>
  <style>
    body { margin:0; font-family:Segoe UI, Arial, sans-serif; background:#f4f7fb; color:#17233b; }
    .container { max-width: 1100px; margin: 0 auto; padding: 32px 20px 40px; }
    .card { background:#fff; border:1px solid #e5ebf4; border-radius:12px; box-shadow:0 12px 24px rgba(15,31,62,.05); }
    .header { display:flex; justify-content:space-between; margin-bottom:20px; }
    h1 { margin:0; font-size:32px; }
    .grid { display:grid; grid-template-columns: 1.1fr .9fr; gap:18px; }
    .panel { padding:18px 20px; }
    table { width:100%; border-collapse: collapse; }
    th, td { padding:12px 8px; border-top:1px solid #edf1f6; text-align:left; }
    th { font-size:11px; letter-spacing:.7px; text-transform:uppercase; color:#71809b; }
    form { display:grid; gap:14px; }
    .row { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:12px; }
    label { display:block; font-size:12px; color:#66768f; margin-bottom:6px; }
    input, select, button { width:100%; padding:10px 12px; border:1px solid #dfe7f2; border-radius:8px; font:inherit; }
    button { background:#0d2854; color:#fff; border:none; cursor:pointer; }
    .alert { margin-bottom:18px; border-radius:10px; padding:12px 14px; background:#fff5f5; border:1px solid #f7cdd2; color:#8a3036; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div>
        <p style="margin:0 0 8px; color:#3b82f6; font-size:11px; letter-spacing:1.2px; text-transform:uppercase; font-weight:700;">Finance and HR</p>
        <h1>Tax scheme library</h1>
      </div>
      <a href="/payroll" style="display:inline-flex; align-items:center; padding:10px 16px; background:#eef4ff; color:#0d2854; border-radius:8px; text-decoration:none; font-weight:700;">Back to payroll</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert"><strong>Alert:</strong> <%= error %></div>
    <% } %>

    <div class="grid">
      <div class="card panel">
        <h2 style="margin-top:0;">Saved tax schemes</h2>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Fiscal year</th>
              <th>Mode</th>
              <th>Slabs</th>
            </tr>
          </thead>
          <tbody>
            <% if (!schemes || !schemes.length) { %>
              <tr><td colspan="4">No tax schemes configured yet.</td></tr>
            <% } else { %>
              <% schemes.forEach(scheme => { %>
                <tr>
                  <td><%= scheme.name || '—' %></td>
                  <td><%= scheme.fiscalYear || '—' %></td>
                  <td><%= scheme.calculationMode || 'PROGRESSIVE' %></td>
                  <td><%= Array.isArray(scheme.slabs) ? scheme.slabs.length : 0 %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="card panel">
        <h2 style="margin-top:0;">Create tax scheme</h2>
        <form method="POST" action="/payroll/tax-schemes">
          <div>
            <label for="name">Scheme name</label>
            <input id="name" name="name" placeholder="e.g. FY 2082-83" required />
          </div>
          <div class="row">
            <div>
              <label for="fiscalYear">Fiscal year</label>
              <input id="fiscalYear" name="fiscalYear" value="2082/83" required />
            </div>
            <div>
              <label for="calculationMode">Calculation mode</label>
              <select id="calculationMode" name="calculationMode">
                <option value="PROGRESSIVE">Progressive</option>
                <option value="FLAT">Flat</option>
                <option value="MARGINAL">Marginal</option>
              </select>
            </div>
          </div>
          <div>
            <label for="slabs">Tax slabs (JSON array)</label>
            <textarea id="slabs" name="slabs" rows="6" style="width:100%; border:1px solid #dfe7f2; border-radius:8px; padding:10px; font:inherit;" placeholder='[{"minIncome":0,"maxIncome":200000,"rate":1,"fixedAmount":0}]'></textarea>
          </div>
          <button type="submit">Save tax scheme</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
