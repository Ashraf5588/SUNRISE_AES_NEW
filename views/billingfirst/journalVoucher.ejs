<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/css/nepali.datepicker.v5.0.6.min.css" rel="stylesheet" type="text/css">
  <style>
    :root { --navy:#102a52; --blue:#3979d6; --blue-soft:#edf5ff; --ink:#1d2b42; --muted:#73829a; --line:#e2eaf4; --page:#f5f8fc; --green:#16846a; --red:#b6404a; --amber:#946000; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--page); color:var(--ink); font-family:"Segoe UI",Arial,sans-serif; }
    .voucher-main { min-height:100vh; margin-left:268px; padding:32px 38px 48px; }
    .voucher-content { max-width:1500px; margin:0 auto; }
    .page-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:22px; }
    .eyebrow { margin:0 0 7px; color:var(--blue); font-size:11px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; }
    h1 { margin:0; color:var(--navy); font-size:30px; letter-spacing:-.7px; }
    .subtitle { margin:8px 0 0; color:var(--muted); font-size:14px; line-height:1.5; }
    .double-entry-note { display:flex; align-items:flex-start; gap:10px; max-width:350px; padding:12px 14px; border:1px solid #d5e6fb; border-radius:11px; background:#f0f7ff; color:#486887; font-size:11px; line-height:1.5; }
    .note-icon { display:grid; flex:none; place-items:center; width:24px; height:24px; border-radius:8px; background:#deedff; color:var(--blue); font-size:13px; font-weight:800; }
    .alert { margin-bottom:16px; padding:12px 15px; border:1px solid #bce5d8; border-radius:9px; background:#effaf6; color:#176c57; font-size:13px; }
    .alert.error { border-color:#f0c7ca; background:#fff5f5; color:var(--red); }
    .edit-banner { margin-bottom:16px; padding:13px 15px; border:1px solid #cbdff9; border-radius:10px; background:#f0f7ff; color:#416588; font-size:12px; line-height:1.55; }
    .edit-banner strong { color:#234a77; }
    .voucher-card,.saved-card { border:1px solid var(--line); border-radius:15px; background:#fff; box-shadow:0 10px 28px rgba(24,52,91,.055); overflow:hidden; }
    .card-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:20px 22px 0; }
    .card-heading h2 { margin:0; color:var(--navy); font-size:17px; }
    .card-heading p { margin:5px 0 0; color:var(--muted); font-size:12px; }
    .form-content { padding:20px 22px 23px; }
    .meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px 20px; }
    .field { display:grid; align-content:start; gap:7px; min-width:0; }
    .field.full { grid-column:1/-1; }
    .field label { color:#53647d; font-size:12px; font-weight:750; }
    .field input,.field textarea,.search-input,.filter-select { width:100%; min-height:42px; padding:10px 12px; border:1px solid #dbe5f1; border-radius:9px; background:#fbfdff; color:var(--ink); font:inherit; font-size:13px; outline:none; }
    .field textarea { min-height:74px; resize:vertical; }
    .field input:focus,.field textarea:focus,.search-input:focus,.filter-select:focus { border-color:#82ade7; box-shadow:0 0 0 3px rgba(57,121,214,.1); background:#fff; }
    .field input[readonly] { background:#f2f6fb; color:#30537d; font-weight:800; letter-spacing:.2px; }
    .field-hint { min-height:14px; color:#8190a5; font-size:10px; line-height:1.4; }
    .date-hint.invalid { color:var(--red); }
    .entry-heading { display:flex; align-items:center; justify-content:space-between; gap:14px; margin:22px 0 11px; }
    .entry-heading h3 { margin:0; color:var(--navy); font-size:15px; }
    .entry-heading p { margin:4px 0 0; color:var(--muted); font-size:11px; }
    .button { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:38px; padding:0 13px; border:1px solid #d7e2ef; border-radius:9px; background:#fff; color:#31577f; cursor:pointer; font:700 12px "Segoe UI",Arial,sans-serif; text-decoration:none; transition:.15s ease; }
    .button:hover { border-color:#a9c8ee; background:#f3f8ff; }
    .button.primary { min-height:42px; padding:0 18px; border-color:var(--navy); background:var(--navy); color:#fff; }
    .button.primary:hover { background:#214d86; }
    .button:disabled { cursor:not-allowed; opacity:.5; }
    .entry-scroll,.saved-scroll { overflow-x:auto; }
    .entry-table,.saved-table { width:100%; border-collapse:separate; border-spacing:0; }
    .entry-table { min-width:780px; border:1px solid var(--line); border-radius:11px; overflow:hidden; }
    .entry-table th,.saved-table th { padding:12px 13px; background:#142848; color:#dceaff; font-size:10px; font-weight:800; letter-spacing:.55px; text-align:left; text-transform:uppercase; white-space:nowrap; }
    .entry-table th:first-child,.saved-table th:first-child { border-top-left-radius:9px; }
    .entry-table th:last-child,.saved-table th:last-child { border-top-right-radius:9px; }
    .entry-table td { padding:10px 12px; border-top:1px solid #edf1f6; background:#fff; }
    .entry-table tbody tr:nth-child(even) td { background:#f8fafd; }
    .row-number { width:55px; color:#71809a; font-size:12px; font-weight:700; text-align:center; }
    .entry-table select,.entry-table input { width:100%; min-height:39px; padding:8px 10px; border:1px solid #dce5f0; border-radius:8px; background:#fff; color:var(--ink); font:inherit; font-size:12px; outline:none; }
    .entry-table select:focus,.entry-table input:focus { border-color:#82ade7; box-shadow:0 0 0 3px rgba(57,121,214,.08); }
    .entry-table input[type=number] { min-width:130px; text-align:right; font-variant-numeric:tabular-nums; }
    .entry-table tfoot td { padding:13px 12px; border-top:1px solid #dfe7f1; background:#f3f7fc; color:var(--navy); font-weight:800; }
    .total-label { color:#72839a!important; font-size:10px; text-align:right; text-transform:uppercase; }
    .total-value { font-size:14px; font-variant-numeric:tabular-nums; }
    .remove-row { width:32px; height:32px; border:1px solid #e0e7f0; border-radius:8px; background:#fff; color:#78879c; cursor:pointer; font-size:16px; }
    .remove-row:hover:not(:disabled) { border-color:#efc0c4; background:#fff5f5; color:var(--red); }
    .remove-row:disabled { cursor:not-allowed; opacity:.4; }
    .balance-message { display:flex; align-items:center; gap:9px; margin-top:14px; padding:11px 13px; border:1px solid #f1dfb1; border-radius:9px; background:#fff9e9; color:var(--amber); font-size:12px; font-weight:700; }
    .balance-message.balanced { border-color:#c5e7d8; background:#effaf5; color:#187257; }
    .balance-icon { display:grid; flex:none; place-items:center; width:22px; height:22px; border-radius:50%; background:rgba(255,255,255,.8); font-weight:900; }
    .form-bottom { display:flex; align-items:center; justify-content:space-between; gap:15px; margin-top:17px; }
    .form-note { max-width:520px; color:#8290a4; font-size:10px; line-height:1.5; }
    .form-actions { display:flex; justify-content:flex-end; gap:9px; }
    .saved-card { margin-top:22px; }
    .saved-header { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:20px 22px 15px; }
    .saved-header h2 { margin:0; color:var(--navy); font-size:17px; }
    .saved-header p { margin:5px 0 0; color:var(--muted); font-size:12px; }
    .saved-count { padding:6px 9px; border-radius:20px; background:#edf4fd; color:#52749d; font-size:10px; font-weight:800; white-space:nowrap; }
    .list-tools { display:grid; grid-template-columns:minmax(200px,1fr) 220px; gap:10px; padding:0 22px 15px; }
    .search-input,.filter-select { min-height:39px; font-size:12px; }
    .saved-table { min-width:1000px; }
    .saved-table th { background:#142848; }
    .saved-table td { padding:12px 13px; border-top:1px solid #edf1f6; color:#526178; font-size:11px; vertical-align:middle; }
    .saved-table tbody tr:hover > td { background:#fbfdff; }
    .saved-table tbody tr[hidden] { display:none; }
    .saved-date { color:#304c70; font-weight:750; }
    .saved-date small { display:block; margin-top:4px; color:#8390a4; font-size:9px; font-weight:500; }
    .voucher-number { color:#253e60; font-family:Consolas,monospace; font-weight:750; }
    .type-pill,.status-pill { display:inline-flex; padding:5px 8px; border:1px solid #dceafe; border-radius:20px; background:#f0f6ff; color:#4273ad; font-size:10px; font-weight:800; }
    .status-pill { border-color:#c4eadb; background:#effaf5; color:#16846a; text-transform:lowercase; }
    .amount { color:#32455f; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .view-toggle { border:0; background:transparent; color:var(--blue); cursor:pointer; font:700 11px "Segoe UI",Arial,sans-serif; white-space:nowrap; }
    .edit-voucher-link { display:inline-flex; align-items:center; justify-content:center; min-height:29px; padding:0 10px; border:1px solid #d5e4f6; border-radius:7px; background:#fff; color:var(--blue); font:700 11px "Segoe UI",Arial,sans-serif; text-decoration:none; white-space:nowrap; }
    .edit-voucher-link:hover { border-color:#a9c8ee; background:#f3f8ff; }
    .details-row td { padding:0 12px 13px; background:#f8fafd!important; }
    .line-detail { width:100%; border-collapse:collapse; }
    .line-detail th { padding:8px; background:#eaf2fd; color:#647891; font-size:9px; text-align:left; }
    .line-detail td { padding:8px; border-top:1px solid #e8eef5; background:transparent!important; font-size:10px; }
    .revision-heading { margin:14px 0 7px; color:#405977; font-size:11px; font-weight:800; }
    .revision-summary { margin:0 0 8px; color:#75849a; font-size:10px; }
    .empty-state { padding:32px 20px; color:var(--muted); font-size:12px; text-align:center; }
    .saved-footer { padding:11px 22px 17px; color:#8a97a9; font-size:10px; }
    .hidden { display:none!important; }
    @media (max-width:1000px) { .voucher-main { padding:27px 22px 40px; } .double-entry-note { max-width:300px; } }
    @media (max-width:760px) { .voucher-main { margin-left:0; padding:22px 14px 34px; } .page-heading { align-items:flex-start; flex-direction:column; } .double-entry-note { max-width:none; } .card-heading,.form-content { padding-right:15px; padding-left:15px; } .saved-header { padding-right:15px; padding-left:15px; } .list-tools { padding-right:15px; padding-left:15px; } .form-bottom { align-items:stretch; flex-direction:column; } .form-actions .button { flex:1; } .saved-table { min-width:880px; } }
    @media (max-width:520px) { h1 { font-size:26px; } .meta-grid { grid-template-columns:1fr; } .field.full { grid-column:auto; } .list-tools { grid-template-columns:1fr; } .saved-header { align-items:flex-start; } .entry-heading { align-items:flex-start; } .entry-heading .button { flex:none; } .card-heading { flex-direction:column; } }
    @media print { body { background:#fff; } .fee-sidebar,.page-heading,.entry-heading,.form-actions,.saved-card { display:none!important; } .voucher-main { margin:0; padding:0; } .voucher-card { border:0; box-shadow:none; } .form-content { padding:10px 0; } }
  </style>
</head>
<body>
  <%- include('feesidenav') %>
  <main class="voucher-main">
    <div class="voucher-content">
      <header class="page-heading">
        <div><p class="eyebrow">Ledger management / Accounting</p><h1><%= editingVoucher ? 'Edit draft journal voucher' : 'Journal voucher entry' %></h1><p class="subtitle"><%= editingVoucher ? 'Update this unposted draft voucher.' : 'Record balanced journal entries with the voucher date in BS and AD for audit clarity.' %></p></div>
        <div class="double-entry-note"><span class="note-icon">↔</span><span><strong>Double-entry control</strong><br>Every posted voucher must have equal total debits and credits. Posted vouchers are preserved as accounting records.</span></div>
      </header>

      <% if (message) { %><div class="alert" role="status"><%= message %></div><% } %>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <% if (!ledgers.length) { %><div class="alert error" role="status">Create ledger accounts in the <a href="/chartsofAccount" style="color:inherit;font-weight:800">Chart of Accounts</a> before entering a voucher.</div><% } %>
      <% if (editingVoucher) { %><div class="edit-banner"><strong>Editing draft <%= editingVoucher.voucherNumber %></strong> — changes are revalidated before it is posted.</div><% } %>

      <section class="voucher-card">
        <div class="card-heading"><div><h2>Journal Voucher Entry <span style="font-weight:400;color:#73829a">/ भौचर प्रविष्टि</span></h2><p>Enter the transaction date, narration and balanced account lines.</p></div></div>
        <div class="form-content">
          <form action="<%= editingVoucher ? '/journal-voucher/' + editingVoucher._id + '/edit' : '/journal-voucher' %>" method="POST" id="voucher-form">
            <% if (!editingVoucher) { %><input type="hidden" name="idempotencyKey" value="<%= idempotencyKey %>"><% } %>
            <% if (editingVoucher) { %><input type="hidden" name="revision" value="<%= form.revision %>"><% } %>
            <div class="meta-grid">
              <div class="field"><label for="voucher-number">Voucher number / भौचर नं.</label><input id="voucher-number" type="text" value="<%= editingVoucher ? editingVoucher.voucherNumber : voucherNumberPreview %>" readonly aria-describedby="voucher-number-hint"><span class="field-hint" id="voucher-number-hint"><%= editingVoucher ? 'Voucher number is fixed and cannot be changed.' : 'Preview only. The next number is allocated uniquely when the voucher is saved.' %></span></div>
              <div class="field"><label for="dateBS">Date / नेपाली मिति (वि.सं.)</label><input id="dateBS" name="dateBS" class="nepali-datepicker" type="text" value="<%= form.dateBS || todayBs %>" placeholder="YYYY-MM-DD" autocomplete="off" required><span class="field-hint date-hint" id="date-hint">AD date equivalent: <span id="dateAD"><%= todayAd || 'Checking date…' %></span></span></div>
              <div class="field full"><label for="narration">Narration / कारोबारको विवरण</label><textarea id="narration" name="narration" maxlength="500" placeholder="Describe the reason and nature of this transaction…" required><%= form.narration || '' %></textarea><span class="field-hint"><span id="narration-count"><%= (form.narration || '').length %></span>/500 characters. Use a clear description for the audit trail.</span></div>
            </div>

            <div class="entry-heading"><div><h3>Entry details / खाता पङ्क्तिहरू</h3><p>Select each ledger and enter the amount on either the debit or credit side.</p></div><button class="button" type="button" id="add-row"><span aria-hidden="true">＋</span> Add row</button></div>
            <div class="entry-scroll">
              <table class="entry-table">
                <thead><tr><th style="width:58px">S.N.</th><th>Account head / खाता नाम</th><th style="width:190px">Debit (Rs.)</th><th style="width:190px">Credit (Rs.)</th><th style="width:75px;text-align:center">Action</th></tr></thead>
                <tbody id="entry-rows">
                  <% const initialRows = Array.isArray(form.entries) && form.entries.length ? form.entries : [{}, {}]; %>
                  <% initialRows.forEach((entry, index) => { %>
                    <tr class="entry-row">
                      <td class="row-number"><%= index + 1 %></td>
                      <td><select class="ledger-select" name="entries[<%= index %>][ledger]" required><option value="">Choose account…</option><% ledgers.forEach(ledger => { %><option value="<%= ledger._id %>" <%= String(entry.ledger || '') === String(ledger._id) ? 'selected' : '' %>><%= ledger.code %> · <%= ledger.name %><%= ledger.group ? ' — ' + ledger.group.name : '' %></option><% }); %></select></td>
                      <td><input class="debit-input" name="entries[<%= index %>][debit]" type="number" min="0" step="0.01" value="<%= entry.debit || '' %>" placeholder="0.00" inputmode="decimal" aria-label="Debit amount for entry <%= index + 1 %>"></td>
                      <td><input class="credit-input" name="entries[<%= index %>][credit]" type="number" min="0" step="0.01" value="<%= entry.credit || '' %>" placeholder="0.00" inputmode="decimal" aria-label="Credit amount for entry <%= index + 1 %>"></td>
                      <td style="text-align:center"><button class="remove-row" type="button" aria-label="Remove entry <%= index + 1 %>" title="Remove row">×</button></td>
                    </tr>
                  <% }); %>
                </tbody>
                <tfoot><tr><td colspan="2" class="total-label">Total / जम्मा</td><td class="total-value" id="total-debit">Rs. 0.00</td><td class="total-value" id="total-credit">Rs. 0.00</td><td></td></tr></tfoot>
              </table>
            </div>

            <div class="balance-message" id="balance-message" role="status" aria-live="polite"><span class="balance-icon">!</span><span id="balance-text">Enter debit and credit amounts. The totals must match before posting.</span></div>
            <div class="form-bottom"><div class="form-note"><%= editingVoucher ? 'The server revalidates the BS date, ledger accounts and balanced totals. Prior posted values are preserved in revision history.' : 'The server validates every ledger, date and amount. A voucher number is allocated atomically on save; gaps may occur if a save fails, but numbers are never reused.' %></div><div class="form-actions"><% if (editingVoucher) { %><a class="button" href="/journal-voucher">Cancel edit</a><button class="button primary" id="save-voucher" type="submit" disabled>Update voucher</button><% } else { %><button class="button" type="button" id="reset-form">Clear form</button><button class="button primary" id="save-voucher" type="submit" disabled>Post journal voucher</button><% } %></div></div>
          </form>
        </div>
      </section>

      <section class="saved-card">
        <div class="saved-header"><div><h2>Saved journal vouchers / सुरक्षित भौचर सूची</h2><p>Latest vouchers with BS and AD dates, debit-credit totals, and reversal status.</p></div><span class="saved-count"><%= vouchers.length %> latest records</span></div>
        <div class="list-tools"><input class="search-input" id="voucher-search" type="search" placeholder="Search voucher no., narration or account…" aria-label="Search vouchers"><select class="filter-select" id="voucher-month" aria-label="Filter by BS month"><option value="">All dates</option><% [...new Set(vouchers.map(voucher => voucher.dateBS.slice(0, 7)))].sort().reverse().forEach(month => { %><option value="<%= month %>"><%= month %> BS</option><% }); %></select></div>
        <% if (vouchers.length) { %>
          <div class="saved-scroll"><table class="saved-table" id="saved-vouchers"><thead><tr><th>Date</th><th>Voucher no.</th><th>Type</th><th>Description / विवरण</th><th>Debit (Rs.)</th><th>Credit (Rs.)</th><th>Status</th><th>Actions</th></tr></thead><tbody>
            <% vouchers.forEach((voucher, index) => { const searchText = `${voucher.voucherNumber} ${voucher.narration} ${voucher.entries.map(entry => entry.ledger ? `${entry.ledger.code} ${entry.ledger.name}` : '').join(' ')}`.toLowerCase(); %>
              <tr class="voucher-row" data-search="<%= searchText %>" data-month="<%= voucher.dateBS.slice(0, 7) %>">
                <td class="saved-date"><%= voucher.dateBS %> BS<small><%= voucher.dateAdDisplay %> AD</small></td>
                <td class="voucher-number"><%= voucher.voucherNumber %></td>
                <td><span class="type-pill"><%= voucher.voucherTypeLabel %></span></td>
                <td><%= voucher.narration %></td>
                <td class="amount">Rs. <%= Number(voucher.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td class="amount">Rs. <%= Number(voucher.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td><span class="status-pill"><%= voucher.displayStatus.replace(/_/g, ' ') %></span></td>
                <td><div style="display:flex;align-items:center;gap:12px"><button class="view-toggle" type="button" aria-expanded="false" aria-controls="voucher-detail-<%= index %>">View lines</button><a class="edit-voucher-link" href="/accounting/vouchers">Approval &amp; reversal</a></div></td>
              </tr>
              <tr class="details-row" id="voucher-detail-<%= index %>" hidden><td colspan="8"><table class="line-detail"><thead><tr><th>Account</th><th>Code</th><th>Debit (Rs.)</th><th>Credit (Rs.)</th></tr></thead><tbody>
                <% voucher.entries.forEach(entry => { %><tr><td><%= entry.ledger ? entry.ledger.name : 'Account unavailable' %></td><td><%= entry.ledger ? entry.ledger.code : '—' %></td><td><%= Number(entry.debit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= Number(entry.credit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td></tr><% }); %>
              </tbody></table>
              <% (voucher.revisionHistory || []).slice().reverse().forEach(revision => { %>
                <h4 class="revision-heading">Previous version <%= revision.revision + 1 %> · <%= revision.editedAt.toISOString().slice(0, 10) %> · <%= revision.editedBy || 'Admin' %></h4>
                <p class="revision-summary"><%= revision.dateBS %> BS / <%= revision.dateAD.toISOString().slice(0, 10) %> AD — <%= revision.narration %> · Debit Rs. <%= Number(revision.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> · Credit Rs. <%= Number(revision.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
                <table class="line-detail"><thead><tr><th>Previous account</th><th>Code</th><th>Debit (Rs.)</th><th>Credit (Rs.)</th></tr></thead><tbody>
                  <% revision.entries.forEach(entry => { %><tr><td><%= entry.ledger ? entry.ledger.name : 'Account unavailable' %></td><td><%= entry.ledger ? entry.ledger.code : '—' %></td><td><%= Number(entry.debit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= Number(entry.credit).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td></tr><% }); %>
                </tbody></table>
              <% }); %>
              </td></tr>
            <% }); %>
          </tbody></table><div class="empty-state hidden" id="no-vouchers-found">No vouchers match your search.</div></div>
        <% } else { %><div class="empty-state">No journal vouchers saved yet. Your posted vouchers will appear here.</div><% } %>
        <div class="saved-footer">Posted voucher records are retained for audit integrity. Correct errors through a reversing and replacement voucher rather than changing the posted record.</div>
      </section>
    </div>
  </main>
  <template id="ledger-options"><option value="">Choose account…</option><% ledgers.forEach(ledger => { %><option value="<%= ledger._id %>"><%= ledger.code %> · <%= ledger.name %><%= ledger.group ? ' — ' + ledger.group.name : '' %></option><% }); %></template>
  <script src="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/js/nepali.datepicker.v5.0.6.min.js" type="text/javascript"></script>
  <script>
    (function () {
      const form = document.getElementById('voucher-form');
      const rows = document.getElementById('entry-rows');
      const addRowButton = document.getElementById('add-row');
      const dateInput = document.getElementById('dateBS');
      const dateOutput = document.getElementById('dateAD');
      const dateHint = document.getElementById('date-hint');
      const narration = document.getElementById('narration');
      const saveButton = document.getElementById('save-voucher');
      let dateRequest = 0;
      let dateIsValid = false;

      function money(minor) {
        return (minor / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function amountInMinorUnits(input) {
        const value = input.value.trim();
        if (!value) return 0;
        if (!/^\d+(?:\.\d{1,2})?$/.test(value)) return null;
        const [whole, fraction = ''] = value.split('.');
        const minor = Number(whole) * 100 + Number((fraction + '00').slice(0, 2));
        return Number.isSafeInteger(minor) ? minor : null;
      }

      function updateRows() {
        const currentRows = Array.from(rows.querySelectorAll('.entry-row'));
        let totalDebit = 0;
        let totalCredit = 0;
        let validAmounts = true;
        currentRows.forEach((row, index) => {
          row.querySelector('.row-number').textContent = String(index + 1);
          const remove = row.querySelector('.remove-row');
          remove.disabled = currentRows.length <= 2;
          remove.setAttribute('aria-label', `Remove entry ${index + 1}`);
          const debit = amountInMinorUnits(row.querySelector('.debit-input'));
          const credit = amountInMinorUnits(row.querySelector('.credit-input'));
          if (debit === null || credit === null) validAmounts = false;
          else {
            totalDebit += debit;
            totalCredit += credit;
          }
        });
        document.getElementById('total-debit').textContent = `Rs. ${money(totalDebit)}`;
        document.getElementById('total-credit').textContent = `Rs. ${money(totalCredit)}`;
        const balanced = validAmounts && totalDebit > 0 && totalDebit === totalCredit;
        const message = document.getElementById('balance-message');
        message.classList.toggle('balanced', balanced);
        message.querySelector('.balance-icon').textContent = balanced ? '✓' : '!';
        document.getElementById('balance-text').textContent = balanced
          ? 'Balanced. Debit and credit totals match.'
          : validAmounts
            ? 'Not balanced yet. Total debit must equal total credit before posting.'
            : 'Enter valid amounts with no more than two decimal places.';
        saveButton.disabled = !balanced || !dateIsValid || !narration.value.trim() || !document.querySelector('.ledger-select option[value]:not([value=""])');
      }

      function renumberRows() {
        Array.from(rows.querySelectorAll('.entry-row')).forEach((row, index) => {
          row.querySelector('.ledger-select').name = `entries[${index}][ledger]`;
          row.querySelector('.debit-input').name = `entries[${index}][debit]`;
          row.querySelector('.credit-input').name = `entries[${index}][credit]`;
        });
        updateRows();
      }

      function addRow(entry) {
        const row = document.createElement('tr');
        row.className = 'entry-row';
        const select = document.createElement('select');
        select.className = 'ledger-select';
        select.required = true;
        select.append(document.getElementById('ledger-options').content.cloneNode(true));
        if (entry && entry.ledger) select.value = entry.ledger;
        const number = document.createElement('input');
        number.className = 'debit-input';
        number.type = 'number';
        number.min = '0';
        number.step = '0.01';
        number.placeholder = '0.00';
        number.inputMode = 'decimal';
        number.setAttribute('aria-label', 'Debit amount');
        if (entry && entry.debit) number.value = entry.debit;
        const credit = document.createElement('input');
        credit.className = 'credit-input';
        credit.type = 'number';
        credit.min = '0';
        credit.step = '0.01';
        credit.placeholder = '0.00';
        credit.inputMode = 'decimal';
        credit.setAttribute('aria-label', 'Credit amount');
        if (entry && entry.credit) credit.value = entry.credit;
        row.innerHTML = '<td class="row-number"></td><td></td><td></td><td></td><td style="text-align:center"><button class="remove-row" type="button" aria-label="Remove entry" title="Remove row">×</button></td>';
        row.children[1].append(select);
        row.children[2].append(number);
        row.children[3].append(credit);
        rows.append(row);
        renumberRows();
      }

      async function convertDate() {
        const value = dateInput.value.trim();
        dateIsValid = false;
        if (!value) {
          dateOutput.textContent = 'Select a valid BS date';
          dateHint.classList.add('invalid');
          updateRows();
          return;
        }
        const requestId = ++dateRequest;
        dateOutput.textContent = 'Checking…';
        dateHint.classList.remove('invalid');
        updateRows();
        try {
          const response = await fetch(`/journal-voucher/date-conversion?bsDate=${encodeURIComponent(value)}`, {
            headers: { Accept: 'application/json' }
          });
          const result = await response.json();
          if (requestId !== dateRequest) return;
          if (!response.ok) throw new Error(result.error || 'Invalid BS date');
          dateOutput.textContent = result.dateAD;
          dateHint.classList.remove('invalid');
          dateIsValid = true;
        } catch (error) {
          if (requestId !== dateRequest) return;
          dateOutput.textContent = error.message || 'Invalid BS date';
          dateHint.classList.add('invalid');
        }
        updateRows();
      }

      addRowButton.addEventListener('click', () => addRow());
      rows.addEventListener('input', updateRows);
      rows.addEventListener('change', updateRows);
      rows.addEventListener('click', event => {
        const remove = event.target.closest('.remove-row');
        if (!remove || rows.querySelectorAll('.entry-row').length <= 2) return;
        remove.closest('.entry-row').remove();
        renumberRows();
      });
      dateInput.addEventListener('change', convertDate);
      dateInput.addEventListener('input', convertDate);
      narration.addEventListener('input', () => {
        document.getElementById('narration-count').textContent = narration.value.length;
        updateRows();
      });
      const resetFormButton = document.getElementById('reset-form');
      if (resetFormButton) {
        resetFormButton.addEventListener('click', () => {
          form.reset();
          while (rows.querySelectorAll('.entry-row').length > 2) rows.lastElementChild.remove();
          rows.querySelectorAll('.entry-row').forEach(row => {
            row.querySelector('.ledger-select').value = '';
            row.querySelector('.debit-input').value = '';
            row.querySelector('.credit-input').value = '';
          });
          dateInput.value = '<%= todayBs %>';
          document.getElementById('narration-count').textContent = '0';
          convertDate();
          renumberRows();
        });
      }
      form.addEventListener('submit', event => {
        updateRows();
        if (saveButton.disabled) {
          event.preventDefault();
          document.getElementById('balance-message').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });

      document.querySelectorAll('.nepali-datepicker').forEach(input => {
        if (typeof input.nepaliDatePicker === 'function') {
          input.nepaliDatePicker({
            dateFormat: 'YYYY-MM-DD',
            language: 'en',
            onSelect: function (selectedDate) {
              if (typeof selectedDate === 'string') input.value = selectedDate.trim();
              else if (selectedDate && selectedDate.year && selectedDate.month && selectedDate.day) {
                input.value = `${selectedDate.year}-${String(selectedDate.month).padStart(2, '0')}-${String(selectedDate.day).padStart(2, '0')}`;
              }
              convertDate();
            }
          });
        }
      });

      const search = document.getElementById('voucher-search');
      const monthFilter = document.getElementById('voucher-month');
      function filterVouchers() {
        const query = search.value.trim().toLowerCase();
        const month = monthFilter.value;
        let shown = 0;
        document.querySelectorAll('.voucher-row').forEach(row => {
          const matched = row.dataset.search.includes(query) && (!month || row.dataset.month === month);
          row.hidden = !matched;
          row.nextElementSibling.hidden = !matched;
          if (matched) shown += 1;
        });
        const noMatches = document.getElementById('no-vouchers-found');
        if (noMatches) noMatches.classList.toggle('hidden', shown !== 0);
      }
      if (search && monthFilter) {
        search.addEventListener('input', filterVouchers);
        monthFilter.addEventListener('change', filterVouchers);
      }

      document.querySelectorAll('.view-toggle').forEach(button => {
        button.addEventListener('click', () => {
          const details = document.getElementById(button.getAttribute('aria-controls'));
          details.hidden = !details.hidden;
          button.setAttribute('aria-expanded', String(!details.hidden));
          button.textContent = details.hidden ? 'View lines' : 'Hide lines';
        });
      });
      convertDate();
      updateRows();
    })();
  </script>
</body>
</html>