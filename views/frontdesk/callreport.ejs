<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Student-wise call report</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
	<style>
		:root { color-scheme:light; --ink:#1b2940; --muted:#66758b; --line:#dce4ee; --paper:#fff; --canvas:#f1f5fa; --blue:#24477b; --blue-dark:#17345e; --blue-soft:#edf4ff; --green:#23704c; --amber:#805b12; font-family:'DM Sans',sans-serif; color:var(--ink); background:var(--canvas); }
		* { box-sizing:border-box; }
		body { margin:0; min-height:100vh; background:linear-gradient(145deg,#f5f8fc,#eaf0f7); }
		button,input,select { font:inherit; }
		.call-report-shell { width:min(1440px,calc(100% - 44px)); margin:0 auto; padding:32px 0 52px; }
		.report-header { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:22px; }
		.report-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:9px; }
		.eyebrow { margin:0 0 6px; color:var(--blue); font-size:.7rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
		h1,h2 { font-family:'Manrope',sans-serif; }
		h1 { margin:0; font-size:clamp(1.45rem,3vw,2rem); }
		.intro { max-width:740px; margin:7px 0 0; color:var(--muted); line-height:1.55; }
		.primary-button,.secondary-button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:42px; padding:0 15px; border:1px solid var(--blue); border-radius:7px; cursor:pointer; font-weight:800; text-decoration:none; transition:background .15s ease,transform .15s ease; }
		.primary-button { background:var(--blue); color:#fff; box-shadow:0 5px 14px rgba(36,71,123,.16); }
		.primary-button:hover { background:var(--blue-dark); transform:translateY(-1px); }
		.secondary-button { border-color:var(--line); background:#fff; color:var(--ink); }
		.secondary-button:hover { background:#f6f9fd; }
		button:disabled { opacity:.55; cursor:not-allowed; transform:none; }
		.panel { overflow:hidden; border:1px solid var(--line); border-radius:10px; background:var(--paper); box-shadow:0 8px 26px rgba(23,52,94,.05); }
		.report-panel { min-height:250px; }
		.panel-heading { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:18px 20px; border-bottom:1px solid var(--line); }
		.panel-heading h2 { margin:0; font-size:1rem; }
		.report-summary { color:var(--muted); font-size:.82rem; }
		.report-empty { display:grid; min-height:190px; place-content:center; justify-items:center; gap:9px; padding:28px; color:var(--muted); text-align:center; }
		.report-empty i { color:#91a5c1; font-size:1.7rem; }
		.report-empty strong { color:var(--ink); font-size:.96rem; }
		.table-wrap { overflow:auto; max-height:72vh; }
		.report-table { width:100%; min-width:850px; border-collapse:collapse; font-size:.82rem; }
		.report-table th,.report-table td { min-width:112px; padding:11px 12px; border:1px solid var(--line); text-align:left; vertical-align:top; }
		.report-table th { position:sticky; top:0; z-index:2; background:#edf3fb; color:#344963; font-size:.72rem; text-transform:uppercase; }
		.report-table th:first-child,.report-table td:first-child { position:sticky; left:0; z-index:1; min-width:48px; width:48px; text-align:center; background:#fff; }
		.report-table th:first-child { z-index:3; background:#edf3fb; }
		.report-table th:nth-child(2),.report-table td:nth-child(2) { min-width:170px; }
		.report-table tbody tr:nth-child(even) td { background:#f9fbfe; }
		.report-table tbody tr:nth-child(even) td:first-child { background:#f9fbfe; }
		.month-heading { display:grid; gap:5px; }
		.month-total { color:var(--blue); font-size:.68rem; font-weight:800; text-transform:none; }
		.student-name { font-weight:800; }
		.student-meta { display:block; margin-top:4px; color:var(--muted); font-size:.72rem; font-weight:500; text-transform:none; }
		.call-cell { min-width:160px !important; }
		.call-count { display:inline-flex; margin-bottom:7px; padding:3px 8px; border-radius:999px; background:var(--blue-soft); color:var(--blue); font-size:.7rem; font-weight:800; }
		.call-entry { padding:7px 0; border-top:1px solid #e8edf4; line-height:1.45; overflow-wrap:anywhere; }
		.call-entry:first-of-type { border-top:0; padding-top:0; }
		.call-day { color:var(--blue-dark); font-weight:800; }
		.call-detail-label { color:var(--muted); font-weight:700; }
		.no-calls { color:#8995a5; }
		.report-error { margin:14px 20px; color:#a1303c; font-size:.84rem; font-weight:700; }
		dialog { width:min(780px,calc(100% - 24px)); max-height:min(90vh,900px); padding:0; border:1px solid var(--line); border-radius:12px; color:var(--ink); box-shadow:0 24px 80px rgba(12,28,52,.28); }
		dialog::backdrop { background:rgba(14,29,52,.52); backdrop-filter:blur(2px); }
		.modal-content { display:flex; max-height:min(90vh,900px); flex-direction:column; }
		.modal-header { display:flex; align-items:flex-start; justify-content:space-between; gap:15px; padding:20px 22px; border-bottom:1px solid var(--line); }
		.modal-header h2 { margin:0; font-size:1.12rem; }
		.modal-header p { margin:5px 0 0; color:var(--muted); font-size:.82rem; }
		.close-button { display:grid; flex:0 0 36px; width:36px; height:36px; place-items:center; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--muted); cursor:pointer; font-size:1.15rem; }
		.modal-body { display:grid; gap:18px; overflow:auto; padding:18px 22px; }
		.field-label { display:block; margin-bottom:7px; color:#344963; font-size:.78rem; font-weight:800; }
		.search-input,.year-select { width:100%; min-height:42px; padding:9px 11px; border:1px solid #cbd6e4; border-radius:7px; background:#fff; color:var(--ink); }
		.search-input:focus,.year-select:focus { outline:3px solid rgba(66,126,207,.15); border-color:#6e97ca; }
		.student-picker { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(210px,.8fr); gap:18px; }
		.student-results { display:grid; align-content:start; max-height:250px; overflow:auto; border:1px solid var(--line); border-radius:8px; }
		.student-option { display:flex; align-items:flex-start; gap:10px; padding:10px 11px; border-bottom:1px solid #edf1f6; cursor:pointer; }
		.student-option:last-child { border-bottom:0; }
		.student-option:hover { background:#f7faff; }
		.student-option input { margin-top:3px; accent-color:var(--blue); }
		.student-option-copy { display:grid; gap:3px; }
		.student-option-name { color:var(--ink); font-size:.81rem; font-weight:800; text-transform:lowercase; }
		.student-option-meta { color:var(--muted); font-size:.71rem; }
		.student-result-message { padding:16px; color:var(--muted); font-size:.78rem; text-align:center; }
		.selected-heading { margin:13px 0 7px; color:var(--muted); font-size:.72rem; font-weight:800; }
		.selected-students { display:flex; flex-wrap:wrap; gap:7px; min-height:28px; }
		.selected-chip { display:inline-flex; align-items:center; gap:7px; padding:5px 8px; border:1px solid #cbd9eb; border-radius:999px; background:#f1f6fd; color:var(--blue-dark); font-size:.7rem; font-weight:700; }
		.selected-chip button { display:grid; width:18px; height:18px; place-items:center; border:0; border-radius:50%; background:transparent; color:var(--blue-dark); cursor:pointer; }
		.selected-empty { color:#8995a5; font-size:.74rem; }
		.month-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
		.month-option { display:flex; align-items:center; gap:8px; min-height:40px; padding:8px 10px; border:1px solid var(--line); border-radius:7px; color:#3e5067; font-size:.75rem; font-weight:700; cursor:pointer; }
		.month-option:has(input:checked) { border-color:#9bb9e0; background:#f0f6ff; color:var(--blue-dark); }
		.month-option input { accent-color:var(--blue); }
		.month-actions { display:flex; align-items:center; justify-content:space-between; gap:10px; }
		.text-button { padding:4px 2px; border:0; background:transparent; color:var(--blue); font-size:.72rem; font-weight:800; text-decoration:underline; cursor:pointer; }
		.modal-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:15px 22px; border-top:1px solid var(--line); background:#fbfcfe; }
		.modal-error { min-height:1.2em; color:#a1303c; font-size:.76rem; }
		@media(max-width:760px) {
			.call-report-shell { width:calc(100% - 24px); padding-top:14px; }
			.report-header { flex-direction:column; }
			.report-header .report-actions { width:100%; justify-content:flex-start; }
			.report-header .report-actions button { flex:1; }
			.student-picker { grid-template-columns:1fr; }
			.month-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
			.panel-heading { align-items:flex-start; flex-direction:column; }
			.modal-header,.modal-body,.modal-footer { padding-right:15px; padding-left:15px; }
		}
		@media(max-width:440px) {
			.month-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
			.modal-footer { align-items:stretch; flex-direction:column; }
			.modal-footer .primary-button { width:100%; }
		}
		@media print {
			body { background:#fff; }
			.frontdesk-sidenav,.frontdesk-mobile-nav-toggle,.frontdesk-nav-backdrop,.report-header .report-actions { display:none !important; }
			body.frontdesk-nav-active .call-report-shell { width:100%; margin:0; padding:0; }
			.report-panel { border:0; box-shadow:none; }
			.table-wrap { max-height:none; overflow:visible; }
			.report-table th,.report-table td { position:static !important; }
		}
	</style>
</head>
<body>
	<%- include('frontdesksidenav', { frontdeskCurrentPage }) %>
	<main class="call-report-shell">
		<header class="report-header">
			<div>
				<p class="eyebrow">Front Desk / Reports</p>
				<h1>Student-wise call report</h1>
				<p class="intro">Review who was contacted, when each call was made, why the call was placed, and the response received from the parent.</p>
			</div>
			<div class="report-actions">
				<button class="primary-button" id="openReportModal" type="button"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i> Generate student-wise call record</button>
				<button class="secondary-button" id="openTotalReportModal" type="button"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> Total call record</button>
			</div>
		</header>

		<section class="panel report-panel" aria-labelledby="reportTitle">
			<div class="panel-heading">
				<h2 id="reportTitle">Call report</h2>
				<span class="report-summary" id="reportSummary">Choose students, months, and academic year to generate a report.</span>
			</div>
			<div id="reportEmpty" class="report-empty">
				<i class="fa-solid fa-phone-volume" aria-hidden="true"></i>
				<strong>No report generated</strong>
				<span>Select one or more students and months to view their call history.</span>
			</div>
			<p id="reportError" class="report-error" role="alert" hidden></p>
			<div class="table-wrap" id="reportTableWrap" hidden>
				<table class="report-table" id="studentCallReport">
					<thead></thead>
					<tbody></tbody>
				</table>
			</div>
			<div class="table-wrap" id="totalTableWrap" hidden>
				<table class="report-table" id="monthlyTotalReport">
					<thead></thead>
					<tbody></tbody>
				</table>
			</div>
		</section>
	</main>

	<dialog id="reportModal" aria-labelledby="reportModalTitle">
		<form class="modal-content" id="reportForm">
			<div class="modal-header">
				<div><h2 id="reportModalTitle">Build student-wise call report</h2><p>Select multiple students, one or more Bikram Sambat months, and an academic year.</p></div>
				<button class="close-button" id="closeReportModal" type="button" aria-label="Close dialog"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
			</div>
			<div class="modal-body">
				<div class="student-picker">
					<div>
						<label class="field-label" for="studentSearch">Search students by name</label>
						<input class="search-input" id="studentSearch" type="search" autocomplete="off" placeholder="Type a name or part of a name">
						<div class="student-results" id="studentResults" role="group" aria-label="Matching students">
							<div class="student-result-message">Type at least one letter to search.</div>
						</div>
					</div>
					<div>
						<label class="field-label" for="academicYear">Academic year</label>
						<select class="year-select" id="academicYear" required>
							<% academicYears.forEach(year => { %><option value="<%= year %>" <%= String(year) === String(currentAcademicYear) ? 'selected' : '' %>><%= year %></option><% }) %>
						</select>
						<p class="selected-heading">Selected students <span id="selectedCount">(0)</span></p>
						<div class="selected-students" id="selectedStudents"><span class="selected-empty">No students selected yet.</span></div>
					</div>
				</div>

				<div>
					<div class="month-actions">
						<span class="field-label">Months (select one or more)</span>
						<div><button class="text-button" id="selectAllMonths" type="button">Select all</button><button class="text-button" id="clearMonths" type="button">Clear</button></div>
					</div>
					<div class="month-grid" id="monthOptions">
						<% months.forEach(month => { %><label class="month-option"><input type="checkbox" name="months" value="<%= month %>" <%= month === currentMonth ? 'checked' : '' %>><span><%= month %></span></label><% }) %>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<span class="modal-error" id="modalError" role="status" aria-live="polite"></span>
				<div><button class="secondary-button" id="cancelReport" type="button">Cancel</button> <button class="primary-button" id="generateReport" type="submit"><i class="fa-solid fa-chart-column" aria-hidden="true"></i> Generate report</button></div>
			</div>
		</form>
	</dialog>

	<dialog id="totalReportModal" aria-labelledby="totalReportModalTitle">
		<form class="modal-content" id="totalReportForm">
			<div class="modal-header">
				<div><h2 id="totalReportModalTitle">Build monthly total call report</h2><p>Choose the academic year and months to count all recorded calls, including saved absence reasons.</p></div>
				<button class="close-button" id="closeTotalReportModal" type="button" aria-label="Close dialog"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
			</div>
			<div class="modal-body">
				<div>
					<label class="field-label" for="totalAcademicYear">Academic year</label>
					<select class="year-select" id="totalAcademicYear" required>
						<% academicYears.forEach(year => { %><option value="<%= year %>" <%= String(year) === String(currentAcademicYear) ? 'selected' : '' %>><%= year %></option><% }) %>
					</select>
				</div>
				<div>
					<div class="month-actions">
						<span class="field-label">Months (current year is selected through the current month)</span>
						<div><button class="text-button" id="selectAllTotalMonths" type="button">Select all</button><button class="text-button" id="clearTotalMonths" type="button">Clear</button></div>
					</div>
					<div class="month-grid" id="totalMonthOptions">
						<% months.forEach((month, index) => { %><label class="month-option"><input type="checkbox" name="totalMonths" value="<%= month %>" <%= index <= months.indexOf(currentMonth) ? 'checked' : '' %>><span><%= month %></span></label><% }) %>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<span class="modal-error" id="totalModalError" role="status" aria-live="polite"></span>
				<div><button class="secondary-button" id="cancelTotalReport" type="button">Cancel</button> <button class="primary-button" id="generateTotalReport" type="submit"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> Generate totals</button></div>
			</div>
		</form>
	</dialog>

	<script>
		const reportModal = document.getElementById('reportModal');
		const reportForm = document.getElementById('reportForm');
		const totalReportModal = document.getElementById('totalReportModal');
		const totalReportForm = document.getElementById('totalReportForm');
		const studentSearch = document.getElementById('studentSearch');
		const studentResults = document.getElementById('studentResults');
		const selectedStudentsContainer = document.getElementById('selectedStudents');
		const selectedCount = document.getElementById('selectedCount');
		const modalError = document.getElementById('modalError');
		const generateButton = document.getElementById('generateReport');
		const selectedStudents = new Map();
		let searchTimer;
		let latestSearchId = 0;

		document.getElementById('openReportModal').addEventListener('click', () => {
			modalError.textContent = '';
			reportModal.showModal();
			studentSearch.focus();
		});
		document.getElementById('openTotalReportModal').addEventListener('click', () => {
			document.getElementById('totalModalError').textContent = '';
			totalReportModal.showModal();
		});
		document.getElementById('closeReportModal').addEventListener('click', () => reportModal.close());
		document.getElementById('cancelReport').addEventListener('click', () => reportModal.close());
		document.getElementById('closeTotalReportModal').addEventListener('click', () => totalReportModal.close());
		document.getElementById('cancelTotalReport').addEventListener('click', () => totalReportModal.close());
		reportModal.addEventListener('click', event => {
			if (event.target === reportModal) reportModal.close();
		});
		totalReportModal.addEventListener('click', event => {
			if (event.target === totalReportModal) totalReportModal.close();
		});
		document.getElementById('selectAllMonths').addEventListener('click', () => {
			document.querySelectorAll('#monthOptions input').forEach(input => { input.checked = true; });
		});
		document.getElementById('clearMonths').addEventListener('click', () => {
			document.querySelectorAll('#monthOptions input').forEach(input => { input.checked = false; });
		});
		document.getElementById('selectAllTotalMonths').addEventListener('click', () => {
			document.querySelectorAll('#totalMonthOptions input').forEach(input => { input.checked = true; });
		});
		document.getElementById('clearTotalMonths').addEventListener('click', () => {
			document.querySelectorAll('#totalMonthOptions input').forEach(input => { input.checked = false; });
		});

		const showSearchMessage = message => {
			const item = document.createElement('div');
			item.className = 'student-result-message';
			item.textContent = message;
			studentResults.replaceChildren(item);
		};
		const renderSelectedStudents = () => {
			selectedCount.textContent = `(${selectedStudents.size})`;
			selectedStudentsContainer.replaceChildren();
			if (!selectedStudents.size) {
				const empty = document.createElement('span');
				empty.className = 'selected-empty';
				empty.textContent = 'No students selected yet.';
				selectedStudentsContainer.appendChild(empty);
				return;
			}
			selectedStudents.forEach(student => {
				const chip = document.createElement('span');
				chip.className = 'selected-chip';
				const label = document.createElement('span');
				label.textContent = `${student.name.toLowerCase()} · ${student.roll || '-'} · ${student.studentClass || '-'} ${student.section || ''}`;
				const remove = document.createElement('button');
				remove.type = 'button';
				remove.setAttribute('aria-label', `Remove ${student.name} from selection`);
				remove.innerHTML = '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';
				remove.addEventListener('click', () => {
					selectedStudents.delete(student.reg);
					renderSelectedStudents();
					renderSearchResults(window.currentStudentResults || []);
				});
				chip.append(label, remove);
				selectedStudentsContainer.appendChild(chip);
			});
		};
		const renderSearchResults = results => {
			window.currentStudentResults = results;
			studentResults.replaceChildren();
			if (!results.length) {
				showSearchMessage('No students match this name.');
				return;
			}
			results.forEach(student => {
				const label = document.createElement('label');
				label.className = 'student-option';
				const checkbox = document.createElement('input');
				checkbox.type = 'checkbox';
				checkbox.checked = selectedStudents.has(student.reg);
				checkbox.addEventListener('change', () => {
					if (checkbox.checked) {
						if (selectedStudents.size >= 200) {
							checkbox.checked = false;
							modalError.textContent = 'You can select up to 200 students per report.';
							return;
						}
						selectedStudents.set(student.reg, student);
						modalError.textContent = '';
					} else {
						selectedStudents.delete(student.reg);
					}
					renderSelectedStudents();
				});
				const copy = document.createElement('span');
				copy.className = 'student-option-copy';
				const name = document.createElement('span');
				name.className = 'student-option-name';
				name.textContent = student.name.toLowerCase();
				const meta = document.createElement('span');
				meta.className = 'student-option-meta';
				meta.textContent = `Roll ${student.roll || '-'} · Class ${student.studentClass || '-'} · Section ${student.section || '-'}`;
				copy.append(name, meta);
				label.append(checkbox, copy);
				studentResults.appendChild(label);
			});
		};
		const searchStudents = async () => {
			const query = studentSearch.value.trim();
			const searchId = ++latestSearchId;
			if (!query) {
				showSearchMessage('Type at least one letter to search.');
				return;
			}
			showSearchMessage('Searching students…');
			try {
				const response = await fetch(`/frontdesk/call-report/students?q=${encodeURIComponent(query)}`, {
					credentials: 'same-origin',
					headers: { Accept: 'application/json' }
				});
				const data = await response.json();
				if (!response.ok) throw new Error(data.message || 'Unable to search students.');
				if (searchId === latestSearchId) renderSearchResults(data);
			} catch (error) {
				if (searchId === latestSearchId) showSearchMessage(error.message);
			}
		};
		studentSearch.addEventListener('input', () => {
			clearTimeout(searchTimer);
			searchTimer = setTimeout(searchStudents, 250);
		});

		const addTextCell = (row, value, className) => {
			const cell = document.createElement('td');
			if (className) cell.className = className;
			cell.textContent = value || '';
			row.appendChild(cell);
			return cell;
		};
		const renderReport = data => {
			const table = document.getElementById('studentCallReport');
			const head = table.querySelector('thead');
			const body = table.querySelector('tbody');
			head.replaceChildren();
			body.replaceChildren();
			document.getElementById('totalTableWrap').hidden = true;
			document.getElementById('reportTitle').textContent = 'Student-wise call report';
			const monthTotals = Object.fromEntries(data.months.map(month => [month, 0]));
			data.students.forEach(student => data.months.forEach(month => {
				monthTotals[month] += student.months[month].count;
			}));
			const headerRow = document.createElement('tr');
			['SN', 'Student'].forEach(label => {
				const cell = document.createElement('th');
				cell.scope = 'col';
				cell.textContent = label;
				headerRow.appendChild(cell);
			});
			data.months.forEach(month => {
				const cell = document.createElement('th');
				cell.scope = 'col';
				const wrapper = document.createElement('span');
				wrapper.className = 'month-heading';
				const title = document.createElement('span');
				title.textContent = month;
				const total = document.createElement('span');
				total.className = 'month-total';
				total.textContent = `${monthTotals[month]} ${monthTotals[month] === 1 ? 'call' : 'calls'}`;
				wrapper.append(title, total);
				cell.appendChild(wrapper);
				headerRow.appendChild(cell);
			});
			head.appendChild(headerRow);
			data.students.forEach(student => {
				const row = document.createElement('tr');
				addTextCell(row, student.sn);
				const nameCell = addTextCell(row, student.name);
				nameCell.className = 'student-name';
				const studentMeta = document.createElement('span');
				studentMeta.className = 'student-meta';
				const classAndSection = [student.studentClass, student.section].filter(Boolean).join('-');
				studentMeta.textContent = `${student.roll || '-'} | ${classAndSection || '-'}`;
				nameCell.appendChild(studentMeta);
				data.months.forEach(month => {
					const report = student.months[month];
					const cell = document.createElement('td');
					cell.className = 'call-cell';
					const count = document.createElement('span');
					count.className = 'call-count';
					count.textContent = `${report.count} ${report.count === 1 ? 'call' : 'calls'}`;
					cell.appendChild(count);
					if (!report.calls.length) {
						const none = document.createElement('div');
						none.className = 'no-calls';
						none.textContent = 'No calls';
						cell.appendChild(none);
					}
					report.calls.forEach(call => {
						const entry = document.createElement('div');
						entry.className = 'call-entry';
						const day = document.createElement('div');
						day.className = 'call-day';
						day.textContent = `${month} ${call.day || '-'}`;
						entry.appendChild(day);
						const reason = document.createElement('div');
						const reasonLabel = document.createElement('span');
						reasonLabel.className = 'call-detail-label';
						reasonLabel.textContent = 'Reason: ';
						reason.append(reasonLabel, document.createTextNode(call.callReason || 'Not recorded'));
						entry.appendChild(reason);
						const response = document.createElement('div');
						const responseLabel = document.createElement('span');
						responseLabel.className = 'call-detail-label';
						responseLabel.textContent = 'Parent response: ';
						response.append(responseLabel, document.createTextNode(call.parentResponse || 'Not recorded'));
						entry.appendChild(response);
						if (call.callLoggedAt) {
							const loggedAt = document.createElement('div');
							loggedAt.className = 'student-meta';
							loggedAt.textContent = `Logged ${new Date(call.callLoggedAt).toLocaleString()}`;
							entry.appendChild(loggedAt);
						}
						cell.appendChild(entry);
					});
					row.appendChild(cell);
				});
				body.appendChild(row);
			});
			document.getElementById('reportSummary').textContent =
				`${data.totalStudents} students · ${data.totalCalls} calls · Academic year ${data.academicYear} · ${data.months.join(', ')}`;
			document.getElementById('reportEmpty').hidden = true;
			document.getElementById('reportError').hidden = true;
			document.getElementById('reportTableWrap').hidden = false;
		};

		const renderTotalReport = data => {
			const table = document.getElementById('monthlyTotalReport');
			const head = table.querySelector('thead');
			const body = table.querySelector('tbody');
			head.replaceChildren();
			body.replaceChildren();
			const headerRow = document.createElement('tr');
			['Month', 'Total call'].forEach(label => {
				const cell = document.createElement('th');
				cell.scope = 'col';
				cell.textContent = label;
				headerRow.appendChild(cell);
			});
			head.appendChild(headerRow);
			data.months.forEach(month => {
				const row = document.createElement('tr');
				addTextCell(row, month);
				addTextCell(row, String(data.monthTotals[month] || 0));
				body.appendChild(row);
			});
			document.getElementById('reportTitle').textContent = 'Monthly total call record';
			document.getElementById('reportSummary').textContent =
				`${data.totalCalls} total calls · Academic year ${data.academicYear}`;
			document.getElementById('reportEmpty').hidden = true;
			document.getElementById('reportError').hidden = true;
			document.getElementById('reportTableWrap').hidden = true;
			document.getElementById('totalTableWrap').hidden = false;
		};

		reportForm.addEventListener('submit', async event => {
			event.preventDefault();
			modalError.textContent = '';
			const months = Array.from(document.querySelectorAll('#monthOptions input:checked'), input => input.value);
			if (!selectedStudents.size) {
				modalError.textContent = 'Search for and select at least one student.';
				return;
			}
			if (!months.length) {
				modalError.textContent = 'Select at least one month.';
				return;
			}
			generateButton.disabled = true;
			generateButton.textContent = 'Generating…';
			try {
				const response = await fetch('/frontdesk/call-report/generate', {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						regs: Array.from(selectedStudents.keys()),
						months,
						academicYear: document.getElementById('academicYear').value
					})
				});
				const data = await response.json();
				if (!response.ok) throw new Error(data.message || 'Unable to generate the report.');
				renderReport(data);
				reportModal.close();
				document.getElementById('reportTitle').scrollIntoView({ behavior: 'smooth', block: 'start' });
			} catch (error) {
				modalError.textContent = error.message;
			} finally {
				generateButton.disabled = false;
				generateButton.innerHTML = '<i class="fa-solid fa-chart-column" aria-hidden="true"></i> Generate report';
			}
		});

		totalReportForm.addEventListener('submit', async event => {
			event.preventDefault();
			const errorMessage = document.getElementById('totalModalError');
			const generateTotalButton = document.getElementById('generateTotalReport');
			errorMessage.textContent = '';
			const months = Array.from(document.querySelectorAll('#totalMonthOptions input:checked'), input => input.value);
			if (!months.length) {
				errorMessage.textContent = 'Select at least one month.';
				return;
			}
			generateTotalButton.disabled = true;
			generateTotalButton.textContent = 'Generating…';
			try {
				const response = await fetch('/frontdesk/call-report/monthly-totals', {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						months,
						academicYear: document.getElementById('totalAcademicYear').value
					})
				});
				const data = await response.json();
				if (!response.ok) throw new Error(data.message || 'Unable to generate monthly totals.');
				renderTotalReport(data);
				totalReportModal.close();
				document.getElementById('reportTitle').scrollIntoView({ behavior: 'smooth', block: 'start' });
			} catch (error) {
				errorMessage.textContent = error.message;
			} finally {
				generateTotalButton.disabled = false;
				generateTotalButton.innerHTML = '<i class="fa-solid fa-chart-pie" aria-hidden="true"></i> Generate totals';
			}
		});
	</script>
</body>
</html>