<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Employee list</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
	<style>
		:root { color-scheme: light; --ink:#1b2940; --muted:#6a7585; --line:#dce2e9; --paper:#fff; --canvas:#f1f3f6; --blue:#24477b; font-family:'DM Sans',sans-serif; color:var(--ink); background:var(--canvas); }
		* { box-sizing:border-box; }
		body { margin:0; min-height:100vh; background:var(--canvas); }
		.page-shell { width:min(1500px,calc(100% - 34px)); margin:0 auto; padding:28px 0 52px; }
		h1,h2 { font-family:'Manrope',sans-serif; }
		h1 { margin:0; font-size:1.6rem; }
		.page-header,.panel-heading { display:flex; align-items:center; justify-content:space-between; gap:14px; }
		.page-header { margin-bottom:20px; }
		.muted { margin:6px 0 0; color:var(--muted); }
		.panel { overflow:hidden; border:1px solid var(--line); border-radius:6px; background:var(--paper); }
		.panel-heading { padding:16px 18px; border-bottom:1px solid var(--line); }
		.panel-heading h2 { margin:0; font-size:1rem; }
		.controls { display:flex; gap:9px; }
		input { min-height:38px; width:min(320px,45vw); padding:8px 10px; border:1px solid #cbd4df; border-radius:4px; }
		.button { display:inline-flex; align-items:center; gap:8px; min-height:38px; padding:0 13px; border:1px solid var(--blue); border-radius:4px; background:var(--blue); color:#fff; text-decoration:none; font-weight:700; }
		.table-wrap { overflow:auto; }
		table { width:100%; border-collapse:collapse; white-space:nowrap; font-size:.83rem; }
		th,td { padding:11px 14px; border-bottom:1px solid #e9edf2; text-align:left; }
		th { background:#f5f7fa; color:var(--muted); font-size:.68rem; text-transform:uppercase; }
		tbody tr:last-child td { border-bottom:0; }
		.employee-code { color:var(--blue); font-weight:800; }
		.status { color:#285c47; font-weight:700; }
		.status-inactive { color:#7a4550; font-weight:800; }
		.empty { padding:28px; color:var(--muted); text-align:center; }
		.enrollment-button { min-height:32px; padding:0 10px; border:1px solid var(--blue); border-radius:4px; background:#fff; color:var(--blue); font:inherit; font-weight:700; cursor:pointer; }
		.action-group { display:flex; flex-wrap:wrap; gap:5px; }
		.action-button { min-height:30px; padding:0 8px; border:1px solid var(--blue); border-radius:4px; background:#fff; color:var(--blue); font:inherit; font-size:.78rem; font-weight:700; cursor:pointer; }
		.action-button:disabled,.enrollment-button:disabled { opacity:.5; cursor:not-allowed; }
		.manager-badge { display:inline-block; padding:2px 8px; border-radius:999px; background:#fff0d6; color:#7a4b00; font-size:.78rem; font-weight:800; }
		.notice { margin:16px 18px; padding:12px; border:1px solid #e8d59b; border-radius:4px; background:#fff9e8; line-height:1.5; }
		.device-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:14px; padding:16px 18px; }
		.device-card { padding:14px; border:1px solid var(--line); border-radius:5px; }
		.device-card h3 { margin:0 0 6px; }
		.device-card p { margin:6px 0; color:var(--muted); font-size:.88rem; }
		.capability-form { display:grid; gap:8px; margin-top:12px; }
		.capability-form label { display:flex; align-items:center; gap:7px; color:var(--ink); font-size:.86rem; }
		.capability-form input[type="text"] { width:100%; min-height:34px; }
		.capability-form .button { justify-content:center; }
		.history-content { max-height:60vh; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere; font-size:.83rem; }
		.inline-form-button { display:inline; }
		dialog { width:min(520px,calc(100% - 28px)); padding:0; border:1px solid var(--line); border-radius:8px; color:var(--ink); box-shadow:0 18px 60px #10233b40; }
		dialog::backdrop { background:#10233b80; }
		.dialog-content { padding:22px; }
		.dialog-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:14px; }
		.dialog-heading h2 { margin:0; font-size:1.15rem; }
		.dialog-close { border:0; background:none; color:var(--muted); font-size:1.5rem; cursor:pointer; }
		.enrollment-notice { padding:12px; border:1px solid #e8d59b; border-radius:4px; background:#fff9e8; line-height:1.5; }
		.device-picker { display:grid; gap:6px; margin:18px 0; font-weight:700; }
		.device-picker select { min-height:40px; padding:7px; border:1px solid #cbd4df; border-radius:4px; font:inherit; }
		.enrollment-values { display:grid; grid-template-columns:1fr auto; gap:8px 12px; align-items:center; padding-top:4px; }
		.enrollment-values dt { color:var(--muted); }
		.enrollment-values dd { margin:0; font-weight:800; overflow-wrap:anywhere; }
		.copy-button { min-height:30px; padding:0 9px; border:1px solid var(--line); border-radius:4px; background:#fff; color:var(--blue); cursor:pointer; }
		.dialog-status { min-height:1.4em; color:var(--muted); }
		@media(max-width:700px) { .page-shell { width:calc(100% - 20px); padding-top:18px; } .page-header,.panel-heading { align-items:flex-start; flex-direction:column; } .controls { width:100%; } input { flex:1; width:auto; } }
	</style>
</head>
<body>
	<%- include('employeesidenav', { currentPage, selectedEmployee }) %>
	<main class="page-shell">
		<header class="page-header"><div><p class="muted">People / Employee management</p><h1>Employee list</h1><p class="muted">Employee records are never sent automatically. Device user updates require an administrator action and exact-device firmware verification.</p></div><a class="button" href="/employeedetail?new=1"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add employee</a></header>
		<p class="notice">Global ADMS employee synchronization is disabled. Attendance uploads remain enabled. <% if (!userSyncProtocolVerified) { %>Manual USERINFO update commands are blocked until normal update support is verified for the exact device and firmware. <% } %><% if (!managerPrivilegeProtocolVerified) { %>Elevated privileges (Pri 2/6/14) are separately blocked until their behavior is verified for the exact device and firmware. <% } %>This system cannot remotely inspect a terminal’s User List; confirm the selected PIN belongs to this employee before sending.</p>
		<section class="panel"><div class="panel-heading"><h2><%= employees.length %> employees</h2><div class="controls"><input id="employeeSearch" type="search" placeholder="Search employees" aria-label="Search employees"><a class="button" href="/employeeattendance"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Attendance</a></div></div>
			<% if (employees.length) { %>
			<div class="table-wrap"><table id="employeeList"><thead><tr><th>S.N</th><th>Employee code</th><th>Device code / PIN</th><th>Name</th><th>Designation</th><th>Department</th><th>Branch</th><th>Contact</th><th>Office email</th><th>Status</th><th>Device sync status</th><th>Profile actions</th><th>Device actions</th><th>Fingerprint enrollment</th></tr></thead><tbody>
			<% employees.forEach((employee,index) => { const employeeId = String(employee._id); const sync = syncStatusByEmployee[employeeId]; const enrollment = manualEnrollmentByEmployee[employeeId]; const employeeStatuses = [employee.jobStatus, employee.employmentStatus].map(status => String(status || '').trim().toLowerCase()); const employeeInactive = employee.isActive === false || employeeStatuses.some(status => ['inactive', 'disabled', 'resigned', 'terminated'].includes(status)); %>
				<tr>
					<td><%= index+1 %></td><td class="employee-code"><%= employee.employeeCode || '-' %></td><td class="employee-code"><%= employee.deviceCode || 'Not set' %></td><td><%= employee.staffName %></td><td><%= employee.designation || '-' %></td><td><%= employee.department || '-' %></td><td><%= employee.branchName || '-' %></td><td><%= employee.mobileNumber || '-' %></td><td><%= employee.officeEmail || employee.email || '-' %></td><td class="<%= employeeInactive ? 'status-inactive' : 'status' %>"><%= employeeInactive ? 'Inactive' : employee.jobStatus || employee.employmentStatus || 'Active' %></td>
					<td><%= sync ? (sync.status === 'SUCCESS' ? 'ADMS returned success' : sync.status === 'PENDING' ? 'Pending device poll' : sync.status === 'SENT' ? 'Sent in ADMS response; acknowledgement pending' : sync.status === 'FAILED' ? 'Failed' : sync.status) : 'Not synced' %>
						<% if (sync?.status === 'SUCCESS') { %><br>Sender identity is unverified. If this is the terminal’s acknowledgement, enroll fingerprint with PIN <%= employee.deviceCode || '(not set)' %>.<% } %>
						<% if (sync?.status === 'SENT') { %><br>Physical receipt is not confirmed<%= sync.deliverySource === 'likely_simulated' ? ' (request appeared simulated)' : '' %>.<% } %>
						<% if (sync?.status === 'FAILED' && sync.lastError) { %><br><%= sync.lastError %><% } %>
						<% if (enrollment) { %><br>Fingerprint manually confirmed on <%= enrollment.serialNumber %><% } %>
					</td>
					<td><div class="action-group">
						<a class="action-button" href="/employeedetail?employeeId=<%= employee._id %>"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Edit</a>
						<% if (!employeeInactive) { %>
						<form method="post" action="/employeedata/<%= employeeId %>/deactivate" onsubmit="return confirm('Deactivate this employee? Their employee profile and attendance history will be preserved.');">
							<button class="action-button" type="submit"><i class="fa-solid fa-user-slash" aria-hidden="true"></i> Deactivate</button>
						</form>
						<% } else { %><span class="status-inactive">Inactive</span><% } %>
					</div></td>
					<td><div class="action-group">
						<button class="action-button sync-button" type="button" data-employee-id="<%= employeeId %>" data-employee-name="<%= employee.staffName %>" data-device-code="<%= employee.deviceCode || '' %>" <%= manualSyncTestEnabled && devices.length && manualSyncTestEligibleEmployeeIds.includes(employeeId) ? '' : 'disabled' %>>Sync to Device</button>
						<button class="action-button push-user-button" type="button" data-employee-id="<%= employeeId %>" data-employee-name="<%= employee.staffName || '' %>" data-device-code="<%= employee.deviceCode || employee.employeeCode || '' %>" data-is-manager="<%= employee.isManager === true ? 'true' : 'false' %>" <%= devices.length ? '' : 'disabled' %>><i class="fa-solid fa-fingerprint" aria-hidden="true"></i> Send to Device</button>
						<% if (sync?.status === 'FAILED' && sync.manualTest && sync.manualRequestVersion === 1 && manualSyncTestEnabled && userSyncProtocolVerified) { %><button class="action-button retry-button" type="button" data-command-id="<%= sync._id %>">Retry failed</button><% } %>
						<button class="action-button history-button" type="button" data-employee-id="<%= employeeId %>">Command history</button>
					</div></td>
					<td><button class="enrollment-button" type="button" <%= employee.deviceCode && devices.length ? '' : 'disabled' %> data-employee-id="<%= employeeId %>" data-device-code="<%= employee.deviceCode || '' %>" data-employee-name="<%= employee.staffName %>"><%= enrollment ? 'Record another enrollment' : 'Manual enrollment' %></button></td>
				</tr>
			<% }) %></tbody></table></div><% } else { %><div class="empty">No employee profiles have been added yet.</div><% } %>
		</section>
		<section class="panel" style="margin-top:18px"><div class="panel-heading"><h2>Attendance devices</h2><span class="muted"><%= devices.length %> registered</span></div>
			<% if (devices.length) { %><div class="device-grid"><% devices.forEach(device => { %><article class="device-card">
				<h3><%= device.name %></h3><p>Serial: <strong><%= device.serialNumber %></strong></p><p>Model / firmware: <%= device.model || 'Not verified' %> / <%= device.firmwareVersion || 'Not recorded' %></p><p>Communication: <strong><%= device.isOnline ? 'Online recently' : 'Offline / no recent contact' %></strong></p>
				<p>Command capabilities are per-device and default off. Verify the exact firmware and test device before enabling.</p>
				<form class="capability-form" method="post" action="/employeeattendance/device/<%= encodeURIComponent(device.serialNumber) %>/capabilities">
					<input type="hidden" name="csrfToken" value="<%= csrfToken %>">
					<label>Model <input type="text" name="model" value="<%= device.model || '' %>" maxlength="80"></label>
					<label>Firmware <input type="text" name="firmwareVersion" value="<%= device.firmwareVersion || '' %>" maxlength="80"></label>
					<label><input type="checkbox" name="supportsUserSyncCommands" value="true" <%= device.supportsUserSyncCommands ? 'checked' : '' %> <%= userSyncProtocolVerified ? '' : 'disabled' %>> Enable normal-user updates only after exact firmware verification</label>
					<label><input type="checkbox" name="confirmUserSyncProtocol" value="true"> I verified normal USERINFO update support on this exact device/firmware.</label>
					<label><input type="checkbox" name="supportsManagerPrivilege" value="true" <%= device.supportsManagerPrivilege ? 'checked' : '' %> <%= managerPrivilegeProtocolVerified && userSyncProtocolVerified ? '' : 'disabled' %>> Enable elevated USERINFO privileges (Pri 2/6/14) only after exact firmware verification</label>
					<label><input type="checkbox" name="confirmManagerPrivilegeProtocol" value="true"> I separately verified elevated privilege behavior on this exact device/firmware and accept the device-menu access described below.</label>
					<p class="muted">User deletion remains forced off. <% if (!userSyncProtocolVerified) { %>Set EMPLOYEE_ADMS_USERINFO_PROTOCOL_VERIFIED=true only after verifying normal USERINFO updates for the exact device and firmware; it is currently blocked. <% } %><% if (!managerPrivilegeProtocolVerified || !userSyncProtocolVerified) { %>Elevated privileges also require EMPLOYEE_ADMS_MANAGER_PRIVILEGE_PROTOCOL_VERIFIED=true and normal update verification; they are currently blocked.<% } %></p>
					<button class="button" type="submit">Save device settings</button>
				</form>
			</article><% }) %></div><% } else { %><div class="empty">No ZKTeco terminal has connected to this organization database yet.</div><% } %>
		</section>
	</main>
	<dialog id="syncDialog" aria-labelledby="syncTitle">
		<div class="dialog-content">
			<div class="dialog-heading"><div><h2 id="syncTitle">Sync employee to device</h2><p id="syncEmployeeSummary" class="muted"></p></div><button class="dialog-close" type="button" aria-label="Close dialog">&times;</button></div>
			<p class="enrollment-notice">Check the selected terminal’s User List first. Continue only if this PIN is unassigned or already belongs to this employee; an update command may replace the name for that PIN. This workflow does not delete users or enroll fingerprints.</p>
			<label class="device-picker" for="syncDevice">Target attendance device
				<select id="syncDevice">
				<% devices.forEach(device => { const syncAllowed = userSyncProtocolVerified && device.supportsUserSyncCommands; %><option value="<%= device.serialNumber %>" <%= syncAllowed ? '' : 'disabled' %>><%= device.name %> — <%= device.serialNumber %><%= syncAllowed ? '' : ' (sync support not verified)' %></option><% }) %>
				</select>
			</label>
			<% if (!userSyncProtocolVerified || !devices.some(device => device.supportsUserSyncCommands)) { %><p class="status-inactive">No device is currently enabled for USERINFO update commands. Sync is blocked until the exact device and firmware are verified.</p><% } %>
			<label><input id="confirmPinOwnership" type="checkbox"> I checked this device: the PIN is unassigned or belongs to this employee.</label>
			<p><button id="confirmEmployeeSync" class="button" type="button" disabled>Confirm Sync</button></p>
			<p id="syncStatus" class="dialog-status" role="status" aria-live="polite"></p>
		</div>
	</dialog>
	<dialog id="pushUserDialog" aria-labelledby="pushUserTitle">
		<div class="dialog-content">
			<div class="dialog-heading"><div><h2 id="pushUserTitle">Send employee to device</h2><p class="muted">This queues a user update; fingerprint enrollment must still be completed on the terminal.</p></div><button class="dialog-close" type="button" aria-label="Close dialog">&times;</button></div>
			<p class="enrollment-notice">This updates the device user record for the selected PIN and may replace the name or privilege already assigned to that PIN. Only continue if the PIN belongs to this employee. Elevated privileges expose device menus after that person is enrolled.</p>
			<dl class="enrollment-values">
				<dt>Employee name</dt><dd id="pushUserName"></dd>
				<dt>Device PIN</dt><dd id="pushUserPin"></dd>
				<dt>Manager status</dt><dd id="pushUserManager"></dd>
			</dl>
			<label class="device-picker" for="pushUserDevice">Target ZKTeco device
				<select id="pushUserDevice">
					<option value="">Select a device</option>
					<% devices.forEach(device => { const userSyncAllowed = userSyncProtocolVerified && device.supportsUserSyncCommands === true; const managerPrivilegeAllowed = managerPrivilegeProtocolVerified && device.supportsManagerPrivilege === true; %><option value="<%= device.serialNumber %>" data-user-sync-enabled="<%= userSyncAllowed ? 'true' : 'false' %>" data-manager-privilege-enabled="<%= managerPrivilegeAllowed ? 'true' : 'false' %>"><%= device.name %> — <%= device.serialNumber %><%= userSyncAllowed ? '' : ' (USERINFO update not verified)' %></option><% }) %>
				</select>
			</label>
			<label class="device-picker" for="pushUserPrivilege">Device privilege (Pri)
				<select id="pushUserPrivilege">
					<option value="0">0 — Normal User: attendance punch only; no device menu</option>
					<option value="2">2 — Enroller: menu access to add users and enroll fingerprints/cards</option>
					<option value="6">6 — Manager: manage users and basic settings; cannot wipe all logs</option>
					<option value="14">14 — Super Admin: full access to menus, logs, network settings, and resets</option>
				</select>
			</label>
			<p class="notice">Note: Assigning Enroller (2), Manager (6), or Super Admin (14) locks the device menu behind that person's fingerprint once enrolled.</p>
			<p id="pushUserEligibility" class="dialog-status" role="status" aria-live="polite"></p>
			<label><input id="confirmPushUser" type="checkbox"> I confirm this PIN belongs to this employee and understand the selected privilege and device-menu access.</label>
			<p><button id="submitPushUser" class="button" type="button" disabled>Confirm and Send to Device</button></p>
			<p id="pushUserStatus" class="dialog-status" role="status" aria-live="polite"></p>
		</div>
	</dialog>
	<dialog id="enrollmentDialog" aria-labelledby="enrollmentTitle">
		<div class="dialog-content">
			<div class="dialog-heading"><div><h2 id="enrollmentTitle">Manual device enrollment</h2><p class="muted">Use these details to add the employee on the terminal.</p></div><button class="dialog-close" type="button" aria-label="Close dialog">&times;</button></div>
			<p class="enrollment-notice">Remote fingerprint enrollment is not verified for this model and firmware. Add the employee with this Device Code / PIN and enroll their fingerprint directly on the terminal. Only record confirmation after completing that step on the machine.</p>
			<label class="device-picker" for="enrollmentDevice">Terminal
				<select id="enrollmentDevice" <%= devices.length ? '' : 'disabled' %>>
					<% devices.forEach(device => { %><option value="<%= device.serialNumber %>"><%= device.name %> — <%= device.serialNumber %></option><% }) %>
				</select>
			</label>
			<% if (!devices.length) { %><p class="muted">No ZKTeco terminal has connected to this server yet.</p><% } %>
			<dl class="enrollment-values">
				<dt>Device Code / PIN</dt><dd id="enrollmentCode"></dd><dt></dt><dd><button class="copy-button" type="button" data-copy="code">Copy PIN</button></dd>
				<dt>Employee name</dt><dd id="enrollmentName"></dd><dt></dt><dd><button class="copy-button" type="button" data-copy="name">Copy name</button></dd>
			</dl>
			<label><input id="confirmManualEnrollment" type="checkbox"> I enrolled this employee on the selected terminal using this PIN.</label>
			<p><button id="saveManualEnrollment" class="button" type="button" disabled>Record manual confirmation</button></p>
			<p id="enrollmentStatus" class="dialog-status" role="status" aria-live="polite"></p>
		</div>
	</dialog>
	<dialog id="historyDialog" aria-labelledby="historyTitle"><div class="dialog-content"><div class="dialog-heading"><div><h2 id="historyTitle">Device command history</h2></div><button class="dialog-close" type="button" aria-label="Close dialog">&times;</button></div><pre id="historyContent" class="history-content">Loading…</pre><div id="historyActions" class="action-group"></div><p id="historyStatus" class="dialog-status" role="status" aria-live="polite"></p></div></dialog>
	<script>
		const employeeSearch = document.getElementById('employeeSearch');
		employeeSearch.addEventListener('input', event => {
			const query = event.target.value.trim().toLowerCase();
			document.querySelectorAll('#employeeList tbody tr').forEach(row => {
				row.hidden = !row.textContent.toLowerCase().includes(query);
			});
		});

		const pushUserDialog = document.getElementById('pushUserDialog');
		const pushUserDevice = document.getElementById('pushUserDevice');
		const pushUserPrivilege = document.getElementById('pushUserPrivilege');
		const confirmPushUser = document.getElementById('confirmPushUser');
		const submitPushUser = document.getElementById('submitPushUser');
		const pushUserEligibility = document.getElementById('pushUserEligibility');
		const pushUserStatus = document.getElementById('pushUserStatus');
		const pushUserCsrfToken = '<%= csrfToken %>';
		let selectedPushUserEmployeeId = '';
		const updatePushUserState = () => {
			const elevatedPrivilege = Number(pushUserPrivilege.value) > 0;
			[...pushUserDevice.options].forEach(option => {
				if (!option.value) {
					option.disabled = false;
					return;
				}
				const userSyncEnabled = option.dataset.userSyncEnabled === 'true';
				const managerPrivilegeEnabled = option.dataset.managerPrivilegeEnabled === 'true';
				option.disabled = !userSyncEnabled || (elevatedPrivilege && !managerPrivilegeEnabled);
			});
			const availableDevices = [...pushUserDevice.options].filter(option => option.value && !option.disabled);
			const selectedOption = pushUserDevice.selectedOptions[0];
			if (!availableDevices.length) {
				pushUserEligibility.textContent = elevatedPrivilege
					? 'No device is verified for this privilege. Select Pri 0 or complete the exact-device manager-privilege verification first.'
					: 'No device is enabled for USERINFO updates. Verify and enable a registered device before sending.';
			} else if (!selectedOption?.value) {
				pushUserEligibility.textContent = 'Select a verified target device.';
			} else if (selectedOption.disabled) {
				pushUserEligibility.textContent = elevatedPrivilege
					? 'This device is not verified for elevated privileges. Select another verified device or choose Pri 0.'
					: 'This device is not enabled for USERINFO updates.';
			} else {
				pushUserEligibility.textContent = '';
			}
			submitPushUser.disabled = !selectedPushUserEmployeeId
				|| !confirmPushUser.checked
				|| !selectedOption?.value
				|| selectedOption.disabled;
		};
		document.querySelectorAll('.push-user-button').forEach(button => {
			button.addEventListener('click', () => {
				selectedPushUserEmployeeId = button.dataset.employeeId || '';
				document.getElementById('pushUserName').textContent = button.dataset.employeeName || '(no employee name)';
				document.getElementById('pushUserPin').textContent = button.dataset.deviceCode || '(no Device PIN configured)';
				const managerStatus = document.getElementById('pushUserManager');
				const isManager = button.dataset.isManager === 'true';
				managerStatus.textContent = isManager ? 'Manager' : 'Not a manager';
				managerStatus.classList.toggle('manager-badge', isManager);
				pushUserPrivilege.value = isManager ? '14' : '0';
				pushUserDevice.value = pushUserDevice.options.length === 2 ? pushUserDevice.options[1].value : '';
				confirmPushUser.checked = false;
				pushUserStatus.textContent = '';
				updatePushUserState();
				pushUserDialog.showModal();
			});
		});
		pushUserPrivilege.addEventListener('change', () => {
			confirmPushUser.checked = false;
			updatePushUserState();
		});
		pushUserDevice.addEventListener('change', () => {
			confirmPushUser.checked = false;
			updatePushUserState();
		});
		confirmPushUser.addEventListener('change', updatePushUserState);
		submitPushUser.addEventListener('click', async () => {
			if (submitPushUser.disabled) return;
			submitPushUser.disabled = true;
			pushUserStatus.textContent = 'Queueing the user update for the selected device…';
			try {
				const response = await fetch(`/api/devices/${encodeURIComponent(pushUserDevice.value)}/push-user`, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'X-CSRF-Token': pushUserCsrfToken
					},
					body: JSON.stringify({
						staffId: selectedPushUserEmployeeId,
						privilege: Number(pushUserPrivilege.value)
					})
				});
				let result;
				try {
					result = await response.json();
				} catch (error) {
					result = { message: 'The server returned an invalid response.' };
				}
				if (!response.ok) throw new Error(result.message || 'Unable to queue the device user update.');
				pushUserStatus.textContent = `Command queued for the device’s next ADMS poll (Pri ${result.appliedPrivilege}). After delivery, wait ~10 seconds, then open User Mgt -> All Users on the device to enroll the fingerprint.`;
			} catch (error) {
				pushUserStatus.textContent = error.message;
				updatePushUserState();
			}
		});
		pushUserDialog.querySelector('.dialog-close').addEventListener('click', () => pushUserDialog.close());
		pushUserDialog.addEventListener('click', event => {
			if (event.target === pushUserDialog) pushUserDialog.close();
		});

		const enrollmentDialog = document.getElementById('enrollmentDialog');
		const enrollmentStatus = document.getElementById('enrollmentStatus');
		const enrollmentConfirmation = document.getElementById('confirmManualEnrollment');
		const saveEnrollmentButton = document.getElementById('saveManualEnrollment');
		let selectedEnrollmentEmployeeId = '';
		document.querySelectorAll('.enrollment-button').forEach(button => {
			button.addEventListener('click', () => {
				selectedEnrollmentEmployeeId = button.dataset.employeeId || '';
				document.getElementById('enrollmentCode').textContent = button.dataset.deviceCode || '(no device code configured)';
				document.getElementById('enrollmentName').textContent = button.dataset.employeeName || '(no employee name)';
				enrollmentStatus.textContent = '';
				enrollmentConfirmation.checked = false;
				saveEnrollmentButton.disabled = true;
				enrollmentDialog.showModal();
			});
		});
		enrollmentConfirmation.addEventListener('change', () => {
			saveEnrollmentButton.disabled = !enrollmentConfirmation.checked;
		});
		saveEnrollmentButton.addEventListener('click', async () => {
			if (!selectedEnrollmentEmployeeId || !enrollmentConfirmation.checked) return;
			saveEnrollmentButton.disabled = true;
			enrollmentStatus.textContent = 'Saving manual confirmation…';
			try {
				const response = await fetch(`/employeeattendance/staff/${encodeURIComponent(selectedEnrollmentEmployeeId)}/manual-fingerprint-enrollment`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						serialNumber: document.getElementById('enrollmentDevice').value,
						confirmed: true
					})
				});
				const result = await response.json();
				if (!response.ok) throw new Error(result.message || 'Unable to save enrollment confirmation.');
				enrollmentStatus.textContent = result.message;
				setTimeout(() => window.location.reload(), 900);
			} catch (error) {
				enrollmentStatus.textContent = error.message;
				saveEnrollmentButton.disabled = !enrollmentConfirmation.checked;
			}
		});
		enrollmentDialog.querySelector('.dialog-close').addEventListener('click', () => enrollmentDialog.close());
		enrollmentDialog.addEventListener('click', event => {
			if (event.target === enrollmentDialog) enrollmentDialog.close();
		});
		enrollmentDialog.querySelectorAll('[data-copy]').forEach(button => {
			button.addEventListener('click', async () => {
				const valueId = button.dataset.copy === 'code' ? 'enrollmentCode' : 'enrollmentName';
				const value = document.getElementById(valueId).textContent;
				try {
					await navigator.clipboard.writeText(value);
					enrollmentStatus.textContent = `${button.dataset.copy === 'code' ? 'Employee code' : 'Employee name'} copied.`;
				} catch (error) {
					enrollmentStatus.textContent = 'Copy is unavailable in this browser context; select the displayed value and copy it manually.';
				}
			});
		});
		const syncDialog = document.getElementById('syncDialog');
		const syncDevice = document.getElementById('syncDevice');
		const confirmPinOwnership = document.getElementById('confirmPinOwnership');
		const confirmEmployeeSync = document.getElementById('confirmEmployeeSync');
		const syncStatus = document.getElementById('syncStatus');
		let selectedSyncEmployeeId = '';
		const updateSyncButtonState = () => {
			const selectedOption = syncDevice.selectedOptions[0];
			confirmEmployeeSync.disabled = !selectedSyncEmployeeId
				|| !confirmPinOwnership.checked
				|| !selectedOption
				|| selectedOption.disabled;
		};
		document.querySelectorAll('.sync-button').forEach(button => {
			button.addEventListener('click', () => {
				selectedSyncEmployeeId = button.dataset.employeeId || '';
				document.getElementById('syncEmployeeSummary').textContent =
					`${button.dataset.employeeName || 'Employee'} — PIN ${button.dataset.deviceCode || '(not set)'}`;
				syncStatus.textContent = '';
				confirmPinOwnership.checked = false;
				const firstVerifiedDevice = [...syncDevice.options].find(option => !option.disabled);
				if (firstVerifiedDevice) syncDevice.value = firstVerifiedDevice.value;
				updateSyncButtonState();
				syncDialog.showModal();
			});
		});
		confirmPinOwnership.addEventListener('change', updateSyncButtonState);
		syncDevice.addEventListener('change', updateSyncButtonState);
		confirmEmployeeSync.addEventListener('click', async () => {
			if (confirmEmployeeSync.disabled || !selectedSyncEmployeeId) return;
			confirmEmployeeSync.disabled = true;
			syncStatus.textContent = 'Submitting one employee to the selected device…';
			try {
				const response = await fetch(`/employeeattendance/staff/${encodeURIComponent(selectedSyncEmployeeId)}/sync`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						serialNumber: syncDevice.value,
						confirmPinOwnership: true
					})
				});
				let result;
				try {
					result = await response.json();
				} catch (error) {
					result = { message: 'The server returned an invalid response.' };
				}
				if (!response.ok) {
					const prefix = result.code === 'PROTOCOL_VERIFICATION_REQUIRED'
						? 'Protocol verification blocked'
						: 'Sync request failed';
					syncStatus.textContent = `${prefix}: ${result.message || 'Unable to queue employee synchronization.'}`;
					updateSyncButtonState();
					return;
				}
				const outcomeLabels = {
					queued: 'New command queued',
					existing_pending: 'Existing PENDING command',
					existing_sent: 'Existing SENT command'
				};
				syncStatus.textContent = `${outcomeLabels[result.outcome] || 'Sync request completed'}: ${result.message} Command ID: ${result.commandId}; status: ${result.status}.`;
				setTimeout(() => window.location.reload(), 1600);
			} catch (error) {
				syncStatus.textContent = `Sync request failed: ${error.message}`;
				updateSyncButtonState();
			}
		});
		syncDialog.querySelector('.dialog-close').addEventListener('click', () => syncDialog.close());
		syncDialog.addEventListener('click', event => {
			if (event.target === syncDialog) syncDialog.close();
		});
		document.querySelectorAll('.retry-button').forEach(button => {
			button.addEventListener('click', async () => {
				if (!window.confirm('Confirm that the device PIN still belongs to this employee and that its command can be retried?')) return;
				button.disabled = true;
				try {
					const response = await fetch(`/employeeattendance/device-command/${encodeURIComponent(button.dataset.commandId)}/retry`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ confirmPinOwnership: true })
					});
					const result = await response.json();
					if (!response.ok) throw new Error(result.message || 'Unable to retry the command.');
					window.location.reload();
				} catch (error) {
					window.alert(error.message);
					button.disabled = false;
				}
			});
		});

		const historyDialog = document.getElementById('historyDialog');
		document.querySelectorAll('.history-button').forEach(button => {
			button.addEventListener('click', async () => {
				const historyContent = document.getElementById('historyContent');
				const historyActions = document.getElementById('historyActions');
				const historyStatus = document.getElementById('historyStatus');
				historyContent.textContent = 'Loading…';
				historyActions.replaceChildren();
				historyStatus.textContent = '';
				historyDialog.showModal();
				try {
					const response = await fetch(`/employeeattendance/staff/${encodeURIComponent(button.dataset.employeeId)}/commands`);
					const result = await response.json();
					if (!response.ok) throw new Error(result.message || 'Unable to load command history.');
					const commandRows = result.commands.map(command =>
						`${command.createdAt} | ${command.serialNumber} | ID ${command.commandId} | ${command.commandType} | ${command.status} | attempts ${command.attempts}${command.deliverySource ? ` | delivery request source ${command.deliverySource}` : ''}${command.acknowledgementSource ? ` | acknowledgement source ${command.acknowledgementSource}` : ''}${command.lastError ? ` | ${command.lastError}` : ''}`
					);
					const enrollmentRows = result.manualEnrollments.map(enrollment =>
						`${enrollment.confirmedAt} | ${enrollment.serialNumber} | Manually confirmed by ${enrollment.confirmedBy}`
					);
					historyContent.textContent = [
						'Device commands:',
						...(commandRows.length ? commandRows : ['No commands recorded.']),
						'',
						'Fingerprint enrollment:',
						...(enrollmentRows.length ? enrollmentRows : ['No manual enrollment confirmation recorded.']),
						'Remote fingerprint enrollment: unverified'
					].join('\n');
					result.commands.filter(command => ['PENDING', 'SENT'].includes(command.status)).forEach(command => {
						const cancelButton = document.createElement('button');
						cancelButton.type = 'button';
						cancelButton.className = 'action-button';
						cancelButton.textContent = `Cancel ${command.status} command ${command.commandId} (${command.serialNumber})`;
						cancelButton.addEventListener('click', async () => {
							if (!window.confirm('Cancel this command at the server? If the terminal already received it, it cannot be recalled.')) return;
							cancelButton.disabled = true;
							try {
								const cancelResponse = await fetch(`/employeeattendance/device/${encodeURIComponent(command.serialNumber)}/command/${encodeURIComponent(command.commandId)}/cancel`, {
									method: 'POST'
								});
								const cancelResult = await cancelResponse.json();
								if (!cancelResponse.ok) throw new Error(cancelResult.message || 'Unable to cancel command.');
								historyStatus.textContent = cancelResult.message;
								cancelButton.remove();
								window.setTimeout(() => window.location.reload(), 1200);
							} catch (error) {
								historyStatus.textContent = error.message;
								cancelButton.disabled = false;
							}
						});
						historyActions.append(cancelButton);
					});
				} catch (error) {
					historyContent.textContent = error.message;
				}
			});
		});
		historyDialog.querySelector('.dialog-close').addEventListener('click', () => historyDialog.close());
	</script>
</body>
</html>
