					</nav>
					<section class="tab-panel" id="profileGeneralPanel" role="tabpanel">
						<div class="section-heading"><h3>Personal information</h3><% if (selectedEmployee) { %><button class="button button-secondary" type="button" data-open-basic-dialog><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Edit</button><% } else { %><button class="button button-primary" type="button" data-open-basic-dialog><i class="fa-solid fa-plus" aria-hidden="true"></i> Add profile</button><% } %></div>
						<div class="field-grid read-only-grid">
							<div><label>Employee name</label><strong><%= formData.staffName || '-' %></strong></div><div><label>Employee code</label><strong><%= formData.employeeCode || '-' %></strong></div><div><label>Designation</label><strong><%= formData.designation || '-' %></strong></div>
							<div><label>Office email</label><strong><%= formData.officeEmail || formData.email || '-' %></strong></div><div><label>Office contact</label><strong><%= formData.officeContact || formData.mobileNumber || '-' %></strong></div><div><label>Join date</label><strong><%= formData.dateOfJoiningBs || '-' %></strong></div>
							<div><label>Branch</label><strong><%= formData.branchName || '-' %></strong></div><div><label>Department</label><strong><%= formData.department || '-' %></strong></div><div><label>Job status</label><strong><%= formData.jobStatus || formData.employmentStatus || '-' %></strong></div>
							<div><label>Mobile</label><strong><%= formData.mobileNumber || '-' %></strong></div><div><label>Personal email</label><strong><%= formData.email || '-' %></strong></div><div><label>Blood group</label><strong><%= formData.health?.bloodGroup || formData.bloodGroup || '-' %></strong></div>
							<div class="field-wide"><label>Address</label><strong><%= formData.permanentAddress || formData.address || '-' %></strong></div>
