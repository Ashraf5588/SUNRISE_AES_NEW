			<form class="profile-form" action="<%= selectedEmployee ? `/employeedetail/${selectedEmployee._id}` : '/employeedetail' %>" method="post" enctype="multipart/form-data" id="employeeProfileForm" data-employee-id="<%= selectedEmployee?._id || '' %>" novalidate>
