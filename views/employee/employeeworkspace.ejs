x %>_<%= index %>_<%= field.name %>" aria-label="<%= field.label %>"><% field.options.forEach(option=> { %><option value="<%= option==='Yes'?'true':option==='No'?'false':option %>" <%= String(row[field.name]??'')===(option==='Yes'?'true':option==='No'?'false':option)?'selected':'' %>><%= option %></option><% }) %></select><% } else { %><input type="<%= field.type==='date'?'text':field.type||'text' %>" class="<%= field.type==='date'?'nepali-date-input':'' %>" name="<%= config.prefix %>_<%= index %>_<%= field.name %>" value="<%= row[field.name]??'' %>" aria-label="<%= field.label %>" <%= field.type==='number'?'step="any" min="0"':'' %>><% } %></td><% }) %><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr><% }) %></tbody></table></div></section><% }) %><section class="tab-panel" id="taxConfigPanel" role="tabpanel" hidden><div class="section-heading"><h3>Tax Configuration</h3></div><div class="field-grid"><div class="field"><label for="taxPanNumber">PAN Number</label><input id="taxPanNumber" name="taxPanNumber" value="<%= formData.taxConfiguration?.panNumber||formData.panNumber||'' %>"></div><div class="field"><label for="taxSsfNumber">SSF Number</label><input id="taxSsfNumber" name="taxSsfNumber" value="<%= formData.taxConfiguration?.ssfNumber||formData.ssfNumber||'' %>"></div><div class="field"><label for="taxSsfEffectiveDate">SSF Effective Date (BS)</label><input id="taxSsfEffectiveDate" class="nepali-date-input" name="taxSsfEffectiveDate" value="<%= formData.taxConfiguration?.ssfEffectiveDate||'' %>"></div></div><div class="section-heading" style="margin-top:22px"><h3>Contribution configuration</h3><button class="add-row" type="button" data-add-row="taxContribution">+ Add contribution</button></div><div class="repeat-table-wrap"><table class="repeat-table"><thead><tr><th>S.N</th><th>Title</th><th>Number</th><th>Enabled</th><th>Rate (Employee)</th><th>Rate (Employer)</th><th>Action</th></tr></thead><tbody id="taxContributionRows" data-row-prefix="taxContribution"><% const contributions=formData.taxConfiguration?.contributions?.length?formData.taxConfiguration.contributions:[{title:'PF'},{title:'CIT'}];contributions.forEach((row,index)=> { %><tr data-repeat-row><td class="row-number"><%= index+1 %></td><td><input name="taxContribution_<%= index %>_title" value="<%= row.title||'' %>"></td><td><input name="taxContribution_<%= index %>_number" value="<%= row.number||'' %>"></td><td><select name="taxContribution_<%= index %>_enabled"><option value="false">No</option><option value="true" <%= row.enabled?'selected':'' %>>Yes</option></select></td><td><input type="number" min="0" step="any" name="taxContribution_<%= index %>_employeeRate" value="<%= row.employeeRate??'' %>"></td><td><input type="number" min="0" step="any" name="taxContribution_<%= index %>_employerRate" value="<%= row.employerRate??'' %>"></td><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr><% }) %></tbody></table></div></section></section><% const advanceConfig=tableConfigs.find(config=>config.prefix==='advance'); %><section class="tab-panel" id="advanceRecordsPanel" role="tabpanel" hidden><div class="section-heading"><h3>Advance</h3><button class="add-row" type="button" data-add-row="advance">+ Add Advance</button></div><div class="repeat-table-wrap"><table class="repeat-table"><thead><tr><th>S.N</th><% advanceConfig.fields.forEach(field=> { %><th><%= field.label %></th><% }) %><th>Action</th></tr></thead><tbody id="advanceRows" data-row-prefix="advance"><% currentRows(advanceConfig).forEach((row,index)=> { %><tr data-repeat-row><td class="row-number"><%= index+1 %></td><% advanceConfig.fields.forEach(field=> { %><td><% if(field.type==='select'){ %><select name="advance_<%= index %>_<%= field.name %>"><% field.options.forEach(option=> { %><option value="<%= option==='Yes'?'true':option==='No'?'false':option %>" <%= String(row[field.name]??'')===(option==='Yes'?'true':option==='No'?'false':option)?'selected':'' %>><%= option %></option><% }) %></select><% } else { %><input type="<%= field.type==='date'?'text':field.type||'text' %>" class="<%= field.type==='date'?'nepali-date-input':'' %>" name="advance_<%= index %>_<%= field.name %>" value="<%= row[field.name]??'' %>"><% } %></td><% }) %><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr><% }) %></tbody></table></div></section></div>
				<div class="module-panel" data-module="office" hidden><nav class="tab-list" role="tablist" aria-label="Office activities" data-tab-group="office"><% groupedTabs.office.forEach((title,index)=> {const config=tableConfigs.find(item=>item.group==='office'&&item.title===title); %><button class="tab-button" type="button" role="tab" aria-selected="<%= index===0 %>" data-tab-target="<%= configPanelId(config) %>"><%= title %></button><% }) %></nav><% tableConfigs.filter(config=>config.group==='office').forEach((config,index)=> { %><section class="tab-panel" id="<%= configPanelId(config) %>" role="tabpanel" <%= index===0?'':'hidden' %>><div class="section-heading"><h3><%= config.title %></h3><button class="add-row" type="button" data-add-row="<%= config.prefix %>">+ <%= config.action %></button></div><div class="repeat-table-wrap"><table class="repeat-table"><thead><tr><th>S.N</th><% config.fields.forEach(field=> { %><th><%= field.label %></th><% }) %><th>Action</th></tr></thead><tbody id="<%= config.prefix %>Rows" data-row-prefix="<%= config.prefix %>"><% currentRows(config).forEach((row,index)=> { %><tr data-repeat-row><td class="row-number"><%= index+1 %></td><% config.fields.forEach(field=> { %><td><% if(field.type==='select'){ %><select name="<%= config.prefix %>_<%= index %>_<%= field.name %>" aria-label="<%= field.label %>"><% field.options.forEach(option=> { %><option value="<%= option==='Yes'?'true':option==='No'?'false':option %>" <%= String(row[field.name]??'')===(option==='Yes'?'true':option==='No'?'false':option)?'selected':'' %>><%= option %></option><% }) %></select><% } else { %><input type="<%= field.type==='date'?'text':field.type||'text' %>" class="<%= field.type==='date'?'nepali-date-input':'' %>" name="<%= config.prefix %>_<%= index %>_<%= field.name %>" value="<%= row[field.name]??'' %>" aria-label="<%= field.label %>"><% } %></td><% }) %><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr><% }) %></tbody></table></div></section><% }) %><section class="tab-panel" role="tabpanel"><div class="section-heading"><h3>Experience Letter</h3><a class="button button-secondary" href="/teacher-record">Template setup / issue letter</a></div><p class="muted-copy">Select Experience Letter in Letter Issued to record an issued letter.</p></section></div>
				<div class="module-panel" data-module="loan" hidden><section class="tab-panel"><div class="section-heading"><h3>Loan</h3><button class="add-row" type="button" data-add-row="loan">+ Add Loan</button></div><div class="repeat-table-wrap"><table class="repeat-table"><thead><tr><th>S.N</th><% const loanConfig=tableConfigs.find(config=>config.prefix==='loan');loanConfig.fields.forEach(field=> { %><th><%= field.label %></th><% }) %><th>Action</th></tr></thead><tbody id="loanRows" data-row-prefix="loan"><% currentRows(loanConfig).forEach((row,index)=> { %><tr data-repeat-row><td class="row-number"><%= index+1 %></td><% loanConfig.fields.forEach(field=> { %><td><% if(field.type==='select'){ %><select name="loan_<%= index %>_<%= field.name %>"><% field.options.forEach(option=> { %><option value="<%= option==='Yes'?'true':option==='No'?'false':option %>" <%= String(row[field.name]??'')===(option==='Yes'?'true':option==='No'?'false':option)?'selected':'' %>><%= option %></option><% }) %></select><% } else { %><input type="<%= field.type==='date'?'text':field.type||'text' %>" class="<%= field.type==='date'?'nepali-date-input':'' %>" name="loan_<%= index %>_<%= field.name %>" value="<%= row[field.name]??'' %>"><% } %></td><% }) %><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr><% }) %></tbody></table></div></section></div>
				<div class="module-panel" data-module="assets" hidden><nav class="tab-list" role="tablist" aria-label="Assets and facilities" data-tab-group="assets"><% groupedTabs.assets.forEach((title,index)=> {const config=tableConfigs.find(item=>item.group==='assets'&&item.title===title); %><button class="tab-button" type="button" role="tab" aria-selected="<%= index===0 %>" data-tab-target="<%= configPanelId(config) %>"><%= title %></button><% }) %></nav><% tableConfigs.filter(config=>config.group==='assets').forEach((config,index)=> { %><section class="tab-panel" id="<%= configPanelId(config) %>" role="tabpanel" <%= index===0?'':'hidden' %>><div class="section-heading"><h3><%= config.title %></h3><button class="add-row" type="button" data-add-row="<%= config.prefix %>">+ <%= config.action %></button></div><div class="repeat-table-wrap"><table class="repeat-table"><thead><tr><th>S.N</th><% config.fields.forEach(field=> { %><th><%= field.label %></th><% }) %><th>Action</th></tr></thead><tbody id="<%= config.prefix %>Rows" data-row-prefix="<%= config.prefix %>"><% currentRows(config).forEach((row,index)=> { %><tr data-repeat-row><td class="row-number"><%= index+1 %></td><% config.fields.forEach(field=> { %><td><input type="<%= field.type==='date'?'text':field.type||'text' %>" class="<%= field.type==='date'?'nepali-date-input':'' %>" name="<%= config.prefix %>_<%= index %>_<%= field.name %>" value="<%= row[field.name]??'' %>" aria-label="<%= field.label %>"></td><% }) %><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr><% }) %></tbody></table></div></section><% }) %></div>
				<div class="module-panel" data-module="reporting" hidden><section class="management-block"><h3>Management Hierarchy</h3><div class="management-target"><strong><%= selectedEmployee?.staffName || 'Target employee' %></strong><span>Active node / <%= selectedEmployee?.designation || 'Employee' %></span></div><div class="field" style="max-width:420px;margin-top:16px"><label for="reportsTo">Reports to</label><select id="reportsTo" name="reportsTo"><option value="">No manager assigned</option><% employees.filter(employee=>String(employee._id)!==String(selectedEmployee?._id)).forEach(employee=> { %><option value="<%= employee._id %>" <%= String(formData.reportsTo||'')===String(employee._id)?'selected':'' %>><%= employee.staffName %> / <%= employee.designation||employee.employeeCode %></option><% }) %></select></div></section><section class="management-block"><h3>Direct Subordinates (<%= employees.filter(employee=>String(employee.reportsTo||'')===String(selectedEmployee?._id||'')).length %>)</h3><div class="repeat-table-wrap"><table><thead><tr><th>Employee</th><th>Designation</th><th>Department</th></tr></thead><tbody><% const reports=employees.filter(employee=>String(employee.reportsTo||'')===String(selectedEmployee?._id||''));reports.forEach(employee=> { %><tr><td><%= employee.staffName %></td><td><%= employee.designation||'-' %></td><td><%= employee.department||'-' %></td></tr><% }) %></tbody></table></div></section></div>
				<dialog class="edit-dialog" id="basicInfoDialog" aria-labelledby="basicInfoDialogTitle">
					<div class="dialog-heading"><h2 id="basicInfoDialogTitle"><i class="fa-regular fa-id-card" aria-hidden="true"></i> Employee Office Record</h2><button class="icon-button" type="button" data-close-basic-dialog aria-label="Close edit dialog"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
					<div class="dialog-content">
						<nav class="tab-list office-tabs" role="tablist" aria-label="Employee office record" data-tab-group="officeRecord">
							<button class="tab-button" type="button" role="tab" aria-selected="true" data-tab-target="officeRecordPanel">Office Record</button>
							<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="basicInformationPanel">Basic Information</button>
							<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="punchManagementPanel">Time Punch Management</button>
							<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="shiftManagementPanel">Shift / WO / Management</button>
							<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="taxContributionsPanel">Tax &amp; Contributions</button>
						</nav>
						<section class="office-panel" id="officeRecordPanel" role="tabpanel">
							<div class="field-grid">
								<div class="field"><label for="companyName">Company name</label><input id="companyName" name="companyName" value="<%= formData.companyName || 'United English Boarding School' %>"></div>
								<div class="field"><label for="branchName">Select branch</label><select id="branchName" name="branchName"><option value="">Select branch</option><% if (formData.branchName && !branches.some(branch => branch.name === formData.branchName)) { %><option value="<%= formData.branchName %>" selected><%= formData.branchName %> (existing)</option><% } %><% branches.forEach(branch => { %><option value="<%= branch.name %>" <%= formData.branchName === branch.name ? 'selected' : '' %>><%= branch.name %></option><% }) %></select></div>
								<div class="field"><label for="employeeCode">Employee code <span>*</span></label><input id="employeeCode" name="employeeCode" value="<%= formData.employeeCode || '' %>" aria-describedby="employeeCodeAvailability" required><span class="identifier-feedback" id="employeeCodeAvailability" role="status"></span></div>
								<div class="field"><label for="deviceCode">Employee device code <span>*</span></label><input id="deviceCode" name="deviceCode" value="<%= formData.deviceCode || formData.employeeCode || '' %>" aria-describedby="deviceCodeAvailability" required><span class="identifier-feedback" id="deviceCodeAvailability" role="status"></span></div>
								<div class="field"><label for="staffName">Name <span>*</span></label><input id="staffName" name="staffName" value="<%= formData.staffName || '' %>" required></div>
								<div class="field"><label for="officeEmail">Office email</label><input id="officeEmail" name="officeEmail" type="email" value="<%= formData.officeEmail || '' %>"></div>
								<div class="field"><label for="officeContact">Office contact</label><input id="officeContact" name="officeContact" value="<%= formData.officeContact || '' %>"></div>
								<div class="field"><label for="nameNepali">Name (Nepali)</label><input id="nameNepali" name="nameNepali" value="<%= formData.nameNepali || '' %>"></div>
								<div class="field"><label for="dateOfJoiningBs">Joining date (BS) <span>*</span></label><input id="dateOfJoiningBs" class="nepali-date-input" name="dateOfJoiningBs" value="<%= formData.dateOfJoiningBs || '' %>" placeholder="YYYY-MM-DD" required></div>
								<div class="field"><label for="designation">Staff designation <span>*</span></label><select id="designation" name="designation" required><option value="">Select designation</option><% if (formData.designation && !designations.some(item => item.name === formData.designation)) { %><option value="<%= formData.designation %>" selected><%= formData.designation %> (existing)</option><% } %><% designations.forEach(item => { %><option value="<%= item.name %>" <%= formData.designation === item.name ? 'selected' : '' %>><%= item.name %></option><% }) %></select></div>
								<div class="field"><label for="department">Department <span>*</span></label><select id="department" name="department" required><option value="">Select department</option><% if (formData.department && !departments.some(item => item.name === formData.department)) { %><option value="<%= formData.department %>" selected><%= formData.department %> (existing)</option><% } %><% departments.forEach(item => { %><option value="<%= item.name %>" <%= formData.department === item.name ? 'selected' : '' %>><%= item.name %></option><% }) %></select></div>
								<div class="field"><label for="section">Department section</label><select id="section" name="section"><option value="">Select section</option><% if (formData.section && !departmentSections.some(item => item.name === formData.section && item.departmentName === formData.department)) { %><option value="<%= formData.section %>" data-department-name="<%= formData.department || '' %>" selected><%= formData.section %> (existing)</option><% } %><% departmentSections.forEach(item => { %><option value="<%= item.name %>" data-department-name="<%= item.departmentName %>" <%= formData.section === item.name ? 'selected' : '' %>><%= item.name %> / <%= item.departmentName %></option><% }) %></select></div>
								<div class="field"><label for="gradeLevel">Grade level</label><input id="gradeLevel" name="gradeLevel" value="<%= formData.gradeLevel || '' %>"></div>
								<div class="field"><label for="jobStatus">Job status</label><select id="jobStatus" name="jobStatus"><% ['Active','Probation','On Leave','Resigned','Terminated'].forEach(value => { %><option value="<%= value %>" <%= (formData.jobStatus || formData.employmentStatus || 'Active') === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div>
								<label class="switch-row"><input type="checkbox" name="isManager" value="true" <%= formData.isManager ? 'checked' : '' %>> Is manager</label>
								<label class="switch-row"><input type="checkbox" name="isActive" value="true" <%= formData.isActive !== false ? 'checked' : '' %>> Is active</label>
							</div>
						</section>
						<section class="office-panel" id="basicInformationPanel" role="tabpanel" hidden>
							<div class="field-grid">
								<div class="field"><label for="dateOfBirthBs">Date of birth (BS)</label><input id="dateOfBirthBs" class="nepali-date-input" name="dateOfBirthBs" value="<%= formData.dateOfBirthBs || '' %>" placeholder="YYYY-MM-DD"></div>
								<div class="field"><label for="maritalStatus">Marital status</label><select id="maritalStatus" name="maritalStatus"><% ['Married','Unmarried','Other'].forEach(value => { %><option value="<%= value %>" <%= (formData.maritalStatus || 'Unmarried') === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div>
								<div class="field"><label for="gender">Gender <span>*</span></label><select id="gender" name="gender" required><option value="">Select</option><% ['Male','Female','Other'].forEach(value => { %><option value="<%= value %>" <%= formData.gender === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div>
								<div class="field"><label for="bloodGroup">Blood group</label><select id="bloodGroup" name="bloodGroup"><option value="">Select</option><% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(value => { %><option value="<%= value %>" <%= (formData.bloodGroup || formData.health?.bloodGroup) === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div>
								<div class="field"><label for="mobileNumber">Mobile number <span>*</span></label><input id="mobileNumber" name="mobileNumber" value="<%= formData.mobileNumber || '' %>" required></div>
								<div class="field"><label for="email">Personal email <span>*</span></label><input id="email" name="email" type="email" value="<%= formData.email || '' %>" required></div>
								<div class="field"><label for="country">Country</label><input id="country" name="country" value="<%= formData.country || 'Nepal' %>"></div>
								<div class="field"><label for="religion">Religion</label><input id="religion" name="religion" value="<%= formData.religion || '' %>"></div>
								<div class="field"><label for="passportNumber">Passport number</label><input id="passportNumber" name="passportNumber" value="<%= formData.passportNumber || '' %>"></div>
								<div class="field"><label for="citizenNumber">Citizen number</label><input id="citizenNumber" name="citizenNumber" value="<%= formData.citizenNumber || '' %>"></div>
								<div class="field"><label for="citizenshipIssueDate">Issue date (BS)</label><input id="citizenshipIssueDate" class="nepali-date-input" name="citizenshipIssueDate" value="<%= formData.citizenshipIssueDate || '' %>" placeholder="YYYY-MM-DD"></div>
								<div class="field"><label for="citizenshipIssueOffice">Issue district / office</label><input id="citizenshipIssueOffice" name="citizenshipIssueOffice" value="<%= formData.citizenshipIssueOffice || '' %>"></div>
								<div class="field"><label for="panNumber">PAN number</label><input id="panNumber" name="panNumber" value="<%= formData.panNumber || '' %>"></div>
								<div class="field"><label for="fatherName">Father name</label><input id="fatherName" name="fatherName" value="<%= formData.fatherName || '' %>"></div>
								<div class="field"><label for="motherName">Mother name</label><input id="motherName" name="motherName" value="<%= formData.motherName || '' %>"></div>
								<label class="switch-row"><input type="checkbox" name="isDifferentlyAbled" value="true" <%= formData.isDifferentlyAbled ? 'checked' : '' %>> Is differently abled</label>
							</div>
							<fieldset><legend>Permanent address</legend><div class="field-grid">
								<div class="field"><label for="address">Permanent address <span>*</span></label><input id="address" name="address" value="<%= formData.permanentAddress || formData.address || '' %>" required></div>
								<div class="field"><label for="permanentDistrict">District</label><input id="permanentDistrict" name="permanentDistrict" value="<%= formData.permanentDistrict || '' %>"></div>
								<div class="field"><label for="permanentMunicipality">Municipality</label><input id="permanentMunicipality" name="permanentMunicipality" value="<%= formData.permanentMunicipality || '' %>"></div>
								<div class="field"><label for="permanentWard">Ward</label><input id="permanentWard" name="permanentWard" value="<%= formData.permanentWard || '' %>"></div>
								<div class="field field-wide"><label for="permanentAddressNepali">Permanent address (Nepali)</label><input id="permanentAddressNepali" name="permanentAddressNepali" value="<%= formData.permanentAddressNepali || '' %>"></div>
							</div></fieldset>
							<label class="switch-row"><input type="checkbox" name="sameAddressAsPermanent" id="sameAddressAsPermanent" value="true" <%= formData.sameAddressAsPermanent ? 'checked' : '' %>> Same as permanent address</label>
							<fieldset id="temporaryAddressGroup"><legend>Temporary address</legend><div class="field-grid">
								<div class="field"><label for="temporaryAddress">Temporary address</label><input id="temporaryAddress" name="temporaryAddress" value="<%= formData.temporaryAddress || '' %>"></div>
								<div class="field"><label for="temporaryDistrict">District</label><input id="temporaryDistrict" name="temporaryDistrict" value="<%= formData.temporaryDistrict || '' %>"></div>
								<div class="field"><label for="temporaryMunicipality">Municipality</label><input id="temporaryMunicipality" name="temporaryMunicipality" value="<%= formData.temporaryMunicipality || '' %>"></div>
								<div class="field"><label for="temporaryWard">Ward</label><input id="temporaryWard" name="temporaryWard" value="<%= formData.temporaryWard || '' %>"></div>
								<div class="field field-wide"><label for="temporaryAddressNepali">Temporary address (Nepali)</label><input id="temporaryAddressNepali" name="temporaryAddressNepali" value="<%= formData.temporaryAddressNepali || '' %>"></div>
							</div></fieldset>
							<fieldset><legend>Bank information</legend><div class="field-grid"><div class="field"><label for="bankName">Bank</label><input id="bankName" name="bankName" value="<%= formData.bankName || '' %>"></div><div class="field"><label for="bankBranch">Branch</label><input id="bankBranch" name="bankBranch" value="<%= formData.bankBranch || '' %>"></div><div class="field"><label for="bankAccountNumber">Bank account</label><input id="bankAccountNumber" name="bankAccountNumber" value="<%= formData.bankAccountNumber || '' %>"></div></div></fieldset>
							<fieldset><legend>Emergency contact</legend><div class="field-grid"><div class="field"><label for="emergencyContactName">Contact person name <span>*</span></label><input id="emergencyContactName" name="emergencyContactName" value="<%= formData.emergencyContactName || '' %>" required></div><div class="field"><label for="emergencyContactRelation">Relation</label><input id="emergencyContactRelation" name="emergencyContactRelation" value="<%= formData.emergencyContactRelation || '' %>"></div><div class="field"><label for="emergencyContactNumber">Phone number <span>*</span></label><input id="emergencyContactNumber" name="emergencyContactNumber" value="<%= formData.emergencyContactNumber || '' %>" required></div><div class="field field-wide"><label for="emergencyContactAddress">Address</label><input id="emergencyContactAddress" name="emergencyContactAddress" value="<%= formData.emergencyContactAddress || '' %>"></div></div></fieldset>
							<div class="photo-upload"><label for="employeePhoto">Employee picture</label><input id="employeePhoto" type="file" name="employeePhoto" accept="image/*"><span class="muted-copy">Choose an image to replace the profile photo.</span></div>
						</section>
						<section class="office-panel" id="punchManagementPanel" role="tabpanel" hidden><h3>Time Punch Management</h3><div class="field-grid"><div class="field"><label for="punchMethod">Punch method</label><select id="punchMethod" name="punchMethod"><% ['No Punch','Single Punch','Two Punch','Four Punch','Any Time Punch'].forEach(value => { %><option value="<%= value %>" <%= (formData.punchMethod || 'Two Punch') === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div><label class="switch-row"><input type="checkbox" name="allowMobilePunch" value="true" <%= formData.allowMobilePunch ? 'checked' : '' %>> Allow mobile punch</label><div class="field"><label for="plannedIn">Planned in</label><input id="plannedIn" name="plannedIn" type="time" value="<%= formData.plannedIn || '09:00' %>"></div><div class="field"><label for="plannedOut">Planned out</label><input id="plannedOut" name="plannedOut" type="time" value="<%= formData.plannedOut || '17:00' %>"></div></div></section>
								<section class="office-panel" id="shiftManagementPanel" role="tabpanel" hidden><h3>Shift / Week Off / Management</h3><div class="field-grid"><div class="field"><label for="shiftType">Shift type</label><select id="shiftType" name="shiftType"><% ['Fixed','Rotational'].forEach(value => { %><option value="<%= value %>" <%= (formData.shiftType || 'Fixed') === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div><div class="field"><label for="shiftName">Shift</label><select id="shiftName" name="shiftName"><option value="">Select shift</option><% if (formData.shiftName && !shifts.some(item => item.name === formData.shiftName)) { %><option value="<%= formData.shiftName %>" selected><%= formData.shiftName %> (existing)</option><% } %><% shifts.forEach(item => { %><option value="<%= item.name %>" <%= formData.shiftName === item.name ? 'selected' : '' %>><%= item.name %> (<%= item.shiftStart %>-<%= item.shiftEnd %>)</option><% }) %></select></div></div><p class="muted-copy" style="margin-top:18px">To change current week off, select active days and an effective date. Adding a new rule preserves the previous rule in history.</p><div class="section-heading"><h3>Active week off</h3><button class="add-row" type="button" id="addWeekOffRule"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add New</button></div><div class="day-options"><% ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].forEach(day => { %><label class="day-option"><input type="checkbox" name="activeWeekOff" value="<%= day %>" <%= (formData.activeWeekOff || []).includes(day) ? 'checked' : '' %>><%= day %></label><% }) %></div><div class="field" style="max-width:320px;margin-top:14px"><label for="weekOffEffectiveFrom">Effective from (BS)</label><input id="weekOffEffectiveFrom" class="nepali-date-input" name="weekOffEffectiveFrom" value="<%= formData.weekOffEffectiveFrom || '' %>" placeholder="YYYY-MM-DD"></div><div class="section-heading" style="margin-top:24px"><h3>Week Off History</h3></div><div class="repeat-table-wrap"><table><thead><tr><th>Off days</th><th>From date</th><th>To date</th></tr></thead><tbody><% if (selectedEmployee?.weekOffHistory?.length) { selectedEmployee.weekOffHistory.forEach(entry => { %><tr><td><%= (entry.offDays || []).join(', ') %></td><td><%= entry.fromDate || '-' %></td><td><%= entry.toDate || '-' %></td></tr><% }) %><% } else { %><tr><td colspan="3">No history found.</td></tr><% } %></tbody></table></div></section>
						<section class="office-panel" id="taxContributionsPanel" role="tabpanel" hidden><h3>Social Security &amp; Tax</h3><div class="field-grid"><label class="switch-row"><input type="checkbox" name="ssnEnabled" value="true" <%= formData.socialSecurityTax?.enabled ? 'checked' : '' %>> Enable SSN</label><div class="field"><label for="ssnNumber">SSN number</label><input id="ssnNumber" name="ssnNumber" value="<%= formData.socialSecurityTax?.number || '' %>"></div><div class="field"><label for="ssfEffectiveDate">SSF effective date (BS)</label><input id="ssfEffectiveDate" class="nepali-date-input" name="ssfEffectiveDate" value="<%= formData.socialSecurityTax?.effectiveDate || '' %>" placeholder="YYYY-MM-DD"></div></div><fieldset><legend>Provident Fund</legend><div class="field-grid"><label class="switch-row"><input type="checkbox" name="pfEnabled" value="true" <%= formData.providentFund?.enabled ? 'checked' : '' %>> Enable PF</label><div class="field"><label for="pfCalculationType">Calculation</label><select id="pfCalculationType" name="pfCalculationType"><% ['Flat','Percent'].forEach(value => { %><option value="<%= value %>" <%= (formData.providentFund?.calculationType || 'Flat') === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div><div class="field"><label for="pfNumber">PF number</label><input id="pfNumber" name="pfNumber" value="<%= formData.providentFund?.number || '' %>"></div><div class="field"><label for="pfEmployeeAmount">Employee amount (Rs.)</label><input id="pfEmployeeAmount" type="number" min="0" step="any" name="pfEmployeeAmount" value="<%= formData.providentFund?.employeeAmount ?? '' %>"></div><div class="field"><label for="pfEmployeeRate">Employee rate (%)</label><input id="pfEmployeeRate" type="number" min="0" step="any" name="pfEmployeeRate" value="<%= formData.providentFund?.employeeRate ?? '' %>"></div><div class="field"><label for="pfEmployerRate">Employer rate (%)</label><input id="pfEmployerRate" type="number" min="0" step="any" name="pfEmployerRate" value="<%= formData.providentFund?.employerRate ?? '' %>"></div></div></fieldset><fieldset><legend>Citizen Investment Trust</legend><div class="field-grid"><label class="switch-row"><input type="checkbox" name="citEnabled" value="true" <%= formData.citizenInvestmentTrust?.enabled ? 'checked' : '' %>> Enable CIT</label><div class="field"><label for="citCalculationType">Calculation</label><select id="citCalculationType" name="citCalculationType"><% ['Flat','Percent'].forEach(value => { %><option value="<%= value %>" <%= (formData.citizenInvestmentTrust?.calculationType || 'Flat') === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div><div class="field"><label for="citNumber">CIT number</label><input id="citNumber" name="citNumber" value="<%= formData.citizenInvestmentTrust?.number || '' %>"></div><div class="field"><label for="citAmount">CIT amount (Rs.)</label><input id="citAmount" type="number" min="0" step="any" name="citAmount" value="<%= formData.citizenInvestmentTrust?.amount ?? '' %>"></div></div></fieldset><fieldset><legend>Gratuity</legend><label class="switch-row"><input type="checkbox" name="gratuityEnabled" value="true" <%= formData.gratuity?.enabled ? 'checked' : '' %>> Enable gratuity</label></fieldset><fieldset><legend>Previous Company TDS Entry Setup</legend><p class="muted-copy">Enter data for the current fiscal year only. Include previous-employer salary and TDS already deducted.</p><div class="field-grid"><div class="field"><label for="previousCompanyName">Old company name</label><input id="previousCompanyName" name="previousCompanyName" value="<%= formData.previousCompanyTds?.companyName || '' %>"></div><div class="field"><label for="previousTotalSalary">Total salary amount (Rs.)</label><input id="previousTotalSalary" name="previousTotalSalary" type="number" min="0" step="any" value="<%= formData.previousCompanyTds?.totalSalary ?? '' %>"></div><div class="field"><label for="previousTotalTds">Total TDS amount (Rs.)</label><input id="previousTotalTds" name="previousTotalTds" type="number" min="0" step="any" value="<%= formData.previousCompanyTds?.totalTds ?? '' %>"></div><div class="field"><label for="previousFiscalYear">Fiscal year</label><input id="previousFiscalYear" name="previousFiscalYear" value="<%= formData.previousCompanyTds?.fiscalYear || '' %>"></div><div class="field"><label for="previousTdsDocumentName">Document name</label><input id="previousTdsDocumentName" name="previousTdsDocumentName" value="<%= formData.previousCompanyTds?.documentName || '' %>"></div><div class="field"><label for="previousTdsDocument">Upload document</label><input id="previousTdsDocument" type="file" name="previousTdsDocument" accept="application/pdf,image/*"></div><% if (formData.previousCompanyTds?.url) { %><div class="field"><label>Current document</label><a href="<%= formData.previousCompanyTds.url %>" target="_blank" rel="noopener">Open document</a><input type="hidden" name="previousTdsDocumentUrl" value="<%= formData.previousCompanyTds.url %>"><input type="hidden" name="previousTdsDocumentBlobName" value="<%= formData.previousCompanyTds.blobName || '' %>"></div><% } %></div></fieldset></section>
						<div class="form-actions"><button class="button button-secondary" type="button" data-close-basic-dialog>Cancel</button><button class="button button-primary" type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save employee record</button></div>
				</dialog>
				<div class="form-actions"><button class="button button-secondary" type="reset">Reset unsaved changes</button><button class="button button-primary" type="submit"><%= selectedEmployee ? 'Save changes' : 'Create employee' %></button></div>
			</form>
		</section>
	</div>
</main>
<template id="documentRowTemplate"><div class="document-entry" data-repeat-row><span class="row-number"></span><input type="text" name="documentName___index__" placeholder="Document name" aria-label="Document name" required><input type="file" name="documentFile___index__" accept="application/pdf,image/jpeg,image/png,image/webp,image/gif" aria-label="Upload document"><button class="remove-row" type="button" data-remove-row>Remove</button></div></template>
<% tableConfigs.forEach(config=> { %><template id="<%= config.prefix %>RowTemplate"><tr data-repeat-row><td class="row-number"></td><% config.fields.forEach(field=> { %><td><% if(field.type==='select'){ %><select name="<%= config.prefix %>___index___<%= field.name %>" aria-label="<%= field.label %>"><% field.options.forEach(option=> { %><option value="<%= option==='Yes'?'true':option==='No'?'false':option %>"><%= option %></option><% }) %></select><% } else { %><input type="<%= field.type==='date'?'text':field.type||'text' %>" class="<%= field.type==='date'?'nepali-date-input':'' %>" name="<%= config.prefix %>___index___<%= field.name %>" aria-label="<%= field.label %>" <%= field.type==='number'?'step="any" min="0"':'' %>><% } %></td><% }) %><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr></template><% }) %>
<template id="familyRowTemplate"><tr data-repeat-row><td class="row-number"></td><td><input name="family___index___name" aria-label="Family member name"></td><td><input name="family___index___relation" aria-label="Relation"></td><td><input name="family___index___note" aria-label="Note"></td><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr></template>
<template id="taxContributionRowTemplate"><tr data-repeat-row><td class="row-number"></td><td><input name="taxContribution___index___title" aria-label="Title"></td><td><input name="taxContribution___index___number" aria-label="Number"></td><td><select name="taxContribution___index___enabled"><option value="false">No</option><option value="true">Yes</option></select></td><td><input type="number" min="0" step="any" name="taxContribution___index___employeeRate" aria-label="Employee rate"></td><td><input type="number" min="0" step="any" name="taxContribution___index___employerRate" aria-label="Employer rate"></td><td><button class="remove-row" type="button" data-remove-row>Remove</button></td></tr></template>
<script src="https://kit.fontawesome.com/368eb67b69.js" crossorigin="anonymous"></script>
<script src="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/js/nepali.datepicker.v5.0.6.min.js" type="text/javascript"></script>
<script>
	const profileForm=document.getElementById('employeeProfileForm');
	const basicInfoDialog=document.getElementById('basicInfoDialog');
	document.querySelectorAll('[data-open-basic-dialog]').forEach(button=>button.addEventListener('click',()=>{basicInfoDialog.showModal();initializeDatePickers(basicInfoDialog);}));
	document.querySelectorAll('[data-close-basic-dialog]').forEach(button=>button.addEventListener('click',()=>basicInfoDialog.close()));
	basicInfoDialog.addEventListener('click',event=>{if(event.target===basicInfoDialog)basicInfoDialog.close();});
	const moduleButtons=[...document.querySelectorAll('[data-module-target]')];
	const modulePanels=[...document.querySelectorAll('[data-module]')];
	function activateModule(name){modulePanels.forEach(panel=>{panel.hidden=panel.dataset.module!==name;if(!panel.hidden)initializeDatePickers(panel);});moduleButtons.forEach(button=>button.setAttribute('aria-current',String(button.dataset.moduleTarget===name?'page':'false')));document.getElementById('activeModule').value=name;}
	moduleButtons.forEach(button=>button.addEventListener('click',()=>activateModule(button.dataset.moduleTarget)));
	activateModule('<%= activeModuleName %>');
	function activateTab(button){const group=button.closest('[data-tab-group]');group.querySelectorAll(':scope > .tab-button').forEach(tab=>tab.setAttribute('aria-selected',String(tab===button)));group.querySelectorAll(':scope > [data-tab-target]').forEach(tab=>{const target=document.getElementById(tab.dataset.tabTarget);if(target)target.hidden=tab!==button;});initializeDatePickers(document.getElementById(button.dataset.tabTarget));}
	document.querySelectorAll('[data-tab-group] .tab-button').forEach(button=>button.addEventListener('click',()=>activateTab(button)));
	function initializeDatePickers(root=document){if(!root)return;root.querySelectorAll('.nepali-date-input').forEach(input=>{if(typeof input.NepaliDatePicker==='function'&&!input.dataset.pickerReady){input.NepaliDatePicker({dateFormat:'YYYY-MM-DD',language:'english'});input.dataset.pickerReady='true';}});}
	initializeDatePickers(document.querySelector('[data-module="<%= activeModuleName %>"]')||document);
	const profileDepartment=document.getElementById('department');
	const profileSection=document.getElementById('section');
	function filterProfileSections(){
		if(!profileDepartment||!profileSection)return;
		const departmentName=profileDepartment.value.trim().toLowerCase();
		Array.from(profileSection.options).forEach(option=>{
			if(!option.value||!option.dataset.departmentName)return;
			option.hidden=Boolean(departmentName)&&option.dataset.departmentName.trim().toLowerCase()!==departmentName;
		});
		if(profileSection.selectedOptions[0]?.hidden)profileSection.value='';
	}
	profileDepartment?.addEventListener('change',filterProfileSections);
	filterProfileSections();
	const identifierInputs=[...profileForm.querySelectorAll('#employeeCode,#deviceCode')];
	const identifierTimers=new WeakMap();
	const identifierVersions=new WeakMap();
	function setIdentifierFeedback(input,message,state=''){
		const feedback=document.getElementById(`${input.id}Availability`);
		if(!feedback)return;
		feedback.textContent=message;
		feedback.className=`identifier-feedback${state?` is-${state}`:''}`;
	}
	function clearIdentifierWarning(input){
		input.setCustomValidity('');
		input.classList.remove('identifier-duplicate','identifier-shake');
		setIdentifierFeedback(input,'');
	}
	async function checkIdentifierAvailability(input,version){
		const value=input.value.trim();
		if(!value||identifierVersions.get(input)!==version)return;
		try{
			const query=new URLSearchParams({field:input.name,value,employeeId:profileForm.dataset.employeeId||''});
			const response=await fetch(`/employeedetail/check-code?${query}`,{headers:{Accept:'application/json'}});
			if(!response.ok)throw new Error('Availability check failed.');
			const result=await response.json();
			if(identifierVersions.get(input)!==version)return;
			if(result.available){
				clearIdentifierWarning(input);
				setIdentifierFeedback(input,'Available','available');
				return;
			}
			input.setCustomValidity('This code is already used.');
			input.classList.remove('identifier-shake');
			input.classList.add('identifier-duplicate');
			void input.offsetWidth;
			input.classList.add('identifier-shake');
			setIdentifierFeedback(input,'Already used','duplicate');
		}catch(error){
			if(identifierVersions.get(input)===version)setIdentifierFeedback(input,'Could not check right now');
		}
	}
	function scheduleIdentifierCheck(input,delay){
		clearTimeout(identifierTimers.get(input));
		const version=(identifierVersions.get(input)||0)+1;
		identifierVersions.set(input,version);
		clearIdentifierWarning(input);
		if(!input.value.trim())return;
		setIdentifierFeedback(input,'Checking...');
		identifierTimers.set(input,setTimeout(()=>checkIdentifierAvailability(input,version),delay));
	}
	identifierInputs.forEach(input=>{
		input.addEventListener('input',()=>scheduleIdentifierCheck(input,350));
		input.addEventListener('blur',()=>scheduleIdentifierCheck(input,0));
	});
	const sameAddressToggle=document.getElementById('sameAddressAsPermanent');
	const syncTemporaryAddress=()=>{const isSame=sameAddressToggle.checked;[['address','temporaryAddress'],['permanentDistrict','temporaryDistrict'],['permanentMunicipality','temporaryMunicipality'],['permanentWard','temporaryWard'],['permanentAddressNepali','temporaryAddressNepali']].forEach(([from,to])=>{const source=document.getElementById(from);const target=document.getElementById(to);target.readOnly=isSame;if(isSame)target.value=source.value;});};
	sameAddressToggle.addEventListener('change',syncTemporaryAddress);
	if(sameAddressToggle.checked)syncTemporaryAddress();
	const updateTaxRequirements=()=>{document.getElementById('ssnNumber').required=document.querySelector('[name="ssnEnabled"]').checked;document.getElementById('pfNumber').required=document.querySelector('[name="pfEnabled"]').checked;document.getElementById('citNumber').required=document.querySelector('[name="citEnabled"]').checked;};
	document.querySelectorAll('[name="ssnEnabled"],[name="pfEnabled"],[name="citEnabled"]').forEach(input=>input.addEventListener('change',updateTaxRequirements));
	updateTaxRequirements();
	document.getElementById('addWeekOffRule').addEventListener('click',()=>{document.querySelectorAll('[name="activeWeekOff"]').forEach(input=>input.checked=false);document.getElementById('weekOffEffectiveFrom').value='';document.getElementById('weekOffEffectiveFrom').focus();});
	function reindex(container){const prefix=container.dataset.rowPrefix;const rows=[...container.querySelectorAll('[data-repeat-row]')];rows.forEach((row,index)=>{const number=row.querySelector('.row-number');if(number)number.textContent=String(index+1);row.querySelectorAll('[name]').forEach(input=>{input.name=prefix==='document'?input.name.replace(/^document(Name|File)_\d+$/,(_,kind)=>`document${kind}_${index}`):input.name.replace(new RegExp(`^${prefix}_\\d+_`),`${prefix}_${index}_`);});});const count=document.getElementById(`${prefix}Count`);if(count)count.value=String(rows.length);}
	document.querySelectorAll('[data-add-row]').forEach(button=>button.addEventListener('click',()=>{const prefix=button.dataset.addRow;const container=document.getElementById(`${prefix}Rows`);const template=document.getElementById(`${prefix}RowTemplate`);if(!container||!template)return;const index=container.querySelectorAll('[data-repeat-row]').length;const holder=document.createElement('template');holder.innerHTML=template.innerHTML.replaceAll('__index__',String(index));container.append(holder.content.cloneNode(true));reindex(container);initializeDatePickers(container);}));
	document.addEventListener('click',event=>{const button=event.target.closest('[data-remove-row]');if(!button)return;const row=button.closest('[data-repeat-row]');const container=button.closest('[data-row-prefix]');if(row&&container){row.remove();reindex(container);}});
	document.getElementById('healthHeightCm').addEventListener('input',updateBmi);document.getElementById('healthWeightKg').addEventListener('input',updateBmi);
	function updateBmi(){const height=Number(document.getElementById('healthHeightCm').value)/100;const weight=Number(document.getElementById('healthWeightKg').value);document.getElementById('bmiPreview').textContent=height>0&&weight>0?(weight/(height*height)).toFixed(1):'-';}
	const joined=document.querySelector('.service-period')?.dataset.joinDate;if(joined){const start=new Date(`${joined}T00:00:00`);const now=new Date();let years=now.getFullYear()-start.getFullYear();let months=now.getMonth()-start.getMonth();let days=now.getDate()-start.getDate();if(days<0){months--;days+=new Date(now.getFullYear(),now.getMonth(),0).getDate();}if(months<0){years--;months+=12;}document.querySelector('.service-period').textContent=`${years}y ${months}m ${days}d`;}
	let validationAttempted=false;
	function updateInvalidHighlights(){
		profileForm.querySelectorAll('.required-invalid').forEach(input=>input.classList.remove('required-invalid'));
		profileForm.querySelectorAll('.field.has-invalid').forEach(field=>field.classList.remove('has-invalid'));
		document.querySelectorAll('.tab-button.tab-invalid').forEach(button=>button.classList.remove('tab-invalid'));
		return [...profileForm.querySelectorAll('input:invalid,select:invalid,textarea:invalid')].map(input=>{
			input.classList.add('required-invalid');
			input.closest('.field')?.classList.add('has-invalid');
			let panel=input.closest('[role="tabpanel"]');
			while(panel&&profileForm.contains(panel)){
				const tabButton=[...document.querySelectorAll('.tab-button[data-tab-target]')].find(button=>button.dataset.tabTarget===panel.id);
				if(tabButton)tabButton.classList.add('tab-invalid');
				panel=panel.parentElement.closest('[role="tabpanel"]');
			}
			return input;
		});
	}
	profileForm.addEventListener('input',()=>{if(validationAttempted)updateInvalidHighlights();});
	profileForm.addEventListener('change',()=>{if(validationAttempted)updateInvalidHighlights();});
	profileForm.addEventListener('reset',()=>{validationAttempted=false;setTimeout(updateInvalidHighlights);});
	profileForm.addEventListener('submit',event=>{
		validationAttempted=true;
		const invalidInputs=updateInvalidHighlights();
		if(invalidInputs.length){
			event.preventDefault();
			const firstInvalid=invalidInputs[0];
			const modulePanel=firstInvalid.closest('[data-module]');
			if(modulePanel?.hidden)activateModule(modulePanel.dataset.module);
			const dialog=firstInvalid.closest('dialog');
			if(dialog&&!dialog.open)dialog.showModal();
			const tabPanels=[];
			let panel=firstInvalid.closest('[role="tabpanel"]');
			while(panel&&profileForm.contains(panel)){tabPanels.unshift(panel);panel=panel.parentElement.closest('[role="tabpanel"]');}
			tabPanels.forEach(tabPanel=>{
				const button=[...document.querySelectorAll('.tab-button[data-tab-target]')].find(tab=>tab.dataset.tabTarget===tabPanel.id);
				if(button)activateTab(button);
			});
			requestAnimationFrame(()=>{firstInvalid.focus();firstInvalid.scrollIntoView({block:'center',behavior:'smooth'});});
			return;
		}
		profileForm.querySelectorAll('.nepali-date-input').forEach(input=>{const match=input.value.match(/^([0-9०-९]{4})-([0-9०-९]{1,2})-([0-9०-९]{1,2})$/);if(!match)return;const zero=/[०-९]/.test(input.value)?'०':'0';input.value=`${match[1]}-${match[2].padStart(2,zero)}-${match[3].padStart(2,zero)}`;});
	});
</script>
</body>
</html>