<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= selectedEmployee ? `${selectedEmployee.staffName} | Employee profile` : 'Add employee' %></title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
	<link href="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/css/nepali.datepicker.v5.0.6.min.css" rel="stylesheet" type="text/css">
	<style>
		:root { color-scheme: light; --ink: #1b2940; --muted: #6a7585; --line: #dce2e9; --paper: #fff; --canvas: #f1f3f6; --blue: #24477b; --blue-dark: #18375f; --blue-soft: #e8eef7; --orange: #bd673f; --red: #a53535; font-family: 'DM Sans', sans-serif; color: var(--ink); background: var(--canvas); }
		* { box-sizing: border-box; }
		body { margin: 0; min-height: 100vh; background: var(--canvas); }
		button, input, select, textarea { font: inherit; }
		.page-shell { width: min(1600px, calc(100% - 32px)); margin: 0 auto; padding: 24px 0 48px; }
		.page-header { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin: 0 0 18px; }
		.eyebrow { margin: 0 0 6px; color: var(--orange); font-size: .7rem; font-weight: 800; text-transform: uppercase; }
		h1, h2, h3 { font-family: 'Manrope', sans-serif; }
		h1 { margin: 0; font-size: 1.65rem; }
		.page-intro { margin: 5px 0 0; color: var(--muted); font-size: .9rem; }
		.workspace { display: grid; grid-template-columns: 300px minmax(0, 1fr); align-items: start; gap: 18px; }
		.left-rail { display: grid; gap: 14px; position: sticky; top: 16px; }
		.rail-panel, .workspace-panel { border: 1px solid var(--line); border-radius: 7px; background: var(--paper); }
		.profile-card { overflow: hidden; }
		.profile-card-heading { padding: 15px 16px; border-bottom: 1px solid var(--line); font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
		.profile-summary { padding: 16px; }
		.profile-photo { display: grid; place-items: center; width: 104px; height: 104px; margin: 0 auto 14px; border: 1px solid var(--line); border-radius: 50%; background: #edf1f6; color: var(--muted); overflow: hidden; }
		.profile-photo img { width: 100%; height: 100%; object-fit: cover; }
		.profile-summary h2 { margin: 0 0 12px; text-align: center; font-size: 1rem; }
		.profile-facts { display: grid; gap: 10px; margin: 0; }
		.profile-fact { display: grid; grid-template-columns: 95px minmax(0, 1fr); gap: 8px; font-size: .78rem; }
		.profile-fact dt { color: var(--muted); font-weight: 700; }
		.profile-fact dd { margin: 0; overflow-wrap: anywhere; }
		.employee-switcher { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--line); }
		.employee-switcher select { min-width: 0; flex: 1; }
		.rail-links { display: grid; gap: 3px; padding: 8px; }
		.rail-link { display: flex; align-items: center; min-height: 42px; padding: 0 12px; border: 0; border-radius: 4px; background: transparent; color: #46594f; text-align: left; text-decoration: none; cursor: pointer; font-weight: 700; }
		.rail-link:hover { background: #edf1f6; }
		.rail-link[aria-current="page"] { background: var(--blue); color: #fff; }
		.rail-link-quiet { color: var(--muted); font-size: .84rem; }
		.workspace-panel { min-width: 0; overflow: hidden; }
		.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 17px 20px; border-bottom: 1px solid var(--line); }
		.panel-heading h2 { margin: 0; font-size: 1.05rem; }
		.required-note { color: var(--muted); font-size: .78rem; }
		.required-note span { color: var(--orange); font-weight: 800; }
		form.profile-form { padding: 0; }
		form.employee-switcher { margin: 0; padding: 0; }
		input, select, textarea { width: 100%; min-height: 40px; padding: 9px 10px; border: 1px solid #cddad1; border-radius: 4px; background: white; color: var(--ink); }
		.identifier-duplicate { border-color: var(--red) !important; background: #fff5f5 !important; box-shadow: 0 0 0 1px rgba(165,53,53,.16); }
		.identifier-shake { animation: identifier-shake .36s ease-in-out; }
		.identifier-feedback { min-height: 0; margin-top: 4px; color: var(--muted); font-size: .72rem; }
		.identifier-feedback:not(:empty) { min-height: 16px; }
		.identifier-feedback.is-available { color: #286247; }
		.identifier-feedback.is-duplicate { color: var(--red); font-weight: 800; }
		@keyframes identifier-shake { 0%,100% { transform:translateX(0); } 25% { transform:translateX(-5px); } 50% { transform:translateX(5px); } 75% { transform:translateX(-3px); } }
		@media(prefers-reduced-motion:reduce) { .identifier-shake { animation:none; } }
		input.required-invalid, select.required-invalid, textarea.required-invalid { border-color: var(--red); background: #fff7f7; box-shadow: 0 0 0 1px rgba(165,53,53,.16); }
		.field.has-invalid > label { color: var(--red); }
		textarea { min-height: 78px; resize: vertical; }
		input:focus, select:focus, textarea:focus, button:focus-visible, a:focus-visible { outline: 3px solid rgba(23,105,77,.18); outline-offset: 2px; }
		label { display: block; margin-bottom: 5px; color: #455a51; font-size: .78rem; font-weight: 700; }
		.field-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
		.field { min-width: 0; }
		.field-wide { grid-column: span 2; }
		.tab-list { display: flex; gap: 4px; overflow-x: auto; padding: 7px 16px 0; border-bottom: 1px solid var(--line); }
		.tab-button { flex: 0 0 auto; min-height: 42px; padding: 9px 13px; border: 0; border-bottom: 3px solid transparent; background: transparent; color: var(--muted); cursor: pointer; font-size: .84rem; font-weight: 700; }
		.tab-button[aria-selected="true"] { border-color: var(--blue); color: var(--blue-dark); }
		.tab-button.tab-invalid { border-bottom-color: var(--red); background: #fff1f1; color: var(--red); }
		.tab-panel { padding: 20px; }
		.tab-panel[hidden], .module-panel[hidden], .sub-panel[hidden] { display: none; }
		.sub-tabs { margin-bottom: 18px; padding: 0; }
		.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 14px; }
		.section-heading h3 { margin: 0; font-size: .98rem; }
		fieldset { min-width: 0; margin: 0; padding: 18px 0; border: 0; border-bottom: 1px solid var(--line); }
		fieldset:last-child { border-bottom: 0; }
		legend { margin-bottom: 14px; font-family: 'Manrope', sans-serif; font-size: .9rem; font-weight: 800; }
		.repeat-table-wrap { overflow: auto; border: 1px solid var(--line); border-radius: 4px; }
		table { width: 100%; border-collapse: collapse; white-space: nowrap; font-size: .78rem; }
		th, td { padding: 9px 10px; border-bottom: 1px solid #e9efea; text-align: left; }
		th { background: #f5f8f5; color: var(--muted); font-size: .68rem; font-weight: 800; text-transform: uppercase; }
		tbody tr:last-child td { border-bottom: 0; }
		.repeat-table { min-width: 850px; }
		.repeat-table input, .repeat-table select { min-width: 105px; min-height: 36px; padding: 6px 8px; }
		.add-row { min-height: 35px; padding: 0 11px; border: 1px solid var(--blue); border-radius: 4px; background: var(--blue-soft); color: var(--blue-dark); cursor: pointer; font-size: .82rem; font-weight: 700; }
		.remove-row { min-height: 32px; padding: 0 8px; border: 1px solid #e5c6c2; border-radius: 4px; background: #fff7f5; color: var(--red); cursor: pointer; }
		.button { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 0 15px; border: 1px solid transparent; border-radius: 4px; cursor: pointer; font-weight: 700; text-decoration: none; }
		.button-primary { background: var(--blue); color: white; }
		.button-primary:hover { background: var(--blue-dark); }
		.button-secondary { border-color: var(--line); background: #f4f7f4; color: var(--ink); }
		.form-actions { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 20px; border-top: 1px solid var(--line); background: #fbfcfb; }
		.form-actions .button { min-width: 130px; }
		.notice { margin: 14px 18px 0; padding: 11px 14px; border-radius: 4px; font-size: .86rem; font-weight: 600; }
		.notice-error { border: 1px solid #edc8c3; background: #fff2ef; color: #a53535; }
		.notice-success { border: 1px solid #bfd0e5; background: #eef3fa; color: var(--blue-dark); }
		.document-list { display: grid; }
		.document-entry { display: grid; grid-template-columns: 30px minmax(170px, .8fr) minmax(240px, 1.2fr) auto; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
		.document-entry:last-child { border-bottom: 0; }
		.document-entry input[type="file"] { min-height: 38px; padding: 5px; }
		.document-hint, .muted-copy { margin: 0 0 12px; color: var(--muted); font-size: .8rem; }
		.photo-upload { display: grid; gap: 8px; max-width: 300px; }
		.profile-photo img { display: block; }
		.bmi-readout output { color: var(--blue-dark); font-weight: 800; }
		.icon-button { display: inline-grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 4px; background: white; color: var(--blue); cursor: pointer; }
		.profile-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
		.profile-heading-row .profile-card-heading { padding: 0; border: 0; }
		.empty-profile-add { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 42px; margin: 12px; border: 1px dashed #9baac0; border-radius: 5px; color: var(--blue); text-decoration: none; font-weight: 700; }
		.edit-dialog { width: min(1040px, calc(100% - 28px)); max-width: none; max-height: min(90vh, 900px); padding: 0; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); box-shadow: 0 20px 60px rgba(18,35,58,.28); }
		.edit-dialog::backdrop { background: rgba(18, 30, 48, .52); }
		.dialog-heading { position: sticky; top: 0; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); background: var(--paper); }
		.dialog-heading h2 { margin: 0; font-size: 1rem; }
		.dialog-content { padding: 0 18px 18px; }
		.office-tabs { position: sticky; top: 57px; z-index: 2; margin: 0 -18px 14px; padding: 0 12px; background: var(--paper); }
		.office-panel { padding: 14px 2px; }
		.office-panel[hidden] { display: none; }
		.switch-row { display: flex; align-items: center; gap: 9px; }
		.switch-row input[type="checkbox"] { width: 18px; min-height: 18px; accent-color: var(--blue); }
		.day-options { display: flex; flex-wrap: wrap; gap: 8px; }
		.day-option { display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 4px; }
		.day-option input { width: 16px; min-height: 16px; accent-color: var(--blue); }
		.icon-label { display: inline-flex; align-items: center; gap: 8px; }
		.management-block { padding: 16px; border-bottom: 1px solid var(--line); }
		.management-block h3 { margin: 0 0 12px; font-size: .95rem; }
		.management-target { padding: 12px; border-left: 3px solid var(--blue); background: #f4f6f9; }
		.management-target strong, .management-target span { display: block; }
		.management-target span { margin-top: 4px; color: var(--muted); font-size: .8rem; }
		.empty-state { padding: 20px; color: var(--muted); text-align: center; }
		@media (max-width: 980px) { .workspace { grid-template-columns: 250px minmax(0, 1fr); } .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
		@media (max-width: 700px) { .page-shell { width: calc(100% - 20px); padding-top: 16px; } .workspace { grid-template-columns: 1fr; } .left-rail { position: static; grid-template-columns: 1fr; } .profile-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .profile-fact { grid-template-columns: 1fr; gap: 2px; } .tab-panel { padding: 16px 12px; } .field-grid { grid-template-columns: 1fr; } .field-wide { grid-column: auto; } .document-entry { grid-template-columns: 28px 1fr auto; } .document-entry input[type="file"] { grid-column: 2 / -1; } .panel-heading { padding: 15px; } }
	</style>
</head>
<body>
<%
const tableConfigs = [
	{ group: 'education', prefix: 'qualification', collection: 'qualifications', title: 'Qualification', action: 'Add Qualification', fields: [{name:'degree',label:'Degree'},{name:'level',label:'Level'},{name:'faculty',label:'Faculty'},{name:'institution',label:'Institution'},{name:'affiliation',label:'Affiliation'},{name:'country',label:'Country'},{name:'passedYearBs',label:'Passed year (BS)'},{name:'passedYearAd',label:'Passed year (AD)'},{name:'result',label:'Result'},{name:'majorSubjects',label:'Major subjects'},{name:'description',label:'Description'}] },
	{ group: 'education', prefix: 'experience', collection: 'experiences', title: 'Experience', action: 'Add Experience', fields: [{name:'title',label:'Title'},{name:'organization',label:'Organization'},{name:'beganOn',label:'Began on (BS)',type:'date'},{name:'endedOn',label:'Ended on (BS)',type:'date'},{name:'description',label:'Description'}] },
	{ group: 'education', prefix: 'skill', collection: 'skills', title: 'Skills', action: 'Add Skill', fields: [{name:'code',label:'Code'},{name:'name',label:'Name'},{name:'description',label:'Description'}] },
	{ group: 'education', prefix: 'training', collection: 'trainings', title: 'Training', action: 'Add Training', fields: [{name:'trainingName',label:'Training name'},{name:'fromDate',label:'From date (BS)',type:'date'},{name:'toDate',label:'To date (BS)',type:'date'},{name:'description',label:'Description'}] },
	{ group: 'pay', prefix: 'salary', collection: 'salaryRecords', title: 'Basic Salary', action: 'Add Salary', fields: [{name:'from',label:'From (BS)',type:'date'},{name:'to',label:'To (BS)',type:'date'},{name:'paidPer',label:'Paid per',type:'select',options:['Month','Day','Hour']},{name:'paymentBy',label:'Payment by',type:'select',options:['Bank','Cash','Cheque']},{name:'basicSalary',label:'Basic salary',type:'number'},{name:'allowance',label:'Allowance',type:'number'},{name:'dearness',label:'Dearness',type:'number'},{name:'total',label:'Total',type:'number'}] },
	{ group: 'pay', prefix: 'allowance', collection: 'allowances', title: 'Allowance', action: 'Add Allowance', fields: [{name:'allowance',label:'Allowance'},{name:'value',label:'Value',type:'number'},{name:'fromDate',label:'From date (BS)',type:'date'},{name:'minWorkHour',label:'Min work hour',type:'number'},{name:'minDays',label:'Min days',type:'number'},{name:'maxDays',label:'Max days',type:'number'},{name:'approved',label:'Approved',type:'select',options:['No','Yes']}] },
	{ group: 'pay', prefix: 'deduction', collection: 'deductions', title: 'Deduction', action: 'Add Deduction', fields: [{name:'deduction',label:'Deduction'},{name:'value',label:'Value',type:'number'},{name:'calculatedBy',label:'Calculated by'},{name:'isApproved',label:'Approved',type:'select',options:['No','Yes']}] },
	{ group: 'pay', prefix: 'advance', collection: 'advances', title: 'Advance', action: 'Add Advance', fields: [{name:'advanceName',label:'Advance name'},{name:'amount',label:'Amount',type:'number'},{name:'issueDate',label:'Issue date (BS)',type:'date'},{name:'status',label:'Status',type:'select',options:['Pending','Approved','Paid','Closed']},{name:'approved',label:'Approved',type:'select',options:['No','Yes']},{name:'matureDate',label:'Mature date (BS)',type:'date'}] },
	{ group: 'office', prefix: 'contract', collection: 'contracts', title: 'Contracts', action: 'Add Contract', fields: [{name:'status',label:'Status',type:'select',options:['Draft','Active','Expired','Closed']},{name:'beganOn',label:'Began on (BS)',type:'date'},{name:'endedOn',label:'Ended on (BS)',type:'date'}] },
	{ group: 'office', prefix: 'transfer', collection: 'transferHistory', title: 'Transfer History', action: 'Add Transfer', fields: [{name:'transferDate',label:'Transfer date (BS)',type:'date'},{name:'transferType',label:'Transfer type'},{name:'from',label:'From'},{name:'to',label:'To'},{name:'transferredBy',label:'Transferred by'}] },
	{ group: 'office', prefix: 'promotion', collection: 'promotionHistory', title: 'Promotion History', action: 'Add Promotion', fields: [{name:'status',label:'Status'},{name:'promotionDate',label:'Promotion date (BS)',type:'date'},{name:'fromDesignation',label:'From designation'},{name:'toDesignation',label:'To designation'},{name:'promotedBy',label:'Promoted by'}] },
	{ group: 'office', prefix: 'resignation', collection: 'resignations', title: 'Resignation', action: 'Add Resignation', fields: [{name:'eventDate',label:'Resignation date (BS)',type:'date'},{name:'lastWorkingDate',label:'Last working date (BS)',type:'date'},{name:'reason',label:'Reason'},{name:'details',label:'Details'},{name:'approved',label:'Approved',type:'select',options:['No','Yes']},{name:'approvedBy',label:'Approved by'}] },
	{ group: 'office', prefix: 'termination', collection: 'terminations', title: 'Terminations', action: 'Add Termination', fields: [{name:'eventDate',label:'Notice date (BS)',type:'date'},{name:'lastWorkingDate',label:'Service end date (BS)',type:'date'},{name:'reason',label:'Reason'},{name:'details',label:'Details'},{name:'approved',label:'Approved',type:'select',options:['No','Yes']},{name:'approvedBy',label:'Approved by'}] },
	{ group: 'office', prefix: 'disciplinary', collection: 'disciplinaryCases', title: 'Disciplinary Cases', action: 'Add Disciplinary Case', fields: [{name:'caseName',label:'Case name'},{name:'description',label:'Description'},{name:'createdOn',label:'Created on (BS)',type:'date'},{name:'status',label:'Status'},{name:'forwardTo',label:'Forward to'},{name:'actions',label:'Actions'}] },
	{ group: 'office', prefix: 'exitInterview', collection: 'exitInterviews', title: 'Exit Interview', action: 'Add Exit Interview', fields: [{name:'description',label:'Description'}] },
	{ group: 'office', prefix: 'letter', collection: 'lettersIssued', title: 'Letter Issued', action: 'Add Letter', fields: [{name:'type',label:'Letter type',type:'select',options:['Experience Letter','Appointment Letter','Other']},{name:'issueDate',label:'Issue date (BS)',type:'date'},{name:'issuedBy',label:'Issued by'},{name:'letterUrl',label:'Letter file URL'}] },
	{ group: 'loan', prefix: 'loan', collection: 'loans', title: 'Loan', action: 'Add Loan', fields: [{name:'loanName',label:'Loan name'},{name:'principalAmount',label:'Principal amount',type:'number'},{name:'interestRate',label:'Interest rate (%)',type:'number'},{name:'status',label:'Status',type:'select',options:['Pending','Approved','Active','Closed']},{name:'approved',label:'Approved',type:'select',options:['No','Yes']},{name:'matureDate',label:'Mature date (BS)',type:'date'}] },
	{ group: 'assets', prefix: 'asset', collection: 'assets', title: 'Assets', action: 'Add Asset', fields: [{name:'name',label:'Name'},{name:'assetNumber',label:'Asset number'},{name:'assetType',label:'Asset type'},{name:'issueDate',label:'Issue date (BS)',type:'date'},{name:'condition',label:'Condition'},{name:'note',label:'Note'}] },
	{ group: 'assets', prefix: 'facility', collection: 'facilities', title: 'Facilities', action: 'Add Facility', fields: [{name:'facility',label:'Facility'},{name:'description',label:'Description'},{name:'startDate',label:'Start date (BS)',type:'date'},{name:'endDate',label:'End date (BS)',type:'date'},{name:'note',label:'Note'}] },
	{ group: 'assets', prefix: 'vehicle', collection: 'personalVehicles', title: 'Personal Vehicle', action: 'Add Vehicle', fields: [{name:'vehicleType',label:'Vehicle type'},{name:'brand',label:'Brand'},{name:'model',label:'Model'},{name:'number',label:'Number'},{name:'status',label:'Status'}] }
];
const groupedTabs = {
	education: ['Qualification', 'Experience', 'Skills', 'Training'],
	pay: ['Basic Salary', 'Allowance', 'Deduction', 'Tax Configuration', 'Advance'],
	office: ['Contracts', 'Transfer History', 'Promotion History', 'Resignation', 'Terminations', 'Disciplinary Cases', 'Exit Interview', 'Letter Issued'],
	assets: ['Assets', 'Facilities', 'Personal Vehicle']
};
const configPanelId = config => `${config.prefix}ModulePanel`;
const currentRows = config => formData[config.collection]?.length ? formData[config.collection] : [{}];
const activeModuleName = activeModule || 'profile';
%>
<%- include('employeesidenav', { currentPage: activeModuleName, selectedEmployee }) %>
<main class="page-shell">
	<header class="page-header"><div><p class="eyebrow">People / Human resources</p><h1>Employee management</h1><p class="page-intro">Profile, compensation, office history, assets, and reporting.</p></div><a class="button button-secondary" href="/employeeattendance">Attendance</a></header>
	<% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
	<% if (saved) { %><div class="notice notice-success" role="status">Employee record saved.</div><% } %>
	<div class="workspace">
		<aside class="left-rail" aria-label="Employee navigation">
			<section class="rail-panel profile-card">
				<div class="profile-heading-row"><div class="profile-card-heading">Personal Info</div><% if (selectedEmployee) { %><button class="icon-button" type="button" data-open-basic-dialog aria-label="Edit personal information" title="Edit personal information"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button><% } else { %><a class="icon-button" href="/employeedetail?new=1" aria-label="Add employee" title="Add employee"><i class="fa-solid fa-plus" aria-hidden="true"></i></a><% } %></div>
				<div class="profile-summary">
					<div class="profile-photo"><% if (selectedEmployee?.employeePhoto?.url) { %><img src="<%= selectedEmployee.employeePhoto.url %>" alt="<%= selectedEmployee.staffName %>"><% } else { %><i class="fa-solid fa-user-tie" aria-hidden="true"></i><% } %></div>
					<h2><%= selectedEmployee?.staffName || 'New employee' %></h2>
					<dl class="profile-facts">
						<div class="profile-fact"><dt>Contact</dt><dd><%= selectedEmployee?.mobileNumber || '-' %></dd></div>
						<div class="profile-fact"><dt>Address</dt><dd><%= selectedEmployee?.address || '-' %></dd></div>
						<div class="profile-fact"><dt>Gender</dt><dd><%= selectedEmployee?.gender || '-' %></dd></div>
						<div class="profile-fact"><dt>Join date</dt><dd><%= formData.dateOfJoiningBs || '-' %></dd></div>
						<div class="profile-fact"><dt>Service period</dt><dd class="service-period" data-join-date="<%= selectedEmployee?.dateOfJoining ? new Date(selectedEmployee.dateOfJoining).toISOString().slice(0, 10) : '' %>">-</dd></div>
						<div class="profile-fact"><dt>Blood group</dt><dd><%= formData.health?.bloodGroup || selectedEmployee?.bloodGroup || '-' %></dd></div>
					</dl>
				</div>
				<% if (employees.length) { %><form class="employee-switcher" action="/employeedetail" method="get"><select name="employeeId" aria-label="Select employee" onchange="this.form.submit()"><% employees.forEach(employee => { %><option value="<%= employee._id %>" <%= String(employee._id) === String(selectedEmployee?._id) ? 'selected' : '' %>><%= employee.staffName %> / <%= employee.employeeCode %></option><% }) %></select></form><% } %>
			</section>
			<nav class="rail-panel rail-links" aria-label="Employee profile modules">
				<button class="rail-link" type="button" data-module-target="profile" aria-current="<%= activeModuleName === 'profile' ? 'page' : 'false' %>"><i class="fa-regular fa-id-badge" aria-hidden="true"></i> Employee Profile</button>
