						<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="profileEducationPanel">Qualifications &amp; Skills</button>
						<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="profileFamilyPanel">Family Info</button>
						<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="profileHealthPanel">Health Info</button>
						<button class="tab-button" type="button" role="tab" aria-selected="false" data-tab-target="profileDocumentsPanel">Documents</button>
