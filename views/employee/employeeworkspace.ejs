s||'' %></textarea></div></div></section>
					<section class="tab-panel" id="profileDocumentsPanel" role="tabpanel" hidden><div class="section-heading"><h3>Employee documents</h3><button class="add-row" type="button" data-add-row="document">+ Add other document</button></div><p class="document-hint">PDF and image documents are stored in Azure. Maximum 10 MB per file.</p><div class="document-list" id="documentRows" data-row-prefix="document"><% const docRows=formData.documentRows?.length?formData.documentRows:defaultDocuments.map(name=>({name}));docRows.forEach((row,index)=> { %><div class="document-entry" data-repeat-row><span class="row-number"><%= index+1 %></span><input type="text" name="documentName_<%= index %>" value="<%= row.name||'' %>" aria-label="Document name" required><input type="file" name="documentFile_<%= index %>" accept="application/pdf,image/jpeg,image/png,image/webp,image/gif" aria-label="Upload <%= row.name||'document' %>"><button class="remove-row" type="button" data-remove-row>Remove</button></div><% }) %></div></section>
