<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Employee attendance</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
	<link href="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/css/nepali.datepicker.v5.0.6.min.css" rel="stylesheet" type="text/css">
	<style>
		:root { color-scheme: light; 
			--ink: #20342e; --muted: #667871;  --paper: #fff; --canvas: #f2f2f2; --green: #0e0c5d; --green-dark: #180956; --green-soft: #e7f2eb; --orange: #d66b3d; --red: #a53535; font-family: 'DM Sans', sans-serif; color: var(--ink); background: var(--canvas); }
		* { box-sizing: border-box; }
		body { margin: 0; min-height: 100vh; background-color: var(--canvas); background-size: 28px 28px; }
		button, input, select { font: inherit; }
		.page-shell { width: min(1440px, calc(100% - 40px)); margin: 0 auto; padding: 34px 0 60px; }
		.page-header, .toolbar, .table-heading, .pagination { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
		.page-header { margin-bottom: 22px; }
		.eyebrow { margin: 0 0 6px; color: var(--orange); font-size: .72rem; font-weight: 800; text-transform: uppercase; }
		h1, h2 { font-family: 'Manrope', sans-serif; }
		h1 { margin: 0; font-size: 1.9rem; }
		.page-intro { margin: 6px 0 0; color: var(--muted); }
		.panel { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; }
		.toolbar { justify-content: flex-start; flex-wrap: wrap; padding: 16px; border-bottom: 1px solid var(--line); }
		.filter { display: flex; align-items: center; gap: 8px; }
		label { color: var(--muted); font-size: .78rem; font-weight: 700; }
		input, select { min-height: 39px; padding: 8px 10px; border: 1px solid #cddad1; border-radius: 5px; background: #fff; color: var(--ink); }
		input:focus, select:focus, button:focus-visible, a:focus-visible { outline: 3px solid rgba(23, 105, 77, .18); outline-offset: 2px; }
		.button { display: inline-flex; align-items: center; justify-content: center; min-height: 39px; padding: 0 14px; border: 1px solid transparent; border-radius: 5px; cursor: pointer; font-weight: 700; text-decoration: none; }
		.button-primary { background: var(--green); color: #fff; }
		.button-primary:hover { background: var(--green-dark); }
		.button-secondary { border-color: var(--line); background: #f4f7f4; color: var(--ink); }
		.import-notice { margin: 0 16px; padding: 10px 12px; border: 1px solid #c8dfd1; border-radius: 5px; background: #edf8f1; color: var(--green-dark); font-size: .82rem; font-weight: 700; }
		.import-error { border-color: #ebc9ce; background: #fff1f2; color: var(--red); }
		.table-heading { padding: 17px 18px; }
		h2 { margin: 0; font-size: 1rem; }
		.count { color: var(--muted); font-size: .82rem; }
		.table-wrap { overflow: auto; max-height: 70vh; }
		table { width: 100%; border-collapse: collapse; white-space: nowrap; font-size: .8rem; }
		th, td { padding: 10px 12px; border-bottom: 1px solid #e9efea; text-align: left; }
		th { position: sticky; top: 0; z-index: 1; padding: 0; background: #02337b; color: var(--paper); font-size: .69rem; text-transform: uppercase; }
		.sort-button { width: 100%; min-height: 40px; padding: 8px 12px; border: 0; background: transparent; color: inherit; text-align: left; font-size: inherit; font-weight: 800; text-transform: inherit; cursor: pointer; }
		tbody tr:hover { background: #f8fbf8; }
		tbody tr.holiday-row td, tbody tr.holiday-row:hover td { background: #f8d7da; color: #842029; }
		.employee-name { font-weight: 700; }
		.employee-code { color: var(--green-dark); font-weight: 800; }
		.status-late { color: #9b4c16; font-weight: 700; }
		.status-missed { color: var(--red); font-weight: 700; }
		.status-on-time { color: var(--green-dark); }
		.pagination { justify-content: flex-end; padding: 12px 16px; color: var(--muted); font-size: .82rem; }
		.page-controls { display: flex; align-items: center; gap: 8px; }
		.page-controls button { min-height: 34px; padding: 0 12px; border: 1px solid var(--line); border-radius: 5px; background: #fff; color: var(--ink); cursor: pointer; }
		.page-controls button:disabled { opacity: .45; cursor: not-allowed; }
		.empty-state { padding: 30px; color: var(--muted); text-align: center; }
		.sync-panel { margin-bottom: 18px; padding: 18px; }
		.sync-intro { max-width: 900px; margin: 8px 0 16px; color: var(--muted); font-size: .86rem; line-height: 1.55; }
		.device-list { display: grid; gap: 12px; }
		.device-card { display: grid; grid-template-columns: minmax(180px, 1fr) repeat(3, minmax(130px, .7fr)) minmax(220px, 1.1fr) auto; align-items: center; gap: 14px; padding: 14px; border: 1px solid var(--line); border-radius: 6px; }
		.device-title { margin: 0 0 4px; font-weight: 800; }
		.device-sn, .device-meta { color: var(--muted); font-size: .78rem; overflow-wrap: anywhere; }
		.device-status { display: inline-block; margin-top: 5px; font-size: .75rem; font-weight: 800; }
		.device-online { color: var(--green-dark); }
		.device-offline { color: var(--red); }
		.sync-result { color: var(--muted); font-size: .78rem; line-height: 1.5; }
		.sync-result strong { color: var(--ink); }
		.sync-note { margin: 0 0 12px; padding: 10px 12px; border: 1px solid #ead8a8; border-radius: 5px; background: #fff9e8; color: #705814; font-size: .82rem; line-height: 1.5; }
		@media (max-width: 1000px) { .device-card { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
		@media (max-width: 700px) { .page-shell { width: calc(100% - 24px); padding-top: 22px; } .page-header { align-items: flex-start; flex-direction: column; } .toolbar { align-items: stretch; } .filter { justify-content: space-between; width: 100%; } .filter input { flex: 1; } .table-heading { align-items: flex-start; flex-direction: column; } .pagination { align-items: flex-start; flex-direction: column; } }
	</style>
</head>
<body>
	<%- include('employeesidenav', { currentPage: 'attendance', selectedEmployee: null }) %>
	<main class="page-shell">
		<header class="page-header">
			<div>
				<p class="eyebrow">People / Attendance</p>
				<h1>Employee attendance</h1>
				<p class="page-intro">Choose the attendance range using Bikram Sambat dates.</p>
			</div>
			<% if (deviceSN) { %><span class="count">Device SN: <%= deviceSN %></span><% } %>
		</header>
		<section class="panel sync-panel" aria-labelledby="deviceSyncHeading">
			<h2 id="deviceSyncHeading">Device attendance synchronization</h2>
			<p class="sync-intro">The attendance server receives ADMS punches sent by a device. Starting a manual sync here opens a 10-minute monitoring window; it does not send an unverified command to request historic logs. Counts below are based on records actually processed by the server.</p>
			<p class="sync-note">Historical replay cannot be confirmed for this device from its serial number alone. Use the export or retransmission procedure documented for the exact ZKTeco model and firmware; if the device exports CSV, use the attendance CSV import below. Do not clear device records until exported or received records are checked.</p>
			<% if (attendanceDevices.length) { %>
				<div class="device-list">
					<% attendanceDevices.forEach(device => { %>
						<article class="device-card" data-serial="<%= device.serialNumber %>">
							<div>
								<p class="device-title"><%= device.deviceName %></p>
								<div class="device-sn">SN: <%= device.serialNumber %></div>
								<span class="device-status <%= device.online ? 'device-online' : 'device-offline' %>" data-role="connection"><%= device.connectionLabel %></span>
							</div>
							<div class="device-meta">Last activity<br><strong data-role="last-communication"><%= device.lastActivity ? new Date(device.lastActivity).toLocaleString() : device.lastCommunicationAt ? new Date(device.lastCommunicationAt).toLocaleString() : 'Not recorded' %></strong><br>Last attendance <span data-role="last-attendance"><%= device.lastAttendanceReceived ? new Date(device.lastAttendanceReceived).toLocaleString() : 'None received' %></span></div>
							<div class="device-meta">Last successfully processed batch<br><strong data-role="last-batch"><%= device.lastSuccessfulBatchAt ? new Date(device.lastSuccessfulBatchAt).toLocaleString() : 'None recorded' %></strong></div>
							<div class="device-meta">Request<br><strong data-role="request-type"><%= device.lastRequestType || 'None' %></strong> · <span data-role="request-status"><%= device.lastRequestStatus || 'No request status' %></span><br>Source: <span data-role="request-source"><%= device.lastRequestSource.replace(/_/g, ' ') %></span><br>Records received / inserted: <span data-role="device-totals"><%= device.totalReceivedRecords %> / <%= device.totalInsertedRecords %></span></div>
							<div class="device-meta">Last successful synchronization<br><strong>Not verifiable from ADMS</strong></div>
							<div class="sync-result" data-role="result" aria-live="polite">
								<% if (device.run) { %>
									Status: <strong data-role="status"><%= device.run.status.replace(/_/g, ' ') %></strong><br>
									Received <span data-role="received"><%= device.run.receivedRecords %></span> · Saved <span data-role="saved"><%= device.run.savedRecords %></span> · Duplicates <span data-role="duplicates"><%= device.run.duplicateRecords %></span> · Failed <span data-role="failed"><%= device.run.failedRecords %></span>
								<% } else { %>
									Status: <strong data-role="status">No manual monitoring session</strong><br>
									Received 0 · Saved 0 · Duplicates 0 · Failed 0
								<% } %>
							</div>
							<button class="button button-primary sync-device-button" type="button">Sync Device Attendance</button>
						</article>
					<% }) %>
				</div>
			<% } else { %>
				<div class="empty-state">No device has contacted the attendance server yet. Its serial number will appear here after it connects to the configured ADMS endpoint.</div>
			<% } %>
		</section>
		<section class="panel" aria-label="Attendance report">
			<form class="toolbar" method="get" action="/employeeattendance">
				<div class="filter"><label for="startDateBs">From (BS)</label><input id="startDateBs" class="nepali-date-input" name="startDateBs" type="text" inputmode="numeric" autocomplete="off" placeholder="YYYY-MM-DD" value="<%= startDateBs %>" required></div>
				<div class="filter"><label for="endDateBs">To (BS)</label><input id="endDateBs" class="nepali-date-input" name="endDateBs" type="text" inputmode="numeric" autocomplete="off" placeholder="YYYY-MM-DD" value="<%= endDateBs %>" required></div>
				<button class="button button-secondary" type="submit">Apply dates</button>
				<a class="button button-primary" href="/employeeattendance/export?startDateBs=<%= encodeURIComponent(startDateBs) %>&amp;endDateBs=<%= encodeURIComponent(endDateBs) %>" download>Export to Excel</a>
			</form>
				<% if (importMessage) { %><div class="import-notice" role="status"><%= importMessage %></div><% } %>
				<% if (importError) { %><div class="import-notice import-error" role="alert"><%= importError %></div><% } %>
				<form class="toolbar import-toolbar" method="post" action="/employeeattendance/import" enctype="multipart/form-data">
					<a class="button button-secondary" href="/employeeattendance/template">Download CSV template</a>
					<div class="filter"><label for="attendanceCsv">Upload attendance CSV</label><input id="attendanceCsv" name="attendanceCsv" type="file" accept=".csv,text/csv" required></div>
					<button class="button button-primary" type="submit">Upload and save</button>
				</form>
			<div class="table-heading">
				<h2>Daily attendance details</h2>
				<span class="count"><span id="totalRows"><%= reportRows.length %></span> records</span>
			</div>
			<% if (reportRows.length) { %>
				<div class="table-wrap">
					<table id="attendanceTable">
						<thead><tr>
							<% [['sn', 'SN'], ['employeeName', 'Employee name'], ['employeeCode', 'Code'], ['branchName', 'Branch name'], ['department', 'Department'], ['nepaliDate', 'Date (BS)'], ['plannedIn', 'Planned in'], ['plannedOut', 'Planned out'], ['actualIn', 'Actual in'], ['actualOut', 'Actual out'], ['lateInStatus', 'Late in status'], ['earlyOutStatus', 'Early out status'], ['leaveType', 'Leave type'], ['remarks', 'Remarks']].forEach(([key, label]) => { %>
								<th scope="col"><button class="sort-button" type="button" data-sort="<%= key %>" aria-label="Sort by <%= label %>"><%= label %> <span aria-hidden="true">↕</span></button></th>
							<% }) %>
						</tr></thead>
						<tbody>
							<% reportRows.forEach((row, index) => { %>
								<tr class="<%= row.isHoliday ? 'holiday-row' : '' %>">
									<td data-value="<%= index + 1 %>"><%= index + 1 %></td>
									<td class="employee-name" data-value="<%= row.employeeName %>"><%= row.employeeName %></td>
									<td class="employee-code" data-value="<%= row.employeeCode %>"><%= row.employeeCode %></td>
									<td data-value="<%= row.branchName %>"><%= row.branchName %></td>
									<td data-value="<%= row.department %>"><%= row.department %></td>
									<td data-value="<%= row.date %>"><%= row.nepaliDate %></td>
									<td data-value="<%= row.plannedIn %>"><%= row.plannedIn %></td>
									<td data-value="<%= row.plannedOut %>"><%= row.plannedOut %></td>
									<td data-value="<%= row.actualIn %>" class="<%= row.actualIn.startsWith('Missed') ? 'status-missed' : '' %>"><%= row.actualIn %></td>
									<td data-value="<%= row.actualOut %>" class="<%= row.actualOut.startsWith('Missed') ? 'status-missed' : '' %>"><%= row.actualOut %></td>
									<td data-value="<%= row.lateMinutes %>" class="<%= row.lateMinutes ? 'status-late' : row.actualIn.startsWith('Missed') ? 'status-missed' : 'status-on-time' %>"><%= row.lateInStatus %></td>
									<td data-value="<%= row.earlyMinutes %>" class="<%= row.earlyMinutes ? 'status-late' : row.actualOut.startsWith('Missed') ? 'status-missed' : 'status-on-time' %>"><%= row.earlyOutStatus %></td>
									<td data-value="<%= row.leaveType %>"><%= row.leaveType %></td>
									<td data-value="<%= row.remarks %>"><%= row.remarks %></td>
								</tr>
							<% }) %>
						</tbody>
					</table>
				</div>
				<div class="pagination">
					<label>Rows per page <select id="pageSize"><option>25</option><option>50</option><option>100</option><option value="all">All</option></select></label>
					<div class="page-controls"><span id="pageSummary"></span><button id="previousPage" type="button" aria-label="Previous page">Previous</button><button id="nextPage" type="button" aria-label="Next page">Next</button></div>
				</div>
			<% } else { %>
				<div class="empty-state">No attendance records or employee profiles were found for this date range.</div>
			<% } %>
		</section>
	</main>
	<script src="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/js/nepali.datepicker.v5.0.6.min.js" type="text/javascript"></script>
	<script>
		const syncStatusLabels = {
			waiting: 'Waiting for device data',
			receiving: 'Receiving and processing records',
			records_received: 'Records received; replay completion is unknown',
			no_data: 'No data observed during monitoring',
			partial: 'Partial processing; some records failed',
			failed: 'Processing failed'
		};
		const formatSyncDate = value => value ? new Date(value).toLocaleString() : 'Not recorded';
		document.querySelectorAll('.sync-device-button').forEach(button => button.addEventListener('click', async () => {
			const card = button.closest('.device-card');
			const serialNumber = card.dataset.serial;
			const status = card.querySelector('[data-role="status"]');
			button.disabled = true;
			status.textContent = 'Starting monitor…';

			try {
				const response = await fetch('/employeeattendance/device-sync', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ serialNumber })
				});
				const data = await response.json();
				if (!response.ok) throw new Error(data.message || 'Unable to start attendance monitoring.');
				updateSyncCard(card, data);
				if (data.run) monitorSync(card, data.run.id);
			} catch (error) {
				status.textContent = error.message;
				button.disabled = false;
			}
		}));

		function updateSyncCard(card, data) {
			const run = data.run;
			if (!run) return;
			card.querySelector('[data-role="connection"]').textContent = data.connectionLabel;
			card.querySelector('[data-role="connection"]').className = `device-status ${data.online ? 'device-online' : 'device-offline'}`;
			card.querySelector('[data-role="last-communication"]').textContent = formatSyncDate(data.lastCommunicationAt);
			card.querySelector('[data-role="last-attendance"]').textContent = formatSyncDate(data.lastAttendanceReceived);
			card.querySelector('[data-role="last-batch"]').textContent = formatSyncDate(data.lastSuccessfulBatchAt);
			card.querySelector('[data-role="request-type"]').textContent = data.lastRequestType || 'None';
			card.querySelector('[data-role="request-status"]').textContent = data.lastRequestStatus || 'No request status';
			card.querySelector('[data-role="request-source"]').textContent = String(data.lastRequestSource || 'unverified').replace(/_/g, ' ');
			card.querySelector('[data-role="device-totals"]').textContent = `${data.totalReceivedRecords || 0} / ${data.totalInsertedRecords || 0}`;
			card.querySelector('[data-role="status"]').textContent = syncStatusLabels[run.status] || run.status;
			for (const [field, key] of [['received', 'receivedRecords'], ['saved', 'savedRecords'], ['duplicates', 'duplicateRecords'], ['failed', 'failedRecords']]) {
				const target = card.querySelector(`[data-role="${field}"]`);
				if (target) target.textContent = run[key];
			}
			const result = card.querySelector('[data-role="result"]');
			if (run.errorDetails && run.errorDetails.length) {
				result.title = run.errorDetails.join('\n');
			} else {
				result.removeAttribute('title');
			}
		}

		function monitorSync(card, runId) {
			const button = card.querySelector('.sync-device-button');
			let pollCount = 0;
			const timer = setInterval(async () => {
				pollCount += 1;
				try {
					const response = await fetch(`/employeeattendance/device-sync/${encodeURIComponent(runId)}`);
					const data = await response.json();
					if (!response.ok) throw new Error(data.message || 'Unable to read sync status.');
					updateSyncCard(card, data);
					if (!['waiting', 'receiving'].includes(data.run.status) || pollCount >= 120) {
						clearInterval(timer);
						button.disabled = false;
					}
				} catch (error) {
					clearInterval(timer);
					card.querySelector('[data-role="status"]').textContent = error.message;
					button.disabled = false;
				}
			}, 5000);
		}

		document.querySelectorAll('.nepali-date-input').forEach(input => {
			if (typeof input.NepaliDatePicker === 'function') {
				input.NepaliDatePicker({ dateFormat: 'YYYY-MM-DD', language: 'english' });
			}
		});
		document.querySelector('.toolbar').addEventListener('submit', event => {
			event.currentTarget.querySelectorAll('.nepali-date-input').forEach(input => {
				const match = input.value.match(/^([0-9०-९]{4})-([0-9०-९]{1,2})-([0-9०-९]{1,2})$/);
				if (!match) return;
				const zero = /[०-९]/.test(input.value) ? '०' : '0';
				input.value = `${match[1]}-${match[2].padStart(2, zero)}-${match[3].padStart(2, zero)}`;
			});
		});

		const table = document.getElementById('attendanceTable');
		if (table) {
			const body = table.tBodies[0];
			const pageSizeSelect = document.getElementById('pageSize');
			const pageSummary = document.getElementById('pageSummary');
			const previousButton = document.getElementById('previousPage');
			const nextButton = document.getElementById('nextPage');
			let rows = Array.from(body.rows);
			let page = 0;
			let sortKey = '';
			let sortDirection = 1;

			function renderPage() {
				const size = pageSizeSelect.value === 'all' ? rows.length : Number(pageSizeSelect.value);
				const pageCount = Math.max(1, Math.ceil(rows.length / size));
				page = Math.min(page, pageCount - 1);
				rows.forEach((row, index) => {
					row.cells[0].textContent = String(index + 1);
					row.hidden = index < page * size || index >= (page + 1) * size;
				});
				pageSummary.textContent = `${page + 1} / ${pageCount}`;
				previousButton.disabled = page === 0;
				nextButton.disabled = page >= pageCount - 1;
			}

			table.querySelectorAll('[data-sort]').forEach(button => button.addEventListener('click', () => {
				const key = button.dataset.sort;
				const column = Array.from(table.tHead.rows[0].cells).indexOf(button.closest('th'));
				sortDirection = sortKey === key ? -sortDirection : 1;
				sortKey = key;
				rows.sort((first, second) => {
					const firstValue = first.cells[column].dataset.value || first.cells[column].textContent;
					const secondValue = second.cells[column].dataset.value || second.cells[column].textContent;
					const firstNumber = Number(firstValue);
					const secondNumber = Number(secondValue);
					return (Number.isFinite(firstNumber) && Number.isFinite(secondNumber)
						? firstNumber - secondNumber
						: firstValue.localeCompare(secondValue, undefined, { numeric: true, sensitivity: 'base' })) * sortDirection;
				});
				rows.forEach(row => body.appendChild(row));
				page = 0;
				renderPage();
			}));

			pageSizeSelect.addEventListener('change', () => { page = 0; renderPage(); });
			previousButton.addEventListener('click', () => { page -= 1; renderPage(); });
			nextButton.addEventListener('click', () => { page += 1; renderPage(); });
			renderPage();
		}
	</script>
</body>
</html>